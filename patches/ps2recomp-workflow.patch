+void register_ps2_gs_gpu_tests()
+{
+#ifdef PS2X_HAS_DILIGENT_GS
+    MiniTest::Case("PS2GPUKeys", [](TestCase &tc)
+    {
+        tc.Run("exact register cache keys", [](TestCase &t)
+        { CheckRegisterKey<8>(t); CheckRegisterKey<9>(t); CheckRegisterKey<22>(t); });
+    });
+    // Explicit research pipe: bounded local inputs, no stored game packets or
+    // output images. Raw batch layout must match this exact build.
+    if (const char *pipe = std::getenv("PS2_GS_REFERENCE_PIPE"); pipe && std::strcmp(pipe, "1") == 0)
+    MiniTest::Case("PS2GPUReference", [](TestCase &tc)
+    {
+        tc.Run("streamed shadow draws match CPU reference", [](TestCase &t)
+        {
+#ifdef _WIN32
+            _setmode(_fileno(stdin), _O_BINARY);
+#endif
+            uint32_t header[4]{};
+            std::cin.read(reinterpret_cast<char *>(header), sizeof(header));
+            if (!std::cin || header[0] != 0x47535231 || header[1] != sizeof(GSPrimitiveBatch) ||
+                !header[2] || header[2] > 32 || header[3] != 4u * 1024u * 1024u)
+            { t.Fail("Invalid bounded draw stream"); return; }
+            std::vector<uint8_t> initial(header[3]), expected(header[3]), actual(header[3]);
+            std::vector<GSPrimitiveBatch> draws(header[2]);
+            std::cin.read(reinterpret_cast<char *>(initial.data()), initial.size());
+            std::cin.read(reinterpret_cast<char *>(draws.data()), draws.size() * sizeof(GSPrimitiveBatch));
+            if (!std::cin) { t.Fail("Incomplete draw stream"); return; }
+            struct RestoreRounding { int mode = std::fegetround(); ~RestoreRounding() { std::fesetround(mode); } } restore;
+            std::fesetround(FE_TONEAREST);
+            GSDiligentDevice gpu(GSDiligentDevice::Api::D3D11);
+            uint64_t touched[2]{};
+            for (unsigned isolated = 0; isolated < 2; ++isolated)
+            for (size_t i = 0; i < draws.size(); ++i)
+            {
+                auto draw = draws[i];
+                expected = initial;
+                if (isolated)
+                {
+                    // Reveal the shadow independently of stale scene depth or
+                    // destination colors, while preserving captured STQ/blend.
+                    draw.state.context.frame = {0, 8, GS_PSM_CT32, 0};
+                    draw.state.context.scissor = {0, 511, 0, 223};
+                    draw.state.context.zbuf.zmask = true;
+                    draw.state.context.test = 3ull << 16; // ZTE, ALWAYS.
+                    for (uint32_t y = 0; y < 224; ++y)
+                        for (uint32_t x = 0; x < 512; ++x)
+                            GSMem::WriteCT32(expected.data(), 0, 8, x, y, 0x80808080);
+                }
+                GSCpuBackend cpu;
+                cpu.Initialize(expected.data(), uint32_t(expected.size()));
+                gpu.UploadVram(expected);
+                actual = expected;
+                cpu.Submit(draw);
+                uint64_t changed = 0;
+                for (size_t j = 0; j < actual.size(); ++j) changed += actual[j] != expected[j];
+                const char *reason = nullptr;
+                if (!gpu.DrawPrimitive(draw, false, &reason))
+                { t.Fail(std::string("Captured draw rejected: ") + (reason ? reason : "unknown")); return; }
+                gpu.DownloadVram(actual);
+                const auto mismatch = std::mismatch(expected.begin(), expected.end(), actual.begin());
+                if (mismatch.first != expected.end())
+                {
+                    const size_t offset = size_t(mismatch.first - expected.begin());
+                    std::cout << "GS reference case=" << i << " isolated=" << isolated << " offset=" << offset
+                        << " cpu=" << unsigned(expected[offset]) << " gpu=" << unsigned(actual[offset]) << '\n';
+                    t.Fail("Captured draw differs from CPU reference"); return;
+                }
+                touched[isolated] += changed;
+                std::cout << "GS reference case=" << i << " isolated=" << isolated << " changed_bytes=" << changed << '\n';
+            }
+            t.IsTrue(touched[0] > 0, "Captured stream must exercise visible writes");
+            t.IsTrue(touched[1] > 0, "Isolated stream must exercise visible writes");
+        });
+    });
+    // GPU tests are explicit: normal CPU test runs must not require a GPU/driver.
+    const char *selected = std::getenv("PS2_GPU_TEST_APIS");
+    if (!selected) return;
+    const std::string apis = selected;
+    MiniTest::Case("PS2GPU", [apis](TestCase &tc)
+    {
+        for (const char *api : {"d3d11", "d3d12", "vulkan"})
+            if (apis.find(api) != std::string::npos)
+                tc.Run(std::string(api) + " ordered game backend", [api](TestCase &t) { CheckBackend(t, api); });
+        if (apis.find("d3d11") != std::string::npos)
+            tc.Run("D3D11 shared GS shader", [](TestCase &t) { CheckApi(t, GSDiligentDevice::Api::D3D11); });
+        if (apis.find("d3d12") != std::string::npos)
+            tc.Run("D3D12 shared GS shader", [](TestCase &t) { CheckApi(t, GSDiligentDevice::Api::D3D12); });
+        if (apis.find("vulkan") != std::string::npos)
+            tc.Run("Vulkan shared GS shader", [](TestCase &t) { CheckApi(t, GSDiligentDevice::Api::Vulkan); });
+#ifdef _WIN32
+        if (apis.find("opengl") != std::string::npos)
+            tc.Run("OpenGL shared GS shader", [](TestCase &t)
+            {
+                HiddenGLContext context;
+                if (!context.Initialize()) { t.Fail("Could not create hidden test GL context"); return; }
+                CheckApi(t, GSDiligentDevice::Api::OpenGL);
+            });
+#endif
+    });
+#endif
+}
