+bool T8PaletteIgnoresHighBit(const GSDrawState &s, std::span<const uint8_t> memory)
+{
+    const auto &c = s.context; const auto &t = c.tex0;
+    if (memory.size() != VramBytes || t.psm != GS_PSM_T8H || t.cpsm != GS_PSM_CT32 ||
+        t.csm != 0 || PreservedIndexBits(c) != 0x7f000000u) return false;
+    // Check the complete CSM1 CT32 palette, including any CSA rotation. Bit7
+    // commutes with that rotation and the bits3/4 swap. Actual RGBA equality
+    // preserves every texture function, alpha policy and filter result.
+    for (uint32_t i = 0; i < 128; ++i)
+    {
+        const uint32_t index = (i & ~24u) | ((i & 8u) << 1u) | ((i & 16u) >> 1u);
+        const uint32_t x = s.texclut.cou + (index & 15), y = s.texclut.cov + (index >> 4);
+        const auto width = std::max(uint32_t(s.texclut.cbw), 1u);
+        auto *bytes = const_cast<uint8_t *>(memory.data()); // GSMem read API is non-const, but does not write.
+        if (GSMem::ReadCT32(bytes, t.cbp, width, x, y) != GSMem::ReadCT32(bytes, t.cbp, width, x, y + 8)) return false;
+    }
+    return true;
+}
