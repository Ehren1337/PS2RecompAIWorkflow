+// Fixed register keys contain words only, with no padding or ignored bits.
+// Avoid an out-of-line byte comparator for every submitted primitive. The
+// reduction permits vectorization while retaining exact equality (no hash).
+template<size_t N>
+inline bool EqualRegisterKey(const std::array<uint32_t, N> &a, const std::array<uint32_t, N> &b)
+{
+    uint32_t different = 0;
+    for (size_t i = 0; i < N; ++i) different |= a[i] ^ b[i];
+    return different == 0;
+}
+}
