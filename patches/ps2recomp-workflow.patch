+                request.hasPreferredSource = true; request.preferredDestFbp = 511;
+                request.preferredSource = {16379, uint32_t(scenario == 3 ? 0 : 7), format, 0};
+            }
+            if (scenario >= 5)
+            {
+                request.pmode = 3 | (uint64_t(scenario & 1) << 5) | (uint64_t(scenario & 2) << 5) |
+                    (uint64_t(scenario & 4) << 5) | (173ull << 8);
+                request.bgcolor = 0x936512;
+                request.dispfb2 = 53ull | (6ull << 9) | (uint64_t(format) << 15) | (61ull << 32) | (125ull << 43);
+                request.display2 = (uint64_t(width - 4) << 32) | (uint64_t(height - 8) << 44);
+            }
+            const auto reference = cpu.Present(request);
+            if (scenario == 10)
+            {
+                request.dispfb2 = request.dispfb1; request.display2 = request.display1;
+                request.pmode = 3 | (173ull << 8);
+                auto single = request; single.pmode = 1;
+                const auto singleFrame = cpu.Present(single), doubleFrame = cpu.Present(request);
+                test.IsTrue(singleFrame.pixels == doubleFrame.pixels, "Identical display circuits preserve single-source output");
+            }
+            const auto displayReference = scenario == 10 ? cpu.Present(request) : reference;
+            const auto result = ComposeGSPresentation(request, [&](const GSFrameReg &frame, uint32_t w, uint32_t h,
+                std::vector<uint8_t> &pixels, bool alpha, bool pages, uint32_t x, uint32_t y)
+            { return gpu.ReadDisplay(frame, w, h, pixels, alpha, pages, x, y); });
+            test.IsTrue(result.pixels == displayReference.pixels && result.width == displayReference.width && result.height == displayReference.height &&
+                result.displayFbp == displayReference.displayFbp && result.sourceFbp == displayReference.sourceFbp && result.usedPreferred == displayReference.usedPreferred,
+                "GPU display matches CPU pixels and metadata for format/scenario " + std::to_string(format) + "/" + std::to_string(scenario));
+            const auto *allocation = recycledDisplay.data();
+            auto composed = gpu.Present(request, false, &recycledDisplay);
+            test.IsTrue(composed.pixels.data() == allocation && recycledDisplay.empty(),
+                "Synchronous presentation reuses the retired allocation");
+            test.IsTrue(composed.pixels == displayReference.pixels && composed.width == displayReference.width && composed.height == displayReference.height &&
+                composed.displayFbp == displayReference.displayFbp && composed.sourceFbp == displayReference.sourceFbp && composed.usedPreferred == displayReference.usedPreferred,
+                "GPU composition matches CPU pixels and metadata for format/scenario " + std::to_string(format) + "/" + std::to_string(scenario));
+            recycledDisplay.swap(composed.pixels);
+            std::fill(recycledDisplay.begin(), recycledDisplay.end(), uint8_t(0xa5));
+            const auto queued = gpu.Present(request, true, &recycledDisplay);
+            test.IsTrue(recycledDisplay.data() == allocation && recycledDisplay.front() == 0xa5,
+                "Pending submission leaves the caller's spare untouched");
+            test.IsTrue(queued.pending && !queued, "First deferred submission returns pending, not a blank replacement");
+            // Guest FINISH and full VRAM reads use different staging storage.
+            gpu.WaitForCompletion();
+            GSTransferCommand smallRead;
+            smallRead.direction = 1; smallRead.bitbltbuf = {5417, 1, GS_PSM_Z32, 0, 1, GS_PSM_CT32};
+            smallRead.trxpos = {32, 16, 0, 0, 0}; smallRead.trxreg = {8, 5};
+            std::vector<uint8_t> depthBytes;
+            test.IsTrue(gpu.ReadLocalToHost(smallRead, depthBytes), "Guest depth read can occur during deferred display");
+            gpu.DownloadVram(actual);
+            auto drained = drainDisplay(&recycledDisplay);
+            test.IsTrue(drained.pixels.data() == allocation && recycledDisplay.empty(),
+                "Deferred completion reuses the retired allocation");
