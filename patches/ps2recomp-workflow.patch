--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_audio_reverb.h
@@ -0,0 +1,160 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <vector>
+
+// Register-driven SPU reverb network at its half-rate clock (24 kHz on PS2).
+// Independent implementation of the documented reflection/comb/all-pass network:
+// https://psx-spx.consoledev.net/soundprocessingunitspu/#spu-reverb-formula
+// PS2 register-address expansion and alternating-channel behavior were checked
+// against PS2SDK effect.c and PCSX2 SPU2/Reverb.cpp. No preset/game data is here.
+// The network itself does not implement voice sends, output depth,
+// SPU RAM aliasing with samples, or IRQs; those belong to the enclosing mixer.
+class PS2ReverbNetwork
+{
+public:
+    // The conventional 32-halfword SPU effect-register order. Address fields
+    // use eight-byte units; coefficient fields are signed Q15.
+    using Registers = std::array<uint16_t, 32>;
+    static constexpr uint32_t kRamWords = 1u << 20;
+
+    bool configure(const Registers &registers, uint32_t startWord,
+                   uint32_t wordCount, bool clear = false)
+    {
+        if (!wordCount || startWord >= kRamWords || wordCount > kRamWords - startWord)
+            return false;
+        if (m_memory.empty()) m_memory.resize(kRamWords);
+        if (clear) std::fill_n(m_memory.begin() + startWord, wordCount, int16_t(0));
+        m_registers = registers;
+        m_start = startWord;
+        m_count = wordCount;
+        return true;
+    }
+
+    void reset()
+    {
+        std::fill(m_memory.begin(), m_memory.end(), int16_t(0));
+        m_registers = {};
+        m_start = m_count = 0;
+        m_clock = 0;
+    }
+
+    std::array<int16_t, 2> processFrame(int32_t left, int32_t right, bool writeEnabled = true)
+    {
+        return {processChannel(0, left, writeEnabled), processChannel(1, right, writeEnabled)};
+    }
+
+    // The 48-kHz wrapper alternates left/right; each pair advances effect RAM.
+    int16_t processChannel(unsigned channel, int32_t input, bool writeEnabled = true)
+    {
+        if (!m_count || channel > 1) return 0;
+        const int64_t sameDestination = address(10 + channel);
+        const int64_t crossDestination = address(18 + channel);
+        const int64_t incoming = multiply(clamp(input), coefficient(30 + channel));
+        const auto reflection = [&](int64_t source, int64_t destination) {
+            const int64_t previous = read(destination - 1);
+            return previous + multiply(incoming + multiply(read(source), coefficient(7)) - previous,
+                                       coefficient(2));
+        };
+        const int64_t same = reflection(address(16 + channel), sameDestination);
+        const int64_t cross = reflection(address(24 + (channel ^ 1)), crossDestination);
+        int64_t combined = 0;
+        constexpr std::array<unsigned, 4> taps{12, 14, 20, 22};
+        for (unsigned tap = 0; tap < taps.size(); ++tap)
+            combined += multiply(read(address(taps[tap] + channel)), coefficient(3 + tap));
+
+        std::array<int64_t, 2> allPass{};
+        for (unsigned stage = 0; stage < 2; ++stage)
+        {
+            const int64_t destination = address(26 + stage * 2 + channel);
+            const int64_t delayed = read(destination - address(stage));
+            allPass[stage] = combined - multiply(delayed, coefficient(8 + stage));
+            combined = delayed + multiply(allPass[stage], coefficient(8 + stage));
+        }
+        // Read the channel's taps before committing its saturated writes.
+        // The right channel subsequently sees the left channel's writes.
+        if (writeEnabled)
+        {
+            write(sameDestination, same);
+            write(crossDestination, cross);
+            write(address(26 + channel), allPass[0]);
+            write(address(28 + channel), allPass[1]);
+        }
+        if (channel == 1) ++m_clock;
+        return clamp(combined);
+    }
+
+private:
+    static int16_t clamp(int64_t value)
+    { return int16_t(std::clamp<int64_t>(value, -32768, 32767)); }
+    static int64_t multiply(int64_t value, int16_t gain)
+    { return (value * gain) >> 15; }
+    int16_t coefficient(unsigned field) const
+    { return std::bit_cast<int16_t>(m_registers[field]); }
+    int64_t address(unsigned field) const { return int64_t(m_registers[field]) * 4; }
+    uint32_t index(int64_t offset) const
+    {
+        const int64_t relative = (int64_t(m_clock % m_count) + offset) % m_count;
+        return m_start + uint32_t(relative < 0 ? relative + m_count : relative);
+    }
+    int16_t read(int64_t offset) const { return m_memory[index(offset)]; }
+    void write(int64_t offset, int64_t value) { m_memory[index(offset)] = clamp(value); }
+    Registers m_registers{};
+    std::vector<int16_t> m_memory;
+    uint32_t m_start = 0, m_count = 0;
+    uint64_t m_clock = 0;
+};
+
+// Streaming rate conversion surrounding the half-rate network. Coefficients
+// are documented hardware constants (PSX-SPX, Reverb Buffer Resampling), not
+// game data. The alternating SPU2 schedule was checked against PCSX2 Reverb.cpp.
+// Independent scalar FIR implementation; exact silicon rounding remains unverified.
+class PS2ReverbProcessor
+{
+public:
+    bool configure(const PS2ReverbNetwork::Registers &registers, uint32_t start,
+                   uint32_t count, bool clear = false)
+    { return m_network.configure(registers, start, count, clear); }
+
+    void reset()
+    {
+        m_network.reset();
+        m_input = {}; m_output = {}; m_position = 0;
+    }
+
+    std::array<int16_t, 2> processFrame(int32_t left, int32_t right, bool writeEnabled)
+    {
+        const unsigned channel = m_position & 1;
+        // Downsample the preceding input history, then latch this frame.
+        const int16_t down = filter(m_input[channel], 1, false);
+        m_input[0][m_position] = clamp(left);
+        m_input[1][m_position] = clamp(right);
+        m_output[channel][m_position] = m_network.processChannel(channel, down, writeEnabled);
+        m_output[channel ^ 1][m_position] = 0; // Zero insertion before interpolation.
+        const std::array<int16_t, 2> wet{
+            filter(m_output[0], 0, true), filter(m_output[1], 0, true)};
+        m_position = (m_position + 1) % 64;
+        return wet;
+    }
+
+private:
+    static int16_t clamp(int64_t value)
+    { return int16_t(std::clamp<int64_t>(value, -32768, 32767)); }
+    int16_t filter(const std::array<int16_t, 64> &history, unsigned delay, bool up) const
+    {
+        // Nonzero half-band taps and centre. Mirroring gives the 39-tap FIR.
+        constexpr std::array<int16_t, 10> edge{-1,2,-10,35,-103,266,-616,1332,-2960,10246};
+        const auto sample = [&](unsigned age) { return history[(m_position + 64 - age) % 64]; };
+        int64_t total = int64_t(sample(delay + 19)) * (up ? 32767 : 16384);
+        for (unsigned i = 0; i < edge.size(); ++i)
+            total += int64_t(edge[i]) * (up ? 2 : 1) *
+                (int32_t(sample(delay + 2 * i)) + sample(delay + 38 - 2 * i));
+        return clamp(total >> 15);
+    }
+    PS2ReverbNetwork m_network;
+    std::array<std::array<int16_t, 64>, 2> m_input{}, m_output{};
+    unsigned m_position = 0;
+};
