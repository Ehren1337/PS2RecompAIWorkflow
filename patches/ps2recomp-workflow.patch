+                        m_ambientStream = ambientStream;
+                        m_ambientObject = ambientObject;
+                        m_ambientPosition = ambientPosition;
+                        m_engineStream = engineStream;
+                        m_enginePlayer = enginePlayer;
+                        m_streamStopRequested = streamStopRequested;
+                        m_soundEnabled = soundEnabled;
+                        m_levelResets = levelResets;
+                        m_retailLevelRecord = retailLevelRecord;
+                        m_engines = engines;
+                        m_skidPitches = skidPitches;
+                        m_roadPitches = roadPitches;
+                        m_listeners = listeners;
+                        m_emitters = emitters;
+                        m_engineAliasesReady = engineAliasesReady;
+                        m_engineUpdates = engineUpdates;
+                        m_environmentEnabled = environmentEnabled;
+                        m_cueEnabled = cueEnabled;
+                        m_cueVoice = cueVoice;
+                        m_cueCommands += cueCount;
