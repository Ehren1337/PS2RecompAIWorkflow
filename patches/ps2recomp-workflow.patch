+
+namespace ps2_ipu
+{
+    bool decodePicture(std::span<const uint8_t> input, Picture &output, std::string &error)
+    {
+        auto fail = [&](const char *message) { error = message; return false; };
+        auto u32 = [&](size_t at) {
+            return uint32_t(input[at]) | uint32_t(input[at + 1]) << 8 |
+                uint32_t(input[at + 2]) << 16 | uint32_t(input[at + 3]) << 24;
+        };
+        if (input.size() < 25 || input.size() > 32u * 1024u * 1024u ||
+            std::memcmp(input.data(), "ipum", 4) != 0)
+            return fail("invalid IPUM header/extent");
+        const uint32_t width = input[8] | uint32_t(input[9]) << 8;
+        const uint32_t height = input[10] | uint32_t(input[11]) << 8;
+        const uint64_t logicalSize = uint64_t(u32(4)) + 8;
+        if (logicalSize < 25 || logicalSize > input.size() ||
+            (input.size() != logicalSize && input.size() != ((logicalSize + 3) & ~uint64_t(3))))
+            return fail("invalid IPUM logical extent or resource padding");
+        // SHOC picture resources round their size to four bytes. The padding
+        // may be nonzero and follows B1; never pass it to the frame decoder or
+        // mistake it for part of the end markers. Loose trailing data remains
+        // rejected outside this exact alignment boundary.
+        input = input.first(static_cast<size_t>(logicalSize));
+        if (u32(12) != 1 ||
+            !width || !height || width > 2048 || height > 2048 || width % 16 || height % 16)
+            return fail("unsupported IPUM dimensions, size, or frame count");
+        if (input[16] != 0)
+            return fail("unsupported IPUM flags; only progressive default-matrix pictures verified");
+        constexpr uint8_t endMarkers[] = {0, 0, 1, 0xb0, 0, 0, 1, 0xb1};
+        if (std::memcmp(input.data() + input.size() - 8, endMarkers, 8) != 0)
+            return fail("missing IPUM frame/sequence end");
+#if PS2X_HAS_FFMPEG
+        struct Decoder
+        {
+            AVCodecContext *context = nullptr;
+            AVPacket *packet = nullptr;
+            AVFrame *frame = nullptr;
+            ~Decoder() { av_frame_free(&frame); av_packet_free(&packet); avcodec_free_context(&context); }
+        } decoder;
+        const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_IPU);
+        if (!codec) return fail("FFmpeg IPU decoder unavailable");
+        decoder.context = avcodec_alloc_context3(codec);
+        decoder.packet = av_packet_alloc();
+        decoder.frame = av_frame_alloc();
+        if (!decoder.context || !decoder.packet || !decoder.frame) return fail("IPUM decoder allocation failed");
+        decoder.context->width = static_cast<int>(width);
+        decoder.context->height = static_cast<int>(height);
+        decoder.context->thread_count = 1;
+        decoder.context->err_recognition = AV_EF_EXPLODE;
+        // Exactly one frame: skip the 16-byte container header and final B1.
+        // The IPU decoder expects the B0 marker as its last four packet bytes.
+        const int packetBytes = static_cast<int>(input.size() - 20);
