+                    const long double exactProduct = static_cast<long double>(matrix[(axis + 1) * 4 + c]) * position[axis];
+                    const long double exactSum = static_cast<long double>(acc) + exactProduct;
+                    sticky |= flags(exactProduct) | flags(exactSum);
+                    float product;
+                    if (!rounded(static_cast<double>(exactProduct), product) ||
+                        !rounded(static_cast<double>(acc) + product, acc)) return false;
+                    // Match the reference FMAC's exact-result normalization.
+                    if (std::fabs(exactSum) < std::numeric_limits<float>::min())
