+    test.IsTrue(memory == hostBeforeDisplay, "Display extraction does not overwrite stale host VRAM");
+    displayContext.frame.fbmsk = 0xff00ff00u;
+    cpu.ClearFramebuffer(displayContext, 0x12873456); gpu->ClearFramebuffer(displayContext, 0x12873456);
+    compare("GPU drawing resumes after presentation scratch reuse");
+    // Early depth snapshots must never outlive writes to their coherence region.
+    for (unsigned sequence = 0; sequence < 24; ++sequence)
+    {
