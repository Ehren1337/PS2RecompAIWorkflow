+                    if (std::fabs(exactSum) > std::numeric_limits<float>::max()) return false;
+                    if (axis == 1) out.scalar[c] = std::bit_cast<uint32_t>(acc);
+                }
+                transformed[c] = acc;
+            }
+            return true;
+        };
+        out.vf[0] = out.vf[1] = out.vf[2] = 0;
+        out.vf[3] = 0x3f800000u;
+        out.vi[0] = 0;
+        const auto put = [&](uint32_t index, uint32_t value) {
+            out.words[index] = value; out.compared[index] = 1;
+        };
+        const auto copyQuad = [&](uint32_t source, uint32_t destination) {
+            for (uint32_t c = 0; c < 4; ++c) put(destination * 4 + c, word(data, source * 4 + c));
+        };
+        for (uint32_t i = 0; i < prefix; ++i) copyQuad(top + 1 + i, top + 224 + i);
+        uint32_t cursor = top + 1 + prefix, output = top + 224 + prefix;
+        for (uint32_t group = 0; group < groups; ++group)
+        {
+            if (cursor >= 1024) return false;
+            const uint32_t count = word(data, cursor * 4) & 32767u;
+            if (count < 2 || count > 128 || cursor + 1 + 3 * count > top + 224 || output + 1 + 3 * count > 1024) return false;
+            copyQuad(cursor, output);
+            for (uint32_t vertex = 0; vertex < count; ++vertex)
+            {
+                float position[3], texture[3], transformed[4];
+                for (uint32_t c = 0; c < 3; ++c)
+                {
+                    position[c] = std::bit_cast<float>(word(data, (cursor + 1 + vertex) * 4 + c));
+                    texture[c] = std::bit_cast<float>(word(data, (cursor + 1 + count + vertex) * 4 + c));
+                    if (!operand(position[c]) || !operand(texture[c])) return false;
+                }
+                if (!transform(position, transformed)) return false;
+                float q;
+                if (!transformed[3] || !rounded(1.0 / static_cast<double>(transformed[3]), q)) return false;
+                out.scalar[4] = std::bit_cast<uint32_t>(q);
+                // Binary32 products in [2^-64, 2^64] cannot underflow or
+                // overflow. Their direct float rounding matches the exact
+                // double product followed by rounded(). Only S/Z can change;
+                // retain final current/MAC flags even after sticky saturation.
+                bool boundedProjection = !referenceTransform && bounded(q);
+                if (boundedProjection)
+                {
+                    for (float x : transformed) boundedProjection &= bounded(x);
+                    for (float x : texture) boundedProjection &= bounded(x);
+                }
+                for (uint32_t c = 0; c < 4; ++c)
+                {
+                    float copied = transformed[c] + 0.0f;
+                    // The accepted transform returns only normalized finite
+                    // floats. Its ADD-to-zero copy can add S/Z, never U/O.
+                    // Saturated S/Z cannot change, but preserve the rounded
+                    // copy itself and the following MULq's complete flags.
+                    if (vertex && (referenceTransform || (sticky & 3u) != 3u)) sticky |= flags(copied);
+                    if (!boundedProjection || (sticky & 3u) != 3u)
+                        sticky |= flags(static_cast<long double>(copied) * q);
+                    out.vf[26 * 4 + c] = std::bit_cast<uint32_t>(copied);
+                }
+                // Only the last vertex's MULq.xyz current/MAC flags escape
+                // this straight-line packet routine; no intermediate FMAND
+                // reads them. Sticky flags still accumulate every vertex
+                // (VU manual 3.3.1-3.3.2). Keep full flag work for comparison.
+                const bool finalFlags = referenceTransform || (group + 1 == groups && vertex + 1 == count);
+                if (finalFlags) { currentStatus = 0; out.scalar[8] = 0; }
+                const uint32_t stq = (output + 1 + 3 * vertex) * 4;
+                const uint32_t xyz = stq + 8;
+                // MULq.xyz never writes VF27.W; SQI stores its raw bits.
+                put(stq + 3, out.vf[27 * 4 + 3]);
+                for (uint32_t c = 0; c < 3; ++c)
+                {
+                    float coordinate, uv;
+                    if (boundedProjection)
+                    {
+                        coordinate = transformed[c] * q;
+                        uv = texture[c] * q;
+                    }
+                    else if (!rounded(static_cast<double>(transformed[c]) * q, coordinate) ||
+                             !rounded(static_cast<double>(texture[c]) * q, uv)) return false;
+                    const double scaled = static_cast<double>(coordinate) * 16.0;
+                    const int32_t integer = scaled >= 2147483647.0 ? INT32_MAX :
+                                            scaled <= -2147483648.0 ? INT32_MIN : static_cast<int32_t>(scaled);
+                    put(xyz + c, static_cast<uint32_t>(integer));
+                    put(stq + c, std::bit_cast<uint32_t>(uv));
+                    const auto laneFlags = boundedProjection ?
+                        (((std::bit_cast<uint32_t>(uv) >> 30) & 2u) | uint32_t(uv == 0)) :
+                        flags(static_cast<long double>(texture[c]) * q);
+                    sticky |= laneFlags;
+                    if (finalFlags)
+                    {
+                        currentStatus |= laneFlags;
+                        for (uint32_t bit = 0; bit < 4; ++bit)
+                            if (laneFlags & (1u << bit)) out.scalar[8] |= (8u >> c) << (4 * bit);
+                    }
+                }
+                const uint32_t color = cursor + 1 + 2 * count + vertex;
+                copyQuad(color, output + 2 + 3 * vertex);
+                put(xyz + 3, (word(data, color * 4 + 2) & 1u) ? 0x7fffu : 0xffff8000u);
+            }
+            float lookahead[3], transformedTail[4];
+            for (uint32_t c = 0; c < 3; ++c)
+            {
+                lookahead[c] = std::bit_cast<float>(word(data, (cursor + 1 + count) * 4 + c));
+                if (!operand(lookahead[c])) return false;
+            }
+            if (!transform(lookahead, transformedTail)) return false;
+            for (uint32_t c = 0; c < 4; ++c)
+            {
+                out.vf[25 * 4 + c] = std::bit_cast<uint32_t>(transformedTail[c]);
+                out.vf[28 * 4 + c] = word(data, (cursor + 2 + count) * 4 + c);
+            }
+            // The ADD copy pipeline touches vertices3..N+1, including
+            // lookahead texture quads. Normalization plus ADD-to-zero can
+            // only add S/Z sticky flags (VU manual pp39-40; current runtime's
+            // exponent255 normalization is documented separately). Once both
+            // are set, intermediate copies have no surviving effect. Keep the
+            // final VF29 value and retain the full path for comparisons.
+            const uint32_t copyStart=!referenceTransform && (sticky&3u)==3u ? count+1 : 3;
+            for (uint32_t index = copyStart; index < count + 2; ++index)
+                for (uint32_t c = 0; c < 4; ++c)
+                {
+                    float x = std::bit_cast<float>(word(data, (cursor + 1 + index) * 4 + c));
+                    operand(x, true);
+                    x += 0.0f;
+                    sticky |= flags(x);
+                    out.vf[29 * 4 + c] = std::bit_cast<uint32_t>(x);
+                }
+            for (uint32_t lane = 0; lane < 4; ++lane)
+            {
+                out.vf[18 * 4 + lane] = word(data, cursor * 4 + lane);
+                out.vf[30 * 4 + lane] = word(data, (cursor + 2 * count) * 4 + lane);
+                out.vf[31 * 4 + lane] = word(data, (cursor + 3 * count) * 4 + lane);
+                out.vf[24 * 4 + lane] = out.words[(output + 3 * count) * 4 + lane];
+                out.vf[27 * 4 + lane] = out.words[(output + 3 * count - 2) * 4 + lane];
+            }
+            out.vi[1] = 1;
+            out.vi[2] = static_cast<int32_t>(cursor + 1 + 2 * count);
+            out.vi[3] = out.vi[6] = static_cast<int32_t>(cursor + 1 + 3 * count);
+            out.vi[4] = static_cast<int32_t>(output + 1 + 3 * count);
+            out.vi[5] = static_cast<int32_t>(top + 224);
+            out.vi[8] = -32768;
+            out.vi[9] = out.vi[4] - 4; // IADDI's signed five-bit immediate.
+            out.vi[10] = (out.vf[31 * 4 + 2] & 1u) ? 32767 : -32768;
+            out.vi[11] = 32767;
+            out.vi[12] = static_cast<int32_t>(count);
+            out.vi[13] = 0;
+            out.vertices += count;
+            cursor += 1 + 3 * count;
+            output += 1 + 3 * count;
+        }
+        out.packetQwords = output - (top + 224);
+        // All accepted divisors are nonzero: final current D/I flags clear.
+        out.scalar[10] = (entry.status & 0xfc0u) | (sticky << 6) | currentStatus;
+        return true;
+    }
+
+    uint32_t firstRegisterMismatch(const Packet &expected, const VU1State &actual)
+    {
+        for (uint32_t i = 0; i < expected.vf.size(); ++i)
+            if (expected.vfCompared[i] && expected.vf[i] != std::bit_cast<uint32_t>(actual.vf[i / 4][i % 4]))
+                return i;
+        for (uint32_t i = 0; i < expected.vi.size(); ++i)
+            if (expected.vi[i] != actual.vi[i]) return 128 + i;
+        const uint32_t scalar[] = {
+            std::bit_cast<uint32_t>(actual.acc[0]), std::bit_cast<uint32_t>(actual.acc[1]),
+            std::bit_cast<uint32_t>(actual.acc[2]), std::bit_cast<uint32_t>(actual.acc[3]),
+            std::bit_cast<uint32_t>(actual.q), std::bit_cast<uint32_t>(actual.p),
+            std::bit_cast<uint32_t>(actual.i), actual.r, actual.mac, actual.clip, actual.status};
+        for (uint32_t i = 0; i < expected.scalar.size(); ++i)
+            if (expected.scalar[i] != scalar[i]) return 144 + i;
+        return 155;
+    }
+
+    bool validateTransfer(Packet &packet, uint32_t top)
+    {
+        if (top >= 1024 || !packet.groups || !packet.packetQwords ||
+            packet.packetQwords > 1024 - top || top + 224 + packet.packetQwords > 1024) return false;
+        const uint32_t first = top + 224, end = first + packet.packetQwords;
+        for (uint32_t i = first * 4; i < end * 4; ++i)
+            if (!packet.compared[i]) return false;
+        uint32_t cursor = first;
+        while (cursor < end)
+        {
+            const uint64_t tag = packet.words[cursor * 4] | (static_cast<uint64_t>(packet.words[cursor * 4 + 1]) << 32);
+            const uint32_t loops = static_cast<uint32_t>(tag & 0x7fffu);
+            const uint32_t format = static_cast<uint32_t>((tag >> 58) & 3u);
+            if (format == 3) return false; // Reference XGKICK rejects this reserved format.
+            const uint32_t registers = ((tag >> 60) & 15u) ? static_cast<uint32_t>((tag >> 60) & 15u) : 16u;
+            const uint32_t payload = format == 0 ? loops * registers : format == 1 ? (loops * registers + 1) / 2 : loops;
+            if (payload + 1 > end - cursor) return false;
+            cursor += payload + 1;
+            if (tag & 0x8000u)
+            {
+                if (cursor != end) return false; // Early EOP changes transfer timing.
+                packet.kickCycles = 13 * packet.vertices + 21 * packet.groups + 7 + 5 * packet.prefix;
+                packet.totalCycles = packet.kickCycles + 2 * packet.packetQwords - 1;
+                return true;
+            }
+        }
+        return false; // No terminating tag.
+    }
+
+    bool buildReflectPacket(const uint8_t *data, const VU1State &entry, ClipPacket &out, bool referenceArithmetic)
+    {
+        if (!data || entry.pc != 0xb38 || entry.top < 128 || entry.top >= 1024 || entry.ebit || entry.haltAfterDelaySlot ||
+            entry.dBitEnabled || entry.tBitEnabled || entry.stoppedByD || entry.stoppedByT || entry.branchPending)
+            return false;
+        Rounding rounding;
+        if (!rounding.valid) return false;
+        using Vec = std::array<uint32_t, 4>;
+        std::array<Vec, 32> vf;
+        Vec acc;
+        std::memcpy(vf.data(), entry.vf, sizeof(entry.vf));
+        std::memcpy(acc.data(), entry.acc, sizeof(entry.acc));
+        if (vf[0] != Vec{0, 0, 0, 0x3f800000}) return false;
+        out.state = entry;
+        std::memcpy(out.data.data(), data, out.data.size());
+        auto &vi = out.state.vi;
+        uint32_t q = std::bit_cast<uint32_t>(entry.q), clip = entry.clip;
+        uint32_t sticky = 0, current = 0, mac = 0;
+        bool valid = true;
+        const auto number = [&](uint32_t bits) {
+            float value = std::bit_cast<float>(bits);
+            if (!operand(value)) { valid = false; return 0.0f; }
+            return value;
+        };
+        const auto bits = [&](double value) {
+            float result = 0;
+            if (!rounded(value, result)) valid = false;
+            return std::bit_cast<uint32_t>(result);
+        };
+        const auto arithmetic = [&](const Vec &left, const Vec &right, const Vec *base, unsigned mask = 15, bool subtract = false, bool finalFlags = false) {
+            const bool writeFlags = referenceArithmetic || finalFlags;
+            const auto calculate = [&]<bool trackFlags>() {
+                Vec result = left;
+                if (writeFlags) current = mac = 0;
+                for (unsigned c = 0; c < 4; ++c) if (mask & (8u >> c))
+                {
+                    const float a = number(left[c]), b = number(right[c]);
+                    const float addend = base ? number((*base)[c]) : 0.0f;
+                    uint32_t fastFlags = 0, fastProductFlags = 0;
+                    if (!referenceArithmetic && boundedLightingFmac<trackFlags>(a, b, addend, base != nullptr, subtract,
+                        result[c], fastFlags, fastProductFlags))
+                    {
+                        if (base) sticky |= fastProductFlags;
+                        sticky |= fastFlags;
+                        if (writeFlags)
+                        {
+                            current |= fastFlags;
+                            const uint32_t lane = 8u >> c;
+                            mac |= ((fastFlags & 1u) ? lane : 0u) | ((fastFlags & 2u) ? lane << 4 : 0u);
+                        }
+                        continue;
+                    }
