+uint64_t PS2AudioBackend::activePcmVoiceMask()
+{
+    std::lock_guard lock(m_mutex);
+    uint64_t mask = 0;
+    for (unsigned voice = 0; voice < m_impl->voices.size(); ++voice)
+        if (m_impl->voices[voice].pcm || m_impl->voices[voice].loop) mask |= uint64_t(1) << voice;
+    return mask;
+}
