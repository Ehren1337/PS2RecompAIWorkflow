diff --git a/ps2xRuntime/src/lib/rumble_picture.cpp b/ps2xRuntime/src/lib/rumble_picture.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/rumble_picture.cpp
@@ -0,0 +1,170 @@
+// Native adaptation of the verified USA retail LLPict picture path.
+// Original assets stay in guest memory; allocation/upload/free use retail code.
+#include "game_overrides.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "ps2_log.h"
+#include "runtime/ee_scheduler.h"
+#include "Stubs/IPU.h"
+#include <bit>
+#include <cstring>
+#include <initializer_list>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+
+namespace
+{
+    constexpr uint32_t kPictureEntry = 0x1a83a0;
+    constexpr uint32_t kManagerPointer = 0x1ece10;
+    constexpr uint32_t kVramManager = 0x1f0260;
+
+    uint32_t physicalRange(uint32_t address, size_t bytes)
+    {
+        const uint32_t physical = address & 0x1fffffff;
+        if (physical == 0 || physical >= PS2_RAM_SIZE || bytes > PS2_RAM_SIZE - physical)
+            throw std::runtime_error("Rumble retail picture: invalid guest memory range");
+        return physical;
+    }
+
+    struct PictureWork : std::enable_shared_from_this<PictureWork>
+    {
+        PS2Runtime *runtime;
+        uint8_t *rdram;
+        ps2_ipu::Picture decoded;
+        uint32_t descriptor = 0, pixels = 0, manager = 0;
+        uint32_t returnPc = 0, textureWidthLog = 0, textureHeightLog = 0;
+
+        void invoke(R5900Context &parent, uint32_t address,
+                    std::initializer_list<uint32_t> arguments, unsigned next)
+        {
+            GuestInvocation call{};
+            call.kind = GuestInvocationKind::HleCall;
+            call.tag = kPictureEntry;
+            call.context = parent;
+            call.context.pc = address;
+            unsigned reg = 4;
+            for (uint32_t argument : arguments)
+            {
+                SET_GPR_U32(&call.context, reg, argument);
+                ++reg;
+            }
+            SET_GPR_U32(&call.context, 29, 0);
+            SET_GPR_U32(&call.context, 31, 0);
+            call.onComplete = [work = shared_from_this(), next](const R5900Context &completed, R5900Context &resume)
+            {
+                work->advance(next, getRegU32(&completed, 2), resume);
+            };
+            runtime->eeScheduler().invokeCurrent(std::move(call));
+        }
+
+        void advance(unsigned step, uint32_t result, R5900Context &parent)
+        {
+            switch (step)
+            {
+            case 0:
+                invoke(parent, 0x1a8110, {}, 1); // picture-manager temporary DMA buffers
+                break;
+            case 1:
+                invoke(parent, 0x120e60, {0x24, 2, 0x10}, 2);
+                break;
+            case 2:
+                descriptor = result;
+                physicalRange(descriptor, 0x24);
+                invoke(parent, 0x120e60, {static_cast<uint32_t>(decoded.macroblocks.size()), 1, 0x40}, 3);
+                break;
+            case 3:
+            {
+                pixels = result;
+                std::memcpy(rdram + physicalRange(pixels, decoded.macroblocks.size()),
+                            decoded.macroblocks.data(), decoded.macroblocks.size());
+                textureWidthLog = std::bit_width(decoded.width - 1);
+                textureHeightLog = std::bit_width(decoded.height - 1);
+                const uint32_t textureWidth = 1u << textureWidthLog;
+                const uint32_t textureHeight = 1u << textureHeightLog;
+                const uint32_t words[] = {0, 0, decoded.width, decoded.height,
+                    (textureWidth + 63) / 64, textureWidthLog, textureHeightLog,
+                    std::bit_cast<uint32_t>(float(decoded.width) / textureWidth),
+                    std::bit_cast<uint32_t>(float(decoded.height) / textureHeight)};
+                std::memcpy(rdram + physicalRange(descriptor, sizeof(words)), words, sizeof(words));
+                invoke(parent, 0x12a9f0, {kVramManager, textureWidth * textureHeight * 4 / 256}, 4);
+                break;
+            }
+            case 4:
+                std::memcpy(rdram + physicalRange(descriptor, 4), &result, 4);
+                std::memcpy(&manager, rdram + kManagerPointer, 4);
+                physicalRange(manager, 8);
+                // Sixth EE argument t1=1: row-major macroblocks, as at 0x1A85E8.
+                invoke(parent, 0x1a7f90, {manager + 4, pixels, result, decoded.width, decoded.height, 1}, 5);
+                break;
+            case 5:
+                invoke(parent, 0x1a7eb0, {manager + 4}, 6);
+                break;
+            case 6:
+                invoke(parent, 0x1a7f60, {manager + 4}, 7);
+                break;
+            case 7:
+                invoke(parent, 0x1a8150, {}, 8);
+                break;
+            case 8:
+                invoke(parent, 0x121230, {pixels}, 9);
+                break;
+            case 9:
+                RUNTIME_LOG("[Rumble retail picture] uploaded " << decoded.width << "x" << decoded.height
+                    << " descriptor=0x" << std::hex << descriptor << std::dec);
+                SET_GPR_U32(&parent, 2, descriptor);
+                parent.pc = returnPc;
+                break;
+            default:
+                throw std::runtime_error("Rumble retail picture: invalid continuation");
+            }
+        }
+    };
+
+    void decodeRetailPicture(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t source = getRegU32(ctx, 4);
+        const uint32_t size = getRegU32(ctx, 5);
+        if (!source)
+        {
+            SET_GPR_U32(ctx, 2, 0);
+            ctx->pc = getRegU32(ctx, 31);
+            return;
+        }
+        const uint32_t sourceOffset = physicalRange(source, size);
+        auto work = std::make_shared<PictureWork>();
+        work->runtime = runtime;
+        work->rdram = rdram;
+        work->returnPc = getRegU32(ctx, 31);
+        std::string error;
+        if (!ps2_ipu::decodePicture(std::span(rdram + sourceOffset, size), work->decoded, error))
+            throw std::runtime_error("Rumble retail picture: " + error);
+        // Decode/validate before any game allocation or mutation. Each callback
+        // owns this one bounded image until the guest upload and frees finish.
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, rdram);
+        work->advance(0, 0, *ctx);
+    }
+
+    void applyRetailPicture(PS2Runtime &runtime)
+    {
+        for (uint32_t address : {kPictureEntry, 0x1a8110u, 0x120e60u, 0x12a9f0u,
+                0x1a7f90u, 0x1a7eb0u, 0x1a7f60u, 0x1a8150u, 0x121230u})
+            if (!runtime.hasFunction(address))
+                throw std::runtime_error("Rumble retail picture: required guest function missing");
+        if (!runtime.replaceFunction(kPictureEntry, decodeRetailPicture))
+            throw std::runtime_error("Rumble retail picture: could not bind verified entry");
+    }
+}
+
+namespace ps2_game_overrides
+{
+    void registerRumblePictureOverride()
+    {
+        static std::once_flag once;
+        std::call_once(once, [] {
+            registerDescriptor({"Rumble Racing USA retail IPUM picture", "SLUS_201.74",
+                                0x100008, 0x5720d8d8, applyRetailPicture});
+        });
+    }
+}
