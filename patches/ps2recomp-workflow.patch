+        uint table = psm == 2 ? 2048 : 6144;
+        uint addr = (base << 8) + (page << 13) + PageOffset(table + (y & 63) * 64 + (x & 63));
+        value = (Vram[(addr >> 2) & 0xfffff] >> ((addr & 2) * 8)) & 65535;
+    }
+    else if (psm == 19)
+    {
+        uint page = (y >> 6) * max(width >> 1, 1u) + (x >> 7);
+        uint addr = (base << 8) + (page << 13) + PageOffset(10240 + (y & 63) * 128 + (x & 127));
+        value = (Vram[(addr >> 2) & 0xfffff] >> ((addr & 3) * 8)) & 255;
+    }
+    else if (psm == 20)
+    {
+        uint page = (y >> 7) * max(width >> 1, 1u) + (x >> 7);
+        // T4 table and address are in nibbles, not bytes.
+        uint addr = (base << 9) + (page << 14) + PageOffset(18432 + (y & 127) * 128 + (x & 127));
