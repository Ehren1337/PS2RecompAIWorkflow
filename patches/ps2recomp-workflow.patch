+void drawMain(uint3 group : SV_GroupID, uint3 thread : SV_GroupThreadID)
+{
+    uint2 tile = TileHeaders[group.x];
+    uint x = (tile.x & 127) * 16 + thread.x;
+    uint y = ((tile.x >> 7) & 127) * 16 + thread.y;
+    uint count = tile.x >> 14;
+    DrawParams first = Commands[DrawIndex(tile.y)];
+    uint page = first.Frame.x + (y >> 5) * first.Frame.y + (x >> 6);
+    uint addr = ((page << 11) + PageOffset((y & 31) * 64 + (x & 63))) & 0xfffff;
+    if ((first.Mode.y & 8) == 0)
+    {
+        // Only isolated constant clears may alias physical addresses. Retain
+        // the atomic masked update for those; triangles cannot enter here.
+        if (x < first.Rect.x || y < first.Rect.y || x > first.Rect.z || y > first.Rect.w) return;
+        uint mask = first.ColorMask.y | (first.Frame.z == 1 ? 0xff000000 : 0);
+        uint old = Vram[addr];
+        for (;;)
+        {
+            uint expected = old;
+            uint value = (expected & mask) | (first.ColorMask.x & ~mask);
+            InterlockedCompareExchange(Vram[addr], expected, value, old);
+            if (old == expected) break;
+        }
+    }
+    else
+    {
+        // Host batching guarantees identical address mapping, unique pixel
+        // ownership and no texture/CLUT feedback for the entire batch. Keep
+        // intermediate blends in registers and store once after all commands.
+        uint pixel;
+        if ((first.Mode.y & 128) != 0) InterlockedOr(Vram[addr], 0u, pixel);
+        else pixel = Vram[addr];
+        bool touched = false;
+        uint depthAddr = 0, depth = 0, depthShift = 0;
+        bool depthTouched = false;
+        uint depthPsm = first.Depth1.w & 63;
+        bool depth16 = depthPsm == 50 || depthPsm == 58;
+        if ((first.Depth1.w & 128) != 0)
+        {
+            if (depth16)
+            {
+                uint depthPage = first.Depth1.z + (y >> 6) * first.Frame.y + (x >> 6);
+                uint table = depthPsm == 50 ? 2048 : 6144;
+                uint offset = PageOffset(table + (y & 63) * 64 + (x & 63)) ^ 6144u;
+                depthAddr = ((depthPage << 11) + (offset >> 2)) & 0xfffff;
+                depthShift = (offset & 2) * 8;
+                depth = (Vram[depthAddr] >> depthShift) & 65535;
+            }
+            else
+            {
+                uint depthPage = first.Depth1.z + (y >> 5) * first.Frame.y + (x >> 6);
+                depthAddr = ((depthPage << 11) + (PageOffset((y & 31) * 64 + (x & 63)) ^ 1536u)) & 0xfffff;
