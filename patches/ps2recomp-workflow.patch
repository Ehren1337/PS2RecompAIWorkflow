+    std::array<ComparisonStats,2> multiGroupComparisonStats{};
+    std::array<NativeStats,2> multiGroupNativeStats{};
+    ComparisonStats &packetComparisonStats(bool results,bool multiGroup)
+    { return multiGroup ? multiGroupComparisonStats[results ? 1 : 0] : results ? resultsComparisonStats : comparisonStats; }
+
+    struct ClipNativeStats
+    {
+        std::atomic<uint64_t> attempted{0}, rejected{0}, compared{0}, matched{0}, mismatched{0};
+        std::atomic<uint64_t> executed{0}, cycles{0}, nativeNanoseconds{0}, interpreterNanoseconds{0};
+        std::atomic<uint64_t> firstStateWord{166}, firstDataWord{4096};
+    };
+    ClipNativeStats clipNativeStats;
+    struct ClipRejectionStats
+    {
+        std::atomic<uint64_t> builder{0}, budget{0};
+        std::atomic<uint32_t> firstLine{0}, firstCycles{0}, firstLimit{0};
+    };
+    ClipRejectionStats clipRejectionStats; // Numeric diagnostics; no additional sample storage.
+
+    struct SplitNativeStats
+    {
+        std::atomic<uint64_t> compared{0},matched{0},mismatched{0},executed{0};
+    };
+    SplitNativeStats splitNativeStats; // Emitted multi-packet clipping, bounded counters only.
+    ClipNativeStats reflectNativeStats;
+    ClipNativeStats litNativeStats;
+    ClipNativeStats reflectLitNativeStats;
+    ClipNativeStats dualBasisNativeStats;
+    ClipNativeStats quadNativeStats;
+    // Results keep the track scene alive. Validate their inputs independently
