diff --git a/ps2xRuntime/cmake/DiligentGS.cmake b/ps2xRuntime/cmake/DiligentGS.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..5ec5c598f699db71923f145f965aa38bf13fe4cf
--- /dev/null
+++ b/ps2xRuntime/cmake/DiligentGS.cmake
@@ -0,0 +1,30 @@
+# Shared GPU implementation, with API backends selected by Diligent for the host.
+# No samples, tools, extra executables or installation targets are built.
+function(ps2x_add_diligent_gs)
+    include(FetchContent)
+    set(DILIGENT_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+    set(DILIGENT_INSTALL_CORE OFF CACHE BOOL "" FORCE)
+    set(DILIGENT_NO_ARCHIVER ON CACHE BOOL "" FORCE)
+    set(DILIGENT_NO_SUPER_RESOLUTION ON CACHE BOOL "" FORCE)
+    set(DILIGENT_NO_WEBGPU ON CACHE BOOL "" FORCE)
+    FetchContent_Declare(diligentcore
+        GIT_REPOSITORY https://github.com/DiligentGraphics/DiligentCore.git
+        GIT_TAG b37336e5aac0c944a6d8f51b9f453ba3813738b5)
+    FetchContent_GetProperties(diligentcore)
+    if(NOT diligentcore_POPULATED)
+        FetchContent_Populate(diligentcore)
+    endif()
+    add_subdirectory("${diligentcore_SOURCE_DIR}" "${diligentcore_BINARY_DIR}" EXCLUDE_FROM_ALL)
+    add_library(ps2_gs_gpu STATIC src/lib/gs/gs_diligent_device.cpp)
+    target_include_directories(ps2_gs_gpu PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/include")
+    target_include_directories(ps2_gs_gpu PRIVATE "${diligentcore_SOURCE_DIR}")
+    target_compile_features(ps2_gs_gpu PUBLIC cxx_std_20)
+    target_compile_definitions(ps2_gs_gpu PUBLIC PS2X_HAS_DILIGENT_GS=1)
+    target_link_libraries(ps2_gs_gpu PRIVATE Diligent-Common)
+    foreach(api D3D11 D3D12 Vk OpenGL)
+        if(TARGET Diligent-GraphicsEngine${api}-static)
+            target_link_libraries(ps2_gs_gpu PRIVATE Diligent-GraphicsEngine${api}-static)
+            target_compile_definitions(ps2_gs_gpu PRIVATE PS2X_GPU_${api}=1)
+        endif()
+    endforeach()
+endfunction()
