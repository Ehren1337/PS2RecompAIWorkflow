+        change.frame = {scenario == 1 ? 250u : 40u, 1, GS_PSM_CT32, 0};
+        change.scissor = {0, 63, 0, 31};
+        cpu.ClearFramebuffer(change, 0x80987654); gpu->ClearFramebuffer(change, 0x80987654);
