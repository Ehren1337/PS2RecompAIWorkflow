@@ -0,0 +1,170 @@
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <array>
+#include <algorithm>
+#include <condition_variable>
+#include <cfenv>
+#include <exception>
+#include <mutex>
+#include <thread>
+#include <stdexcept>
+
+namespace
+{
+    class GSThreadedCpuBackend final : public GSRasterBackend
+    {
+        static constexpr size_t kCapacity = 1024;
+        struct PendingDraw
+        {
+            GSPrimitiveBatch batch;
+            int roundingMode = FE_TONEAREST;
+        };
+        GSCpuBackend m_cpu;
+        // Public calls serialize with barriers; the worker never takes this lock.
+        mutable std::mutex m_calls;
+        mutable std::mutex m_queueMutex;
+        mutable std::condition_variable m_progress;
+        std::array<PendingDraw, kCapacity> m_queue{};
+        size_t m_head = 0, m_count = 0;
+        bool m_busy = false, m_stopping = false;
+        std::exception_ptr m_failure;
+        std::thread m_worker;
+
+        void WaitForDraws() const
+        {
+            std::unique_lock lock(m_queueMutex);
+            m_progress.wait(lock, [&] { return (!m_count && !m_busy) || m_failure; });
+            if (m_failure) std::rethrow_exception(m_failure);
+        }
+
+        template<class F> decltype(auto) Synchronized(F &&call) const
+        {
+            std::lock_guard lock(m_calls);
+            WaitForDraws();
+            return call();
+        }
+
+        void Run()
+        {
+            // Take small ordered bursts to amortize queue locking. These are
+            // owned copies; barriers include this entire in-flight burst.
+            std::array<PendingDraw, 16> pending;
+            int roundingMode = std::fegetround();
+            for (;;)
+            {
+                size_t count;
+                bool freedFullQueue;
+                {
+                    std::unique_lock lock(m_queueMutex);
+                    m_progress.wait(lock, [&] { return m_count || m_stopping; });
+                    if (!m_count && m_stopping) return;
+                    freedFullQueue = m_count == kCapacity;
+                    count = std::min(m_count, pending.size());
+                    for (size_t i = 0; i < count; ++i)
+                    {
+                        pending[i] = m_queue[m_head];
+                        m_head = (m_head + 1) % kCapacity;
+                    }
+                    m_count -= count;
+                    m_busy = true;
+                }
+                if (freedFullQueue) m_progress.notify_all();
+                try
+                {
+                    for (size_t i = 0; i < count; ++i)
+                    {
+                        // VU-issued GIF packets can arrive under FE_TOWARDZERO.
+                        // Rounding is thread-local: preserve the immediate
+                        // renderer's behavior even after its caller restores it.
+                        const int requested = pending[i].roundingMode;
+                        if (requested != roundingMode)
+                        {
+                            if (requested == -1 || std::fesetround(requested) != 0)
+                                throw std::runtime_error("GS worker could not preserve draw rounding mode");
+                            roundingMode = requested;
+                        }
+                        m_cpu.Submit(pending[i].batch);
+                    }
+                }
+                catch (...)
+                {
+                    std::lock_guard lock(m_queueMutex);
+                    m_failure = std::current_exception();
+                    m_count = 0;
+                    m_stopping = true;
+                }
+                bool completed;
+                {
+                    std::lock_guard lock(m_queueMutex);
+                    m_busy = false;
+                    completed = m_count == 0;
+                }
+                if (completed) m_progress.notify_all();
+            }
+        }
+
+    public:
+        GSThreadedCpuBackend() : m_worker([this] { Run(); }) {}
+        ~GSThreadedCpuBackend() override
+        {
+            // Finish queued work while the caller-owned VRAM is still alive.
+            { std::lock_guard lock(m_queueMutex); m_stopping = true; }
+            m_progress.notify_all();
+            m_worker.join();
+        }
+
+        void Initialize(uint8_t *vram, uint32_t size) override
+        { Synchronized([&] { m_cpu.Initialize(vram, size); }); }
+        void Reset() override
+        { Synchronized([&] { m_cpu.Reset(); }); }
+        void Submit(const GSPrimitiveBatch &batch) override
+        {
+            std::lock_guard callLock(m_calls);
+            std::unique_lock lock(m_queueMutex);
+            m_progress.wait(lock, [&] { return m_count < kCapacity || m_failure; });
+            if (m_failure) std::rethrow_exception(m_failure);
+            const bool wakeWorker = m_count == 0 && !m_busy;
+            auto &draw = m_queue[(m_head + m_count) % kCapacity];
+            draw.batch = batch;
+            draw.roundingMode = std::fegetround();
+            ++m_count;
+            lock.unlock();
+            if (wakeWorker) m_progress.notify_all();
+        }
+        void Flush() override
+        { Synchronized([&] { m_cpu.Flush(); }); }
+        void TextureFlush() override
+        { Synchronized([&] { m_cpu.TextureFlush(); }); }
+        void Sync(GSSyncReason reason) override
+        { Synchronized([&] { m_cpu.Sync(reason); }); }
+        void BeginTransfer(const GSTransferCommand &command) override
+        { Synchronized([&] { m_cpu.BeginTransfer(command); }); }
+        void UploadImage(const uint8_t *data, uint32_t size) override
+        { Synchronized([&] { m_cpu.UploadImage(data, size); }); }
+        PresentationFrame Present(const GSPresentationRequest &request) override
+        { return Synchronized([&] { return m_cpu.Present(request); }); }
+        bool ClearFramebuffer(const GSContext &ctx, uint32_t rgba) override
+        { return Synchronized([&] { return m_cpu.ClearFramebuffer(ctx, rgba); }); }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t size) override
+        { return Synchronized([&] { return m_cpu.ConsumeLocalToHostBytes(dst, size); }); }
+        uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override
+        { return Synchronized([&] { return m_cpu.ReadVram(psm, base, bw, x, y); }); }
+        void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+        { Synchronized([&] { m_cpu.WriteVram(psm, base, bw, x, y, value); }); }
+        void SnapshotVram(std::vector<uint8_t> &out) const override
+        { Synchronized([&] { m_cpu.SnapshotVram(out); }); }
+        GSTransferSnapshot GetTransferSnapshot() const override
+        {
+            // Draws do not alter transfer cursors. Avoid draining the FIFO for
+            // frontend per-primitive diagnostic snapshots. The CPU lock still
+            // protects this read; public transfer operations hold m_calls.
+            std::lock_guard lock(m_calls);
+            return m_cpu.GetTransferSnapshot();
+        }
+    };
+}
+
+std::unique_ptr<GSRasterBackend> CreateThreadedCpuGSBackend()
+{
+    return std::make_unique<GSThreadedCpuBackend>();
+}
