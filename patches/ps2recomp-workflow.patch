+        VU1State entry{}, actual{};
+        Packet expected;
+    };
+    // Last successful comparison or first failure, in memory only.
+    BoundarySample boundarySample;
+
+    struct ClipBoundarySample
+    {
+        VU1State entry{}, actual{};
+        std::array<uint8_t, 16384> before{}, after{};
+        uint64_t ordinal = 0;
+        uint32_t maxCycles = 0, entryIdle = 0, exitIdle = 0;
+        // Published once, after all fields are written. Completed slots are
+        // immutable; external readers must require ready == 1.
+        std::atomic<uint32_t> ready{0};
+    };
+    std::array<ClipBoundarySample, 16> clipSamples{};
+    std::atomic<uint64_t> clipSampleCalls{0}, clipSampleReserved{0};
+
+    namespace
+    {
+#if defined(PS2_RUMBLE_SSE_TRANSFORM)
+        // Called only for the proven bounded domain with saturated S/Z sticky
+        // flags. SSE obeys the surrounding round-toward-zero scope. Strict FP
+        // compilation keeps these separate multiplications and additions.
+        __m128 saturatedTransformSSE(const float *x, const float *y, const float *z,
+            const void *translation, const float *position, void *accumulator)
+        {
+            __m128 acc;
