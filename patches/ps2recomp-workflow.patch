+                std::vector<BankSample> samples;
+            };
+
+            bool prepareEngineLoop(const SoundBank &bank, const uint8_t *tone, PcmLoopVoiceUpdate &voice,
+                bool requireLoop = true, uint32_t startOffset = 0) const
+            {
+                const auto start = readWord(tone + 16);
+                const auto sample = std::find_if(bank.samples.begin(), bank.samples.end(),
+                    [start](const BankSample &s) { return s.offset == start; });
+                if (sample == bank.samples.end() || (requireLoop && !sample->repeats)) return false;
+                if ((startOffset & 15) || startOffset >= sample->bytes) return false;
+                const auto end = start + sample->bytes;
+                // 2A98 initializes LSA to the original base even when SSA is
+                // offset. A skipped loop marker is not active until traversed.
+                uint32_t nextLoop = start;
+                const size_t frames = size_t(sample->bytes + (sample->repeats ? end - sample->loopOffset : 0)) / 16 * 28;
+                if (!frames || frames > 262144) return false;
+                voice.samples.reserve(frames);
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                int64_t previous = 0, older = 0;
+                const auto decode = [&](uint32_t begin) {
+                    for (auto at = begin; at < end; at += 16)
+                    {
+                        const auto *block = bank.body.data() + at;
+                        if (block[1] & 4) nextLoop = at;
+                        const auto &c = coefficients[block[0] >> 4];
+                        for (unsigned n = 0; n < 28; ++n)
+                        {
+                            int nibble = (block[2 + n / 2] >> (4 * (n & 1))) & 15;
+                            if (nibble & 8) nibble -= 16;
+                            const int64_t value = ((nibble * 4096) >> (block[0] & 15)) +
+                                (previous * c[0] + older * c[1]) / 64;
+                            older = previous; previous = value;
+                            voice.samples.push_back(int16_t(std::clamp<int64_t>(value, -32768, 32767)));
+                        }
+                    }
+                };
+                decode(start + startOffset);
+                voice.repeats = sample->repeats;
+                if (sample->repeats)
+                {
+                    // Predictor history need not repeat after the first pass.
+                    // Preserve the transient prefix and find an exact recurring
+                    // boundary state; retail engine bank 1 needs one warm-up.
+                    // Bounded storage; nonrecurring streams remain unsupported.
+                    std::array<std::array<int64_t, 3>, 32> histories{};
+                    std::array<uint32_t, 32> starts{};
+                    bool found = false;
+                    for (unsigned pass = 0; pass <= histories.size(); ++pass)
+                    {
+                        const std::array<int64_t, 3> history{previous, older, nextLoop};
+                        for (unsigned prior = 0; prior < pass; ++prior)
+                            if (histories[prior] == history)
+                            {
+                                voice.loopStart = starts[prior];
+                                found = true;
+                                break;
+                            }
+                        if (found) break;
+                        if (pass == histories.size() ||
+                            voice.samples.size() + size_t(end - nextLoop) / 16 * 28 > 262144)
+                            return false;
+                        histories[pass] = history;
+                        starts[pass] = uint32_t(voice.samples.size());
+                        decode(nextLoop);
+                    }
+                    if (!found) return false;
+                }
+                voice.adsr1 = readHalf(tone + 10);
+                voice.adsr2 = readHalf(tone + 12);
+                return true;
+            }
+
+            bool prepareEmitterCommand(const uint8_t *record, Emitters &emitters) const
+            {
+                // Retail 0x6380 -> 0x66C8/0x67EC/0x6878. All state here is
+                // speculative until the whole batch and native sink commit.
+                auto &emitter = emitters[record[4]];
+                if (record[1] == 2) { emitter.active = false; return true; }
+                if (record[1] == 0)
+                {
+                    // Re-registering a linked slot needs the original list's
+                    // replacement semantics; do not leak an existing voice.
+                    if (emitter.active || emitter.handle) return false;
+                    emitter = {};
+                    emitter.alias = readHalf(record + 2);
+                    if (!emitter.alias || emitter.alias >= 0x180) return false;
+                    const auto definition = soundDefinitionForAlias(emitter.alias);
+                    if (definition != m_soundDefinitions.size() &&
+                        readWord(m_soundDefinitions[definition].parameters.data() + 32)) return false; // Pitch randomization.
+                    emitter.active = true;
+                }
+                std::copy_n(record + 8, 12, emitter.position.begin());
+                // 0x67EC changes gain/pitch only while a voice exists.
+                if (!record[1] || emitter.handle)
+                {
+                    emitter.gain = readWord(record + 20);
+                    emitter.pitch = readWord(record + 24);
+                    if (emitter.gain > 0x10000 || emitter.pitch > 0x40000) return false;
+                }
+                return true;
+            }
+
+            bool prepareEmitterPlayback(std::span<Emitter> emitters, const std::array<uint8_t, 16> &status,
+                const Listeners &listeners, bool enabled, bool close, uint64_t &occupied,
+                std::array<PcmLoopVoiceUpdate, 48> &voices, bool &work, std::vector<uint8_t> &variants,
+                bool sharedCores, bool finiteOnly = false) const
+            {
+                for (auto &emitter : emitters)
+                {
+                    const auto stop = [&] {
+                        if (!emitter.handle) return;
+                        const auto voice = emitter.handle - 1;
+                        voices[voice] = {};
+                        voices[voice].action = PcmLoopVoiceUpdate::Action::Stop;
+                        occupied &= ~(uint64_t(1) << voice);
+                        emitter.handle = 0;
+                        work = true;
+                    };
+                    if (close) emitter.active = false;
+                    if (!emitter.active || !enabled) { stop(); continue; }
+                    if (status[2] != 1) return false; // Split-screen spatial mixing is not implemented.
+                    const auto definition = soundDefinitionForAlias(emitter.alias);
+                    if (definition == m_soundDefinitions.size()) { stop(); continue; } // Original alias lookup = 0xFF.
+                    const auto &sound = m_soundDefinitions[definition];
+                    const auto &parameters = sound.parameters;
+                    // Doppler/random pitch require their own retained state.
+                    if ((readWord(parameters.data() + 28) & 1) || readWord(parameters.data() + 32)) return false;
+                    const auto distance = engineDistance(emitter.position.data(), listeners[0].data());
+                    if (distance < 0) return false;
+                    const auto near = readWord(parameters.data() + 16), far = readWord(parameters.data() + 20);
+                    if (near > far) return false;
+                    int64_t attenuation = 0;
+                    if (distance <= far)
+                    {
+                        attenuation = 0x10000;
+                        if (distance > near)
+                        {
+                            attenuation -= ((distance - near) * int32_t(readWord(parameters.data() + 24))) >> 16;
+                            // 5D14 multiplies by the caller's Q16 gain without
+                            // clamping to unity. 9CB0 collision requests can be
+                            // louder than unity (captured opcode26 gain76/64).
+                            // Original 5E64 uses signed MULT. Opcode26's raw
+                            // parameter<<10 can be negative (live -75/-76);
+                            // that reverses sample phase, not a rejected sound.
+                            if (attenuation < 0 || attenuation > 0x10000) return false;
+                            attenuation = (attenuation * std::bit_cast<int32_t>(emitter.gain)) >> 16;
+                        }
+                    }
+                    if (attenuation < INT32_MIN || attenuation > INT32_MAX) return false;
+                    if (!attenuation) { stop(); continue; } // Retain the emitter for later audibility.
+                    // 9ACC overrides alias43 one-shot pitch after audibility:
+                    // max(listener attenuation[0], attenuation[1]) * 3/4,
+                    // floored at1/4. With the supported single listener, the
+                    // second attenuation is zero. Persistent emitters use the
+                    // normal explicit pitch; missing/inaudible shots skip this.
+                    if (finiteOnly && emitter.alias == 43)
+                        emitter.pitch = uint32_t(std::max<int64_t>(0x4000,
+                            (std::max<int64_t>(attenuation, 0) * 0xc000) >> 16));
+                    std::array<int64_t, 3> rotated{};
+                    for (unsigned column = 0; column < 3; ++column)
+                        for (unsigned row = 0; row < 3; ++row)
+                        {
+                            const auto relative = int64_t(int32_t(readWord(emitter.position.data() + row * 4))) -
+                                int32_t(readWord(listeners[0].data() + row * 4));
+                            const auto coefficient = int32_t(readWord(listeners[0].data() + 12 + row * 12 + column * 4));
+                            if (relative < -0x1000000 || relative > 0x1000000 || coefficient < -0x20000 || coefficient > 0x20000) return false;
+                            rotated[column] += (relative * coefficient) >> 16;
+                        }
+                    const auto magnitude = rotated[0] < 0 ? -rotated[0] : rotated[0];
+                    const auto panMagnitude = distance < 2 ? 0 : (magnitude * (0x80000000ull / (distance >> 1))) >> 16;
+                    const int64_t pan = rotated[0] < 0 ? int64_t(panMagnitude) : -int64_t(panMagnitude);
+                    const auto gain = (int64_t(status[4] * 128) * attenuation) >> 16;
+                    auto left = (gain * (0x10000 - pan)) >> 16;
+                    auto right = (gain * (0x10000 + pan)) >> 16;
+                    if (rotated[2] < -0x1000 && status[1] == 2) { if (left < right) left = -left; else right = -right; }
+                    const unsigned voice = emitter.handle ? emitter.handle - 1 : freeVoice(occupied, sharedCores);
+                    if (voice == 48) return false;
+                    auto &update = voices[voice];
+                    if (!emitter.handle)
+                    {
+                        if (sound.variants.empty()) return false;
+                        const unsigned selected = (variants[definition] + 1) % sound.variants.size();
+                        const auto &choice = sound.variants[selected];
+                        const auto &bank = m_soundBanks[choice.bank];
+                        const auto offset = readWord(bank.header.data() + 16 + choice.program * 4);
+                        if (!offset && finiteOnly)
+                        {
+                            // Retail A018 advances the variant before DBF0/3198
+                            // discovers a null program via 2688. 9ACC releases
+                            // the unused voice and returns normally. No sink work
+                            // or ownership was committed here, so leave the slot
+                            // free and retain only the staged variant advance.
+                            variants[definition] = uint8_t(selected);
+                            emitter.active = false;
+                            continue;
+                        }
+                        if (!offset || !prepareEngineLoop(bank, bank.header.data() + offset + 4, update, false)) return false;
+                        emitter.basePitch = readHalf(bank.header.data() + offset + 18);
+                        emitter.repeats = update.repeats;
+                        if (finiteOnly && update.repeats) return false;
+                        update.action = PcmLoopVoiceUpdate::Action::Start;
+                        variants[definition] = uint8_t(selected);
+                    }
+                    else update.action = PcmLoopVoiceUpdate::Action::Update;
+                    const auto pitch = (uint64_t(emitter.basePitch) * emitter.pitch) >> 16;
+                    if (pitch > 0x3fff || left < INT32_MIN || left > INT32_MAX ||
+                        right < INT32_MIN || right > INT32_MAX) return false;
+                    // 6050 truncates /2 into a short; 2A98 masks that short
+                    // with 7FFF before writing fixed SPU volume. Bit14 is the
+                    // sign bit, not extra positive gain. Loud collisions can
+                    // cross it (observed alias15 gain198); preserve the actual
+                    // register interpretation rather than clamp or reject.
+                    const auto fixedVolume = [](int64_t value) -> int16_t {
+                        const uint32_t bits = uint32_t(value / 2) & 0x7fff;
+                        return int16_t(int32_t(bits) - ((bits & 0x4000) ? 0x8000 : 0));
+                    };
+                    update.repeats = emitter.repeats;
+                    update.pitch = uint16_t(pitch);
+                    update.left = fixedVolume(left); update.right = fixedVolume(right);
+                    emitter.handle = uint8_t(voice + 1);
+                    occupied |= uint64_t(1) << voice;
+                    work = true;
+                }
+                return true;
+            }
+
+            bool prepareBankOneShot(uint16_t alias, std::vector<uint8_t> &variants, std::vector<int16_t> &pcm)
+            {
+                if (!alias || alias >= 0x180) return false;
+                size_t definition = m_soundDefinitions.size();
+                // 0x9D80 writes aliases only on a definition's first registration;
+                // later definitions overwrite collisions in the 0x180-byte map.
+                for (size_t i = m_soundDefinitions.size(); i-- > 0;)
+                {
+                    const auto &parameters = m_soundDefinitions[i].parameters;
+                    for (unsigned slot = 0; slot < 4; ++slot)
+                        if (readHalf(parameters.data() + 8 + slot * 2) == alias) definition = i;
+                    if (definition != m_soundDefinitions.size()) break;
+                }
+                if (definition == m_soundDefinitions.size()) return false;
+                const auto &choices = m_soundDefinitions[definition].variants;
+                if (choices.empty()) return false;
+                // 0xA018 increments before selection; a single variant uses zero.
+                const unsigned selected = (variants[definition] + 1) % choices.size();
+                const auto &choice = choices[selected];
+                const auto &bank = m_soundBanks[choice.bank];
+                const auto program = readWord(bank.header.data() + 16 + choice.program * 4);
+                // Registration can retain empty program slots. Until the
+                // failed-key-on lifecycle is modeled, refuse their playback.
+                if (!program) return false;
+                const auto *tone = bank.header.data() + program + 4; // 0xDBF0 always tone zero.
+                const auto start = readWord(tone + 16);
+                const auto sample = std::find_if(bank.samples.begin(), bank.samples.end(),
+                    [start](const BankSample &s) { return s.offset == start; });
+                if (sample == bank.samples.end() || sample->repeats) return false;
+                const unsigned pitch = readHalf(tone + 14);
+                const unsigned adsr1 = readHalf(tone + 10), adsr2 = readHalf(tone + 12);
+                if (!pitch || pitch > 0x3fff) return false;
+                const size_t sourceFrames = size_t(sample->bytes / 16) * 28;
+                const uint64_t frames = (uint64_t(sourceFrames) * 4096 + pitch - 1) / pitch;
+                if (!frames || frames > 262144) return false;
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                std::vector<int16_t> source;
+                source.reserve(sourceFrames);
+                int64_t previous = 0, older = 0;
+                for (unsigned offset = start; offset < start + sample->bytes; offset += 16)
+                {
+                    const auto *block = bank.body.data() + offset;
+                    const auto &coefficient = coefficients[block[0] >> 4];
+                    for (unsigned n = 0; n < 28; ++n)
+                    {
+                        int nibble = (block[2 + n / 2] >> (4 * (n & 1))) & 15;
+                        if (nibble & 8) nibble -= 16;
+                        const int64_t value = ((nibble * 4096) >> (block[0] & 15)) +
+                            (previous * coefficient[0] + older * coefficient[1]) / 64;
+                        older = previous; previous = value;
+                        source.push_back(int16_t(std::clamp<int64_t>(value, -32768, 32767)));
+                    }
+                }
+                // Python checked the decoder independently against FFmpeg.
+                // Pitch/envelope rendering uses the original tone registers at
+                // the 48-kHz SPU2 clock. Linear interpolation is provisional;
+                // Gaussian interpolation, reverb and hardware timing are unverified.
+                pcm.resize(size_t(frames) * 2);
+                int level = 0, phase = 0, counter = 0;
+                for (size_t frame = 0; frame < frames; ++frame)
+                {
+                    const int shift = phase == 0 ? (adsr1 >> 10) & 31 :
+                        phase == 1 ? (adsr1 >> 4) & 15 : (adsr2 >> 8) & 31;
+                    const int step = phase == 0 ? (adsr1 >> 8) & 3 : phase == 1 ? 0 : (adsr2 >> 6) & 3;
+                    const bool decreasing = phase == 1 || (phase == 2 && (adsr2 & 0x4000));
+                    const bool exponential = phase == 1 || ((phase == 0 ? adsr1 : adsr2) & 0x8000);
+                    int delta = (decreasing ? -8 + step : 7 - step) * (1 << std::max(0, 11 - shift));
+                    int increment = 0x8000 >> std::max(0, shift - 11);
+                    if (exponential && !decreasing && level > 0x6000)
+                    {
+                        delta /= shift < 10 ? 4 : shift == 10 ? 2 : 1;
+                        increment /= shift >= 11 ? 4 : shift == 10 ? 2 : 1;
+                    }
+                    else if (exponential && decreasing) delta = (delta * level) >> 15;
+                    if (phase == 1 || shift * 4 + step != 127) increment = std::max(increment, 1);
+                    counter += increment;
+                    if (counter >= 0x8000)
+                    {
+                        counter -= 0x8000;
+                        level = std::clamp(level + delta, 0, 32767);
+                    }
+                    if ((phase == 0 && level == 32767) ||
+                        (phase == 1 && level <= int(((adsr1 & 15) + 1) * 0x800)))
+                    { ++phase; counter = 0; }
+                    const size_t index = frame * pitch / 4096;
+                    const int fraction = int(frame * pitch % 4096);
+                    const int a = source[index], b = index + 1 < source.size() ? source[index + 1] : 0;
+                    const int value = (a * (4096 - fraction) + b * fraction) / 4096;
+                    const int16_t scaled = int16_t((((int64_t(value) * level) >> 15) * 0x3ffe) >> 15);
+                    pcm[frame * 2] = pcm[frame * 2 + 1] = scaled;
+                }
+                variants[definition] = uint8_t(selected);
+                return true;
+            }
+
+            bool readSoundResource(const SifCommand &command, const std::array<uint8_t, 64> &packet,
+                                   uint32_t tag, uint32_t &identity, std::vector<uint8_t> &payload)
+            {
+                const uint32_t size = readWord(packet.data() + 0x14);
+                const uint32_t address = command.extraDestination;
+                const uint32_t begin = (m_iopBuffer + 63u) & ~63u;
+                if (size < 40 || size > kBufferSize || command.extra.size != ((size + 15u) & ~15u) ||
+                    address != readWord(packet.data() + 0x20) || (address & 63u) != 0 ||
+                    // Retail's large Cvkb transfer reuses the allocation base,
+                    // also used by copied control batches. Pending replies and
+                    // retained resources already own their data separately.
+                    uint64_t(address) < uint64_t(begin) ||
+                    uint64_t(address) + command.extra.size > uint64_t(m_iopBuffer) + kBufferSize)
+                    return false;
+                std::array<uint8_t, 40> header{};
+                if (!m_host.readGuest(address, header.data(), header.size()) ||
+                    readWord(header.data() + 0x1c) != tag) return false;
+                const uint32_t source = readWord(packet.data() + 0x10);
+                const uint32_t pointer = readWord(header.data());
+                const uint32_t bytes = readWord(header.data() + 0x24);
+                if (pointer < source) return false;
+                const uint32_t offset = pointer - source;
+                if (offset < header.size() || bytes == 0 || uint64_t(offset) + bytes > size) return false;
+                payload.resize(bytes);
+                identity = readWord(header.data() + 0x20);
+                return m_host.readGuest(address + offset, payload.data(), bytes);
+            }
+
+            static bool validBankHeader(const std::vector<uint8_t> &header)
+            {
+                if (header.size() < 16 || readWord(header.data()) != 2) return false;
+                const unsigned directoryEnd = 16 + unsigned(header[4]) * 4;
+                if (directoryEnd > header.size()) return false;
+                const uint32_t bytes = readWord(header.data() + 12);
+                if (!bytes || bytes > kBufferSize || bytes % 16) return false;
+                unsigned tones = 0;
+                for (unsigned i = 0; i < header[4]; ++i)
+                {
+                    const auto offset = readWord(header.data() + 16 + i * 4);
+                    if (!offset) continue;
+                    if (offset < directoryEnd || uint64_t(offset) + 4 > header.size()) return false;
+                    const unsigned count = header[offset];
+                    tones += count;
+                    if (!count || tones > 255 || uint64_t(offset) + 4 + count * 20 > header.size()) return false;
+                    for (unsigned tone = 0; tone < count; ++tone)
+                    {
+                        const auto start = readWord(header.data() + offset + 20 + tone * 20);
+                        if (start >= bytes || start % 16) return false;
+                    }
+                }
+                return tones != 0;
+            }
+
+            bool retainSoundBank(const SifCommand &command, const std::array<uint8_t, 64> &packet)
+            {
+                // Retail 0x6E7C retains Cvkh, then pairs Cvkb by resource ID.
+                // 0x6CFC/0x2DC8 copy the sample body to owned sound RAM before
+                // the incoming slot is ACKed; the transfer callback is IOP-only.
+                // Native storage keeps offsets relative instead of embedding
+                // guest/host pointers. Verified independent one-shots consume
+                // this storage, as do supported engine and skid loops.
+                SoundBank bank;
+                if (packet[0x1d] == 0)
+                {
+                    if (!m_pendingBank.header.empty() ||
+                        !readSoundResource(command, packet, 0x43766b68, bank.identity, bank.header) ||
+                        !validBankHeader(bank.header) || bank.identity > 127) return false;
+                    for (const auto &loaded : m_soundBanks)
+                        if (!loaded.header.empty() && loaded.identity == bank.identity) return false;
+                    m_pendingBank = std::move(bank);
+                    return true;
+                }
+                if (m_pendingBank.header.empty() ||
+                    !readSoundResource(command, packet, 0x43766b62, bank.identity, bank.body) ||
+                    bank.identity != m_pendingBank.identity ||
+                    bank.body.size() != readWord(m_pendingBank.header.data() + 12)) return false;
+                auto slot = std::find_if(m_soundBanks.begin(), m_soundBanks.end(),
+                    [](const SoundBank &b) { return b.header.empty(); });
+                if (slot == m_soundBanks.end()) return false;
+                // 0x6900 reserves sound memory from 0x1C4080 upward; allocator
+                // 0xC40 starts banks at 0x5500. Only full level release is
+                // admitted, so aligned aggregate usage equals contiguous usage.
+                const uint32_t allocation = (uint32_t(bank.body.size()) + 63u) & ~63u;
+                if (allocation > 0x1c4080u - 0x5500u - m_bankAllocatedBytes) return false;
+                bank.header = m_pendingBank.header;
+                for (unsigned program = 0; program < bank.header[4]; ++program)
+                {
+                    const auto offset = readWord(bank.header.data() + 16 + program * 4);
+                    if (!offset) continue;
+                    for (unsigned tone = 0; tone < bank.header[offset]; ++tone)
+                    {
+                        const auto start = readWord(bank.header.data() + offset + 20 + tone * 20);
+                        if (std::any_of(bank.samples.begin(), bank.samples.end(),
+                            [start](const BankSample &sample) { return sample.offset == start; })) continue;
+                        BankSample sample;
+                        sample.offset = start;
+                        bool ended = false, hasLoop = false;
+                        for (uint32_t at = start; at < bank.body.size(); at += 16)
+                        {
+                            const uint8_t control = bank.body[at], flags = bank.body[at + 1];
+                            if ((control >> 4) > 4 || (control & 15) > 12 || flags > 6 || flags == 5) return false;
+                            if (flags & 4) { hasLoop = true; sample.loopOffset = at; }
+                            if (flags & 1)
+                            {
+                                ended = true;
+                                sample.bytes = at + 16 - start;
+                                sample.repeats = (flags & 2) != 0;
+                                break;
+                            }
+                        }
+                        if (!ended || (sample.repeats && !hasLoop)) return false;
+                        bank.samples.push_back(sample);
+                    }
+                }
+                // 0x6B2C selects the first retained table containing the bank.
+                const uint8_t *descriptors = nullptr;
+                unsigned descriptorCount = 0;
+                for (const auto &table : m_soundTables)
+                {
+                    if (table.payload.empty()) continue;
+                    for (unsigned i = 0; i < readHalf(table.payload.data() + 2); ++i)
+                    {
+                        const auto *entry = table.payload.data() + 4 + i * 8;
+                        if (readHalf(entry) != bank.identity) continue;
+                        descriptorCount = readHalf(entry + 2);
+                        descriptors = table.payload.data() + readWord(entry + 4);
+                        break;
+                    }
+                    if (descriptors) break;
+                }
+                if (!descriptors) return false;
+                auto definitions = m_soundDefinitions;
+                unsigned variantCount = 0;
+                for (const auto &definition : definitions) variantCount += unsigned(definition.variants.size());
+                const uint8_t bankSlot = uint8_t(slot - m_soundBanks.begin());
+                for (unsigned i = 0; i < descriptorCount; ++i)
+                {
+                    const auto *descriptor = descriptors + i * 36;
+                    const uint8_t program = descriptor[2], identity = descriptor[0];
+                    // 0x6BDC/0x7B8C register descriptors without looking up
+                    // program data. Retail SE1.TRK bank 51 references empty
+                    // slots 50/56/57; those variants must retain their order.
+                    // Lookup 0x2688 handles absence later at playback time.
+                    if (program >= bank.header[4] || !descriptor[5]) return false;
+                    auto definition = std::find_if(definitions.begin(), definitions.end(),
+                        [identity](const SoundDefinition &d) { return d.identity == identity; });
+                    if (definition == definitions.end())
+                    {
+                        if (definitions.size() == 130) return false;
+                        SoundDefinition fresh;
+                        fresh.identity = identity;
+                        std::copy_n(descriptor, 36, fresh.parameters.begin());
+                        fresh.parameters[0] = uint8_t(definitions.size());
+                        fresh.parameters[1] = 0;
+                        fresh.parameters[4] = std::clamp<uint8_t>(descriptor[4], 1, 10);
+                        fresh.parameters[5] = std::min<uint8_t>(descriptor[5], 8);
+                        definitions.push_back(std::move(fresh));
+                        definition = definitions.end() - 1;
+                    }
+                    // 0x9D80 retains the first definition for a sound ID;
+                    // 0x7B8C adds up to eight variants from a 150-entry pool.
+                    if (definition->variants.size() == 8 || variantCount == 150) return false;
+                    definition->variants.push_back({bankSlot, program});
+                    ++variantCount;
+                }
+                // Commit all ownership and registration before releasing the
+                // sender. Invalid pairs preserve pending header and old banks.
+                *slot = std::move(bank);
+                m_soundDefinitions = std::move(definitions);
+                m_bankAllocatedBytes += allocation;
+                m_pendingBank = {};
+                return true;
+            }
+
+            bool decodeVoiceover(PcmLoopVoiceUpdate &voice) const
+            {
+                // Python matched all 20,608 samples of the captured retail
+                // VAGB against FFmpeg. Retain predictor history until END.
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                int64_t previous = 0, older = 0;
+                for (size_t at = 0; at + 16 <= m_voiceover.size(); at += 16)
+                {
+                    const auto *block = m_voiceover.data() + at;
+                    if ((block[0] >> 4) > 4 || (block[1] != 0 && block[1] != 1 && block[1] != 4)) return false;
+                    const auto &coefficient = coefficients[block[0] >> 4];
+                    for (unsigned n = 0; n < 28; ++n)
+                    {
+                        int nibble = (block[2 + n / 2] >> (4 * (n & 1))) & 15;
+                        if (nibble & 8) nibble -= 16;
+                        const int64_t value = ((nibble * 4096) >> (block[0] & 15)) +
+                            (previous * coefficient[0] + older * coefficient[1]) / 64;
+                        older = previous; previous = value;
+                        voice.samples.push_back(int16_t(std::clamp<int64_t>(value, -32768, 32767)));
+                    }
+                    if (block[1] == 1)
+                    {
+                        // 0x77AC / 0x32E8: pitch and voice envelope.
+                        voice.action = PcmLoopVoiceUpdate::Action::Start;
+                        voice.repeats = false;
+                        voice.pitch = 0x759;
+                        voice.adsr1 = 0x80ff; voice.adsr2 = 0x5fce;
+                        return true;
+                    }
+                }
+                return false;
+            }
+
+            bool retainVoiceover(const SifCommand &command, const std::array<uint8_t, 64> &packet)
+            {
+                // Retail 0x6E7C kind4 -> 0x73AC copies payload to SPU storage,
+                // resetting the destination on chunk1, then queues event8 to
+                // release the transfer buffer. Playback is a separate command.
+                // 0x6900 reserves [0x1C4080,0x1DC080) before the music buffers.
+                constexpr uint32_t capacity = 0x18000;
+                const uint32_t size = readWord(packet.data() + 0x14);
+                const uint32_t address = command.extraDestination;
+                const uint32_t begin = (m_iopBuffer + 63u) & ~63u;
+                if (size <= 0x40 || size > capacity + 0x40 || m_voiceoverReleases >= 10 ||
+                    command.extra.size != ((size + 15u) & ~15u) ||
+                    address != readWord(packet.data() + 0x20) || (address & 63u) != 0 ||
+                    uint64_t(address) < uint64_t(begin) + 0xcc0 ||
+                    uint64_t(address) + command.extra.size > uint64_t(m_iopBuffer) + kBufferSize)
+                    return false;
+                std::array<uint8_t, 64> header{};
+                if (!m_host.readGuest(address, header.data(), header.size()) || readWord(header.data() + 4) != size)
+                    return false;
+                const uint32_t bytes = (size - 0x40u + 63u) & ~63u;
+                const bool first = readHalf(header.data() + 0x16) == 1;
+                const size_t offset = first ? 0 : m_voiceover.size();
+                if ((!first && offset == 0) || offset + bytes > capacity || bytes + 0x40 > command.extra.size)
+                    return false;
+                auto retained = first ? std::vector<uint8_t>{} : m_voiceover;
+                retained.resize(offset + bytes);
+                if (!m_host.readGuest(address + 0x40, retained.data() + offset, bytes)) return false;
+                uint64_t hash = 14695981039346656037ull;
+                for (uint8_t value : retained) hash = (hash ^ value) * 1099511628211ull;
+                m_voiceover = std::move(retained);
+                m_voiceoverHash = hash;
+                ++m_voiceoverUploads;
+                ++m_voiceoverReleases;
+                return true;
+            }
+
+            bool retainSoundTable(const SifCommand &command, const std::array<uint8_t, 64> &packet)
+            {
+                // Retail 0x6E7C relocates Cshd's pointer by subtracting the EE
+                // source, retains version 7 in two slots at 0x12110, then ACKs.
+                // 0x6B2C searches those tables; 0x6BDC uses payload-relative
+                // bank offsets and 36-byte descriptors after sample-bank load.
+                // Own the payload before releasing the EE source. Opcode 17
+                // releases the retained tables with the rest of the level.
+                auto slot = std::find_if(m_soundTables.begin(), m_soundTables.end(),
+                    [](const SoundTable &table) { return table.payload.empty(); });
+                if (slot == m_soundTables.end()) return false;
+                const uint32_t size = readWord(packet.data() + 0x14);
+                const uint32_t address = command.extraDestination;
+                const uint32_t begin = (m_iopBuffer + 63u) & ~63u;
+                if (size < 40 || size > kBufferSize || command.extra.size != ((size + 15u) & ~15u) ||
+                    address != readWord(packet.data() + 0x20) || (address & 63u) != 0 ||
+                    uint64_t(address) < uint64_t(begin) + 0xcc0 ||
+                    uint64_t(address) + command.extra.size > uint64_t(m_iopBuffer) + kBufferSize)
+                    return false;
+                std::array<uint8_t, 40> header{};
+                if (!m_host.readGuest(address, header.data(), header.size()) ||
+                    readWord(header.data() + 0x1c) != 0x43736864) return false;
+                const uint32_t source = readWord(packet.data() + 0x10);
+                const uint32_t pointer = readWord(header.data());
+                const uint32_t bytes = readWord(header.data() + 0x24);
+                if (pointer < source) return false;
+                const uint32_t offset = pointer - source;
+                if (offset < header.size() || bytes < 4 || uint64_t(offset) + bytes > size) return false;
+                SoundTable table;
+                table.payload.resize(bytes);
+                if (!m_host.readGuest(address + offset, table.payload.data(), bytes)) return false;
+                const auto *data = table.payload.data();
+                const uint32_t count = readHalf(data + 2);
+                const uint32_t directoryEnd = 4 + 8 * count;
+                if (readHalf(data) != 7 || directoryEnd > bytes) return false;
+                for (uint32_t i = 0; i < count; ++i)
+                {
+                    const auto *bank = data + 4 + 8 * i;
+                    const uint32_t entries = readHalf(bank + 2);
+                    const uint32_t start = readWord(bank + 4);
+                    if (start < directoryEnd || uint64_t(start) + uint64_t(entries) * 36 > bytes) return false;
+                    table.descriptors += entries;
+                }
+                *slot = std::move(table);
+                return true;
+            }
+
+            bool loadRetailReverbTables()
+            {
+                if (m_reverbTablesReady) return true;
+                const auto readModule = [&](const char *path, size_t expectedSize, uint32_t expectedCrc,
+                                            std::vector<uint8_t> &bytes) {
+                    const auto file = m_host.openHostFile(m_host.translateGuestPath(path));
+                    if (!file) return false;
+                    uint64_t size = 0; size_t got = 0;
+                    bytes.resize(expectedSize);
+                    const bool ok = m_host.hostFileSize(file, size) && size == expectedSize &&
+                        m_host.readHostFile(file, 0, bytes.data(), bytes.size(), got) && got == bytes.size();
+                    m_host.closeHostFile(file);
+                    if (!ok) return false;
+                    uint32_t crc = 0xffffffffu;
+                    for (uint8_t byte : bytes)
+                    {
+                        crc ^= byte;
+                        for (unsigned i = 0; i < 8; ++i) crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320u : 0);
+                    }
+                    return (crc ^ 0xffffffffu) == expectedCrc;
+                };
+                std::vector<uint8_t> audio, libsd;
+                if (!readModule("cdrom0:\\MODULES\\AUDIO.IRX;1", 91704, 0x6eaeed1f, audio) ||
+                    !readModule("cdrom0:\\MODULES\\LIBSD.IRX;1", 25317, 0xcb27b3ce, libsd)) return false;
+                RumbleReverbTables tables;
+                for (unsigned i = 0; i < tables.environments.size(); ++i)
+                {
+                    const auto *record = audio.data() + 0xf4a0 + i * 16;
+                    tables.environments[i] = {int32_t(readWord(record)), int32_t(readWord(record + 4)),
+                        int32_t(readWord(record + 8)), int32_t(readWord(record + 12))};
+                }
+                for (unsigned mode = 0; mode < tables.registers.size(); ++mode)
+                {
+                    // Verified LIBSD size table uses eight-byte units. Work
+                    // RAM is addressed in 16-bit words; preset stride is68.
+                    tables.workWords[mode] = readWord(libsd.data() + 0x3fb8 + mode * 4) * 4;
+                    for (unsigned field = 0; field < 32; ++field)
+                        tables.registers[mode][field] = readHalf(libsd.data() + 0x3fe4 + mode * 68 + field * 2);
+                }
+                if (!tables.valid()) return false;
+                m_reverbTables = tables;
+                m_reverbTablesReady = true;
+                return true;
+            }
+
+            bool loadRetailCue()
+            {
+                if (m_cueAttempted) return !m_cuePcm.empty();
+                m_cueAttempted = true;
+                // Retail/March module identity guards these file offsets and
+                // the original voice setup at 0x1A0. Never embed game audio.
+                const auto path = m_host.translateGuestPath("cdrom0:\\MODULES\\AUDIO.IRX;1");
+                const auto file = m_host.openHostFile(path);
+                if (!file) return false;
+                uint64_t size = 0;
+                size_t got = 0;
+                std::vector<uint8_t> module(91704);
+                const bool read = m_host.hostFileSize(file, size) && size == module.size() &&
+                    m_host.readHostFile(file, 0, module.data(), module.size(), got) && got == module.size();
+                m_host.closeHostFile(file);
+                if (!read) return false;
+                uint32_t crc = 0xffffffffu;
+                for (const auto byte : module)
+                {
+                    crc ^= byte;
+                    for (unsigned bit = 0; bit < 8; ++bit)
+                        crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320u : 0u);
+                }
+                if ((crc ^ 0xffffffffu) != 0x6eaeed1fu)
+                {
+                    m_host.log(LogLevel::Warning, "Rumble retail cue: AUDIO.IRX identity mismatch");
+                    return false;
+                }
+                // One-shot at module 0xF0D0, file 0xF160. Decode through the
+                // end flag, excluding the non-audio marker that follows it.
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                std::vector<int16_t> source;
+                int64_t previous = 0, older = 0;
+                for (unsigned offset = 0; offset < 0x2c0; offset += 16)
+                {
+                    const auto *block = module.data() + 0xf160 + offset;
+                    if ((block[0] >> 4) > 4 || (block[0] & 15) > 12) return false;
+                    const auto &coefficient = coefficients[block[0] >> 4];
+                    for (unsigned sample = 0; sample < 28; ++sample)
+                    {
+                        int nibble = (block[2 + sample / 2] >> (4 * (sample & 1))) & 15;
+                        if (nibble & 8) nibble -= 16;
+                        const int64_t value = ((nibble * 4096) >> (block[0] & 15)) +
+                            (previous * coefficient[0] + older * coefficient[1]) / 64;
+                        older = previous; previous = value;
+                        source.push_back(int16_t(std::clamp<int64_t>(value, -32768, 32767)));
+                    }
+                    if (block[1] & 1) break;
+                }
+                if (source.size() != 1204) return false;
+                // Original pitch 0x400 = 1/4 of the 48-kHz SPU2 clock.
+                // ADSR1 0x9EEE: exponential attack shift 7/step 2, decay
+                // shift 14, sustain level 0x7800. ADSR2 0xCD21: exponential
+                // decreasing sustain shift 13/step 0. End flag stops the cue.
+                // Linear interpolation is provisional, not Gaussian SPU2 fidelity.
+                int level = 0, phase = 0, counter = 0;
+                m_cuePcm.reserve(source.size() * 8);
+                for (size_t frame = 0; frame < source.size() * 4; ++frame)
+                {
+                    int step = phase == 0 ? 80 : ((-8 * level) >> 15);
+                    int increment = phase == 0 ? 0x8000 : (phase == 1 ? 0x1000 : 0x2000);
+                    if (phase == 0 && level > 0x6000) step /= 4;
+                    counter += increment;
+                    if (counter >= 0x8000)
+                    {
+                        counter -= 0x8000;
+                        level = std::clamp(level + step, 0, 32767);
+                        if ((phase == 0 && level == 32767) || (phase == 1 && level <= 0x7800))
+                        { ++phase; counter = 0; }
+                    }
+                    const size_t index = frame / 4;
+                    const int a = source[index], b = index + 1 < source.size() ? source[index + 1] : 0;
+                    const int value = (a * (4 - int(frame % 4)) + b * int(frame % 4)) / 4;
+                    const int16_t scaled = int16_t(((int64_t(value) * level) >> 15) * 0x3ffe >> 15);
+                    m_cuePcm.push_back(scaled); m_cuePcm.push_back(scaled);
+                }
+                return true;
+            }
+            std::array<uint8_t, 16> initialStatus() const
+            {
+                // Retail 0x9264 initializes through the individual setters;
