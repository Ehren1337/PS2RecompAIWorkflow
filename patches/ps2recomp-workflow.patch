+    void recordNativeExecution(uint32_t cycles)
+    {
+        auto &stats = work.results ? resultsExecutionStats : nativeStats;
+        stats.executed.fetch_add(1, std::memory_order_relaxed);
+        stats.cycles.fetch_add(cycles, std::memory_order_relaxed);
+        if (work.multiGroup)
+        {
+            auto &groupStats=multiGroupNativeStats[work.results ? 1 : 0];
+            groupStats.executed.fetch_add(1,std::memory_order_relaxed);
