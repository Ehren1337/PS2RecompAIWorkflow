+bool ColorDepthDisjoint(const GSContext &ctx)
+{
+    std::bitset<512> colors;
+    for (uint32_t y = ctx.scissor.y0 / 32; y <= ctx.scissor.y1 / 32; ++y)
+        for (uint32_t x = ctx.scissor.x0 / 64; x <= ctx.scissor.x1 / 64; ++x)
+            colors.set((ctx.frame.fbp + y * ctx.frame.fbw + x) & 511);
+    const uint32_t depthPageHeight = ctx.zbuf.psm == GS_PSM_Z16 || ctx.zbuf.psm == GS_PSM_Z16S ? 64 : 32;
+    for (uint32_t y = ctx.scissor.y0 / depthPageHeight; y <= ctx.scissor.y1 / depthPageHeight; ++y)
+        for (uint32_t x = ctx.scissor.x0 / 64; x <= ctx.scissor.x1 / 64; ++x)
+            if (colors[(ctx.zbuf.zbp + y * ctx.frame.fbw + x) & 511]) return false;
