+bool VU1Interpreter::executeFmacCombined(uint32_t instruction)
+{
+    if (ps2_vu_diagnostics::fmacReferenceMode.load(std::memory_order_relaxed)) return false;
+    const uint8_t op = instruction & 0x3fu;
+    const bool accumulator = op >= 0x3cu;
+    const uint8_t arithmetic = accumulator ? (instruction & 3u) | ((instruction >> 4) & 0x7cu) : op;
+    // Cross products, conversions, CLIP and non-FMAC instructions retain their
+    // original paths. Shared arithmetic normalizes operands only once for both
+    // the rounded register result and the exact-result pipeline flags.
+    unsigned mode;
+    if (arithmetic <= 3) mode = 0; // add
+    else if (arithmetic <= 7) mode = 1; // subtract
+    else if (arithmetic <= 11) mode = 3; // multiply-add
+    else if (arithmetic <= 15) mode = 4; // multiply-subtract
+    else if ((arithmetic >= 0x18 && arithmetic <= 0x1c) || arithmetic == 0x1e || arithmetic == 0x2a) mode = 2;
+    else if (arithmetic >= 0x20 && arithmetic <= 0x27)
+        mode = (arithmetic & 1) ? ((arithmetic & 4) ? 4 : 3) : ((arithmetic & 4) ? 1 : 0);
+    else if (arithmetic == 0x28) mode = 0;
+    else if (arithmetic == 0x29) mode = 3;
+    else if (arithmetic == 0x2c) mode = 1;
+    else if (arithmetic == 0x2d) mode = 4;
+    else return false;
