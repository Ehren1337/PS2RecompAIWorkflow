+    compare("Partial palette coherence preserves GPU framebuffer writes");
+    GSContext clutWrite;
+    clutWrite.frame = {300, 1, GS_PSM_CT32, 0}; clutWrite.scissor = {0, 0, 8, 8};
+    cpu.ClearFramebuffer(clutWrite, 0x12345678); gpu->ClearFramebuffer(clutWrite, 0x12345678);
