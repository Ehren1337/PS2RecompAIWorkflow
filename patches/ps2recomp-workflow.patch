+void EeScheduler::advanceCop0Count(uint32_t cycles) noexcept
+{
+    // Generated MFC0/MTC0 accesses the context field directly. Count is one
+    // hardware clock, not saved per guest thread or callback. Import a guest
+    // write from the active context, then mirror the clock into saved contexts
+    // so restoration cannot rewind it. EE cycle accounting is approximate;
+    // this does not implement Count/Compare interrupts.
+    if (const GuestThread *running = currentThread())
+        m_cop0Count = running->activeContext().cop0_count;
+    m_cop0Count += cycles;
+    for (auto &[id, item] : m_threads)
+    {
+        item.context.cop0_count = m_cop0Count;
+        for (auto &invocation : item.invocations)
+            invocation.context.cop0_count = m_cop0Count;
+    }
+    for (auto &invocation : m_pendingInvocations)
+        invocation.context.cop0_count = m_cop0Count;
 }
 
