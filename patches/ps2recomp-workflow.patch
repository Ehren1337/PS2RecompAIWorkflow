+                std::memcpy(ram + car, oldDirection, 16);
+                std::memcpy(ram + car + 0x11c, &oldYaw, 4);
+            }
+            overlay = initOverlay = false;
+        }
+        void swap(bool initializing)
+        {
+            checked(car, 0x160); checked(state->player, 0xe0);
+            if (word(ram, car + 0x158) != state->player || ram[car + 0xc6] != 1)
+                throw std::runtime_error("Rumble dev AI: player identity changed");
+            const auto slot = ram[car + 0x137];
+            if (slot >= 8) throw std::runtime_error("Rumble dev AI: invalid player slot");
+            entry = 0x1f2170 + slot * 8;
+            oldHead = word(ram, kAiHead); oldNext = word(ram, car + 0x15c);
+            oldScale = word(ram, kDifficultyScale);
+            oldType = ram[car + 0xc6]; oldDifficulty = ram[entry + 5];
+            if (initializing)
+            {
+                std::memcpy(oldStart, ram + 0x1f27e0, 16);
+                std::memcpy(oldDirection, ram + car, 16);
+                oldYaw = word(ram, car + 0x11c);
+            }
+            overlay = true; initOverlay = initializing;
+            ram[car + 0xc6] = 7;
+            ram[entry + 5] = 2; // No Mercy, verified in retail1877D0.
+            put(ram, kDifficultyScale, 0x3f333333); // Original No Mercy factor0.7.
+            put(ram, car + 0x158, state->ai);
+            if (initializing)
+                std::memcpy(ram + 0x1f27e0, ram + car + 0x40, 16);
+            else
+            {
+                put(ram, kAiHead, car);
+                put(ram, car + 0x15c, 0); // MoveAll processes only this temporary member.
+            }
+        }
+        void invoke(R5900Context &parent, uint32_t address,
+                    std::initializer_list<uint32_t> arguments, unsigned next)
+        {
+            GuestInvocation call{};
+            call.kind = GuestInvocationKind::HleCall;
+            call.tag = kInput;
+            call.context = parent; call.context.pc = address;
+            unsigned reg = 4;
+            for (auto argument : arguments) { SET_GPR_U32(&call.context, reg, argument); ++reg; }
+            SET_GPR_U32(&call.context, 29, 0); SET_GPR_U32(&call.context, 31, 0);
+            call.onComplete = [work = shared_from_this(), next](const R5900Context &, R5900Context &resume)
+            { work->advance(next, resume); };
+            state->runtime->eeScheduler().invokeCurrent(std::move(call));
+        }
+        void advance(unsigned step, R5900Context &parent)
+        {
+            switch (step)
+            {
+            case 1: // The original player initializer owns the enlarged control allocation.
+                state->initializingPlayer = false;
+                if (!state->extendedAllocation)
+                    throw std::runtime_error("Rumble dev AI: player allocation interception was not observed");
+                state->car = car; state->player = word(ram, car + 0x158);
+                checked(state->player, 0xe0);
+                state->ai = state->player + 0x40;
+                state->ready = false; state->decisions = 0;
+                std::memset(ram + state->ai, 0, 0xa0);
+                parent.pc = returnPc;
+                RUNTIME_LOG("[Rumble dev AI] player control allocation extended; autopilot pending");
+                return;
+            case 2:
+                state->originalInput = false;
+                swap(!state->ready);
+                if (!state->ready)
+                {
+                    state->initializingAi = true;
+                    state->reusedAiAllocation = false;
+                    invoke(parent, 0x179e50, {car}, 3);
+                    return;
+                }
+                advance(4, parent);
+                return;
+            case 3:
+                state->initializingAi = false;
+                if (!state->reusedAiAllocation || word(ram, car + 0x158) != state->ai || ram[state->ai + 0x3e] != 2)
+                    throw std::runtime_error("Rumble dev AI: original AI initialization did not match No Mercy");
+                restore(); state->ready = true; swap(false);
+                RUNTIME_LOG("[Rumble dev AI] original NPC logic active for player; difficulty=No Mercy");
+                advance(4, parent);
+                return;
+            case 4: // Original NPC weapon choice, nearby-object search, goal selection, steering.
+            {
+                const uint32_t weapons = (static_cast<int8_t>(ram[car + 0x134]) >= 0 ? 1u : 0u) |
+                                         (static_cast<int8_t>(ram[car + 0x135]) >= 0 ? 2u : 0u);
+                invoke(parent, 0x17f790, {car, ticks, weapons}, 5);
+                return;
+            }
+            case 5: invoke(parent, 0x178140, {car, ticks}, 6); return;
+            case 6: invoke(parent, 0x178c90, {car, ticks}, 7); return;
+            case 7: invoke(parent, 0x1760b0, {ticks}, 8); return;
+            case 8:
+            {
+                const uint32_t physics = word(ram, car + 0xec);
+                checked(physics, 0xa20);
+                float steering, amount, maximum;
+                std::memcpy(&steering, ram + state->ai + 0x2c, 4);
+                std::memcpy(&amount, ram + state->ai + 0x34, 4);
+                std::memcpy(&maximum, ram + physics + 0x4c, 4);
+                const uint8_t mode = ram[state->ai + 0x38];
+                if (!std::isfinite(steering) || !std::isfinite(amount) || !std::isfinite(maximum) ||
+                    maximum <= 0 || mode > 2)
+                    throw std::runtime_error("Rumble dev AI: invalid original steering output");
+                // Same AI-to-physics transfer as retail17AE50; retain normal physics.
+                ram[physics + 0x34] = static_cast<uint8_t>(1 | (mode == 2 ? 2 : mode == 1 ? 4 : 8));
+                std::memcpy(ram + physics + (mode == 0 ? 0x40 : 0x3c), &amount, 4);
+                steering /= maximum;
+                std::memcpy(ram + physics + 0x38, &steering, 4);
+                restore(); ++state->decisions;
+                if (state->decisions == 1 || state->decisions % 600 == 0)
+                    RUNTIME_LOG("[Rumble dev AI] decisions=" << state->decisions << " clock=" << word(ram, 0x1f22b8));
+                parent.pc = returnPc;
+                return;
+            }
+            default: throw std::runtime_error("Rumble dev AI: invalid continuation");
+            }
+        }
+    };
+
+    void initialize(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        if (s->initializingPlayer) { s->init(ram, ctx, runtime); return; }
+        auto work = std::make_shared<Work>(s, ram, getRegU32(ctx, 4), getRegU32(ctx, 31));
+        s->initializingPlayer = true;
+        s->extendedAllocation = false;
+        const auto descriptor = getRegU32(ctx, 5);
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, ram);
+        work->invoke(*ctx, kInitPlayer, {work->car, descriptor}, 1);
+    }
+    void allocate(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        const auto caller = getRegU32(ctx, 31);
+        if (s->initializingPlayer && caller == 0x17a6dc && getRegU32(ctx, 4) == 0x40)
+        {
+            SET_GPR_U32(ctx, 4, 0xe0); // Freed with the original player control block.
+            s->extendedAllocation = true;
+        }
+        if (s->initializingAi && caller == 0x179e88 && getRegU32(ctx, 4) == 0xa0)
+        {
+            s->reusedAiAllocation = true;
+            SET_GPR_U32(ctx, 2, s->ai); ctx->pc = caller; return;
+        }
+        s->allocate(ram, ctx, runtime);
+    }
+    void basic(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        if (s->initializingAi && getRegU32(ctx, 4) == s->car && getRegU32(ctx, 31) == 0x179e78)
+        {
+            ctx->pc = getRegU32(ctx, 31); return; // Player already owns initialized body/camera/laps.
+        }
+        s->basic(ram, ctx, runtime);
+    }
+    void input(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        const auto car = getRegU32(ctx, 4);
+        if (s->originalInput || car != s->car || ram[0x1f21e4] != 4 || word(ram, car + 0x10c))
+        { s->input(ram, ctx, runtime); return; }
+        const auto config = word(ram, 0x1f21c0);
+        if (word(ram, 0x1f21d0) != 1 || word(ram, config + 0x28) || word(ram, config + 0x2c))
+            throw std::runtime_error("Rumble dev AI currently requires one player in a normal race");
+        auto work = std::make_shared<Work>(s, ram, car, getRegU32(ctx, 31));
+        work->ticks = getRegU32(ctx, 6);
+        s->originalInput = true;
+        const auto controls = getRegU32(ctx, 5);
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, ram);
+        work->invoke(*ctx, kInput, {car, controls, work->ticks}, 2);
+    }
+    void apply(PS2Runtime &runtime)
+    {
+        applyUpgrades(runtime);
+        applyPickupObserver(runtime);
+        applyObjectTiming(runtime);
+        applyBenchmarkSpot(runtime);
+        applyDirectRace(runtime);
+        const char *enabled = std::getenv("PS2_RUMBLE_DEV_AI");
+        if (!enabled || std::strcmp(enabled, "no-mercy") != 0) return;
+        if (active && active->runtime == &runtime && runtime.lookupFunction(kInput) == input) return;
+        for (auto at : {kInitPlayer, kInput, kBasic, kAllocate, 0x179e50u, 0x17f790u,
+                        0x178140u, 0x178c90u, 0x1760b0u})
+            if (!runtime.hasFunction(at)) throw std::runtime_error("Rumble dev AI: required guest function missing");
+        if (active && active->work) throw std::runtime_error("Rumble dev AI: another operation is active");
+        auto s = std::make_shared<State>(); s->runtime = &runtime;
+        s->init = runtime.lookupFunction(kInitPlayer); s->input = runtime.lookupFunction(kInput);
+        s->basic = runtime.lookupFunction(kBasic); s->allocate = runtime.lookupFunction(kAllocate);
+        active = std::move(s);
+        runtime.replaceFunction(kInitPlayer, initialize); runtime.replaceFunction(kInput, input);
+        runtime.replaceFunction(kBasic, basic); runtime.replaceFunction(kAllocate, allocate);
+        RUNTIME_LOG("[Rumble dev AI] opt-in No Mercy autopilot hooks installed");
+    }
+}
+namespace ps2_game_overrides
+{
+    bool parseDevelopmentRaceSpot(std::string_view text, DevelopmentRaceSpot &spot)
+    {
+        if (text.size() > 1024) return false;
+        std::istringstream input{std::string(text)};
+        input.imbue(std::locale::classic());
+        DevelopmentRaceSpot candidate{};
+        if (!(input >> candidate.track) || candidate.track >= 15) return false;
+        for (auto &v : candidate.matrix) if (!(input >> v) || !std::isfinite(v)) return false;
+        input >> std::ws;
+        if (!input.eof()) return false;
+        const auto &m = candidate.matrix;
+        if (m[3] || m[7] || m[11] || m[15] != 1) return false;
+        for (unsigned a = 0; a < 3; ++a)
+            for (unsigned b = a; b < 3; ++b)
+            {
+                float dot = 0;
+                for (unsigned i = 0; i < 3; ++i) dot += m[a*4+i] * m[b*4+i];
+                if (std::abs(dot - (a == b ? 1.f : 0.f)) > .02f) return false;
+            }
+        const float determinant = m[0]*(m[5]*m[10]-m[6]*m[9]) - m[1]*(m[4]*m[10]-m[6]*m[8]) + m[2]*(m[4]*m[9]-m[5]*m[8]);
+        if (determinant < .98f) return false;
+        for (unsigned i = 12; i < 15; ++i) if (std::abs(m[i]) > 100000) return false;
+        spot = candidate; return true;
+    }
+
+    bool DevelopmentRaceSpotGate::update(uint32_t clock, bool eligible)
+    {
+        if (clock < previousClock) { observedStart = false; fired = false; }
+        previousClock = clock;
+        if (!eligible) return false;
+        if (clock <= 3600) observedStart = true;
+        if (!observedStart || fired || clock < 7200) return false;
+        fired = true; return true;
+    }
+
+    uint32_t countDevelopmentPickupGroups(const uint8_t *records, uint32_t bytes)
+    {
+        if (bytes > 160 * 48 || bytes % 48 || (!records && bytes)) return UINT32_MAX;
+        const auto word = [](const uint8_t *p) { uint32_t v; std::memcpy(&v, p, 4); return v; };
+        const auto format = [](const uint8_t *p, uint8_t type) {
+            return p[36] == 0 && p[37] == type && p[38] == 1;
+        };
+        uint32_t groups = 0;
+        for (uint32_t i = 0; i + 3 * 48 <= bytes; i += 48)
+        {
+            const auto *a = records + i, *b = a + 48, *c = b + 48;
+            if (std::memcmp(a, b, 16) || std::memcmp(a, c, 16) ||
+                word(a + 16) || word(b + 16) || word(c + 16) ||
+                word(a + 20) != 0x60ffa8a8 || word(b + 20) != 0x60ffa8a8 ||
+                word(c + 20) != 0x80ffb8b8 || !format(a, 2) || !format(b, 2) || !format(c, 4)) continue;
+            ++groups; i += 2 * 48;
+        }
+        return groups;
+    }
+
+    bool applyDevelopmentGlitchFrame(std::vector<uint8_t> &rgba, uint32_t width,
+                                    uint32_t height, uint64_t tick, bool enabled)
+    {
+        if (!enabled || !width || !height || rgba.size() % 4u ||
+            rgba.size() / 4u / width != height || rgba.size() / 4u % width) return false;
+        // Deliberately imitate a scrambled palette/texture atlas in a host copy.
+        // Stable blocks change slowly; no random state, game writes or asset edits.
+        const uint32_t phase = static_cast<uint32_t>(tick / 120u);
+        for (uint32_t y = 0; y < height; ++y)
+            for (uint32_t x = 0; x < width; ++x)
+            {
+                auto *p = rgba.data() + (size_t(y) * width + x) * 4u;
+                const uint8_t r = p[0], g = p[1], b = p[2];
+                if (!(r | g | b)) continue;
+                uint32_t tile = (x / 24u) * 0x45d9f3bu ^ (y / 16u) * 0x119de1f3u ^ phase;
+                tile ^= tile >> 16u;
+                if (tile % 29u == 0u)
+                {
+                    p[0] = static_cast<uint8_t>(r | 0xb0u);
+                    p[1] = static_cast<uint8_t>(g | 0xb0u);
+                    p[2] = static_cast<uint8_t>(b | 0xb0u);
+                }
+                else
+                {
+                    p[0] = static_cast<uint8_t>((g & 0xe0u) ^ ((tile & 3u) << 5u));
+                    p[1] = static_cast<uint8_t>((b & 0xe0u) ^ (((tile >> 2u) & 3u) << 5u));
+                    p[2] = static_cast<uint8_t>((r & 0xe0u) ^ (((tile >> 4u) & 3u) << 5u));
+                }
+                // Preserve source alpha and buffer dimensions exactly.
+            }
+        return true;
+    }
+
+    void registerRumbleDevOverride()
+    {
+        static std::once_flag once;
+        std::call_once(once, [] {
+            registerDescriptor({"Rumble Racing USA retail dev AI", "SLUS_201.74", 0x100008, 0x5720d8d8, apply});
+        });
+    }
+}
diff --git a/ps2xRuntime/src/lib/rumble_picture.cpp b/ps2xRuntime/src/lib/rumble_picture.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b92f58b12801680ff7d29e3f6c840ed938b59b84
--- /dev/null
+++ b/ps2xRuntime/src/lib/rumble_picture.cpp
@@ -0,0 +1,170 @@
+// Native adaptation of the verified USA retail LLPict picture path.
+// Original assets stay in guest memory; allocation/upload/free use retail code.
+#include "game_overrides.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "ps2_log.h"
+#include "runtime/ee_scheduler.h"
+#include "Stubs/IPU.h"
+#include <bit>
+#include <cstring>
+#include <initializer_list>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+
+namespace
+{
+    constexpr uint32_t kPictureEntry = 0x1a83a0;
+    constexpr uint32_t kManagerPointer = 0x1ece10;
+    constexpr uint32_t kVramManager = 0x1f0260;
+
+    uint32_t physicalRange(uint32_t address, size_t bytes)
+    {
+        const uint32_t physical = address & 0x1fffffff;
+        if (physical == 0 || physical >= PS2_RAM_SIZE || bytes > PS2_RAM_SIZE - physical)
+            throw std::runtime_error("Rumble retail picture: invalid guest memory range");
+        return physical;
+    }
+
+    struct PictureWork : std::enable_shared_from_this<PictureWork>
+    {
+        PS2Runtime *runtime;
+        uint8_t *rdram;
+        ps2_ipu::Picture decoded;
+        uint32_t descriptor = 0, pixels = 0, manager = 0;
+        uint32_t returnPc = 0, textureWidthLog = 0, textureHeightLog = 0;
+
+        void invoke(R5900Context &parent, uint32_t address,
+                    std::initializer_list<uint32_t> arguments, unsigned next)
+        {
+            GuestInvocation call{};
+            call.kind = GuestInvocationKind::HleCall;
+            call.tag = kPictureEntry;
+            call.context = parent;
+            call.context.pc = address;
+            unsigned reg = 4;
+            for (uint32_t argument : arguments)
+            {
+                SET_GPR_U32(&call.context, reg, argument);
+                ++reg;
+            }
+            SET_GPR_U32(&call.context, 29, 0);
+            SET_GPR_U32(&call.context, 31, 0);
+            call.onComplete = [work = shared_from_this(), next](const R5900Context &completed, R5900Context &resume)
+            {
+                work->advance(next, getRegU32(&completed, 2), resume);
+            };
+            runtime->eeScheduler().invokeCurrent(std::move(call));
+        }
+
+        void advance(unsigned step, uint32_t result, R5900Context &parent)
+        {
+            switch (step)
+            {
+            case 0:
+                invoke(parent, 0x1a8110, {}, 1); // picture-manager temporary DMA buffers
+                break;
+            case 1:
+                invoke(parent, 0x120e60, {0x24, 2, 0x10}, 2);
+                break;
+            case 2:
+                descriptor = result;
+                physicalRange(descriptor, 0x24);
+                invoke(parent, 0x120e60, {static_cast<uint32_t>(decoded.macroblocks.size()), 1, 0x40}, 3);
+                break;
+            case 3:
+            {
+                pixels = result;
+                std::memcpy(rdram + physicalRange(pixels, decoded.macroblocks.size()),
+                            decoded.macroblocks.data(), decoded.macroblocks.size());
+                textureWidthLog = std::bit_width(decoded.width - 1);
+                textureHeightLog = std::bit_width(decoded.height - 1);
+                const uint32_t textureWidth = 1u << textureWidthLog;
+                const uint32_t textureHeight = 1u << textureHeightLog;
+                const uint32_t words[] = {0, 0, decoded.width, decoded.height,
+                    (textureWidth + 63) / 64, textureWidthLog, textureHeightLog,
+                    std::bit_cast<uint32_t>(float(decoded.width) / textureWidth),
+                    std::bit_cast<uint32_t>(float(decoded.height) / textureHeight)};
+                std::memcpy(rdram + physicalRange(descriptor, sizeof(words)), words, sizeof(words));
+                invoke(parent, 0x12a9f0, {kVramManager, textureWidth * textureHeight * 4 / 256}, 4);
+                break;
+            }
+            case 4:
+                std::memcpy(rdram + physicalRange(descriptor, 4), &result, 4);
+                std::memcpy(&manager, rdram + kManagerPointer, 4);
+                physicalRange(manager, 8);
+                // Sixth EE argument t1=1: row-major macroblocks, as at 0x1A85E8.
+                invoke(parent, 0x1a7f90, {manager + 4, pixels, result, decoded.width, decoded.height, 1}, 5);
+                break;
+            case 5:
+                invoke(parent, 0x1a7eb0, {manager + 4}, 6);
+                break;
+            case 6:
+                invoke(parent, 0x1a7f60, {manager + 4}, 7);
+                break;
+            case 7:
+                invoke(parent, 0x1a8150, {}, 8);
+                break;
+            case 8:
+                invoke(parent, 0x121230, {pixels}, 9);
+                break;
+            case 9:
+                RUNTIME_LOG("[Rumble retail picture] uploaded " << decoded.width << "x" << decoded.height
+                    << " descriptor=0x" << std::hex << descriptor << std::dec);
+                SET_GPR_U32(&parent, 2, descriptor);
+                parent.pc = returnPc;
+                break;
+            default:
+                throw std::runtime_error("Rumble retail picture: invalid continuation");
+            }
+        }
+    };
+
+    void decodeRetailPicture(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t source = getRegU32(ctx, 4);
+        const uint32_t size = getRegU32(ctx, 5);
+        if (!source)
+        {
+            SET_GPR_U32(ctx, 2, 0);
+            ctx->pc = getRegU32(ctx, 31);
+            return;
+        }
+        const uint32_t sourceOffset = physicalRange(source, size);
+        auto work = std::make_shared<PictureWork>();
+        work->runtime = runtime;
+        work->rdram = rdram;
+        work->returnPc = getRegU32(ctx, 31);
+        std::string error;
+        if (!ps2_ipu::decodePicture(std::span(rdram + sourceOffset, size), work->decoded, error))
+            throw std::runtime_error("Rumble retail picture: " + error);
+        // Decode/validate before any game allocation or mutation. Each callback
+        // owns this one bounded image until the guest upload and frees finish.
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, rdram);
+        work->advance(0, 0, *ctx);
+    }
+
+    void applyRetailPicture(PS2Runtime &runtime)
+    {
+        for (uint32_t address : {kPictureEntry, 0x1a8110u, 0x120e60u, 0x12a9f0u,
+                0x1a7f90u, 0x1a7eb0u, 0x1a7f60u, 0x1a8150u, 0x121230u})
+            if (!runtime.hasFunction(address))
+                throw std::runtime_error("Rumble retail picture: required guest function missing");
+        if (!runtime.replaceFunction(kPictureEntry, decodeRetailPicture))
+            throw std::runtime_error("Rumble retail picture: could not bind verified entry");
+    }
+}
+
+namespace ps2_game_overrides
+{
+    void registerRumblePictureOverride()
+    {
+        static std::once_flag once;
+        std::call_once(once, [] {
+            registerDescriptor({"Rumble Racing USA retail IPUM picture", "SLUS_201.74",
+                                0x100008, 0x5720d8d8, applyRetailPicture});
+        });
+    }
+}
diff --git a/ps2xRuntime/src/lib/rumble_video.cpp b/ps2xRuntime/src/lib/rumble_video.cpp
