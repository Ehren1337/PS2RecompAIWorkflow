+        for (size_t probe = 0; probe < entries.size(); ++probe)
+        {
+            auto &entry = entries[(((model >> 4) ^ (object >> 4)) + probe) % entries.size()];
+            if (entry.model.load(std::memory_order_relaxed) &&
+                (entry.model.load(std::memory_order_relaxed) != model ||
+                 entry.object.load(std::memory_order_relaxed) != object)) continue;
+            entry.stamp.fetch_add(1, std::memory_order_acq_rel);
+            entry.model.store(model, std::memory_order_relaxed); entry.object.store(object, std::memory_order_relaxed);
