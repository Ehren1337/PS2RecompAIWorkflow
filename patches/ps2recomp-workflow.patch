+            oldScale = word(ram, kDifficultyScale);
+            oldType = ram[car + 0xc6]; oldDifficulty = ram[entry + 5];
+            if (initializing)
+            {
+                std::memcpy(oldStart, ram + 0x1f27e0, 16);
+                std::memcpy(oldDirection, ram + car, 16);
+                oldYaw = word(ram, car + 0x11c);
+            }
