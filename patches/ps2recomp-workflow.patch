+bool PS2AudioBackend::queuePcmVoiceBatch(const std::array<std::vector<int16_t>, 48> &voices,
+    const std::array<ps2x::iop::PcmLoopVoiceUpdate, 48> &loops,
+        const std::array<ps2x::iop::PcmReverbUpdate, 2> &effects)
+{
+#if defined(PLATFORM_VITA)
+    return false;
+#else
+    std::lock_guard lock(m_mutex);
+    if (!m_audioReady || m_impl->voicesFailed) return false;
+    using Action = ps2x::iop::PcmLoopVoiceUpdate::Action;
+    using EffectAction = ps2x::iop::PcmReverbUpdate::Action;
+    bool any = false;
+    for (const auto &effect : effects)
+    {
+        if (effect.action == EffectAction::Keep || effect.action == EffectAction::Reset) continue;
+        if (effect.action != EffectAction::Configure || !effect.wordCount ||
+            effect.startWord >= PS2ReverbNetwork::kRamWords ||
+            effect.wordCount > PS2ReverbNetwork::kRamWords - effect.startWord ||
+            ((effect.sendLeft | effect.sendRight | effect.externalLeft | effect.externalRight) >> 48)) return false;
+    }
+    // Validate every entry before allocating or touching a playing voice.
+    for (size_t i = 0; i < voices.size(); ++i)
+    {
+        const auto &pcm = voices[i];
+        const auto &loop = loops[i];
+        if (pcm.size() % 2 || pcm.size() > 262144u * 2) return false;
+        if (loop.action != Action::Keep && !pcm.empty()) return false;
+        switch (loop.action)
+        {
+        case Action::Keep:
+        case Action::Stop:
+            if (!loop.samples.empty()) return false;
+            break;
+        case Action::Start:
+            if (loop.samples.empty() || loop.samples.size() > 262144u || loop.loopStart >= loop.samples.size()) return false;
+            if (!loop.repeats && loop.loopStart != 0) return false;
+            break;
+        case Action::Update:
+            if (!loop.samples.empty() || m_impl->voices[i].pcm) return false;
+            if (m_impl->voices[i].loop ? m_impl->voices[i].repeats != loop.repeats : loop.repeats) return false;
