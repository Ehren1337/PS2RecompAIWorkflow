+        std::atomic<uint64_t> stamp{0}, nanoseconds{0};
+        std::atomic<uint32_t> clock{0}, records{0}, groups{0}, viewport{0};
+    };
+    std::array<Sample, 64> samples{};
+    std::atomic<uint64_t> published{0}, invalid{0};
+}
