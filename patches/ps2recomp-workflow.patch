+inline int32_t ps2_fpu_cvt_w_s(float value)
+{
+    // EE CVT.W.S always truncates toward zero. Host rounding state must not
+    // select another integer (for example, a neighboring collision-grid cell).
+    // Check the encoding before casting: EE exponent-255 values and finite
+    // overflow saturate by sign, avoiding undefined host float-to-int casts.
+    const uint32_t bits = std::bit_cast<uint32_t>(value);
+    if ((bits & 0x7fffffffu) >= 0x4f000000u)
+        return (bits & 0x80000000u) != 0u ? INT32_MIN : INT32_MAX;
+    return static_cast<int32_t>(value);
+}
