+#ifdef _WIN32
+// Test-only hidden context. It never shows a window or changes the game's
+// context; production GL ownership/presentation is still a separate task.
+struct HiddenGLContext
+{
+    HWND window = nullptr;
+    HDC dc = nullptr;
+    HGLRC gl = nullptr;
+    HDC previousDC = wglGetCurrentDC();
+    HGLRC previousGL = wglGetCurrentContext();
+    ATOM windowClass = 0;
+    bool Initialize()
+    {
+        WNDCLASSA wc{};
+        wc.style = CS_OWNDC;
+        wc.lpfnWndProc = DefWindowProcA;
+        wc.hInstance = GetModuleHandle(nullptr);
+        wc.lpszClassName = "PS2GSSharedShaderTest";
+        windowClass = RegisterClassA(&wc);
+        if (!windowClass) return false;
+        window = CreateWindowExA(0, wc.lpszClassName, "", WS_POPUP,
+            0, 0, 32, 32, nullptr, nullptr, wc.hInstance, nullptr);
+        if (!window) return false;
+        dc = GetDC(window);
+        PIXELFORMATDESCRIPTOR format{};
+        format.nSize = sizeof(format);
+        format.nVersion = 1;
+        format.dwFlags = PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER;
+        format.iPixelType = PFD_TYPE_RGBA;
+        format.cColorBits = 32;
+        const int index = ChoosePixelFormat(dc, &format);
+        if (!index || !SetPixelFormat(dc, index, &format)) return false;
+        gl = wglCreateContext(dc);
+        return gl && wglMakeCurrent(dc, gl);
+    }
+    ~HiddenGLContext()
+    {
+        if (gl) { wglMakeCurrent(previousDC, previousGL); wglDeleteContext(gl); }
+        if (dc) ReleaseDC(window, dc);
+        if (window) DestroyWindow(window);
+        if (windowClass) UnregisterClassA("PS2GSSharedShaderTest", GetModuleHandle(nullptr));
+    }
+};
+#endif
