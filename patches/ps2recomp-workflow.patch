+                    }
+                    m_host.log(LogLevel::Warning, out.str());
+                }
+                return {true, false, {}};
+            }
+
+            void appendDebugMetrics(std::vector<DebugMetric> &metrics) const override
+            {
+                std::lock_guard lock(m_mutex);
+                metrics.push_back({"diagnostic_sound_disabled", m_diagnosticSilent});
+                metrics.push_back({"diagnostic_sound_skipped_commands", m_silentCommands});
+                metrics.push_back({"transfer_ready", m_ready});
+                metrics.push_back({"ee_buffer", m_eeBuffer, true});
+                metrics.push_back({"ee_size", m_eeSize, true});
+                metrics.push_back({"iop_allocation", m_iopBuffer, true});
+                metrics.push_back({"commands", m_commands});
+                metrics.push_back({"unsupported_commands", m_unsupported});
+                metrics.push_back({"last_kind", m_lastKind});
+                metrics.push_back({"control_batches", m_batches});
+                metrics.push_back({"status_acknowledgements", m_statusAcks});
+                metrics.push_back({"status_pending", m_statusPending});
+                metrics.push_back({"last_batch_count", m_lastBatchCount});
+                metrics.push_back({"last_opcode", m_lastOpcode});
+                // 1 packet,2 commands,3 listener,4 engine state,5 engine playback,
+                // 6 emitters,7 positional shots,8 publication/sink;0 accepted.
+                metrics.push_back({"control_rejection_stage", m_controlStage});
+                metrics.push_back({"general_voice_capacity", m_cueEnabled ? 24u : 48u});
+                metrics.push_back({"pcm_active_voice_mask", m_host.activePcmVoiceMask(), true});
+                metrics.push_back({"stream_stop_requested", m_streamStopRequested});
+                metrics.push_back({"voiceover_bytes", m_voiceover.size()});
+                metrics.push_back({"voiceover_uploads", m_voiceoverUploads});
+                metrics.push_back({"voiceover_data_hash", m_voiceoverHash});
+                metrics.push_back({"voiceover_pending_releases", m_voiceoverReleases});
+                metrics.push_back({"speech_handle", m_speech.handle});
+                metrics.push_back({"speech_id", m_speech.id});
+                metrics.push_back({"speech_playing", m_speech.playing});
+                metrics.push_back({"speech_paused", m_speech.paused});
+                metrics.push_back({"audio_paused", m_audioPaused});
+                metrics.push_back({"speech_starts", m_speechStarts});
+                metrics.push_back({"speech_completions", m_speechCompletions});
+                metrics.push_back({"speech_pcm_frames", m_speechFrames});
+                metrics.push_back({"speech_pcm_hash", m_speechHash});
+                metrics.push_back({"sound_enabled", m_soundEnabled});
+                metrics.push_back({"cue_commands", m_cueCommands});
+                metrics.push_back({"cue_next_voice", m_cueVoice});
+                metrics.push_back({"cue_enabled", m_retail && m_cueEnabled});
