+bool SpriteTextureDisjoint(const GSDrawState &s, const DrawParams &draw, bool depthActive)
+{
+    // Only refine direct-color sprites after their coordinates and rectangle
+    // have passed normal validation. Palette/region-wrap hazards retain the
+    // conservative path. Compare against the ENTIRE shared scissor footprint,
+    // not just this sprite, so batching remains safe for every queued draw.
+    if (!SupportedColorTexture(s.context.tex0.psm) || std::fegetround() != FE_TONEAREST) return false;
+    std::array<uint32_t, 4> sampled{};
+    for (unsigned axis = 0; axis < 2; ++axis)
+    {
+        const uint32_t size = axis ? s.textureHeight : s.textureWidth;
+        const uint32_t mode = uint32_t(s.context.clamp >> (axis * 2)) & 3;
+        if (mode > 1) return false;
+        const float start = draw.texcoords[0][axis], end = draw.texcoords[1][axis];
+        if (!std::isfinite(start) || !std::isfinite(end) || std::abs(start) > 8192 || std::abs(end) > 8192 ||
+            std::fpclassify(start) == FP_SUBNORMAL || std::fpclassify(end) == FP_SUBNORMAL) return false;
+        const int origin = int(draw.vertices[0][axis]), span = int(draw.vertices[1][axis]);
+        // Separate float stores match the shader's precise operations and
+        // correctly rounded PixelRatio; no fused multiply/add at boundaries.
+        const auto coordinate = [&](uint32_t pixel) {
+            volatile float ratio = (float(int(pixel) - origin) + 0.5f) / float(span);
+            volatile float delta = end - start;
+            volatile float product = delta * ratio;
+            volatile float value = start + product;
+            if (s.prim.fst)
+            {
+                volatile float scaled = value * 16.0f;
+                volatile float rounded = scaled + 0.5f;
+                return float(std::clamp(int(rounded), 0, 65535)) / 16.0f;
+            }
+            volatile float normalized = value / float(size);
+            volatile float restored = normalized * float(size);
+            return float(restored);
+        };
+        const float first = coordinate(draw.rect[axis]), last = coordinate(draw.rect[axis + 2]);
+        if (!std::isfinite(first) || !std::isfinite(last) ||
+            std::fpclassify(first) == FP_SUBNORMAL || std::fpclassify(last) == FP_SUBNORMAL) return false;
+        float low = std::min(first, last), high = std::max(first, last);
+        int lo, hi;
+        if (s.linearFilter)
+        {
+            low -= 0.5f; high -= 0.5f;
+            lo = int(std::floor(low)); hi = int(std::floor(high));
+            if (high != float(hi)) ++hi; // Nonzero upper tap only, matching SampleTexture.
+        }
+        else { lo = int(low); hi = int(high); }
+        if (mode == 0 && (lo < 0 || hi >= int(size))) return false; // Repeat crosses a boundary.
+        lo = std::clamp(lo, 0, int(size) - 1); hi = std::clamp(hi, 0, int(size) - 1);
+        sampled[axis * 2] = uint32_t(lo); sampled[axis * 2 + 1] = uint32_t(hi);
+    }
+    return !TextureMayAliasFrame(s, depthActive, &sampled);
+}
+}
+
+struct GSDiligentDevice::Impl
+{
+    // These checks depend only on register layout, never VRAM contents or
+    // vertices. Reuse the last exact result across a packet's triangles and
+    // the adapter's validate/submit pair. Explicit keys avoid struct padding.
+    template<size_t N> struct FootprintMemo
+    {
+        std::array<uint32_t, N> key{};
+        bool valid = false, value = false;
+        template<class F> bool Get(const std::array<uint32_t, N> &next, F compute)
+        {
+            if (!valid || !gs_detail::EqualRegisterKey(key, next))
+            {
+                value = compute(); key = next; valid = true;
+            }
+            return value;
+        }
+    };
+    FootprintMemo<8> depthFootprint;
+    FootprintMemo<22> textureFootprint;
+    static_assert(sizeof(depthFootprint) + sizeof(textureFootprint) <= 136);
+
+    bool DepthDisjoint(const GSContext &c)
+    {
+        return depthFootprint.Get({c.frame.fbp, c.frame.fbw,
+            c.scissor.x0, c.scissor.x1, c.scissor.y0, c.scissor.y1,
+            c.zbuf.zbp, c.zbuf.psm}, [&] { return ColorDepthDisjoint(c); });
+    }
+    bool TextureAliases(const GSDrawState &s, bool depthActive)
+    {
+        const auto &c = s.context; const auto &t = c.tex0;
+        return textureFootprint.Get({c.frame.fbp, c.frame.fbw,
+            c.scissor.x0, c.scissor.x1, c.scissor.y0, c.scissor.y1,
+            c.zbuf.zbp, c.zbuf.psm, uint32_t(depthActive),
+            uint32_t(c.clamp), uint32_t(c.clamp >> 32),
+            t.psm, t.tbp0, t.tbw, t.cbp, t.cpsm, t.csm,
+            s.textureWidth, s.textureHeight, s.texclut.cbw, s.texclut.cou, s.texclut.cov},
+            [&] { return TextureMayAliasFrame(s, depthActive); });
+    }
+
+    RefCntAutoPtr<IRenderDevice> device;
+    RefCntAutoPtr<IDeviceContext> context;
+    RefCntAutoPtr<IBuffer> vram, staging, offsets, commands, tileHeaders, tileIndices;
+    // Separate from VRAM/FINISH staging: those operations may run while this
+    // immutable display copy is pending. Allocated only for deferred output.
+    RefCntAutoPtr<IBuffer> displayStaging;
+    RefCntAutoPtr<IFence> displayFence;
+    RefCntAutoPtr<IBuffer> pageStaging;
+    RefCntAutoPtr<IFence> pageFence;
+    uint64_t pageSerial = 0;
+    uint16_t pageFirst = 512;
+    uint64_t displaySerial = 0;
+    bool displayPending = false;
+    struct PendingDisplay
+    {
+        uint32_t width = 0, height = 0, displayFbp = 0, first = 0, count = 0;
+        std::array<uint32_t, 6> sourceFbp{};
+        bool preferred = false;
+    } pendingDisplay;
+    RefCntAutoPtr<IPipelineState> pipeline;
+    RefCntAutoPtr<IShaderResourceBinding> resources;
+    std::string adapter;
+    bool blockingReadbackMap = false;
+    bool depthSupported = false;
+    bool uploaded = false;
+    std::vector<DrawParams> queued;
+    RefCntAutoPtr<IPipelineState> copyPipeline;
+    RefCntAutoPtr<IShaderResourceBinding> copyResources;
+    RefCntAutoPtr<IPipelineState> displayPipeline;
+    RefCntAutoPtr<IShaderResourceBinding> displayResources;
+    RefCntAutoPtr<IPipelineState> scanPipeline, composePipeline;
+    RefCntAutoPtr<IShaderResourceBinding> scanResources, composeResources;
+    RefCntAutoPtr<IPipelineState> readPipeline;
+    RefCntAutoPtr<IShaderResourceBinding> readResources;
+    GSContext batchContext{};
+    uint32_t batchPreservedIndexBits = 0;
+    bool batchIndexFeedback = false;
+    BatchStats stats{};
+
+    explicit Impl(Api api)
+    {
+        switch (api)
+        {
+#if PS2X_GPU_D3D11
+        case Api::D3D11:
+        {
+            auto *factory = GetEngineFactoryD3D11();
+            EngineD3D11CreateInfo ci;
+            ChooseAdapter(factory, ci);
+            factory->CreateDeviceAndContextsD3D11(ci, &device, &context);
+            break;
+        }
+#endif
+#if PS2X_GPU_D3D12
+        case Api::D3D12:
+        {
+            auto *factory = GetEngineFactoryD3D12();
+            if (!factory || !factory->LoadD3D12()) throw std::runtime_error("D3D12 unavailable");
+            EngineD3D12CreateInfo ci;
+            ChooseAdapter(factory, ci);
+            factory->CreateDeviceAndContextsD3D12(ci, &device, &context);
+            break;
+        }
+#endif
+#if PS2X_GPU_Vk
+        case Api::Vulkan:
+        {
+            auto *factory = GetEngineFactoryVk();
+            EngineVkCreateInfo ci;
+            ChooseAdapter(factory, ci);
+            factory->CreateDeviceAndContextsVk(ci, &device, &context);
+            break;
+        }
+#endif
+#if PS2X_GPU_OpenGL
+        case Api::OpenGL:
+        {
+            auto *factory = GetEngineFactoryOpenGL();
+            EngineGLCreateInfo ci;
+            ci.Features.ComputeShaders = DEVICE_FEATURE_STATE_ENABLED;
+            ci.Features.ShaderFloat64 = std::getenv("PS2_GPU_DISABLE_FLOAT64") ? DEVICE_FEATURE_STATE_DISABLED : DEVICE_FEATURE_STATE_OPTIONAL;
+            factory->AttachToActiveGLContext(ci, &device, &context);
+            break;
+        }
+#endif
+        default: throw std::runtime_error("Requested Diligent API was not compiled");
+        }
+        if (!device || !context) throw std::runtime_error("Diligent device creation failed");
+        blockingReadbackMap = api == Api::D3D11;
+        adapter = device->GetAdapterInfo().Description;
+        // Some APIs report always-enabled hardware features even when their
+        // request was DISABLED. Keep the diagnostic capability override explicit.
+        depthSupported = device->GetDeviceInfo().Features.ShaderFloat64 == DEVICE_FEATURE_STATE_ENABLED &&
+            !std::getenv("PS2_GPU_DISABLE_FLOAT64");
+
+        BufferDesc desc;
+        desc.Name = "PS2 GPU VRAM";
+        desc.Size = VramBytes;
+        desc.Mode = BUFFER_MODE_STRUCTURED;
+        desc.ElementByteStride = 4;
+        desc.BindFlags = BIND_UNORDERED_ACCESS;
+        device->CreateBuffer(desc, nullptr, &vram);
+        desc.Name = "PS2 GPU readback";
+        desc.Mode = BUFFER_MODE_UNDEFINED;
+        desc.ElementByteStride = 0;
+        desc.BindFlags = BIND_NONE;
+        desc.Usage = USAGE_STAGING;
+        desc.CPUAccessFlags = CPU_ACCESS_READ;
+        device->CreateBuffer(desc, nullptr, &staging);
+
+        // Every page offset fits in 14 bits, including T4 nibble offsets.
+        // Pack two into each word without changing shader address arithmetic.
+        std::vector<uint32_t> page(34816 / 2);
+        auto offset = [&](uint32_t index, uint32_t value)
+        { page[index >> 1] |= value << ((index & 1) * 16); };
+        for (uint32_t y = 0; y < 32; ++y)
+            for (uint32_t x = 0; x < 64; ++x)
+                offset(y * 64 + x, GSPSMCT32::addrPSMCT32(0, 1, x, y) / 4);
+        for (uint32_t y = 0; y < 64; ++y)
+            for (uint32_t x = 0; x < 64; ++x)
+            {
+                offset(2048 + y * 64 + x, GSPSMCT16::addrPSMCT16(0, 1, x, y));
+                offset(6144 + y * 64 + x, GSPSMCT16::addrPSMCT16S(0, 1, x, y));
+            }
+        for (uint32_t y = 0; y < 128; ++y)
+            for (uint32_t x = 0; x < 128; ++x)
+            {
+                if (y < 64) offset(10240 + y * 128 + x, GSPSMT8::addrPSMT8(0, 2, x, y));
+                offset(18432 + y * 128 + x, GSPSMT4::addrPSMT4(0, 2, x, y));
+            }
+        desc = {};
+        desc.Name = "PS2 color/indexed page swizzles";
+        desc.Size = page.size() * sizeof(uint32_t);
+        desc.Mode = BUFFER_MODE_STRUCTURED;
+        desc.ElementByteStride = 4;
+        desc.BindFlags = BIND_SHADER_RESOURCE;
+        desc.Usage = USAGE_IMMUTABLE;
+        BufferData data{page.data(), desc.Size};
+        device->CreateBuffer(desc, &data, &offsets);
+
+        desc = {};
+        desc.Name = "PS2 draw commands";
+        desc.Size = sizeof(DrawParams) * BatchCapacity;
+        desc.BindFlags = BIND_SHADER_RESOURCE;
+        desc.Mode = BUFFER_MODE_STRUCTURED;
+        desc.ElementByteStride = sizeof(DrawParams);
+        device->CreateBuffer(desc, nullptr, &commands);
+        desc.Name = "PS2 tile headers";
+        desc.BindFlags |= BIND_UNORDERED_ACCESS;
+        desc.Size = 8 * MaxTiles;
+        desc.ElementByteStride = 8;
+        device->CreateBuffer(desc, nullptr, &tileHeaders);
+        desc.Name = "PS2 ordered tile references";
+        desc.BindFlags |= BIND_UNORDERED_ACCESS;
+        desc.Size = MaxTileReferences; // Byte indices, packed four per uint.
+        desc.ElementByteStride = sizeof(uint32_t);
+        device->CreateBuffer(desc, nullptr, &tileIndices);
+        if (!vram || !staging || !offsets || !commands || !tileHeaders || !tileIndices)
+            throw std::runtime_error("GPU buffer creation failed");
+        queued.reserve(BatchCapacity);
+
+        ShaderCreateInfo shaderCI;
+        shaderCI.Desc.Name = "PS2 shared GS compute";
+        shaderCI.Desc.ShaderType = SHADER_TYPE_COMPUTE;
+        shaderCI.Desc.UseCombinedTextureSamplers = true; // Required by Diligent's HLSL -> GLSL path.
+        shaderCI.SourceLanguage = SHADER_SOURCE_LANGUAGE_HLSL;
+        shaderCI.Source = ShaderSource;
+        // Keep entry names distinct: the GL translator generates its own
+        // parameterless main wrapper for whichever entry is selected.
+        shaderCI.EntryPoint = "drawMain";
+        if (api == Api::D3D12) { shaderCI.ShaderCompiler = SHADER_COMPILER_DXC; shaderCI.HLSLVersion = {6, 0}; }
+
+        ShaderMacro macros[] = {{"GS_DEPTH_FP64", depthSupported ? "1" : "0"}, {"GS_ENTRY", "0"}};
+        shaderCI.Macros = ShaderMacroArray{macros, 2};
+        RefCntAutoPtr<IShader> shader;
+        device->CreateShader(shaderCI, &shader);
+        if (!shader) throw std::runtime_error("PS2 GPU shader compilation failed");
+        ComputePipelineStateCreateInfo pipelineCI;
+        pipelineCI.PSODesc.Name = "PS2 GS compute";
+        pipelineCI.PSODesc.PipelineType = PIPELINE_TYPE_COMPUTE;
+        pipelineCI.pCS = shader;
+        device->CreateComputePipelineState(pipelineCI, &pipeline);
+        if (!pipeline) throw std::runtime_error("PS2 GPU pipeline creation failed");
+        pipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Commands")->Set(commands->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        pipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "TileHeaders")->Set(tileHeaders->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        pipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "TileIndices")->Set(tileIndices->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        pipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "PageOffsets")->Set(offsets->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        pipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Vram")->Set(vram->GetDefaultView(BUFFER_VIEW_UNORDERED_ACCESS));
+        pipeline->CreateShaderResourceBinding(&resources, true);
+
+        shaderCI.Desc.Name = "PS2 ordered small local copy";
+        shaderCI.EntryPoint = "copyLocal";
+        macros[1].Definition = "1";
+        shader.Release();
+        device->CreateShader(shaderCI, &shader);
+        if (!shader) throw std::runtime_error("PS2 GPU copy shader compilation failed");
+        pipelineCI.PSODesc.Name = "PS2 local copy";
+        pipelineCI.pCS = shader;
+        device->CreateComputePipelineState(pipelineCI, &copyPipeline);
+        if (!copyPipeline) throw std::runtime_error("PS2 GPU copy pipeline creation failed");
+        copyPipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Commands")->Set(commands->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        copyPipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "PageOffsets")->Set(offsets->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        copyPipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Vram")->Set(vram->GetDefaultView(BUFFER_VIEW_UNORDERED_ACCESS));
+        copyPipeline->CreateShaderResourceBinding(&copyResources, true);
+
+        shaderCI.Desc.Name = "PS2 display extraction";
+        shaderCI.EntryPoint = "displayMain";
+        macros[1].Definition = "2";
+        shader.Release();
+        device->CreateShader(shaderCI, &shader);
+        if (!shader) throw std::runtime_error("PS2 GPU display shader compilation failed");
+        pipelineCI.PSODesc.Name = "PS2 display extraction";
+        pipelineCI.pCS = shader;
+        device->CreateComputePipelineState(pipelineCI, &displayPipeline);
+        if (!displayPipeline) throw std::runtime_error("PS2 GPU display pipeline creation failed");
+        displayPipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Commands")->Set(commands->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        displayPipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "PageOffsets")->Set(offsets->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+        displayPipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Vram")->Set(vram->GetDefaultView(BUFFER_VIEW_UNORDERED_ACCESS));
+        displayPipeline->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "DisplayPixels")->Set(tileIndices->GetDefaultView(BUFFER_VIEW_UNORDERED_ACCESS));
+        displayPipeline->CreateShaderResourceBinding(&displayResources, true);
+
+        for (unsigned stage = 0; stage < 3; ++stage)
+        {
+            auto &target = stage == 2 ? readPipeline : stage ? composePipeline : scanPipeline;
+            auto &binding = stage == 2 ? readResources : stage ? composeResources : scanResources;
+            shaderCI.Desc.Name = stage == 2 ? "PS2 small raw readback" : stage ? "PS2 display composition" : "PS2 display source scan";
+            shaderCI.EntryPoint = stage == 2 ? "readLocal" : stage ? "composeDisplay" : "scanDisplay";
+            macros[1].Definition = stage == 2 ? "5" : stage ? "4" : "3";
+            shader.Release();
+            device->CreateShader(shaderCI, &shader);
+            if (!shader) throw std::runtime_error("PS2 GPU presentation shader compilation failed");
+            pipelineCI.PSODesc.Name = shaderCI.Desc.Name;
+            pipelineCI.pCS = shader;
+            device->CreateComputePipelineState(pipelineCI, &target);
+            if (!target) throw std::runtime_error("PS2 GPU presentation pipeline creation failed");
+            target->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Commands")->Set(commands->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+            target->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "PageOffsets")->Set(offsets->GetDefaultView(BUFFER_VIEW_SHADER_RESOURCE));
+            target->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "Vram")->Set(vram->GetDefaultView(BUFFER_VIEW_UNORDERED_ACCESS));
+            if (stage != 2) target->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "DisplayFlags")->Set(tileHeaders->GetDefaultView(BUFFER_VIEW_UNORDERED_ACCESS));
+            if (stage) target->GetStaticVariableByName(SHADER_TYPE_COMPUTE, "DisplayPixels")->Set(tileIndices->GetDefaultView(BUFFER_VIEW_UNORDERED_ACCESS));
+            target->CreateShaderResourceBinding(&binding, true);
+        }
+    }
+
+    ~Impl()
+    {
+        if (context) context->WaitForIdle();
+    }
+
+    void Enqueue(const DrawParams &draw, const GSContext &ctx)
+    {
+        if (!uploaded) throw std::logic_error("Upload GS VRAM before drawing");
+        const auto &a = batchContext.scissor;
+        const auto &b = ctx.scissor;
+        const uint32_t preserved = PreservedIndexBits(ctx);
+        const bool feedback = (draw.mode[1] & 64u) != 0;
+        // Ordinary mask changes may share a batch. A palette-proven feedback
+        // draw requires EVERY draw in that dispatch to preserve its index bits,
+        // including earlier draws with different masks and later non-textured ones.
+        const bool indexCompatible = (!feedback || batchPreservedIndexBits == 0x7f000000u) &&
+            (!batchIndexFeedback || preserved == 0x7f000000u);
+        const bool compatible = batchContext.frame.fbp == ctx.frame.fbp && batchContext.frame.fbw == ctx.frame.fbw &&
+            indexCompatible &&
+            a.x0 == b.x0 && a.x1 == b.x1 && a.y0 == b.y0 && a.y1 == b.y1 &&
+            (queued.empty() || (queued.front().depth1[2] == draw.depth1[2] &&
+                (queued.front().depth1[3] & ~64u) == (draw.depth1[3] & ~64u)));
+        const bool isolated = !NonAliasingFrame(ctx);
+        if (!compatible || isolated || queued.size() == BatchCapacity) Flush();
+        if (queued.empty())
+        {
+            batchContext = ctx;
+            batchPreservedIndexBits = preserved;
+            batchIndexFeedback = feedback;
+        }
+        else
+        {
+            batchPreservedIndexBits &= preserved;
+            batchIndexFeedback |= feedback;
+        }
+        queued.push_back(draw); // Owned packet; callers may immediately reuse theirs.
+        ++stats.submitted;
+        stats.peakQueued = std::max(stats.peakQueued, uint32_t(queued.size()));
+        if (isolated) Flush(); // Constant clear remains safe even when addresses alias.
+    }
+
+    void Flush()
+    {
+        if (queued.empty()) return;
+        // Each tile has its own first command. Mark every command so every
+        // tile uses atomic Z24 access if any draw in this dispatch reads its
+        // upper byte, including tiles containing only untextured depth writes.
+        uint32_t atomicDepth = 0;
+        for (const auto &draw : queued) atomicDepth |= (draw.mode[1] & 32u) | ((draw.mode[1] & 64u) ? 128u : 0u);
+        if (atomicDepth) for (auto &draw : queued) draw.mode[1] |= atomicDepth;
+        uint32_t minX = 127, minY = 127, maxX = 0, maxY = 0;
+        for (const auto &draw : queued)
+        {
+            minX = std::min(minX, draw.rect[0] / 16); minY = std::min(minY, draw.rect[1] / 16);
+            maxX = std::max(maxX, draw.rect[2] / 16); maxY = std::max(maxY, draw.rect[3] / 16);
+        }
+        const uint32_t columns = maxX - minX + 1;
+        const uint32_t rows = maxY - minY + 1;
+        std::vector<uint16_t> counts(columns * rows, 0); // At most 128 commands per tile.
+        std::vector<uint32_t> cursor(counts.size());
+        auto visit = [&](const DrawParams &draw, auto fn)
+        {
+            for (uint32_t y = draw.rect[1] / 16; y <= draw.rect[3] / 16; ++y)
+                for (uint32_t x = draw.rect[0] / 16; x <= draw.rect[2] / 16; ++x)
+                    fn((y - minY) * columns + x - minX);
+        };
+        for (const auto &draw : queued) visit(draw, [&](uint32_t tile) { ++counts[tile]; });
+        std::vector<std::array<uint32_t, 2>> headers;
+        headers.reserve(counts.size());
+        uint32_t total = 0;
+        for (uint32_t tile = 0; tile < counts.size(); ++tile)
+        {
+            cursor[tile] = total;
+            // 7 bits per tile coordinate and 8 bits for the command count.
+            if (counts[tile]) headers.push_back({(minX + tile % columns) |
+                ((minY + tile / columns) << 7) | (uint32_t(counts[tile]) << 14), total});
+            total += counts[tile];
+        }
+        if (total > MaxTileReferences) throw std::logic_error("GS tile reference capacity invariant violated");
+        std::vector<uint32_t> indices((total + 3) / 4, 0);
+        // Append in original GS order within EVERY tile. One thread owns a
+        // physical framebuffer pixel through the batch; textures cannot alias it.
+        for (uint32_t i = 0; i < queued.size(); ++i)
+            visit(queued[i], [&](uint32_t tile)
+            {
+                const uint32_t position = cursor[tile]++;
+                indices[position >> 2] |= i << ((position & 3) * 8);
+            });
+        context->UpdateBuffer(commands, 0, queued.size() * sizeof(DrawParams), queued.data(), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        context->UpdateBuffer(tileHeaders, 0, headers.size() * sizeof(headers[0]), headers.data(), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        context->UpdateBuffer(tileIndices, 0, indices.size() * sizeof(uint32_t), indices.data(), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        // UAV -> UAV explicitly orders overlapping successive GS operations.
+        StateTransitionDesc barrier{vram, RESOURCE_STATE_UNKNOWN, RESOURCE_STATE_UNORDERED_ACCESS, STATE_TRANSITION_FLAG_UPDATE_STATE};
+        context->TransitionResourceStates(1, &barrier);
+        context->SetPipelineState(pipeline);
+        context->CommitShaderResources(resources, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        DispatchComputeAttribs dispatch;
+        dispatch.ThreadGroupCountX = uint32_t(headers.size());
+        context->DispatchCompute(dispatch);
+        ++stats.dispatches;
+        stats.tiles += headers.size();
+        stats.references += total;
+        queued.clear();
+    }
+};
+
+GSDiligentDevice::GSDiligentDevice(Api api) : m_impl(std::make_unique<Impl>(api)) {}
+GSDiligentDevice::~GSDiligentDevice() = default;
+const std::string &GSDiligentDevice::AdapterName() const { return m_impl->adapter; }
+bool GSDiligentDevice::SupportsDepth() const { return m_impl->depthSupported; }
+GSDiligentDevice::BufferMemory GSDiligentDevice::GetBufferMemory() const
+{
+    const auto &p = *m_impl;
+    return {p.vram->GetDesc().Size, p.staging->GetDesc().Size + (p.displayStaging ? p.displayStaging->GetDesc().Size : 0) +
+        (p.pageStaging ? p.pageStaging->GetDesc().Size : 0), p.offsets->GetDesc().Size,
+        p.commands->GetDesc().Size, p.tileHeaders->GetDesc().Size, p.tileIndices->GetDesc().Size};
+}
+GSDiligentDevice::BatchStats GSDiligentDevice::GetBatchStats() const { return m_impl->stats; }
+void GSDiligentDevice::Flush() { m_impl->Flush(); }
+
+void GSDiligentDevice::WaitForCompletion()
+{
+    auto &p = *m_impl;
+    p.Flush();
+    if (!p.uploaded) return;
+    if (p.blockingReadbackMap)
+    {
+        // D3D11 orders this tiny copy after prior UAV writes. Blocking Map
+        // waits in the driver, avoiding sleep-based query polling. The copied
+        // word is discarded; host VRAM ownership/coherence does not change.
+        p.context->CopyBuffer(p.vram, 0, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+            p.staging, 0, sizeof(uint32_t), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        void *mapped = nullptr;
+        p.context->MapBuffer(p.staging, MAP_READ, MAP_FLAG_NONE, mapped);
+        if (!mapped) throw std::runtime_error("GPU completion mapping failed");
+        p.context->UnmapBuffer(p.staging, MAP_READ);
+    }
+    else p.context->WaitForIdle();
+    p.context->FinishFrame();
+    p.device->ReleaseStaleResources();
+}
+
+bool GSDiligentDevice::CopyLocal(const GSTransferCommand &command, bool validateOnly)
+{
+    const auto &b = command.bitbltbuf; const auto &r = command.trxreg; const auto &p = command.trxpos;
+    const auto supported = [](uint32_t psm)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT32: case GS_PSM_CT24: case GS_PSM_CT16: case GS_PSM_CT16S:
+        case GS_PSM_Z32: case GS_PSM_Z24: case GS_PSM_Z16: case GS_PSM_Z16S:
+        case GS_PSM_T8: case GS_PSM_T4: case GS_PSM_T8H: case GS_PSM_T4HL: case GS_PSM_T4HH: return true;
+        default: return false;
+        }
+    };
+    if (command.direction != 2 || !supported(b.spsm) || !supported(b.dpsm) ||
+        b.sbp > 16383 || b.dbp > 16383 || b.sbw > 63 || b.dbw > 63 ||
+        p.ssax > 2047 || p.ssay > 2047 || p.dsax > 2047 || p.dsay > 2047 || p.dir > 3 ||
+        r.rrw > 4095 || r.rrh > 4095 || uint32_t(r.rrw) * r.rrh > 4096) return false;
+    if (validateOnly || !r.rrw || !r.rrh) return true;
+    auto &impl = *m_impl;
+    if (!impl.uploaded) throw std::logic_error("Upload GS VRAM before copying");
+    impl.Flush();
+    DrawParams copy{};
+    copy.frame[0] = b.sbp; copy.frame[1] = std::max(uint32_t(b.sbw), 1u); copy.frame[2] = b.spsm;
+    copy.texture[0] = b.dbp; copy.texture[1] = std::max(uint32_t(b.dbw), 1u); copy.texture[2] = b.dpsm;
+    copy.rect[0] = p.ssax; copy.rect[1] = p.ssay; copy.rect[2] = p.dsax; copy.rect[3] = p.dsay;
+    copy.mode[0] = r.rrw; copy.mode[1] = r.rrh; copy.mode[2] = p.dir;
+    impl.context->UpdateBuffer(impl.commands, 0, sizeof(copy), &copy, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    StateTransitionDesc barrier{impl.vram, RESOURCE_STATE_UNKNOWN, RESOURCE_STATE_UNORDERED_ACCESS, STATE_TRANSITION_FLAG_UPDATE_STATE};
+    impl.context->TransitionResourceStates(1, &barrier);
+    impl.context->SetPipelineState(impl.copyPipeline);
+    impl.context->CommitShaderResources(impl.copyResources, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    impl.context->DispatchCompute(DispatchComputeAttribs{1, 1, 1});
+    return true;
+}
+
+bool GSDiligentDevice::ReadLocalToHost(const GSTransferCommand &command, std::vector<uint8_t> &bytes, bool validateOnly)
+{
+    const auto &b = command.bitbltbuf; const auto &r = command.trxreg; const auto &pos = command.trxpos;
+    uint32_t bits;
+    switch (b.spsm)
+    {
+    case GS_PSM_CT32: case GS_PSM_Z32: bits = 32; break;
+    case GS_PSM_CT24: case GS_PSM_Z24: bits = 24; break;
+    case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: bits = 16; break;
+    case GS_PSM_T8: case GS_PSM_T8H: bits = 8; break;
+    case GS_PSM_T4: case GS_PSM_T4HL: case GS_PSM_T4HH: bits = 4; break;
+    default: return false;
+    }
+    const uint32_t count = uint32_t(r.rrw) * r.rrh;
+    if (command.direction != 1 || b.sbp > 16383 || b.sbw > 63 || pos.ssax > 2047 || pos.ssay > 2047 ||
+        r.rrw > 4095 || r.rrh > 4095 || count > 4096) return false;
+    if (validateOnly) return true;
+    bytes.assign((count * bits + 7) / 8, 0);
+    if (!count) return true;
+    auto &p = *m_impl;
+    if (!p.uploaded) throw std::logic_error("Upload GS VRAM before reading");
+    p.Flush();
+    DrawParams read{};
+    read.frame[0] = b.sbp; read.frame[1] = std::max(uint32_t(b.sbw), 1u); read.frame[2] = b.spsm;
+    read.rect[0] = pos.ssax; read.rect[1] = pos.ssay; read.rect[2] = r.rrw; read.rect[3] = r.rrh;
+    p.context->UpdateBuffer(p.commands, 0, sizeof(read), &read, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    StateTransitionDesc barrier{p.vram, RESOURCE_STATE_UNKNOWN, RESOURCE_STATE_UNORDERED_ACCESS, STATE_TRANSITION_FLAG_UPDATE_STATE};
+    p.context->TransitionResourceStates(1, &barrier);
+    p.context->SetPipelineState(p.readPipeline);
+    p.context->CommitShaderResources(p.readResources, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    p.context->DispatchCompute(DispatchComputeAttribs{(count + 63) / 64, 1, 1});
+    p.context->CopyBuffer(p.tileIndices, 0, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+        p.staging, 0, count * 4, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    if (!p.blockingReadbackMap) p.context->WaitForIdle();
+    void *mapped = nullptr;
+    p.context->MapBuffer(p.staging, MAP_READ, p.blockingReadbackMap ? MAP_FLAG_NONE : MAP_FLAG_DO_NOT_WAIT, mapped);
+    if (!mapped) throw std::runtime_error("GPU raw readback mapping failed");
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        uint32_t value; std::memcpy(&value, static_cast<const uint8_t *>(mapped) + i * 4, 4);
+        if (bits == 4) bytes[i / 2] |= uint8_t((value & 15) << ((i & 1) * 4));
+        else for (uint32_t byte = 0; byte < bits / 8; ++byte) bytes[i * (bits / 8) + byte] = uint8_t(value >> (byte * 8));
+    }
+    p.context->UnmapBuffer(p.staging, MAP_READ);
+    p.context->FinishFrame(); p.device->ReleaseStaleResources();
+    return true;
+}
+
+void GSDiligentDevice::UploadVram(std::span<const uint8_t> bytes)
+{
+    if (bytes.size() != VramBytes) throw std::invalid_argument("GS VRAM must be exactly 4 MiB");
+    m_impl->Flush();
+    m_impl->context->UpdateBuffer(m_impl->vram, 0, VramBytes, bytes.data(), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    m_impl->uploaded = true;
+}
+
+void GSDiligentDevice::DownloadVram(std::span<uint8_t> bytes)
+{
+    if (bytes.size() != VramBytes) throw std::invalid_argument("GS readback must be exactly 4 MiB");
+    if (!m_impl->uploaded) throw std::logic_error("GS VRAM has not been initialized");
+    auto &p = *m_impl;
+    p.Flush();
+    p.context->CopyBuffer(p.vram, 0, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+        p.staging, 0, VramBytes, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    // D3D11's blocking staging Map waits for this copy in the driver. Avoid
+    // WaitForIdle's sleep-based query polling: a 1-us sleep can become an
+    // entire Windows scheduler tick. Other APIs require explicit completion
+    // before mapping; never apply the D3D11 implicit-sync rule to them.
+    if (!p.blockingReadbackMap) p.context->WaitForIdle();
+    void *mapped = nullptr;
+    p.context->MapBuffer(p.staging, MAP_READ,
+        p.blockingReadbackMap ? MAP_FLAG_NONE : MAP_FLAG_DO_NOT_WAIT, mapped);
+    if (!mapped) throw std::runtime_error("GPU readback mapping failed");
+    std::memcpy(bytes.data(), mapped, VramBytes);
+    p.context->UnmapBuffer(p.staging, MAP_READ);
+    p.context->FinishFrame();
+    p.device->ReleaseStaleResources();
+}
+
+void GSDiligentDevice::DownloadVramPages(std::span<uint8_t> bytes, std::span<const uint16_t> pages)
+{
+    if (bytes.size() != VramBytes || pages.size() > 512 ||
+        std::any_of(pages.begin(), pages.end(), [](uint16_t page) { return page >= 512; }))
+        throw std::invalid_argument("Invalid GS page readback");
+    if (pages.empty()) return;
+    auto &p = *m_impl;
+    if (!p.uploaded) throw std::logic_error("Upload GS VRAM before reading pages");
+    p.Flush();
+    for (size_t i = 0; i < pages.size();)
+    {
+        size_t count = 1;
+        while (i + count < pages.size() && pages[i + count] == uint32_t(pages[i]) + count) ++count;
+        p.context->CopyBuffer(p.vram, uint32_t(pages[i]) * 8192, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+            p.staging, i * 8192, count * 8192, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        i += count;
+    }
+    if (!p.blockingReadbackMap) p.context->WaitForIdle();
+    void *mapped = nullptr;
+    p.context->MapBuffer(p.staging, MAP_READ, p.blockingReadbackMap ? MAP_FLAG_NONE : MAP_FLAG_DO_NOT_WAIT, mapped);
+    if (!mapped) throw std::runtime_error("GPU page readback mapping failed");
+    for (size_t i = 0; i < pages.size(); ++i)
+        std::memcpy(bytes.data() + uint32_t(pages[i]) * 8192, static_cast<const uint8_t *>(mapped) + i * 8192, 8192);
+    p.context->UnmapBuffer(p.staging, MAP_READ);
+    p.context->FinishFrame(); p.device->ReleaseStaleResources();
+}
+
+void GSDiligentDevice::PrefetchVramRegion(uint16_t firstPage)
+{
+    auto &p = *m_impl;
+    if (firstPage >= 512 || (firstPage & 7)) throw std::invalid_argument("Invalid GS prefetch region");
+    if (!p.uploaded) throw std::logic_error("Upload GS VRAM before prefetching");
+    if (!p.pageStaging)
+    {
+        BufferDesc desc;
+        desc.Name = "PS2 pending depth pages"; desc.Size = 65536;
+        desc.Usage = USAGE_STAGING; desc.CPUAccessFlags = CPU_ACCESS_READ;
+        p.device->CreateBuffer(desc, nullptr, &p.pageStaging);
+        FenceDesc fence; fence.Name = "PS2 depth page completion";
+        p.device->CreateFence(fence, &p.pageFence);
+        if (!p.pageStaging || !p.pageFence) throw std::runtime_error("GPU page prefetch allocation failed");
+    }
+    p.Flush();
+    p.context->CopyBuffer(p.vram, uint32_t(firstPage) * 8192, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+        p.pageStaging, 0, 65536, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    p.context->EnqueueSignal(p.pageFence, ++p.pageSerial);
+    p.context->Flush(); // Start the copy while the CPU executes later guest work.
+    p.pageFirst = firstPage;
+}
+
+bool GSDiligentDevice::ReadPrefetchedVramPages(std::span<uint8_t> bytes, std::span<const uint16_t> pages)
+{
+    auto &p = *m_impl;
+    if (bytes.size() != VramBytes || pages.empty() || p.pageFirst >= 512 ||
+        std::any_of(pages.begin(), pages.end(), [&](uint16_t page)
+            { return page < p.pageFirst || page >= p.pageFirst + 8; })) return false;
+    // Only the captured copy must finish, not all graphics submitted since it.
+    // D3D11's staging Map avoids its fence implementation's sleep polling.
+    if (!p.blockingReadbackMap)
+    {
+        p.pageFence->Wait(p.pageSerial);
+        // The pinned Diligent D3D12 implementation uses a manual-reset event
+        // without resetting it between waits. A later Wait can return before
+        // this copy completes. The completed fence value is authoritative.
+        // Retain the ordinary wait and sleep only on that premature-return
+        // path; do not spin or idle unrelated work on the graphics queue.
+        if (p.pageFence->GetCompletedValue() < p.pageSerial)
+        {
+            ++gs_prefetch_diagnostics::earlyFenceWaitReturns;
+            do { std::this_thread::sleep_for(std::chrono::microseconds(50)); }
+            while (p.pageFence->GetCompletedValue() < p.pageSerial);
+        }
+    }
+    void *mapped = nullptr;
+    p.context->MapBuffer(p.pageStaging, MAP_READ, p.blockingReadbackMap ? MAP_FLAG_NONE : MAP_FLAG_DO_NOT_WAIT, mapped);
+    if (!mapped) throw std::runtime_error("GPU prefetched page mapping failed");
+    for (const uint16_t page : pages)
+        std::memcpy(bytes.data() + uint32_t(page) * 8192,
+            static_cast<const uint8_t *>(mapped) + uint32_t(page - p.pageFirst) * 8192, 8192);
+    p.context->UnmapBuffer(p.pageStaging, MAP_READ);
+    return true;
+}
+
+void GSDiligentDevice::DiscardPendingPresentation()
+{
+    // The buffer stays alive. Later queued copies remain ordered after any
+    // cancelled copy; cancellation does not pretend guest work has completed.
+    m_impl->displayPending = false;
+}
+
+PresentationFrame GSDiligentDevice::PollPresentation(std::vector<uint8_t> *recycled)
+{
+    auto &p = *m_impl;
+    if (!p.displayPending) return {};
+    PresentationFrame result;
+    result.pending = true;
+    if (p.displayFence->GetCompletedValue() < p.displaySerial) return result;
+    constexpr uint32_t HostBytes = 640u * 512u * 4u;
+    const auto &d = p.pendingDisplay;
+    void *mapped = nullptr;
+    p.context->MapBuffer(p.displayStaging, MAP_READ, MAP_FLAG_DO_NOT_WAIT, mapped);
+    if (!mapped) return result;
+    struct UnmapDisplay
+    {
+        IDeviceContext *context;
+        IBuffer *buffer;
+        ~UnmapDisplay() { context->UnmapBuffer(buffer, MAP_READ); }
+    } unmap{p.context.RawPtr(), p.displayStaging.RawPtr()};
+    if (recycled) result.pixels.swap(*recycled);
+    result.pixels.assign(HostBytes, 0);
+    const auto *bytes = static_cast<const uint8_t *>(mapped);
+    for (uint32_t y = 0; y < d.height; ++y)
+        std::memcpy(result.pixels.data() + y * 640u * 4u, bytes + y * d.width * 4u, d.width * 4u);
+    unsigned selected = d.first;
+    for (unsigned i = d.first; i < d.first + d.count; ++i)
+    {
+        uint32_t nonBlack; std::memcpy(&nonBlack, bytes + HostBytes + i * 8, 4);
+        if (nonBlack) { selected = i; break; }
+    }
+    result.width = d.width; result.height = d.height;
+    result.displayFbp = d.displayFbp; result.sourceFbp = d.sourceFbp[selected];
+    result.usedPreferred = d.preferred; result.pending = false;
+    p.displayPending = false;
+    return result;
+}
+
+PresentationFrame GSDiligentDevice::Present(const GSPresentationRequest &request, bool deferred, std::vector<uint8_t> *recycled)
+{
+    constexpr uint32_t HostBytes = 640u * 512u * 4u;
+    struct Circuit { GSFrameReg frame{}; uint32_t x, y, width, height; bool valid; };
+    const auto circuit = [](uint64_t fb, uint64_t display, bool enabled)
+    {
+        Circuit c{};
+        c.frame = {uint32_t(fb & 511), uint32_t((fb >> 9) & 63), uint8_t((fb >> 15) & 31), 0};
+        c.x = uint32_t((fb >> 32) & 2047); c.y = uint32_t((fb >> 43) & 2047);
+        const uint32_t dw = uint32_t((display >> 32) & 4095), dh = uint32_t((display >> 44) & 2047);
+        const uint32_t magh = uint32_t((display >> 23) & 15);
+        c.width = (dw + 1) / (magh + 1); c.height = dh + 1;
+        if (c.width < 64 || c.height < 64) { c.width = 640; c.height = 448; }
+        c.width = std::min(c.width, 640u); c.height = std::min(c.height, 512u);
+        c.valid = enabled && (c.frame.fbw || dw || dh || magh);
+        return c;
+    };
+    const auto supported = [](const GSFrameReg &f)
+    { return f.psm == GS_PSM_CT32 || f.psm == GS_PSM_CT24 || f.psm == GS_PSM_CT16 || f.psm == GS_PSM_CT16S; };
+    const auto sameFrame = [](const GSFrameReg &a, const GSFrameReg &b)
+    { return a.fbp == b.fbp && a.fbw == b.fbw && a.psm == b.psm; };
+    const auto a = circuit(request.dispfb1, request.display1, (request.pmode & 1) != 0);
+    const auto b = circuit(request.dispfb2, request.display2, (request.pmode & 2) != 0);
+    if (!a.valid && !b.valid) { DiscardPendingPresentation(); return {}; }
+    bool dual = a.valid && b.valid && supported(a.frame) && supported(b.frame);
+    bool allowPreferred = !dual;
+    if (dual && !(request.pmode & 128) && sameFrame(a.frame, b.frame) && a.x == b.x && a.y == b.y &&
+        a.width == b.width && a.height == b.height) dual = false;
+    const auto &first = a.valid ? a : b;
+    std::array<DrawParams, 7> commands{};
+    unsigned sources = 0;
+    bool preferred = false;
+    const auto add = [&](const GSFrameReg &frame, const Circuit &c, bool pages, uint32_t x, uint32_t y)
+    {
+        if (sources >= 6) throw std::logic_error("Display source bound violated");
+        auto &d = commands[++sources];
+        d.frame[0] = pages ? frame.fbp * 32u : frame.fbp;
+        d.frame[1] = frame.fbw ? frame.fbw : 10;
+        d.frame[2] = frame.psm; d.frame[3] = frame.fbp;
+        d.rect[0] = x; d.rect[1] = y; d.rect[2] = c.width; d.rect[3] = c.height;
+    };
+    const auto addCircuit = [&](const Circuit &c, bool allow, uint32_t &start, uint32_t &count)
+    {
+        start = sources;
+        if (allow && request.hasPreferredSource && request.preferredDestFbp == c.frame.fbp &&
+            (request.preferredSource.fbw || request.preferredSource.fbp != c.frame.fbp) && supported(request.preferredSource))
+        { add(request.preferredSource, c, false, 0, 0); preferred = true; }
+        else
+        {
+            if (!supported(c.frame)) return false;
+            add(c.frame, c, true, c.x, c.y);
+            if (c.frame.fbp == 0)
+                for (const auto &candidate : request.contextFrames)
+                    if (supported(candidate) && !sameFrame(candidate, c.frame)) add(candidate, c, true, 0, 0);
+        }
+        count = sources - start;
+        if (count > 1)
+            for (unsigned i = start; i < start + count; ++i) commands[i + 1].mode[0] = 1;
+        return true;
+    };
+    auto &control = commands[0];
+    if (!addCircuit(first, allowPreferred, control.frame[2], control.frame[3])) { DiscardPendingPresentation(); return {}; }
+    if (dual && !addCircuit(b, false, control.rect[0], control.rect[1])) { DiscardPendingPresentation(); return {}; }
+    const uint32_t width = dual ? std::max(a.width, b.width) : first.width;
+    const uint32_t height = dual ? std::max(a.height, b.height) : first.height;
+    control.frame[0] = width; control.frame[1] = height; control.rect[2] = dual;
+    control.rect[3] = uint32_t((request.smode2 & 3) == 1 && !request.progressiveFieldPresentation) |
+        (uint32_t(request.vsyncTick & 1) << 1);
+    control.mode[0] = uint32_t((request.pmode >> 8) & 255);
+    control.mode[1] = uint32_t((request.pmode >> 5) & 1);
+    control.mode[2] = uint32_t((request.pmode >> 7) & 1);
+    control.mode[3] = uint32_t(request.bgcolor);
+    auto &p = *m_impl;
+    if (!p.uploaded) throw std::logic_error("Upload GS VRAM before presentation");
+    PresentationFrame completed;
+    if (deferred)
+    {
+        completed = PollPresentation(recycled);
+        if (completed.pending) return completed; // Never queue unbounded frames.
+        if (!p.displayStaging)
+        {
+            BufferDesc desc;
+            desc.Name = "PS2 pending display"; desc.Size = HostBytes + 48;
+            desc.Usage = USAGE_STAGING; desc.CPUAccessFlags = CPU_ACCESS_READ;
+            p.device->CreateBuffer(desc, nullptr, &p.displayStaging);
+            FenceDesc fence; fence.Name = "PS2 display completion";
+            p.device->CreateFence(fence, &p.displayFence);
+            if (!p.displayStaging || !p.displayFence) throw std::runtime_error("GPU display readback allocation failed");
+        }
+    }
+    else DiscardPendingPresentation();
+    IBuffer *target = deferred ? p.displayStaging.RawPtr() : p.staging.RawPtr();
+    p.Flush();
+    p.context->UpdateBuffer(p.commands, 0, (sources + 1) * sizeof(DrawParams), commands.data(), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    const std::array<uint32_t, 12> zero{};
+    p.context->UpdateBuffer(p.tileHeaders, 0, sizeof(zero), zero.data(), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    StateTransitionDesc vramBarrier{p.vram, RESOURCE_STATE_UNKNOWN, RESOURCE_STATE_UNORDERED_ACCESS, STATE_TRANSITION_FLAG_UPDATE_STATE};
+    p.context->TransitionResourceStates(1, &vramBarrier);
+    const bool scan = std::any_of(commands.begin() + 1, commands.begin() + sources + 1,
+        [](const auto &d) { return d.mode[0] != 0; });
+    if (scan)
+    {
+        p.context->SetPipelineState(p.scanPipeline);
+        p.context->CommitShaderResources(p.scanResources, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        p.context->DispatchCompute(DispatchComputeAttribs{(width + 7) / 8, (height + 7) / 8, sources});
+        StateTransitionDesc flagBarrier{p.tileHeaders, RESOURCE_STATE_UNKNOWN, RESOURCE_STATE_UNORDERED_ACCESS, STATE_TRANSITION_FLAG_UPDATE_STATE};
+        p.context->TransitionResourceStates(1, &flagBarrier);
+    }
+    const uint32_t rowBytes = width * 4, rowsPerChunk = MaxTileReferences / rowBytes;
+    for (uint32_t y = 0; y < height; y += rowsPerChunk)
+    {
+        const uint32_t rows = std::min(rowsPerChunk, height - y);
+        control.wrap[0] = y; control.wrap[1] = rows;
+        p.context->UpdateBuffer(p.commands, 0, sizeof(control), &control, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        p.context->SetPipelineState(p.composePipeline);
+        p.context->CommitShaderResources(p.composeResources, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        p.context->DispatchCompute(DispatchComputeAttribs{(width + 7) / 8, (rows + 7) / 8, 1});
+        p.context->CopyBuffer(p.tileIndices, 0, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+            target, y * rowBytes, rows * rowBytes, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    }
+    p.context->CopyBuffer(p.tileHeaders, 0, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+        target, HostBytes, sizeof(zero), RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    if (deferred)
+    {
+        p.pendingDisplay = {width, height, first.frame.fbp, control.frame[2], control.frame[3], {}, preferred};
+        for (unsigned i = 0; i < sources; ++i) p.pendingDisplay.sourceFbp[i] = commands[i + 1].frame[3];
+        p.context->EnqueueSignal(p.displayFence, ++p.displaySerial);
+        p.context->Flush(); // Submit before polling on a later emulated vsync.
+        p.displayPending = true;
+        p.context->FinishFrame(); p.device->ReleaseStaleResources();
+        if (!completed) completed.pending = true;
+        return completed;
+    }
+    PresentationFrame result;
+    if (recycled) result.pixels.swap(*recycled);
+    result.pixels.assign(HostBytes, 0); result.width = width; result.height = height;
+    result.displayFbp = first.frame.fbp; result.usedPreferred = preferred;
+    if (!p.blockingReadbackMap) p.context->WaitForIdle();
+    void *mapped = nullptr;
+    p.context->MapBuffer(p.staging, MAP_READ, p.blockingReadbackMap ? MAP_FLAG_NONE : MAP_FLAG_DO_NOT_WAIT, mapped);
+    if (!mapped) throw std::runtime_error("GPU composed display mapping failed");
+    const auto *bytes = static_cast<const uint8_t *>(mapped);
+    for (uint32_t y = 0; y < height; ++y) std::memcpy(result.pixels.data() + y * 640u * 4u, bytes + y * rowBytes, rowBytes);
+    unsigned selected = control.frame[2];
+    for (unsigned i = selected; i < control.frame[2] + control.frame[3]; ++i)
+    {
+        uint32_t nonBlack; std::memcpy(&nonBlack, bytes + HostBytes + i * 8, 4);
+        if (nonBlack) { selected = i; break; }
+    }
+    result.sourceFbp = commands[selected + 1].frame[3];
+    p.context->UnmapBuffer(p.staging, MAP_READ);
+    p.context->FinishFrame(); p.device->ReleaseStaleResources();
+    return result;
+}
+
+bool GSDiligentDevice::ReadDisplay(const GSFrameReg &frame, uint32_t width, uint32_t height,
+    std::vector<uint8_t> &pixels, bool preserveAlpha, bool frameBaseIsPages, uint32_t originX, uint32_t originY)
+{
+    pixels.clear();
+    if (!width || width > 640 || !height || height > 512 ||
+        (frame.psm != GS_PSM_CT32 && frame.psm != GS_PSM_CT24 &&
+         frame.psm != GS_PSM_CT16 && frame.psm != GS_PSM_CT16S)) return false;
+    auto &p = *m_impl;
+    if (!p.uploaded) throw std::logic_error("Upload GS VRAM before presentation");
+    p.Flush(); // Tile-index storage is now free until the next draw dispatch.
+    DrawParams display{};
+    display.frame[0] = frameBaseIsPages ? frame.fbp * 32u : frame.fbp;
+    display.frame[1] = frame.fbw ? frame.fbw : 10u;
+    display.frame[2] = frame.psm;
+    display.mode[0] = preserveAlpha;
+    display.rect[0] = originX; display.rect[2] = width;
+    const uint32_t rowBytes = width * 4;
+    const uint32_t rowsPerChunk = MaxTileReferences / rowBytes;
+    // All chunks copy to disjoint staging ranges before the single map/wait.
+    // Resource transitions order scratch reuse after each copy.
+    for (uint32_t y = 0; y < height; y += rowsPerChunk)
+    {
+        const uint32_t rows = std::min(rowsPerChunk, height - y);
+        display.rect[1] = originY + y; display.rect[3] = rows;
+        p.context->UpdateBuffer(p.commands, 0, sizeof(display), &display, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        StateTransitionDesc barrier{p.vram, RESOURCE_STATE_UNKNOWN, RESOURCE_STATE_UNORDERED_ACCESS, STATE_TRANSITION_FLAG_UPDATE_STATE};
+        p.context->TransitionResourceStates(1, &barrier);
+        p.context->SetPipelineState(p.displayPipeline);
+        p.context->CommitShaderResources(p.displayResources, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+        p.context->DispatchCompute(DispatchComputeAttribs{(width + 7) / 8, (rows + 7) / 8, 1});
+        p.context->CopyBuffer(p.tileIndices, 0, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+            p.staging, y * rowBytes, rows * rowBytes, RESOURCE_STATE_TRANSITION_MODE_TRANSITION);
+    }
+    // Allocate before mapping so allocation failure cannot leave a mapped buffer.
+    pixels.assign(640u * 512u * 4u, 0);
+    if (!p.blockingReadbackMap) p.context->WaitForIdle();
+    void *mapped = nullptr;
+    p.context->MapBuffer(p.staging, MAP_READ,
+        p.blockingReadbackMap ? MAP_FLAG_NONE : MAP_FLAG_DO_NOT_WAIT, mapped);
+    if (!mapped) throw std::runtime_error("GPU display mapping failed");
+    for (uint32_t y = 0; y < height; ++y)
+        std::memcpy(pixels.data() + y * 640u * 4u, static_cast<const uint8_t *>(mapped) + y * rowBytes, rowBytes);
+    p.context->UnmapBuffer(p.staging, MAP_READ);
+    p.context->FinishFrame();
+    p.device->ReleaseStaleResources();
+    return true;
+}
+
+bool GSDiligentDevice::ClearFramebuffer(const GSContext &ctx, uint32_t rgba, bool validateOnly)
+{
+    if (!SupportedFrame(ctx)) return false;
+    if (validateOnly) return true;
+    DrawParams draw;
+    draw.frame[0] = ctx.frame.fbp;
+    draw.frame[1] = ctx.frame.fbw;
+    draw.frame[2] = ctx.frame.psm;
+    draw.mode[1] = NonAliasingFrame(ctx) ? 8u : 0u;
+    draw.rect[0] = ctx.scissor.x0; draw.rect[1] = ctx.scissor.y0;
+    draw.rect[2] = ctx.scissor.x1; draw.rect[3] = ctx.scissor.y1;
+    draw.colorMask[0] = rgba | ((ctx.fba & 1) && ctx.frame.psm != GS_PSM_CT24 ? 0x80000000u : 0u);
+    draw.colorMask[1] = ctx.frame.fbmsk;
+    m_impl->Enqueue(draw, ctx);
+    return true;
+}
+
+bool GSDiligentDevice::DrawPrimitive(const GSPrimitiveBatch &batch, bool validateOnly, const char **rejection,
+    std::span<const uint8_t> coherentPaletteVram)
+{
+    if (rejection) *rejection = nullptr;
+    const auto reject = [&](const char *reason) { if (rejection) *rejection = reason; return false; };
+    const auto &s = batch.state;
+    const auto &ctx = s.context;
+    const bool sprite = s.prim.type == GS_PRIM_SPRITE;
+    // Unsupported states retain ordered CPU handling.
+    if (!SupportedFrame(ctx) || !NonAliasingFrame(ctx) || batch.vertexCount != (sprite ? 2 : 3) ||
+        (!sprite && s.prim.type != GS_PRIM_TRIANGLE && s.prim.type != GS_PRIM_TRISTRIP && s.prim.type != GS_PRIM_TRIFAN) ||
+        (!sprite && s.prim.aa1) || s.scanmsk || s.dthe)
+        return reject("layout_or_raster_state");
+    const uint32_t depthMethod = (ctx.test >> 17) & 3;
+    if (depthMethod == 0) return true; // NEVER makes every pixel a no-op, as in the CPU renderer.
+    const bool depthActive = depthMethod >= 2 || !ctx.zbuf.zmask;
+    if (depthActive && (!m_impl->depthSupported || ctx.zbuf.zbp > 511 ||
+        (ctx.zbuf.psm != GS_PSM_Z32 && ctx.zbuf.psm != GS_PSM_Z24 &&
+         ctx.zbuf.psm != GS_PSM_Z16 && ctx.zbuf.psm != GS_PSM_Z16S) || !m_impl->DepthDisjoint(ctx))) return reject("depth_layout_or_overlap");
+    DrawParams draw;
+    bool refineSpriteFootprint = false;
+    bool ignoreT8HighBit = false;
+    if (depthActive)
+    {
+        double minZ = batch.vertices[sprite ? 1 : 0].z, maxZ = minZ;
+        for (unsigned i = sprite ? 1 : 0; i < (sprite ? 2u : 3u); ++i)
+        {
+            const auto &v = batch.vertices[i];
+            if (!std::isfinite(v.z) || v.z < 0 || v.z > 4294967295.0) return reject("depth_range");
+            minZ = std::min(minZ, v.z); maxZ = std::max(maxZ, v.z);
+        }
+        // Edge epsilon admits slightly negative barycentric weights. Bound
+        // their extrapolation and float weight-sum error before uint conversion.
+        const double margin = 0.0002 * (maxZ - minZ) + 0.000001 * maxZ;
+        if (!sprite && (minZ - margin < -0.5 || maxZ + margin >= 4294967295.5)) return reject("depth_edge_range");
+        const auto z0 = std::bit_cast<uint64_t>(batch.vertices[0].z);
+        const auto z1 = std::bit_cast<uint64_t>(batch.vertices[1].z);
+        const auto z2 = std::bit_cast<uint64_t>(batch.vertices[2].z);
+        draw.depth0[0] = sprite ? uint32_t(batch.vertices[1].z) : uint32_t(z0); draw.depth0[1] = sprite ? 0 : uint32_t(z0 >> 32);
+        draw.depth0[2] = uint32_t(z1); draw.depth0[3] = uint32_t(z1 >> 32);
+        draw.depth1[0] = uint32_t(z2); draw.depth1[1] = uint32_t(z2 >> 32);
+        draw.depth1[2] = ctx.zbuf.zbp;
+        draw.depth1[3] = ctx.zbuf.psm | 128u | (ctx.zbuf.zmask ? 0u : 64u);
+    }
+    draw.frame[0] = ctx.frame.fbp; draw.frame[1] = ctx.frame.fbw;
+    draw.frame[2] = ctx.frame.psm; draw.frame[3] = sprite ? 2 : 1;
+    draw.mode[1] = 8u | ((ctx.fba & 1) ? 16u : 0u);
+    draw.colors[3] = (!sprite && s.prim.iip ? 1u : 0u) | (s.prim.fge ? 2u : 0u) |
+        (s.prim.abe ? 4u : 0u) | (s.pabe ? 8u : 0u);
+    draw.pixelState[0] = uint32_t(ctx.test);
+    draw.pixelState[1] = uint32_t(ctx.alpha) & 255;
+    draw.pixelState[2] = uint32_t(ctx.alpha >> 32) & 255;
+    draw.pixelState[3] = uint32_t(s.fogR) | uint32_t(s.fogG) << 8 | uint32_t(s.fogB) << 16;
+    if (s.prim.tme)
+    {
+        const auto &tex = ctx.tex0;
+        if ((!SupportedColorTexture(tex.psm) && !IsPalette(tex.psm)) || tex.tbp0 > 16383 ||
+            tex.tbw == 0 || tex.tbw > 63 || tex.tfx > 3 || tex.tcc > 1 ||
+            s.textureWidth == 0 || s.textureWidth > 1024 || s.textureHeight == 0 || s.textureHeight > 1024 ||
+            (s.textureWidth & (s.textureWidth - 1)) || (s.textureHeight & (s.textureHeight - 1)) ||
+            (IsPalette(tex.psm) && (!SupportedColorTexture(tex.cpsm) || tex.cbp > 16383 ||
+                tex.csm > 1 || tex.csa > 31 || s.texclut.cbw > 63 || s.texclut.cou > 63 || s.texclut.cov > 1023))) return reject("texture_layout");
+        if (m_impl->TextureAliases(s, depthActive))
+        {
+            ignoreT8HighBit = T8PaletteIgnoresHighBit(s, coherentPaletteVram) &&
+                !TextureMayAliasFrame(s, depthActive, nullptr, true);
+            if (!ignoreT8HighBit)
+            {
+                if (!sprite) return reject("texture_or_palette_overlap");
+                refineSpriteFootprint = true;
+            }
+        }
+        draw.palette[0] = tex.cbp; draw.palette[1] = tex.cpsm;
+        draw.palette[2] = tex.csm;
+        const bool palette16 = tex.cpsm == GS_PSM_CT16 || tex.cpsm == GS_PSM_CT16S;
+        draw.palette[3] = ((uint32_t(tex.csa) & (palette16 ? 31u : 15u)) << 20) | (palette16 ? 511u : 255u);
+        draw.paletteLayout[0] = std::max(uint32_t(s.texclut.cbw), 1u);
+        draw.paletteLayout[1] = s.texclut.cou; draw.paletteLayout[2] = s.texclut.cov;
+        draw.paletteLayout[3] = s.texa.ta1;
+        draw.texture[0] = tex.tbp0; draw.texture[1] = tex.tbw;
+        draw.texture[2] = s.textureWidth; draw.texture[3] = s.textureHeight;
+        draw.mode[0] = tex.psm;
+        draw.mode[1] |= 1u | (s.prim.fst ? 2u : 0u) | (s.linearFilter ? 4u : 0u);
+        if (ignoreT8HighBit) draw.mode[1] |= 64u;
+        if (depthActive && ctx.zbuf.psm == GS_PSM_Z24 &&
+            (tex.psm == GS_PSM_T8H || tex.psm == GS_PSM_T4HL || tex.psm == GS_PSM_T4HH))
+            draw.mode[1] |= 32u;
+        draw.mode[2] = tex.tfx; draw.mode[3] = tex.tcc;
+        draw.wrap[0] = ctx.clamp & 3; draw.wrap[1] = (ctx.clamp >> 2) & 3;
+        draw.wrap[2] = (ctx.clamp >> 4) & 1023; draw.wrap[3] = (ctx.clamp >> 14) & 1023;
+        draw.wrapMore[0] = (ctx.clamp >> 24) & 1023; draw.wrapMore[1] = (ctx.clamp >> 34) & 1023;
+        draw.wrapMore[2] = s.texa.ta0; draw.wrapMore[3] = s.texa.aem;
+        for (unsigned i = 0; i < (sprite ? 2u : 3u); ++i)
+        {
+            const auto &v = batch.vertices[i];
+            if (s.prim.fst)
+            {
+                draw.texcoords[i][0] = float(sprite ? v.u >> 4 : v.u); draw.texcoords[i][1] = float(sprite ? v.v >> 4 : v.v);
+            }
+            else
+            {
+                // Bounded same-sign Q avoids pole crossings / undefined float
+                // to integer conversion. Unsupported numbers retain CPU handling.
+                if (!std::isfinite(v.s) || !std::isfinite(v.t) || !std::isfinite(v.q) ||
+                    std::abs(v.s) > 64 || std::abs(v.t) > 64 || std::abs(v.q) < MinimumTextureQ ||
+                    std::abs(v.q) > 1024 || (!sprite && std::signbit(v.q) != std::signbit(batch.vertices[0].q))) return reject("texture_coordinates");
+                draw.texcoords[i][0] = sprite ? (v.s / v.q) * float(s.textureWidth) : v.s;
+                draw.texcoords[i][1] = sprite ? (v.t / v.q) * float(s.textureHeight) : v.t;
+                draw.texcoords[i][2] = v.q;
+            }
+        }
+        if (!sprite && !s.prim.fst)
+        {
+            const float minQ = std::min({std::abs(batch.vertices[0].q), std::abs(batch.vertices[1].q), std::abs(batch.vertices[2].q)});
+            const float maxQ = std::max({std::abs(batch.vertices[0].q), std::abs(batch.vertices[1].q), std::abs(batch.vertices[2].q)});
+            if (minQ - 0.0002f * maxQ < MinimumTextureQ) return reject("texture_edge_range"); // Include edge epsilon extrapolation.
+        }
+    }
+    for (unsigned i = 0; i < 3; ++i)
+    {
+        const auto &vertex = batch.vertices[sprite ? std::min(i, 1u) : i];
+        const float x = vertex.x - float(ctx.xyoffset.ofx >> 4);
+        const float y = vertex.y - float(ctx.xyoffset.ofy >> 4);
+        if (!std::isfinite(x) || !std::isfinite(y) || std::abs(x) > 4096 || std::abs(y) > 4096) return reject("vertex_range");
+        draw.vertices[i][0] = x; draw.vertices[i][1] = y;
+        draw.colors[i] = uint32_t(vertex.r) | uint32_t(vertex.g) << 8 |
+            uint32_t(vertex.b) << 16 | uint32_t(vertex.a) << 24;
+        draw.texcoords[i][3] = float(vertex.fog);
+    }
+    if (sprite)
+    {
+        const auto &a = batch.vertices[0], &b = batch.vertices[1];
+        int x0 = int(a.x) - int(ctx.xyoffset.ofx >> 4), y0 = int(a.y) - int(ctx.xyoffset.ofy >> 4);
+        int x1 = int(b.x) - int(ctx.xyoffset.ofx >> 4), y1 = int(b.y) - int(ctx.xyoffset.ofy >> 4);
+        if (x0 > x1) std::swap(x0, x1);
+        if (y0 > y1) std::swap(y0, y1);
+        const int spanX = std::max(1, x1 - x0), spanY = std::max(1, y1 - y0);
+        x1 = x0 + spanX - 1; y1 = y0 + spanY - 1;
+        if (x1 < ctx.scissor.x0 || x0 > ctx.scissor.x1 || y1 < ctx.scissor.y0 || y0 > ctx.scissor.y1) return true;
+        draw.vertices[0][0] = float(x0); draw.vertices[0][1] = float(y0);
+        draw.vertices[1][0] = float(spanX); draw.vertices[1][1] = float(spanY);
+        draw.rect[0] = std::max(x0, int(ctx.scissor.x0)); draw.rect[1] = std::max(y0, int(ctx.scissor.y0));
+        draw.rect[2] = std::min(x1, int(ctx.scissor.x1)); draw.rect[3] = std::min(y1, int(ctx.scissor.y1));
+        draw.colorMask[0] = uint32_t(b.r) | uint32_t(b.g) << 8 | uint32_t(b.b) << 16 | uint32_t(b.a) << 24;
+        draw.colorMask[1] = ctx.frame.fbmsk;
+        if (refineSpriteFootprint && !SpriteTextureDisjoint(s, draw, depthActive)) return reject("sprite_texture_or_palette_overlap");
+        if (!validateOnly) m_impl->Enqueue(draw, ctx);
+        return true;
+    }
+    auto &v = draw.vertices;
+    const float denom = (v[1][1] - v[2][1]) * (v[0][0] - v[2][0]) + (v[2][0] - v[1][0]) * (v[0][1] - v[2][1]);
+    if (std::abs(denom) < 0.001f) return true;
+    // Constant for the whole triangle. Precompute once using the same host
+    // expression as the CPU reference instead of a GPU reciprocal per pixel.
+    draw.vertices[0][2] = 1.0f / std::abs(denom);
+    draw.vertices[0][3] = denom < 0 ? -1.0f : 1.0f;
+    draw.rect[0] = std::clamp(int(std::floor(std::min({v[0][0], v[1][0], v[2][0]}))), int(ctx.scissor.x0), int(ctx.scissor.x1));
+    draw.rect[1] = std::clamp(int(std::floor(std::min({v[0][1], v[1][1], v[2][1]}))), int(ctx.scissor.y0), int(ctx.scissor.y1));
+    draw.rect[2] = std::clamp(int(std::ceil(std::max({v[0][0], v[1][0], v[2][0]}))), int(ctx.scissor.x0), int(ctx.scissor.x1));
+    draw.rect[3] = std::clamp(int(std::ceil(std::max({v[0][1], v[1][1], v[2][1]}))), int(ctx.scissor.y0), int(ctx.scissor.y1));
+    const auto &last = batch.vertices[2];
+    draw.colorMask[0] = uint32_t(last.r) | uint32_t(last.g) << 8 | uint32_t(last.b) << 16 | uint32_t(last.a) << 24;
+    draw.colorMask[1] = ctx.frame.fbmsk;
+    if (validateOnly) return true;
+    m_impl->Enqueue(draw, ctx);
+    return true;
+}
