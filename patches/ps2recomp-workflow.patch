+uint32_t VU1Interpreter::normalizeFmacCombined(float *result, uint8_t dest, uint8_t laneFlags[4])
+{
+    const uint32_t upper = m_currentUpperInstruction;
+    const uint8_t op = upper & 0x3fu;
+    const uint8_t arithmetic = op >= 0x3cu ? (upper & 3u) | ((upper >> 4) & 0x7cu) : op;
