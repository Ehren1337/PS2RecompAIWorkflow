+            return fail("IPUM decoder initialization failed");
+        std::memcpy(decoder.packet->data, input.data() + 16, packetBytes);
+        if (avcodec_send_packet(decoder.context, decoder.packet) < 0 ||
+            avcodec_receive_frame(decoder.context, decoder.frame) < 0)
+            return fail("invalid IPUM frame payload");
+        const AVFrame &frame = *decoder.frame;
+        if (frame.width != width || frame.height != height || frame.format != AV_PIX_FMT_YUV420P ||
+            frame.decode_error_flags || !frame.data[0] || !frame.data[1] || !frame.data[2] ||
+            frame.linesize[0] < static_cast<int>(width) || frame.linesize[1] < static_cast<int>(width / 2) ||
+            frame.linesize[2] < static_cast<int>(width / 2))
+            return fail("unexpected IPUM decoded frame");
+        Picture result{width, height, std::vector<uint8_t>(size_t(width) * height * 4)};
+        size_t destination = 0;
+        // Integer IPU color conversion documented by PCSX2's reference path:
+        // https://github.com/PCSX2/pcsx2/blob/master/pcsx2/IPU/yuv2rgb.cpp
+        // C++20 signed right shifts round toward negative infinity. Keep each
+        // chroma product's rounding separate; swscale is not pixel-equivalent.
+        for (uint32_t blockY = 0; blockY < height; blockY += 16)
+            for (uint32_t blockX = 0; blockX < width; blockX += 16)
+                for (uint32_t dy = 0; dy < 16; ++dy)
+                    for (uint32_t dx = 0; dx < 16; ++dx)
+                    {
+                        const uint32_t x = blockX + dx, y = blockY + dy;
+                        const int luma = (149 * std::max(0, int(frame.data[0][y * frame.linesize[0] + x]) - 16)) >> 6;
+                        const int cb = int(frame.data[1][(y / 2) * frame.linesize[1] + x / 2]) - 128;
+                        const int cr = int(frame.data[2][(y / 2) * frame.linesize[2] + x / 2]) - 128;
+                        result.macroblocks[destination++] = static_cast<uint8_t>(std::clamp((luma + ((204 * cr) >> 6) + 1) >> 1, 0, 255));
+                        result.macroblocks[destination++] = static_cast<uint8_t>(std::clamp((luma + ((-104 * cr) >> 6) + ((-50 * cb) >> 6) + 1) >> 1, 0, 255));
+                        result.macroblocks[destination++] = static_cast<uint8_t>(std::clamp((luma + ((258 * cb) >> 6) + 1) >> 1, 0, 255));
+                        result.macroblocks[destination++] = 128;
+                    }
