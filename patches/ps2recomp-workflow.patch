+        if (slot)
+        {
+            if (slot->address && slot->address != address) ++rumble_object_diagnostics::tagEvictions;
+            *slot = {}; // Also invalidate unowned writes and failed original calls.
+        }
+        const auto returnPc = getRegU32(ctx, 31);
+        const uint32_t producerPc = currentProducer.context == ctx && currentProducer.pc
+            ? currentProducer.pc : diagnosticCallSite(ram, returnPc, 0x12c290);
+        uint32_t producerNode = 0, producerModel = 0;
+        // Verified retail dataflow: scenery 161AB4 uses s3, track 16F944 s5.
+        // Both submit [node+28], with qwc=[ [node+10]+4 ] >> 2.
+        // A node identifies a mesh record, not a car/scene object instance.
+        const unsigned nodeRegister = producerPc == 0x161ab4 ? 19 : producerPc == 0x16f944 ? 21 : 0;
+        if (nodeRegister)
+        {
+            const uint32_t node = getRegU32(ctx, nodeRegister);
+            uint32_t model = 0, source = 0, words = 0;
+            if (node >= 0x100000 && node <= PS2_RAM_SIZE - 0x2c && !(node & 3) &&
+                read(node + 0x10, model) && model >= 0x100000 && model <= PS2_RAM_SIZE - 0x60 &&
+                read(node + 0x28, source) && source == data && read(model + 4, words) &&
+                !(words & 3) && (words >> 2) == qwc)
