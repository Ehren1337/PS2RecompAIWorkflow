+namespace
+{
+    constexpr uint32_t kInitPlayer = 0x17a680, kInput = 0x173f60;
+    constexpr uint32_t kBasic = 0x175790, kAllocate = 0x120e60;
+    constexpr uint32_t kAiHead = 0x1f2868, kDifficultyScale = 0x22873c;
+    struct Work;
+    struct State
+    {
+        PS2Runtime *runtime = nullptr;
+        PS2Runtime::RecompiledFunction init = nullptr, input = nullptr, basic = nullptr, allocate = nullptr;
+        Work *work = nullptr;
+        uint32_t car = 0, player = 0, ai = 0;
+        bool initializingPlayer = false, initializingAi = false, originalInput = false, ready = false;
+        bool extendedAllocation = false, reusedAiAllocation = false;
+        uint64_t decisions = 0;
+    };
+    // The development runner owns one runtime per process. A new application
+    // replaces this bounded state; handlers reject a different runtime owner.
+    std::shared_ptr<State> active;
+
+    struct UpgradeState
+    {
+        PS2Runtime *runtime;
+        PS2Runtime::RecompiledFunction prepare;
+        bool calling = false;
+    };
+    std::shared_ptr<UpgradeState> upgrades;
+
+    uint32_t checked(uint32_t at, size_t size)
+    {
+        if (!at || at >= PS2_RAM_SIZE || size > PS2_RAM_SIZE - at)
+            throw std::runtime_error("Rumble dev AI: invalid guest range");
+        return at;
+    }
+    uint32_t word(uint8_t *ram, uint32_t at)
+    {
+        uint32_t value; std::memcpy(&value, ram + checked(at, 4), 4); return value;
+    }
+    void put(uint8_t *ram, uint32_t at, uint32_t value)
+    {
+        std::memcpy(ram + checked(at, 4), &value, 4);
+    }
+
+    // Called after retail has sorted the grid, before it loads car resources.
+    // +1 identifies a human controller; slot zero is not necessarily the player.
+    void upgradeGrid(uint8_t *ram)
+    {
+        const auto config = word(ram, 0x1f21c0);
+        checked(config, 0x30);
+        if (ram[0x22871a] != 1 || ram[0x22871b] != 0 || ram[0x228722] ||
+            ram[0x228887] || word(ram, config + 0x28) || word(ram, config + 0x2c))
+            throw std::runtime_error("Rumble dev upgrades require one-player Single Race");
