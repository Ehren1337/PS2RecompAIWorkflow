+                        }
+                        if (startMovie || startMusic)
+                        {
+                            if (!m_host.beginStereoStream(22050))
+                            {
+                                m_host.log(LogLevel::Warning, "Rumble AUDIO: stereo output unavailable; stream start retained");
+                                return {true, false, {}};
+                            }
+                            (startMusic ? m_music : m_movie).playing = true;
+                        }
+                        if (m_movie.playing || m_music.playing)
+                        {
+                            auto &stream = m_music.playing ? m_music : m_movie;
+                            m_host.mixStereoStream(status[m_music.playing ? 6 : 7], status[1] == 0);
