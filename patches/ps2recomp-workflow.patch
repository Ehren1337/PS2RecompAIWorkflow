+ps2_game_overrides::DevelopmentProducerTiming ps2_game_overrides::developmentProducerTiming(uint32_t pc, uint32_t node)
+{
+    DevelopmentProducerTiming total{};
+    for (const auto &entry : rumble_producer_diagnostics::entries)
+        for (unsigned attempt = 0; attempt < 3; ++attempt)
+        {
+            const auto stamp = entry.stamp.load(std::memory_order_acquire);
+            if (stamp & 1) continue;
+            if (entry.pc.load(std::memory_order_relaxed) != pc) break;
+            if (node && entry.node.load(std::memory_order_relaxed) != node) break;
+            const DevelopmentProducerTiming result{entry.tags.load(), entry.bytes.load(), entry.completed.load(),
+                entry.interrupted.load(), entry.nanoseconds.load(), entry.maximum.load(), entry.exampleSource.load()};
+            if (stamp == entry.stamp.load(std::memory_order_acquire))
+            {
+                total.submittedTags += result.submittedTags; total.submittedBytes += result.submittedBytes;
+                total.completed += result.completed; total.interrupted += result.interrupted;
+                total.nanoseconds += result.nanoseconds;
+                if (result.maximumNanoseconds > total.maximumNanoseconds) total.maximumNanoseconds = result.maximumNanoseconds;
+                total.exampleSource = result.exampleSource;
+                break;
+            }
+        }
+    return total;
+}
