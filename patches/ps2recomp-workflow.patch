+        const auto psm = c.bitbltbuf.dpsm;
+        if (psm != GS_PSM_Z32 && psm != GS_PSM_Z24 && psm != GS_PSM_Z16 && psm != GS_PSM_Z16S) return;
+        const uint32_t height = psm == GS_PSM_Z16 || psm == GS_PSM_Z16S ? 64 : 32;
+        const uint32_t stride = std::max(uint32_t(c.bitbltbuf.dbw), 1u);
+        const uint32_t first = ((c.bitbltbuf.dbp >> 5) + (c.trxpos.dsay / height) * stride + c.trxpos.dsax / 64) & 511;
+        const uint16_t region = uint16_t(first & ~7u);
+        for (uint32_t y = c.trxpos.dsay / height; y <= (uint32_t(c.trxpos.dsay) + c.trxreg.rrh - 1) / height; ++y)
+            for (uint32_t x = c.trxpos.dsax / 64; x <= (uint32_t(c.trxpos.dsax) + c.trxreg.rrw - 1) / 64; ++x)
+            {
+                const uint32_t page = ((c.bitbltbuf.dbp >> 5) + y * stride + x) & 511;
+                if ((page & ~7u) != region || ((c.bitbltbuf.dbp & 31) && (((page + 1) & 511) & ~7u) != region)) return;
+            }
+        gpu->PrefetchVramRegion(region);
+        prefetchedRegion = region;
+        // Even a repeated render layout must invalidate a newly captured page.
+        lastWriteLayoutValid = false;
+        ++gs_prefetch_diagnostics::scheduled;
+    }
+    void MarkGpuWrites(const GSContext &c, bool depthActive)
+    {
+        const std::array<uint32_t, 9> key{c.frame.fbp, c.frame.fbw, c.scissor.x0, c.scissor.x1,
+            c.scissor.y0, c.scissor.y1, c.zbuf.zbp, c.zbuf.psm, uint32_t(depthActive)};
+        if (lastWriteLayoutValid && gs_detail::EqualRegisterKey(lastWriteLayout, key)) return;
+        for (uint32_t y = c.scissor.y0 / 32; y <= c.scissor.y1 / 32; ++y)
+            for (uint32_t x = c.scissor.x0 / 64; x <= c.scissor.x1 / 64; ++x)
+                MarkGpuPage(c.frame.fbp + y * c.frame.fbw + x);
+        if (depthActive)
+        {
+            const uint32_t height = c.zbuf.psm == GS_PSM_Z16 || c.zbuf.psm == GS_PSM_Z16S ? 64 : 32;
+            for (uint32_t y = c.scissor.y0 / height; y <= c.scissor.y1 / height; ++y)
+                for (uint32_t x = c.scissor.x0 / 64; x <= c.scissor.x1 / 64; ++x)
+                    MarkGpuPage(c.zbuf.zbp + y * c.frame.fbw + x);
+        }
+        lastWriteLayout = key; lastWriteLayoutValid = true;
+    }
+    std::span<const uint8_t> CoherentPalette(const GSDrawState &s)
+    {
+        const auto &t = s.context.tex0;
+        if (!vram || !s.prim.tme || t.psm != GS_PSM_T8H || t.cpsm != GS_PSM_CT32 ||
+            t.csm != 0 || t.cbp > 16383 || s.texclut.cbw > 63 || s.texclut.cou > 63 || s.texclut.cov > 1023) return {};
+        if (owner == Owner::GPU)
+        {
+            const auto width = std::max(uint32_t(s.texclut.cbw), 1u);
+            std::array<uint16_t, 8> pages{};
+            size_t count = 0;
+            const auto add = [&](uint32_t page)
+            {
+                if (gpuDirtyPages[page] && std::find(pages.begin(), pages.begin() + count, page) == pages.begin() + count)
+                    pages[count++] = uint16_t(page);
+            };
+            for (uint32_t y = s.texclut.cov / 32; y <= (s.texclut.cov + 15u) / 32; ++y)
+                for (uint32_t x = s.texclut.cou / 64; x <= (s.texclut.cou + 15u) / 64; ++x)
+                {
+                    const uint32_t page = ((t.cbp >> 5) + y * width + x) & 511;
+                    add(page);
+                    if (t.cbp & 31) add((page + 1) & 511);
+                }
+            if (count)
+            {
+                // Only the T8H feedback proof needs host palette evidence.
+                // Refresh its dirty pages without claiming the full mirror is current.
+                if (s.context.frame.psm != GS_PSM_CT32 ||
+                    (s.context.frame.fbmsk & 0x7f000000u) != 0x7f000000u) return {};
+                const auto start = profiling ? Clock::now() : Clock::time_point{};
+                ReadPages({pages.data(), count});
+                ++readbacks;
+                if (profiling)
+                {
+                    const auto ns = Elapsed(start); readbackNs += ns;
+                    auto &item = readbackProfile[size_t(CpuUse::Fallback)]; ++item.count; item.ns += ns;
+                }
+                for (size_t i = 0; i < count; ++i) gpuDirtyPages.reset(pages[i]);
+                lastWriteLayoutValid = false; // Same-layout subsequent draws may dirty these pages again.
+            }
+        }
+        return {vram, VramSize};
+    }
+    void MarkGpuTransfer(const GSTransferCommand &c)
+    {
+        if (!c.trxreg.rrw || !c.trxreg.rrh) return;
+        const auto psm = c.bitbltbuf.dpsm;
+        const bool indexed = psm == GS_PSM_T8 || psm == GS_PSM_T4;
+        const uint32_t pageW = indexed ? 128 : 64;
+        const uint32_t pageH = psm == GS_PSM_T4 ? 128 : psm == GS_PSM_T8 ||
+            psm == GS_PSM_CT16 || psm == GS_PSM_CT16S || psm == GS_PSM_Z16 || psm == GS_PSM_Z16S ? 64 : 32;
+        const uint32_t stride = std::max(uint32_t(c.bitbltbuf.dbw), 1u) >> (indexed ? 1 : 0);
+        for (uint32_t y = c.trxpos.dsay / pageH; y <= (uint32_t(c.trxpos.dsay) + c.trxreg.rrh - 1) / pageH; ++y)
+            for (uint32_t x = c.trxpos.dsax / pageW; x <= (uint32_t(c.trxpos.dsax) + c.trxreg.rrw - 1) / pageW; ++x)
+            {
+                const uint32_t page = ((c.bitbltbuf.dbp >> 5) + y * stride + x) & 511;
+                MarkGpuPage(page);
+                if (c.bitbltbuf.dbp & 31) MarkGpuPage(page + 1);
+            }
+    }
+    void EnsureCPU(CpuUse use = CpuUse::Other)
+    {
+        InvalidatePrefetch();
+        if (vram && owner == Owner::GPU)
+        {
+            const auto start = profiling ? Clock::now() : Clock::time_point{};
+            gpu->DownloadVram({vram, VramSize});
+            if (profiling)
+            {
+                const auto ns = Elapsed(start);
+                readbackNs += ns;
+                auto &item = readbackProfile[size_t(use)];
+                ++item.count; item.ns += ns;
+            }
+            owner = Owner::Both;
+            gpuDirtyPages.reset(); lastWriteLayoutValid = false;
+            ++readbacks;
+        }
+    }
+    void EnsureTransferPages(const GSTransferCommand &c)
+    {
+        if (!c.trxreg.rrw || !c.trxreg.rrh) return;
+        const auto psm = c.bitbltbuf.spsm;
+        const bool indexed = psm == GS_PSM_T8 || psm == GS_PSM_T4;
+        const uint32_t pageW = indexed ? 128 : 64;
+        const uint32_t pageH = psm == GS_PSM_T4 ? 128 : psm == GS_PSM_T8 ||
+            psm == GS_PSM_CT16 || psm == GS_PSM_CT16S || psm == GS_PSM_Z16 || psm == GS_PSM_Z16S ? 64 : 32;
+        const uint32_t stride = std::max(uint32_t(c.bitbltbuf.sbw), 1u) >> (indexed ? 1 : 0);
+        std::bitset<512> wanted;
+        const auto add = [&](uint32_t page)
+        {
+            // A 64 KiB coherence region amortizes nearby guest reads and
+            // palette checks. Only dirty pages are copied; no new GPU buffer.
+            const uint32_t first = (page & 511) & ~7u;
+            for (uint32_t i = first; i < first + 8; ++i) if (gpuDirtyPages[i]) wanted.set(i);
+        };
+        for (uint32_t y = c.trxpos.ssay / pageH; y <= (uint32_t(c.trxpos.ssay) + c.trxreg.rrh - 1) / pageH; ++y)
+            for (uint32_t x = c.trxpos.ssax / pageW; x <= (uint32_t(c.trxpos.ssax) + c.trxreg.rrw - 1) / pageW; ++x)
+            {
+                const uint32_t page = (c.bitbltbuf.sbp >> 5) + y * stride + x;
+                add(page); if (c.bitbltbuf.sbp & 31) add(page + 1);
+            }
+        if (wanted.none()) return;
+        std::array<uint16_t, 512> pages{}; size_t count = 0;
+        for (uint32_t page = 0; page < 512; ++page) if (wanted[page]) pages[count++] = uint16_t(page);
+        const auto start = profiling ? Clock::now() : Clock::time_point{};
+        ReadPages({pages.data(), count});
+        ++readbacks;
+        if (profiling)
+        {
+            const auto ns = Elapsed(start); readbackNs += ns;
+            auto &item = readbackProfile[size_t(CpuUse::Transfer)]; ++item.count; item.ns += ns;
+        }
+        gpuDirtyPages &= ~wanted; lastWriteLayoutValid = false;
+    }
+    void EnsureGPU()
+    {
+        if (!vram) throw std::logic_error("Initialize GS VRAM before drawing");
+        if (owner == Owner::CPU)
+        {
+            const auto start = profiling ? Clock::now() : Clock::time_point{};
+            gpu->UploadVram({vram, VramSize});
+            if (profiling) uploadNs += Elapsed(start);
+            owner = Owner::Both;
+            gpuDirtyPages.reset(); lastWriteLayoutValid = false;
+            ++uploads;
+        }
+    }
+    void Draw(const GSPrimitiveBatch &draw, int rounding)
+    {
+        if (!vram) return;
+        const auto start = profiling ? Clock::now() : Clock::time_point{};
+        const auto transferBefore = uploadNs + readbackNs + cpuNs;
+        // Preserve existing CPU behavior when guest VU execution left a
+        // non-nearest host mode. Shader arithmetic currently uses nearest.
+        const char *reason = "host_rounding";
+        bool submitted = false;
+        if (rounding == FE_TONEAREST)
+        {
+            const auto palette = CoherentPalette(draw.state);
+            if (owner == Owner::CPU)
+            {
+                // CPU changes must be uploaded BEFORE enqueueing a GPU draw:
+                // UploadVram flushes pending work. Keep unsupported CPU-only
+                // draws from causing an unnecessary upload/readback cycle.
+                if (gpu->DrawPrimitive(draw, true, profiling ? &reason : nullptr, palette))
+                {
+                    EnsureGPU();
+                    submitted = gpu->DrawPrimitive(draw, false, nullptr, palette);
+                    if (!submitted) throw std::logic_error("GPU draw validation changed");
+                }
+            }
+            else
+                // GPU memory is already current. DrawPrimitive validates the
+                // complete packet before enqueueing; rejection is untouched.
+                // Avoid preparing the same packet twice on every normal draw.
+                submitted = gpu->DrawPrimitive(draw, false, profiling ? &reason : nullptr, palette);
+        }
+        if (submitted)
+        {
+            const auto &c = draw.state.context;
+            const auto method = (c.test >> 17) & 3;
+            MarkGpuWrites(c, method != 0 && (method >= 2 || !c.zbuf.zmask));
+            owner = Owner::GPU;
+            ++gpuDraws;
+        }
+        else
+        {
+            const auto downloadsBefore = profiling ? readbacks.load() : 0;
+            const auto downloadNsBefore = readbackNs;
+            EnsureCPU(CpuUse::Fallback);
+            const auto cpuStart = profiling ? Clock::now() : Clock::time_point{};
+            cpu.Submit(draw);
+            if (profiling) ProfileFallback(draw, Elapsed(cpuStart), reason, downloadsBefore, downloadNsBefore);
+            owner = Owner::CPU;
+            ++cpuDraws;
+            if (rounding != FE_TONEAREST) ++roundingFallbacks;
+        }
+        if (profiling) submitNs += Elapsed(start) - (uploadNs + readbackNs + cpuNs - transferBefore);
+    }
+    void Transfer(const GSTransferCommand &command)
+    {
+        std::vector<uint8_t> readback;
+        if (vram && owner != Owner::CPU && gpu->ReadLocalToHost(command, readback, true))
+        {
+            if (owner == Owner::GPU) EnsureTransferPages(command);
+            cpu.BeginTransfer(command);
+            // Only requested/co-prefetched pages are coherent; later
+            // reads can reuse them until an actual GPU write invalidates them.
+        }
+        else if (vram && gpu->CopyLocal(command, true))
+        {
+            if (command.trxreg.rrw && command.trxreg.rrh)
+            {
+                EnsureGPU();
+                if (!gpu->CopyLocal(command)) throw std::logic_error("GPU transfer validation changed");
+                MarkGpuTransfer(command); owner = Owner::GPU;
+                MaybePrefetchDepth(command);
+            }
+            cpu.RecordExternalLocalTransfer(command);
+        }
+        else
+        {
+            EnsureCPU(CpuUse::Transfer); cpu.BeginTransfer(command);
+            if (command.direction == 2) owner = Owner::CPU;
+        }
+    }
+    uint64_t Enqueue(std::span<Command> commands)
+    {
+        std::unique_lock lock(queueMutex);
+        waitingSlots = commands.size() > Capacity - count ? commands.size() : 0;
+        progress.wait(lock, [&] { return commands.size() <= Capacity - count || failure; });
+        waitingSlots = 0;
+        if (failure) std::rethrow_exception(failure);
+        const bool wakeWorker = count == 0 && !busy;
+        for (auto &command : commands)
+        {
+            queue[(head + count) % Capacity] = std::move(command);
+            ++count;
+        }
+        peak.store(std::max(peak.load(), uint64_t(count)));
+        const auto ticket = issued += commands.size();
+        lock.unlock();
+        if (wakeWorker) progress.notify_all();
+        return ticket;
+    }
+    void PublishCommands()
+    {
+        if (!pendingCommandCount) return;
+        Enqueue({pendingCommands.data(), pendingCommandCount});
+        pendingCommandCount = 0;
+    }
+    template<class F> void Invoke(F &&fn)
+    {
+        std::lock_guard lock(calls);
+        PublishCommands();
+        std::function<void()> call{std::forward<F>(fn)};
+        Command command;
+        command.call = &call;
+        command.rounding = std::fegetround();
+        const auto ticket = Enqueue({&command, 1});
+        std::unique_lock wait(queueMutex);
+        progress.wait(wait, [&] { return completed >= ticket || failure; });
+        if (failure) std::rethrow_exception(failure);
+    }
+    void Run()
+    {
+        try
+        {
+            gpu = std::make_unique<GSDiligentDevice>(api);
+            int rounding = std::fegetround();
+            // Own a bounded ordered burst so queue locks and notifications are
+            // amortized across draws. Invoke tickets complete only after every
+            // earlier command (including calls in this burst) has executed.
+            std::array<Command, 16> pending;
+            for (;;)
+            {
+                size_t pendingCount;
+                bool freedRequestedSpace;
+                {
+                    std::unique_lock lock(queueMutex);
+                    progress.wait(lock, [&] { return count || stopping; });
+                    if (!count && stopping) break;
+                    pendingCount = std::min(count, pending.size());
+                    for (size_t i = 0; i < pendingCount; ++i)
+                    {
+                        pending[i] = std::move(queue[head]);
+                        head = (head + 1) % Capacity;
+                    }
+                    count -= pendingCount;
+                    freedRequestedSpace = waitingSlots && waitingSlots <= Capacity - count;
+                    busy = true;
+                }
+                // A producer may need room for a whole burst even when the
+                // queue was not completely full before this dequeue.
+                if (freedRequestedSpace) progress.notify_all();
+                bool completedCall = false;
+                for (size_t i = 0; i < pendingCount; ++i)
+                {
+                    auto &command = pending[i];
+                    if (command.rounding != rounding)
+                    {
+                        if (command.rounding == -1 || std::fesetround(command.rounding) != 0)
+                            throw std::runtime_error("GPU worker could not preserve host rounding mode");
+                        rounding = command.rounding;
+                    }
+                    if (command.call) { (*command.call)(); completedCall = true; }
+                    else if (command.kind == Command::Kind::LocalCopy) { Transfer(command.transfer); ++completedLocalCopies; }
+                    else if (command.kind == Command::Kind::TextureFlush) { gpu->Flush(); cpu.TextureFlush(); }
+                    else Draw(command.draw, rounding);
+                }
+                bool drained;
+                {
+                    std::lock_guard lock(queueMutex);
+                    completed += pendingCount;
+                    busy = false;
+                    drained = count == 0;
+                }
+                if (completedCall || drained) progress.notify_all();
+            }
+            EnsureCPU();
+        }
+        catch (...)
+        {
+            std::lock_guard lock(queueMutex);
+            failure = std::current_exception();
+            count = 0;
+            progress.notify_all();
+        }
+        gpu.reset();
+    }
+public:
+    GSDiligentBackend(const char *label, GSDiligentDevice::Api selected) : name(label), api(selected), worker([this] { Run(); }) {}
+    ~GSDiligentBackend() override
+    {
+        // Match the existing destructor's failure behavior: a failed worker
+        // has already stopped consuming, but must still be joined.
+        try { std::lock_guard lock(calls); PublishCommands(); } catch (...) {}
+        { std::lock_guard lock(queueMutex); stopping = true; }
+        progress.notify_all();
+        worker.join();
+    }
+    void Initialize(uint8_t *memory, uint32_t size) override
+    {
+        if (!memory || size != VramSize) throw std::invalid_argument("GPU GS requires 4 MiB VRAM");
+        Invoke([&] { EnsureCPU(); vram = memory; cpu.Initialize(memory, size); owner = Owner::CPU; });
+    }
+    void Reset() override
+    { Invoke([&] { EnsureCPU(); cpu.Reset(); }); }
+    void Submit(const GSPrimitiveBatch &batch) override
+    { SubmitBatch({&batch, 1}); }
+    bool SupportsBatchedSubmit() const override { return true; }
+    void SubmitBatch(std::span<const GSPrimitiveBatch> batches) override
+    {
+        std::lock_guard lock(calls);
+        const int rounding = std::fegetround();
+        for (const auto &batch : batches)
+        {
+            gs_draw_samples::Observe(batch);
+            if (pendingCommandCount == pendingCommands.size()) PublishCommands(); // Retry propagates a prior worker failure.
+            auto &command = pendingCommands[pendingCommandCount++];
+            std::construct_at(&command.draw, batch);
+            command.kind = Command::Kind::Draw; command.call = nullptr; command.rounding = rounding;
+            if (pendingCommandCount == pendingCommands.size()) PublishCommands();
+        }
+    }
+    void Flush() override
+    { Invoke([&] { gpu->Flush(); }); }
+    void TextureFlush() override
+    {
+        if (!asyncTextureFlush)
+        {
+            Invoke([&] { gpu->Flush(); cpu.TextureFlush(); });
+            return;
+        }
+        // GS User's Manual v6 p131: prior drawing -> TEXFLUSH -> later
+        // drawing remains ordered inside GS. This is not a host readback.
+        // Keep the device flush/barriers on its worker; only remove the
+        // producer's completion wait. FINISH, uploads and reads still drain
+        // the same FIFO, and queue capacity still applies backpressure.
+        std::lock_guard lock(calls);
+        if (pendingCommandCount == pendingCommands.size()) PublishCommands();
+        auto &command = pendingCommands[pendingCommandCount++];
+        command.kind = Command::Kind::TextureFlush; command.call = nullptr;
+        command.rounding = std::fegetround();
+        PublishCommands(); // Make progress even if no subsequent draw arrives.
+    }
+    void Sync(GSSyncReason reason) override
+    {
+        Invoke([&]
+        {
+            if (reason == GSSyncReason::Finish)
+            {
+                gpu->WaitForCompletion();
+                return;
+            }
+            const auto use = reason == GSSyncReason::Presentation ? CpuUse::Presentation :
+                reason == GSSyncReason::LocalToHost ? CpuUse::Transfer :
+                reason == GSSyncReason::DebugReadback ? CpuUse::Debug : CpuUse::Other;
+            EnsureCPU(use);
+        });
+    }
+    void BeginTransfer(const GSTransferCommand &transfer) override
+    {
+        if (!asyncLocalCopies || transfer.direction != 2)
+        {
+            // Host reads retain their capture point and completion contract.
+            Invoke([&] { Transfer(transfer); });
+            return;
+        }
+        std::lock_guard lock(calls);
+        if (pendingCommandCount == pendingCommands.size()) PublishCommands();
+        auto &command = pendingCommands[pendingCommandCount++];
+        std::construct_at(&command.transfer, transfer);
+        command.kind = Command::Kind::LocalCopy; command.call = nullptr; ++queuedLocalCopies;
+        command.rounding = std::fegetround();
+        if (pendingCommandCount == pendingCommands.size()) PublishCommands();
+    }
+    void UploadImage(const uint8_t *data, uint32_t size) override
+    { Invoke([&] { EnsureCPU(CpuUse::Upload); cpu.UploadImage(data, size); owner = Owner::CPU; }); }
+    PresentationFrame Present(const GSPresentationRequest &request) override
+    {
+        PresentationFrame frame;
+        Invoke([&]
+        {
+            recycleGpuPresentation = false;
+            if (!vram) return;
+            if (!gpuPresentation || owner == Owner::CPU)
+            {
+                std::vector<uint8_t>().swap(presentationSpare);
+                gpu->DiscardPendingPresentation(); EnsureCPU(CpuUse::Presentation); frame = cpu.Present(request);
+            }
+            else
+            {
+                const auto start = profiling ? Clock::now() : Clock::time_point{};
+                // Reference checks compare the current VRAM/request. Finish
+                // the bounded checks synchronously before enabling the pipe.
+                const bool deferred = deferredPresentation && (!comparePresentation || presentationChecks >= 64);
+                recycleGpuPresentation = true;
+                const auto *spare = presentationSpare.data();
+                frame = gpu->Present(request, deferred, &presentationSpare);
+                if (spare && frame && frame.pixels.data() == spare) ++presentationReuseHits;
+                if (deferred)
+                {
+                    if (frame.pending) ++deferredPendingPolls;
+                    if (frame && (++deferredCompletions == 8 || deferredCompletions == 64))
+                        ps2_log::append_runtime_log_text("[GPU presentation] deferred completed=" + std::to_string(deferredCompletions) +
+                            " pending polls=" + std::to_string(deferredPendingPolls));
+                }
+                if (frame)
+                {
+                    ++readbacks;
+                    if (profiling)
+                    {
+                        const auto ns = Elapsed(start); readbackNs += ns;
+                        auto &item = readbackProfile[size_t(CpuUse::Presentation)];
+                        ++item.count; item.ns += ns;
+                    }
+                }
+                ++presentationSequence;
+                if (comparePresentation && presentationChecks < 64 &&
+                    (presentationChecks < 8 || presentationSequence % 60 == 0))
+                {
+                    EnsureCPU(CpuUse::Debug);
+                    auto reference = cpu.Present(request);
+                    if (frame.pixels != reference.pixels || frame.width != reference.width || frame.height != reference.height ||
+                        frame.displayFbp != reference.displayFbp || frame.sourceFbp != reference.sourceFbp || frame.usedPreferred != reference.usedPreferred)
+                    {
+                        gpuPresentation = false;
+                        recycleGpuPresentation = false;
+                        frame = std::move(reference);
+                        ps2_log::append_runtime_log_text("[GPU presentation] comparison mismatch; using CPU presentation");
+                    }
+                    else
+                    {
+                        ++presentationChecks;
+                        if (presentationChecks == 8 || presentationChecks == 16 || presentationChecks == 32 || presentationChecks == 64)
+                            ps2_log::append_runtime_log_text("[GPU presentation] exact comparisons=" + std::to_string(presentationChecks));
+                    }
+                }
+            }
+            ReportProfile();
+        });
+        return frame;
+    }
+    void RecyclePresentation(std::vector<uint8_t> &pixels) override
+    {
+        constexpr size_t HostBytes = 640u * 512u * 4u;
+        std::lock_guard lock(calls);
+        if (recycleGpuPresentation && !pixels.empty() && pixels.capacity() <= HostBytes)
+        {
+            presentationSpare.swap(pixels);
+            ++presentationRecycles;
+        }
+    }
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override
+    {
+        bool result = false;
+        Invoke([&]
+        {
+            if (gpu->ClearFramebuffer(context, rgba, true))
+            {
+                EnsureGPU(); result = gpu->ClearFramebuffer(context, rgba);
+                MarkGpuWrites(context, false); owner = Owner::GPU;
+            }
+            else { EnsureCPU(CpuUse::Fallback); result = cpu.ClearFramebuffer(context, rgba); if (result) owner = Owner::CPU; }
+        });
+        return result;
+    }
