+static void CaptureInspectorFrame(const std::vector<uint8_t> &pixels, uint32_t width, uint32_t height,
+                                  uint64_t tick, uint32_t displayFbp, uint32_t sourceFbp)
+{
+    const char *enabled = std::getenv("PS2_INSPECTOR_FRAME");
+    if (!enabled || std::strcmp(enabled, "1") != 0 || !width || !height ||
+        pixels.size() != size_t(width) * height * 4u) return;
+    static auto nextCapture = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    // Keep consecutive presented frames, not one sample per second: alternating
+    // blank/partial buffers can otherwise look perfectly stable in a snapshot.
+    struct CapturedFrame
+    {
+        std::vector<uint8_t> pixels;
+        uint32_t width, height, displayFbp, sourceFbp;
+        uint64_t tick;
+        std::chrono::steady_clock::time_point time;
+    };
+    static std::deque<CapturedFrame> frames;
+    if (!frames.empty() && (frames.back().width != width || frames.back().height != height)) frames.clear();
+    frames.push_back({pixels, width, height, displayFbp, sourceFbp, tick, now});
+    while (frames.size() > 8) frames.pop_front();
+    if (now < nextCapture) return;
+    nextCapture = now + std::chrono::seconds(1);
+    static std::string lastError;
+    try
+    {
+        Image frame{const_cast<uint8_t *>(pixels.data()), static_cast<int>(width), static_cast<int>(height),
+                    1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+        int size = 0;
+        std::unique_ptr<unsigned char, decltype(&MemFree)> png(ExportImageToMemory(frame, ".png", &size), &MemFree);
+        if (!png || size <= 0) throw std::runtime_error("frame PNG encoding failed");
+        ps2WriteInspectorFramePng(png.get(), static_cast<size_t>(size), false);
+        if (frames.size() == 8)
+        {
+            const int labelHeight = 20;
+            Image sheet = GenImageColor(int(width) * 2, (int(height) + labelHeight) * 4, BLACK);
+            try
+            {
+                for (size_t index = 0; index < frames.size(); ++index)
+                {
+                    auto &sample = frames[index];
+                    const int x = int(index % 2) * int(width);
+                    const int y = int(index / 2) * (int(height) + labelHeight);
+                    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(sample.time - frames.front().time).count();
+                    const std::string label = "#" + std::to_string(index + 1) + " +" + std::to_string(elapsed) +
+                        "ms tick=" + std::to_string(sample.tick) + " display=" + std::to_string(sample.displayFbp) +
+                        " source=" + std::to_string(sample.sourceFbp);
+                    ImageDrawText(&sheet, label.c_str(), x + 3, y + 3, 10, WHITE);
+                    Image tile{sample.pixels.data(), int(width), int(height), 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+                    ImageDraw(&sheet, tile, {0, 0, float(width), float(height)},
+                              {float(x), float(y + labelHeight), float(width), float(height)}, WHITE);
+                }
+                int sheetSize = 0;
+                std::unique_ptr<unsigned char, decltype(&MemFree)> sheetPng(ExportImageToMemory(sheet, ".png", &sheetSize), &MemFree);
+                if (!sheetPng || sheetSize <= 0) throw std::runtime_error("frame history PNG encoding failed");
+                ps2WriteInspectorFramePng(sheetPng.get(), size_t(sheetSize), true);
+            }
+            catch (...) { UnloadImage(sheet); throw; }
+            UnloadImage(sheet);
+        }
+        lastError.clear();
+    }
+    catch (const std::exception &error)
+    {
+        if (lastError != error.what()) RUNTIME_ERROR("[inspector frame] " << error.what() << std::endl);
+        lastError = error.what();
+    }
+}
