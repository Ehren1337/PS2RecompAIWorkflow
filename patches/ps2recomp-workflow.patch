+                    // Keep just their bounded header evidence in the same log.
+                    if (m_lastKind <= 2 && command.extra.size >= 40)
+                    {
+                        std::array<uint8_t, 40> header{};
+                        if (m_host.readGuest(command.extraDestination, header.data(), header.size()))
+                            out << " resource_tag=0x" << std::hex << readWord(header.data() + 0x1c)
+                                << " source=0x" << readWord(packet.data() + 0x10)
+                                << " payload_pointer=0x" << readWord(header.data())
+                                << " destination=0x" << command.extraDestination << std::dec
+                                << " payload_bytes=" << readWord(header.data() + 0x24);
+                    }
+                    m_host.log(LogLevel::Warning, out.str());
+                }
+                return {true, false, {}};
+            }
+
+            void appendDebugMetrics(std::vector<DebugMetric> &metrics) const override
+            {
+                std::lock_guard lock(m_mutex);
+                metrics.push_back({"transfer_ready", m_ready});
+                metrics.push_back({"ee_buffer", m_eeBuffer, true});
+                metrics.push_back({"ee_size", m_eeSize, true});
+                metrics.push_back({"iop_allocation", m_iopBuffer, true});
+                metrics.push_back({"commands", m_commands});
+                metrics.push_back({"unsupported_commands", m_unsupported});
+                metrics.push_back({"last_kind", m_lastKind});
+                metrics.push_back({"control_batches", m_batches});
+                metrics.push_back({"status_acknowledgements", m_statusAcks});
+                metrics.push_back({"status_pending", m_statusPending});
+                metrics.push_back({"last_batch_count", m_lastBatchCount});
+                metrics.push_back({"last_opcode", m_lastOpcode});
+                metrics.push_back({"stream_stop_requested", m_streamStopRequested});
+                metrics.push_back({"sound_enabled", m_soundEnabled});
+                metrics.push_back({"cue_commands", m_cueCommands});
+                metrics.push_back({"cue_next_voice", m_cueVoice});
+                metrics.push_back({"cue_enabled", m_retail && m_cueEnabled});
+                metrics.push_back({"cue_pcm_frames", m_cuePcm.size() / 2});
+                metrics.push_back({"cue_submitted_frames", m_host.pcmVoiceFramesSubmitted()});
+                metrics.push_back({"bank_voice_commands", m_bankVoiceCommands});
+                metrics.push_back({"bank_voice_last_sound", m_lastBankSound});
+                metrics.push_back({"bank_voice_last_frames", m_lastBankVoiceFrames});
+                metrics.push_back({"bank_voice_last_pcm_hash", m_lastBankVoiceHash});
+                metrics.push_back({"bank_voice_active_mask", m_host.activePcmVoiceMask() & 0xffffff000000ull});
+                metrics.push_back({"immediate_commands", m_immediateCommands});
+                metrics.push_back({"movie_queue_open", m_movie.open});
+                metrics.push_back({"movie_queued_buffers", m_movie.count});
+                metrics.push_back({"movie_queued_bytes", m_movie.bytes});
+                metrics.push_back({"movie_playing", m_movie.playing});
+                metrics.push_back({"movie_staged_frames", m_movie.stagedFrames});
+                metrics.push_back({"movie_released_inputs", m_movie.released});
+                metrics.push_back({"movie_close_pending", m_movie.closePending});
+                metrics.push_back({"movie_release_pending", m_movie.releasePending});
+                metrics.push_back({"movie_closes", m_movie.closes});
+                metrics.push_back({"movie_close_acknowledgements", m_movie.closeAcks});
+                metrics.push_back({"music_queue_open", m_music.open});
+                metrics.push_back({"music_queued_buffers", m_music.count});
+                metrics.push_back({"music_queued_bytes", m_music.bytes});
+                metrics.push_back({"music_playing", m_music.playing});
+                metrics.push_back({"music_staged_frames", m_music.stagedFrames});
+                metrics.push_back({"music_released_inputs", m_music.released});
+                metrics.push_back({"music_close_pending", m_music.closePending});
+                metrics.push_back({"music_release_pending", m_music.releasePending});
+                metrics.push_back({"music_closes", m_music.closes});
+                metrics.push_back({"music_close_acknowledgements", m_music.closeAcks});
+                metrics.push_back({"level_resets", m_levelResets});
+                metrics.push_back({"last_engine_update_mask", m_lastEngineUpdateMask, true});
+                metrics.push_back({"last_engine_init_mask", m_lastEngineInitMask, true});
+                metrics.push_back({"last_player_update_mask", m_lastPlayerUpdateMask, true});
+                if (m_retail)
+                {
+                    unsigned tableCount = 0;
+                    for (unsigned i = 0; i < m_soundTables.size(); ++i)
+                    {
+                        const auto &table = m_soundTables[i];
+                        if (table.payload.empty()) continue;
+                        ++tableCount;
+                        const auto prefix = "sound_table_" + std::to_string(i);
+                        uint64_t hash = 14695981039346656037ull;
+                        for (const auto byte : table.payload) hash = (hash ^ byte) * 1099511628211ull;
+                        metrics.push_back({prefix + "_bytes", table.payload.size()});
+                        metrics.push_back({prefix + "_banks", readHalf(table.payload.data() + 2)});
+                        metrics.push_back({prefix + "_descriptors", table.descriptors});
+                        metrics.push_back({prefix + "_hash", hash, true});
+                    }
+                    metrics.push_back({"sound_table_count", tableCount});
+                    metrics.push_back({"bank_header_pending", !m_pendingBank.header.empty()});
+                    metrics.push_back({"bank_allocated_bytes", m_bankAllocatedBytes});
+                    metrics.push_back({"sound_definition_count", m_soundDefinitions.size()});
+                    unsigned variants = 0, bankCount = 0;
+                    for (const auto &definition : m_soundDefinitions) variants += unsigned(definition.variants.size());
+                    metrics.push_back({"sound_variant_count", variants});
+                    for (unsigned i = 0; i < m_soundBanks.size(); ++i)
+                    {
+                        const auto &bank = m_soundBanks[i];
+                        if (bank.header.empty()) continue;
+                        ++bankCount;
+                        const auto prefix = "sound_bank_" + std::to_string(i);
+                        unsigned loops = 0;
+                        uint64_t hash = 14695981039346656037ull;
+                        for (const auto byte : bank.body) hash = (hash ^ byte) * 1099511628211ull;
+                        for (const auto &sample : bank.samples) loops += sample.repeats;
+                        metrics.push_back({prefix + "_id", bank.identity});
+                        metrics.push_back({prefix + "_bytes", bank.body.size()});
+                        metrics.push_back({prefix + "_samples", bank.samples.size()});
+                        metrics.push_back({prefix + "_loops", loops});
+                        metrics.push_back({prefix + "_hash", hash, true});
+                    }
+                    metrics.push_back({"sound_bank_count", bankCount});
+                    metrics.push_back({"level_environment", unsigned(m_retailLevelRecord[1]) * 2 + m_retailLevelRecord[2]});
+                    metrics.push_back({"level_engine_count", m_retailLevelRecord[3]});
+                    metrics.push_back({"engine_aliases_ready", m_engineAliasesReady});
+                    metrics.push_back({"engine_updates", m_engineUpdates});
+                    metrics.push_back({"level_environment_enabled", m_environmentEnabled});
+                    for (unsigned engine = 0; engine < m_retailLevelRecord[3]; ++engine)
+                    {
+                        metrics.push_back({"level_engine_config_" + std::to_string(engine),
+                            readWord(m_retailLevelRecord.data() + 6 + engine * 4), true});
+                        const auto prefix = "engine_" + std::to_string(engine);
+                        const auto &state = m_engines[engine];
+                        metrics.push_back({prefix + "_bank_slot", state[2]});
+                        metrics.push_back({prefix + "_gear", state[3], true});
+                        metrics.push_back({prefix + "_voice_handle", readWord(state.data() + 0x38)});
+                        metrics.push_back({prefix + "_skid_voice_handle", readWord(state.data() + 0x48)});
+                        metrics.push_back({prefix + "_skid_base_pitch", m_skidPitches[engine]});
+                        metrics.push_back({prefix + "_road_voice_handle", readWord(state.data() + 0x44)});
+                        metrics.push_back({prefix + "_road_base_pitch", m_roadPitches[engine]});
+                        metrics.push_back({prefix + "_mapped_rpm", readWord(state.data() + 0x20)});
+                        metrics.push_back({prefix + "_flags", readWord(state.data() + 0x94), true});
+                        metrics.push_back({prefix + "_x", readWord(state.data() + 0x28), true});
+                    }
+                }
+                metrics.push_back({"listener_0_x", readWord(m_listeners[0].data()), true});
+                metrics.push_back({"positional_emitters", uint64_t(std::count_if(m_emitters.begin(), m_emitters.end(),
+                    [](const auto &e) { return e.active; }))});
+                metrics.push_back({"positional_voices", uint64_t(std::count_if(m_emitters.begin(), m_emitters.end(),
+                    [](const auto &e) { return e.handle != 0; }))});
+                metrics.push_back({"listener_0_matrix_xx", readWord(m_listeners[0].data() + 12), true});
+                metrics.push_back({"ambient_stream", m_ambientStream, true});
+                metrics.push_back({"ambient_object", m_ambientObject, true});
+                metrics.push_back({"ambient_x_bits", m_ambientPosition[0], true});
+                metrics.push_back({"ambient_y_bits", m_ambientPosition[1], true});
+                metrics.push_back({"ambient_z_bits", m_ambientPosition[2], true});
+                metrics.push_back({"engine_stream", m_engineStream, true});
+                metrics.push_back({"engine_player", m_enginePlayer});
+            }
+
+        private:
+            struct Emitter
+            {
+                bool active = false, repeats = false;
+                uint16_t alias = 0, basePitch = 0;
+                uint8_t handle = 0;
+                std::array<uint8_t, 12> position{};
+                uint32_t gain = 0x10000, pitch = 0x10000;
+            };
+            using Emitters = std::array<Emitter, 64>;
+            using Listeners = std::array<std::array<uint8_t, 52>, 2>;
+            using SkidPitches = std::array<uint16_t, 8>;
+            using EngineStates = std::array<std::array<uint8_t, 0xdc>, 8>;
+            struct EngineSurface { uint16_t loop, transient; bool skid; };
+            static EngineSurface engineSurface(uint8_t surface)
+            {
+                // Retail 0x10260, consumed by E940/E948 and B114. -1 means
+                // no surface; other out-of-table values fall back to alias 12.
+                constexpr std::array<EngineSurface, 20> table{{
+                    {128,0,true},{128,0,true},{128,0,true},{129,0,false},{129,0,false},
+                    {132,0,false},{136,0,false},{136,0,false},{129,133,false},{134,0,false},
+                    {134,0,false},{130,0,false},{130,0,false},{131,0,true},{128,0,true},
+                    {12,0,false},{146,0,true},{0,161,false},{0,0,false},{136,0,false}}};
+                return surface == 255 ? EngineSurface{0,0,false} :
+                    surface < table.size() ? table[surface] : EngineSurface{12,0,false};
+            }
+
+            bool prepareEngineState(unsigned index, const uint8_t *record, EngineStates &engines,
+                bool &aliasesReady, uint64_t &updates, const Listeners &listeners) const
+            {
+                // Original 0xA244 ignores entries outside the initialized count.
+                if (index >= m_retailLevelRecord[3]) return true;
+                if (!aliasesReady)
+                {
+                    // 0xC48C caches common sound aliases before accepting engine
+                    // updates. They are looked up in registered definitions, not
+                    // confused with resource IDs or loaded bank-slot numbers.
+                    const auto present = [&](uint16_t alias) { return hasSoundAlias(alias); };
+                    constexpr std::array<uint16_t, 10> required{2, 1, 3, 19, 18, 11, 23, 20, 25, 26};
+                    aliasesReady = std::all_of(required.begin(), required.end(), present);
+                    const unsigned environment = unsigned(m_retailLevelRecord[1]) * 2 + m_retailLevelRecord[2];
+                    if (environment != 15) aliasesReady = aliasesReady && present(0x122) && present(0x15);
+                    if (!aliasesReady) return true; // Original leaves this engine untouched.
+                }
+                auto &state = engines[index];
+                uint32_t flags = readWord(state.data() + 0x94);
+                // Single-player type 0 and negative opponent types share the
+                // ordinary loop. 0xC788 applies the opponent attenuation below.
+                if (static_cast<int8_t>(state[0]) > 0) return false;
+                if (record[0x3c])
+                {
+                    if (state[2] != record[0x3c] && readWord(state.data() + 0x38)) flags |= 0x10;
+                    state[2] = record[0x3c];
+                }
+                if (record[0x22] || (flags & 0x200))
+                {
+                    const unsigned environment = unsigned(m_retailLevelRecord[1]) * 2 + m_retailLevelRecord[2];
+                    // Flag consumers: AEEC (0x20000000), B730 (0x20),
+                    // BBFC (0x2000/4/8), C07C (0x80000). Retain other flags
+                    // without inventing secondary key-ons. +3D is only used
+                    // by the gated C07C effect, and +1 only clears flag 0x20.
+                    if ((environment != 15 && environment != 10) ||
+                        (record[0x22] ? record[0x23] != 0 : (flags & 0x80) != 0) ||
+                        engineSurface(record[0x21]).transient ||
+                        (readWord(record + 0x38) & 0x2008202cu) ||
+                        !state[2] || state[2] > 6) return false;
+                    if (record[0x22])
+                    {
+                        // Retail table 0x10188: slots 1..6 have identical
+                        // reference/max/min and zero pitch randomization range.
+                        const int64_t range = int64_t(int32_t(readWord(record + 0x30))) -
+                            int32_t(readWord(record + 0x34));
+                        if (range <= 0 || range > 0x7fffff) return false;
+                        writeWord(state.data() + 4, readWord(record + 0x2c));
+                        writeWord(state.data() + 8, 91);
+                        writeWord(state.data() + 0xc, 29866);
+                        writeWord(state.data() + 0x10, 4096);
+                        writeWord(state.data() + 0x1c, 0);
+                        writeWord(state.data() + 0x84,
+                            uint32_t((uint64_t((29866 - 4096) * 256) * (0x80000000ull / (range * 128))) >> 16));
+                        const auto distance = engineDistance(record + 4, listeners[0].data());
+                        if (distance < 0) return false;
+                        writeWord(state.data() + 0xc8, uint32_t(distance));
+                        flags = (flags & ~0x80u) | 0x200;
+                    }
+                }
+                else if (readWord(record + 0x14) != 0) return false;
+                // Retail 0xA6E4 uses the IOP system clock at 300 Hz (0x1C98),
+                // with 15-tick ramp steps and a 60-tick elapsed-time cap.
+                // The clock is native monotonic time; all state below remains
+                // speculative until the complete command/audio batch commits.
+                const auto milliseconds = std::chrono::duration_cast<std::chrono::milliseconds>(
+                    std::chrono::steady_clock::now().time_since_epoch()).count();
+                const auto ticks = uint32_t((uint64_t(milliseconds) * 3) / 10);
+                const int64_t previous = int32_t(readWord(state.data() + 0x1c));
+                int64_t requested = int32_t(readWord(record + 0x14));
+                uint8_t acceleration = record[3];
+                const auto gear = static_cast<int8_t>(record[2]);
+                if (gear != static_cast<int8_t>(state[3]))
+                {
+                    if (gear != -1)
+                    {
+                        const bool up = static_cast<int8_t>(state[3]) < gear;
+                        const auto ramp = previous + (up ? 0x855 : -0x855);
+                        writeWord(state.data() + 0x14, uint32_t(ramp));
+                        if (up ? requested + 1000 < ramp : ramp < requested - 1000)
+                        {
+                            const auto step = up ? -((ramp - requested) >> 2) : (requested - ramp) >> 2;
+                            writeWord(state.data() + 0x18, uint32_t(step));
+                            flags |= up ? 2 : 4;
+                        }
+                        writeWord(state.data() + 0x24, ticks);
+                    }
+                    state[3] = record[2];
+                }
+                if (flags & 6)
+                {
+                    auto elapsed = std::min<int32_t>(int32_t(ticks - readWord(state.data() + 0x24)), 60);
+                    int64_t ramp = int32_t(readWord(state.data() + 0x14));
+                    const int64_t step = int32_t(readWord(state.data() + 0x18));
+                    while (elapsed > 15) { elapsed -= 15; ramp += step; }
+                    writeWord(state.data() + 0x24, ticks - uint32_t(elapsed));
+                    if (flags & 2)
+                    {
+                        if (ramp < requested || step > 0) { flags &= ~2u; ramp = requested; }
+                        else acceleration = 0;
+                    }
+                    else if (ramp <= requested && step >= 0) acceleration = 1;
+                    else { flags &= ~4u; ramp = requested; }
+                    writeWord(state.data() + 0x14, uint32_t(ramp));
+                    requested = ramp;
+                }
+                else requested = std::clamp<int64_t>(requested, previous - 0x855, previous + 0x855);
+                const int64_t minimum = readWord(state.data() + 0x10);
+                const int64_t mapped = requested > minimum ? minimum +
+                    (((requested - minimum) >> 8) * readWord(state.data() + 0x84) >> 8) : requested;
+                writeWord(state.data() + 0x1c, uint32_t(requested));
+                writeWord(state.data() + 0x20, uint32_t(std::clamp<int64_t>(mapped,
+                    minimum, readWord(state.data() + 0xc))));
+                // 0xA93C tracks acceleration and requests a new program.
+                if (acceleration)
+                {
+                    if (!(flags & 8)) flags |= 0x10;
+                    flags |= 8;
+                }
+                else
+                {
+                    if (flags & 8) flags |= 0x10;
+                    flags &= ~8u;
+                }
+                if (!record[1]) flags &= ~0x20u;
+                writeWord(state.data() + 0x94, flags);
+                std::copy_n(record + 4, 12, state.begin() + 0x28);
+                std::copy_n(record + 0x10, 2, state.begin() + 0x34);
+                std::copy_n(record + 0x12, 2, state.begin() + 0x76);
+                std::copy_n(record + 0x18, 8, state.begin() + 0x68);
+                std::copy_n(record + 0x24, 4, state.begin() + 0x80);
+                std::copy_n(record + 0x38, 4, state.begin() + 0x90);
+                state[0x8d] = record[0x20]; state[0x8c] = record[0x21];
+                state[0x8e] = record[0x2a]; state[0x8f] = record[0x2b];
+                state[0x7a] = record[0x3d];
+                ++updates;
+                return true;
+            }
+
+            bool hasSoundAlias(uint16_t alias) const
+            {
+                for (const auto &definition : m_soundDefinitions)
+                    for (unsigned slot = 0; slot < 4; ++slot)
+                        if (readHalf(definition.parameters.data() + 8 + slot * 2) == alias) return true;
+                return false;
+            }
+
+            static int64_t engineDistance(const uint8_t *position, const uint8_t *listener)
+            {
+                // Original 0x525C / 0x4E20 integer approximation. Bound this
+                // frontend path before signed arithmetic or reciprocal overflow.
+                const auto axis = [&](unsigned at) -> int64_t {
+                    return int64_t(int32_t(readWord(position + at))) - int32_t(readWord(listener + at));
+                };
+                auto hypot = [](int64_t x, int64_t y) {
+                    int64_t a = x < 0 ? -x : x, b = y < 0 ? -y : y;
+                    if (a < b) std::swap(a, b);
+                    if ((a >> 1) < b) { const auto old = b; b = a - b; a = (a * 75 + old * 106) >> 7; }
+                    return a + (b >> 2) - (b >> 6);
+                };
+                const auto distance = hypot(hypot(axis(0), axis(4)), axis(8));
+                return distance <= 0x1000000 ? distance : -1;
+            }
+
+            bool prepareEnginePlayback(EngineStates &engines, const std::array<uint8_t, 16> &status,
+                const std::array<uint8_t, 64> &level, bool enabled, uint64_t &occupied,
+                std::array<PcmLoopVoiceUpdate, 48> &voices, bool &work,
+                SkidPitches &skidPitches, SkidPitches &roadPitches, std::vector<uint8_t> &variants, const Listeners &listeners) const
+            {
+                // 0xC788 sorts by decreasing audibility before allocating voices.
+                const auto attenuationFor = [&](const auto &state) -> int64_t {
+                    const auto distance = engineDistance(state.data() + 0x28, listeners[0].data());
+                    if (distance < 0) return INT64_MIN;
+                    int64_t gain = distance <= 0x1000 ? 0x10000 : distance <= 0xf000 ?
+                        0x10000 - (((distance - 0x1000) * 0xdb6d) >> 16) :
+                        0x4000 - (((distance - 0xf000) * 0x1d41) >> 16);
+                    if (static_cast<int8_t>(state[0]) < 0) gain = (gain * 0xc000) >> 16;
+                    return gain;
+                };
+                std::array<unsigned, 8> order{0,1,2,3,4,5,6,7};
+                std::stable_sort(order.begin(), order.end(), [&](unsigned a, unsigned b) {
+                    return attenuationFor(engines[a]) > attenuationFor(engines[b]);
+                });
+                for (const unsigned index : order)
+                {
+                    auto &state = engines[index];
+                    auto flags = readWord(state.data() + 0x94);
+                    // Native handle is voice index + 1, replacing the original
+                    // private IOP voice pointer at +0x38; never exposed to EE.
+                    const auto handle = readWord(state.data() + 0x38);
+                    const auto stop = [&](unsigned offset) {
+                        const auto owned = readWord(state.data() + offset);
+                        if (owned)
+                        {
+                            voices[owned - 1].action = PcmLoopVoiceUpdate::Action::Stop;
+                            occupied &= ~(uint64_t(1) << (owned - 1));
+                            writeWord(state.data() + offset, 0);
+                            work = true;
+                        }
+                    };
+                    // Original 0xC258 releases secondary voices on bank changes.
+                    if (!enabled || m_engines[index][2] != state[2])
+                    {
+                        stop(0x44);
+                        roadPitches[index] = 0;
+                        stop(0x48);
+                        skidPitches[index] = 0;
+                    }
+                    if (!enabled) { stop(0x38); continue; }
+                    if (!(flags & 0x200)) continue;
+                    const auto environment = unsigned(level[1]) * 2 + level[2];
+                    if ((environment != 15 && environment != 10) || status[2] != 1 || static_cast<int8_t>(state[0]) > 0) return false;
+                    const auto &listener = listeners[0];
+                    const auto distance = engineDistance(state.data() + 0x28, listener.data());
+                    if (distance < 0) return false;
+                    const auto attenuation = attenuationFor(state);
+                    // 0xC788 excludes inaudible engines from the update list;
+                    // voices survive the -0x200 hysteresis band, then 0xC258
+                    // releases all owned engine effects. Track-menu entry moves
+                    // the car far away instead of sending a separate stop opcode.
+                    if (attenuation <= 0)
+                    {
+                        if (attenuation < -0x200 && (flags & 1))
+                        {
+                            stop(0x38);
+                            stop(0x44);
+                            roadPitches[index] = 0;
+                            stop(0x48);
+                            skidPitches[index] = 0;
+                        }
+                        continue;
+                    }
+                    // 0x56B4 shifts each Q16 product before summing columns;
+                    // 0x5ED4 derives pan from rotated X and unrotated distance.
+                    std::array<int64_t, 3> rotated{};
+                    for (unsigned column = 0; column < 3; ++column)
+                        for (unsigned row = 0; row < 3; ++row)
+                        {
+                            const auto relative = int64_t(int32_t(readWord(state.data() + 0x28 + row * 4))) -
+                                int32_t(readWord(listener.data() + row * 4));
+                            const auto coefficient = int32_t(readWord(listener.data() + 12 + row * 12 + column * 4));
+                            if (relative < -0x1000000 || relative > 0x1000000 ||
+                                coefficient < -0x20000 || coefficient > 0x20000) return false;
+                            rotated[column] += (relative * coefficient) >> 16;
+                        }
+                    const auto magnitude = rotated[0] < 0 ? -rotated[0] : rotated[0];
+                    const auto panMagnitude = distance < 2 ? 0 : (magnitude * (0x80000000ull / (distance >> 1))) >> 16;
+                    const int64_t pan = rotated[0] < 0 ? int64_t(panMagnitude) : -int64_t(panMagnitude);
+                    const auto setGain = [&](PcmLoopVoiceUpdate &voice, int16_t gain) {
+                        const auto attenuated = (int64_t(gain) * attenuation) >> 16;
+                        auto left = (attenuated * (0x10000 - pan)) >> 16;
+                        auto right = (attenuated * (0x10000 + pan)) >> 16;
+                        if (rotated[2] < -0x1000 && status[1] == 2)
+                        {
+                            if (left < right) left = -left;
+                            else right = -right;
+                        }
+                        voice.left = int16_t(left / 2);
+                        voice.right = int16_t(right / 2);
+                    };
+                    const auto delta = std::min<int64_t>((int64_t(readWord(state.data() + 0xc8)) - distance) * 32, 0x10000);
+                    const auto denominator = (0x46e58 - delta) >> 1;
+                    if (denominator <= 0) return false;
+                    const auto doppler = ((0x80000000ull / denominator) * 0x46e58) >> 16;
+                    const auto ratio = ((uint64_t(readWord(state.data() + 0x20)) *
+                        (0x80000000ull / (uint64_t(readWord(state.data() + 8)) * 128))) >> 16) * doppler >> 16;
+                    writeWord(state.data() + 0xc8, uint32_t(distance));
+                    writeWord(state.data() + 0xcc, uint32_t(doppler));
+                    const auto &bank = m_soundBanks[state[2]];
+                    const unsigned program = ((flags >> 3) ^ 1) & 1;
+                    if (bank.header.empty() || program >= bank.header[4]) return false;
+                    const auto offset = readWord(bank.header.data() + 16 + program * 4);
+                    if (!offset || !bank.header[offset]) return false;
+                    const auto *tone = bank.header.data() + offset + 4;
+                    const auto pitch = (uint64_t(readHalf(tone + 14)) * ratio) >> 16;
+                    if (!pitch || pitch > 0x3fff) return false;
+                    unsigned voice = handle ? handle - 1 : 24;
+                    if (!handle)
+                    {
+                        while (voice < 48 && (occupied & (uint64_t(1) << voice))) ++voice;
+                        if (voice == 48) return false;
+                    }
+                    auto &update = voices[voice];
+                    update.pitch = uint16_t(pitch);
+                    setGain(update, int16_t(status[11] * 128));
+                    if (!handle || (flags & 0x10))
+                    {
+                        if (!prepareEngineLoop(bank, tone, update)) return false;
+                        update.action = PcmLoopVoiceUpdate::Action::Start;
+                    }
+                    else update.action = PcmLoopVoiceUpdate::Action::Update;
+                    occupied |= uint64_t(1) << voice;
+                    writeWord(state.data() + 0x38, voice + 1);
+                    writeWord(state.data() + 0x94, flags & ~0x10u);
+                    work = true;
+
+                    // 0xB114 / surface table 0x10260. Preserve the original
+                    // signed-short truncation before the 0xBF15 gain factor.
+                    const auto surface = engineSurface(state[0x8c]);
+                    if (readHalf(state.data() + 0x78) != surface.loop) stop(0x44);
+                    state[0x78] = uint8_t(surface.loop); state[0x79] = uint8_t(surface.loop >> 8);
+                    const auto roadDefinition = soundDefinitionForAlias(surface.loop);
+                    int16_t roadGain = int16_t((int64_t(int16_t(readHalf(state.data() + 0x34))) *
+                        64 * status[4] * 0x200) >> 16);
+                    roadGain = int16_t((int64_t(roadGain) * 0xbf15) >> 16);
+                    if (status[4] && surface.loop != 12) roadGain = int16_t(roadGain + unsigned(state[0x8f]) * 16);
+                    const auto roadHandle = readWord(state.data() + 0x44);
+                    if (!surface.loop || roadDefinition == m_soundDefinitions.size())
+                    {
+                        stop(0x44);
+                        roadPitches[index] = 0;
+                    }
+                    else
+                    {
+                        unsigned roadVoice = roadHandle ? roadHandle - 1 : 24;
+                        if (!roadHandle)
+                        {
+                            while (roadVoice < 48 && (occupied & (uint64_t(1) << roadVoice))) ++roadVoice;
+                            if (roadVoice == 48) return false;
+                        }
+                        auto &roadUpdate = voices[roadVoice];
+                        if (!roadHandle)
+                        {
+                            const auto &choices = m_soundDefinitions[roadDefinition].variants;
+                            if (choices.empty()) return false;
+                            const unsigned selected = (variants[roadDefinition] + 1) % choices.size();
+                            const auto &choice = choices[selected];
+                            const auto &roadBank = m_soundBanks[choice.bank];
+                            const auto at = readWord(roadBank.header.data() + 16 + choice.program * 4);
+                            if (!at) return false;
+                            const auto *roadTone = roadBank.header.data() + at + 4;
+                            if (!prepareEngineLoop(roadBank, roadTone, roadUpdate)) return false;
+                            roadPitches[index] = readHalf(roadTone + 14);
+                            variants[roadDefinition] = uint8_t(selected);
+                            roadUpdate.action = PcmLoopVoiceUpdate::Action::Start;
+                        }
+                        else roadUpdate.action = PcmLoopVoiceUpdate::Action::Update;
+                        const auto roadPitch = (uint64_t(roadPitches[index]) * doppler) >> 16;
+                        if (!roadPitch || roadPitch > 0x3fff) return false;
+                        roadUpdate.pitch = uint16_t(roadPitch);
+                        setGain(roadUpdate, roadGain);
+                        occupied |= uint64_t(1) << roadVoice;
+                        writeWord(state.data() + 0x44, roadVoice + 1);
+                        work = true;
+                    }
+
+                    // Retail 0xB54C: surface 0 permits alias-23 tire skid.
+                    // Start above 4, retain through 1..4, release at zero or
+                    // a disabled surface. No dialogue stream is admitted yet,
+                    // so original 0xDB08 dialogue ducking is inactive here.
+                    const auto skidHandle = readWord(state.data() + 0x48);
+                    const unsigned skid = unsigned(state[0x8d]) + state[0x8e];
+                    if (!surface.skid || skid <= (skidHandle ? 0u : 4u))
+                    {
+                        stop(0x48);
+                        skidPitches[index] = 0;
+                        continue;
+                    }
+                    unsigned skidVoice = skidHandle ? skidHandle - 1 : 24;
+                    if (!skidHandle)
+                    {
+                        while (skidVoice < 48 && (occupied & (uint64_t(1) << skidVoice))) ++skidVoice;
+                        if (skidVoice == 48) return false;
+                    }
+                    auto &skidUpdate = voices[skidVoice];
+                    if (!skidHandle)
+                    {
+                        const auto definition = soundDefinitionForAlias(23);
+                        if (definition == m_soundDefinitions.size()) return false;
+                        const auto &choices = m_soundDefinitions[definition].variants;
+                        if (choices.empty()) return false;
+                        const unsigned selected = (variants[definition] + 1) % choices.size();
+                        const auto &choice = choices[selected];
+                        const auto &skidBank = m_soundBanks[choice.bank];
+                        const auto at = readWord(skidBank.header.data() + 16 + choice.program * 4);
+                        if (!at) return false;
+                        const auto *skidTone = skidBank.header.data() + at + 4;
+                        if (!prepareEngineLoop(skidBank, skidTone, skidUpdate)) return false;
+                        skidPitches[index] = readHalf(skidTone + 14);
+                        variants[definition] = uint8_t(selected);
+                        skidUpdate.action = PcmLoopVoiceUpdate::Action::Start;
+                    }
+                    else skidUpdate.action = PcmLoopVoiceUpdate::Action::Update;
+                    const unsigned excess = skid > 4 ? skid - 4 : 0;
+                    const auto skidPitch = (uint64_t(skidPitches[index]) * (0x10000 + 0x34 * excess)) >> 16;
+                    if (!skidPitch || skidPitch > 0x3fff) return false;
+                    skidUpdate.pitch = uint16_t(skidPitch);
+                    // First key-on inherits B114's zero road-velocity gain.
+                    // Subsequent updates use the original fixed-point order,
+                    // signed-short conversion, attenuation and reset-listener pan.
+                    const auto strength = (uint64_t(0xe154) * (excess << 8)) >> 16;
+                    const auto gain = int16_t((strength * status[4] * 128) >> 16);
+                    setGain(skidUpdate, skidHandle ? gain : roadGain);
+                    occupied |= uint64_t(1) << skidVoice;
+                    writeWord(state.data() + 0x48, skidVoice + 1);
+                }
+                return true;
+            }
+
+            size_t soundDefinitionForAlias(uint16_t alias) const
+            {
+                // Later definitions overwrite alias collisions (retail 0x9D80).
+                for (size_t i = m_soundDefinitions.size(); i-- > 0;)
+                    for (unsigned slot = 0; slot < 4; ++slot)
+                        if (readHalf(m_soundDefinitions[i].parameters.data() + 8 + slot * 2) == alias) return i;
+                return m_soundDefinitions.size();
+            }
+
+            struct SoundTable
+            {
+                std::vector<uint8_t> payload;
+                uint32_t descriptors = 0;
+            };
+
+            struct SoundVariant { uint8_t bank, program; };
+            struct SoundDefinition
+            {
+                uint8_t identity = 0;
+                uint8_t lastVariant = 0;
+                std::array<uint8_t, 36> parameters{};
+                std::vector<SoundVariant> variants;
+            };
+            struct BankSample
+            {
+                uint32_t offset = 0, bytes = 0, loopOffset = 0;
+                bool repeats = false;
+            };
+            struct SoundBank
+            {
+                uint32_t identity = 0;
+                std::vector<uint8_t> header, body;
+                std::vector<BankSample> samples;
+            };
+
+            bool prepareEngineLoop(const SoundBank &bank, const uint8_t *tone, PcmLoopVoiceUpdate &voice,
+                bool requireLoop = true) const
+            {
+                const auto start = readWord(tone + 16);
+                const auto sample = std::find_if(bank.samples.begin(), bank.samples.end(),
+                    [start](const BankSample &s) { return s.offset == start; });
+                if (sample == bank.samples.end() || (requireLoop && !sample->repeats)) return false;
+                const auto end = start + sample->bytes;
+                const size_t frames = size_t(sample->bytes + (sample->repeats ? end - sample->loopOffset : 0)) / 16 * 28;
+                if (!frames || frames > 262144) return false;
+                voice.samples.reserve(frames);
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                int64_t previous = 0, older = 0;
+                const auto decode = [&](uint32_t begin) {
+                    for (auto at = begin; at < end; at += 16)
+                    {
+                        const auto *block = bank.body.data() + at;
+                        const auto &c = coefficients[block[0] >> 4];
+                        for (unsigned n = 0; n < 28; ++n)
+                        {
+                            int nibble = (block[2 + n / 2] >> (4 * (n & 1))) & 15;
+                            if (nibble & 8) nibble -= 16;
+                            const int64_t value = ((nibble * 4096) >> (block[0] & 15)) +
+                                (previous * c[0] + older * c[1]) / 64;
+                            older = previous; previous = value;
+                            voice.samples.push_back(int16_t(std::clamp<int64_t>(value, -32768, 32767)));
+                        }
+                    }
+                };
+                decode(start);
+                voice.repeats = sample->repeats;
+                if (sample->repeats)
+                {
+                    voice.loopStart = uint32_t(voice.samples.size());
+                    const auto cyclePrevious = previous, cycleOlder = older;
+                    decode(sample->loopOffset);
+                    // More complex predictor cycles need streaming decoding.
+                    if (previous != cyclePrevious || older != cycleOlder) return false;
+                }
+                voice.adsr1 = readHalf(tone + 10);
+                voice.adsr2 = readHalf(tone + 12);
+                return true;
+            }
+
+            bool prepareEmitterCommand(const uint8_t *record, Emitters &emitters) const
+            {
+                // Retail 0x6380 -> 0x66C8/0x67EC/0x6878. All state here is
+                // speculative until the whole batch and native sink commit.
+                auto &emitter = emitters[record[4]];
+                if (record[1] == 2) { emitter.active = false; return true; }
+                if (record[1] == 0)
+                {
+                    // Re-registering a linked slot needs the original list's
+                    // replacement semantics; do not leak an existing voice.
+                    if (emitter.active || emitter.handle) return false;
+                    emitter = {};
+                    emitter.alias = readHalf(record + 2);
+                    if (!emitter.alias || emitter.alias >= 0x180) return false;
+                    const auto definition = soundDefinitionForAlias(emitter.alias);
+                    if (definition != m_soundDefinitions.size() &&
+                        readWord(m_soundDefinitions[definition].parameters.data() + 32)) return false; // Pitch randomization.
+                    emitter.active = true;
+                }
+                std::copy_n(record + 8, 12, emitter.position.begin());
+                // 0x67EC changes gain/pitch only while a voice exists.
+                if (!record[1] || emitter.handle)
+                {
+                    emitter.gain = readWord(record + 20);
+                    emitter.pitch = readWord(record + 24);
+                    if (emitter.gain > 0x10000 || emitter.pitch > 0x40000) return false;
+                }
+                return true;
+            }
+
+            bool prepareEmitterPlayback(Emitters &emitters, const std::array<uint8_t, 16> &status,
+                const Listeners &listeners, bool enabled, bool close, uint64_t &occupied,
+                std::array<PcmLoopVoiceUpdate, 48> &voices, bool &work, std::vector<uint8_t> &variants) const
+            {
+                for (auto &emitter : emitters)
+                {
+                    const auto stop = [&] {
+                        if (!emitter.handle) return;
+                        const auto voice = emitter.handle - 1;
+                        voices[voice] = {};
+                        voices[voice].action = PcmLoopVoiceUpdate::Action::Stop;
+                        occupied &= ~(uint64_t(1) << voice);
+                        emitter.handle = 0;
+                        work = true;
+                    };
+                    if (close) emitter.active = false;
+                    if (!emitter.active || !enabled) { stop(); continue; }
+                    if (status[2] != 1) return false; // Split-screen spatial mixing is not implemented.
+                    const auto definition = soundDefinitionForAlias(emitter.alias);
+                    if (definition == m_soundDefinitions.size()) { stop(); continue; } // Original alias lookup = 0xFF.
+                    const auto &sound = m_soundDefinitions[definition];
+                    const auto &parameters = sound.parameters;
+                    // Doppler/random pitch require their own retained state.
+                    if ((readWord(parameters.data() + 28) & 1) || readWord(parameters.data() + 32)) return false;
+                    const auto distance = engineDistance(emitter.position.data(), listeners[0].data());
+                    if (distance < 0) return false;
+                    const auto near = readWord(parameters.data() + 16), far = readWord(parameters.data() + 20);
+                    if (near > far) return false;
+                    int64_t attenuation = 0;
+                    if (distance <= far)
+                    {
+                        attenuation = 0x10000;
+                        if (distance > near)
+                        {
+                            attenuation -= ((distance - near) * int32_t(readWord(parameters.data() + 24))) >> 16;
+                            attenuation = (attenuation * emitter.gain) >> 16;
+                        }
+                    }
+                    if (attenuation < 0 || attenuation > 0x10000) return false;
+                    if (!attenuation) { stop(); continue; } // Retain the emitter for later audibility.
+                    std::array<int64_t, 3> rotated{};
+                    for (unsigned column = 0; column < 3; ++column)
+                        for (unsigned row = 0; row < 3; ++row)
+                        {
+                            const auto relative = int64_t(int32_t(readWord(emitter.position.data() + row * 4))) -
+                                int32_t(readWord(listeners[0].data() + row * 4));
+                            const auto coefficient = int32_t(readWord(listeners[0].data() + 12 + row * 12 + column * 4));
+                            if (relative < -0x1000000 || relative > 0x1000000 || coefficient < -0x20000 || coefficient > 0x20000) return false;
+                            rotated[column] += (relative * coefficient) >> 16;
+                        }
+                    const auto magnitude = rotated[0] < 0 ? -rotated[0] : rotated[0];
+                    const auto panMagnitude = distance < 2 ? 0 : (magnitude * (0x80000000ull / (distance >> 1))) >> 16;
+                    const int64_t pan = rotated[0] < 0 ? int64_t(panMagnitude) : -int64_t(panMagnitude);
+                    const auto gain = (int64_t(status[4] * 128) * attenuation) >> 16;
+                    auto left = (gain * (0x10000 - pan)) >> 16;
+                    auto right = (gain * (0x10000 + pan)) >> 16;
+                    if (rotated[2] < -0x1000 && status[1] == 2) { if (left < right) left = -left; else right = -right; }
+                    const unsigned voice = emitter.handle ? emitter.handle - 1 : [&] {
+                        unsigned slot = 24;
+                        while (slot < 48 && (occupied & (uint64_t(1) << slot))) ++slot;
+                        return slot;
+                    }();
+                    if (voice == 48) return false;
+                    auto &update = voices[voice];
+                    if (!emitter.handle)
+                    {
+                        if (sound.variants.empty()) return false;
+                        const unsigned selected = (variants[definition] + 1) % sound.variants.size();
+                        const auto &choice = sound.variants[selected];
+                        const auto &bank = m_soundBanks[choice.bank];
+                        const auto offset = readWord(bank.header.data() + 16 + choice.program * 4);
+                        if (!offset || !prepareEngineLoop(bank, bank.header.data() + offset + 4, update, false)) return false;
+                        emitter.basePitch = readHalf(bank.header.data() + offset + 18);
+                        emitter.repeats = update.repeats;
+                        update.action = PcmLoopVoiceUpdate::Action::Start;
+                        variants[definition] = uint8_t(selected);
+                    }
+                    else update.action = PcmLoopVoiceUpdate::Action::Update;
+                    const auto pitch = (uint64_t(emitter.basePitch) * emitter.pitch) >> 16;
+                    if (pitch > 0x3fff || left / 2 < -0x4000 || left / 2 > 0x3fff || right / 2 < -0x4000 || right / 2 > 0x3fff) return false;
+                    update.repeats = emitter.repeats;
+                    update.pitch = uint16_t(pitch);
+                    update.left = int16_t(left / 2); update.right = int16_t(right / 2);
+                    emitter.handle = uint8_t(voice + 1);
+                    occupied |= uint64_t(1) << voice;
+                    work = true;
+                }
+                return true;
+            }
