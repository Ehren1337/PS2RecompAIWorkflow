+    frames.push_back({pixels, width, height, displayFbp, sourceFbp, tick, now});
+    while (frames.size() > 8) frames.pop_front();
+    if (now < nextCapture) return;
+    nextCapture = now + std::chrono::seconds(1);
+    static std::string lastError;
