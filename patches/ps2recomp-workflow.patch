+                            stream.count = 0;
+                            stream.bytes = 0;
+                            stream.buffers = {};
+                            stream.history = {};
+                            stream.closeSlot = m_statusSlot;
+                            m_statusSlot = (m_statusSlot + 1) & 7;
+                            stream.closePending = true;
+                            stream.releasePending = true;
