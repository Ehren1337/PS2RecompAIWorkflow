+        }
+    }
+    // Display extraction must not make the host VRAM mirror falsely coherent.
+    GSContext displayContext;
+    displayContext.frame = {0, 1, GS_PSM_CT32, 0}; displayContext.scissor = {0, 63, 0, 63};
