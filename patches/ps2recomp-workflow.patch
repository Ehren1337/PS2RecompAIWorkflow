+        uint64_t cycles = 0;
+        uint32_t top = 0, groups = 0, prefix = 0, vertices = 0, packetQwords = 0;
+        uint32_t entryStatus = 0, exitStatus = 0, registerMismatch = 155;
+    };
+    std::array<BoundaryRecord, 256> boundaryRecords{};
+    struct BoundarySample
