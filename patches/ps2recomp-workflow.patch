+    void applyRegisters(const Packet &packet, VU1State &state)
+    {
+        std::memcpy(state.vf, packet.vf.data(), sizeof(state.vf));
+        std::memcpy(state.vi, packet.vi.data(), sizeof(state.vi));
+        std::memcpy(state.acc, packet.scalar.data(), sizeof(state.acc));
+        state.q = std::bit_cast<float>(packet.scalar[4]);
+        state.p = std::bit_cast<float>(packet.scalar[5]);
+        state.i = std::bit_cast<float>(packet.scalar[6]);
+        state.r = packet.scalar[7]; state.mac = packet.scalar[8];
+        state.clip = packet.scalar[9]; state.status = packet.scalar[10];
+    }
