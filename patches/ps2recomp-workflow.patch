+                invoke(parent, 0x1a7f90, {manager + 4, pixels, result, decoded.width, decoded.height, 1}, 5);
+                break;
+            case 5:
+                invoke(parent, 0x1a7eb0, {manager + 4}, 6);
+                break;
+            case 6:
+                invoke(parent, 0x1a7f60, {manager + 4}, 7);
+                break;
+            case 7:
+                invoke(parent, 0x1a8150, {}, 8);
+                break;
+            case 8:
+                invoke(parent, 0x121230, {pixels}, 9);
+                break;
+            case 9:
+                RUNTIME_LOG("[Rumble retail picture] uploaded " << decoded.width << "x" << decoded.height
+                    << " descriptor=0x" << std::hex << descriptor << std::dec);
+                SET_GPR_U32(&parent, 2, descriptor);
+                parent.pc = returnPc;
+                break;
+            default:
+                throw std::runtime_error("Rumble retail picture: invalid continuation");
+            }
+        }
+    };
+
+    void decodeRetailPicture(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t source = getRegU32(ctx, 4);
+        const uint32_t size = getRegU32(ctx, 5);
+        if (!source)
+        {
+            SET_GPR_U32(ctx, 2, 0);
+            ctx->pc = getRegU32(ctx, 31);
+            return;
+        }
+        const uint32_t sourceOffset = physicalRange(source, size);
+        auto work = std::make_shared<PictureWork>();
+        work->runtime = runtime;
+        work->rdram = rdram;
+        work->returnPc = getRegU32(ctx, 31);
+        std::string error;
+        if (!ps2_ipu::decodePicture(std::span(rdram + sourceOffset, size), work->decoded, error))
+            throw std::runtime_error("Rumble retail picture: " + error);
+        // Decode/validate before any game allocation or mutation. Each callback
+        // owns this one bounded image until the guest upload and frees finish.
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, rdram);
+        work->advance(0, 0, *ctx);
+    }
+
+    void applyRetailPicture(PS2Runtime &runtime)
+    {
+        for (uint32_t address : {kPictureEntry, 0x1a8110u, 0x120e60u, 0x12a9f0u,
+                0x1a7f90u, 0x1a7eb0u, 0x1a7f60u, 0x1a8150u, 0x121230u})
+            if (!runtime.hasFunction(address))
+                throw std::runtime_error("Rumble retail picture: required guest function missing");
+        if (!runtime.replaceFunction(kPictureEntry, decodeRetailPicture))
+            throw std::runtime_error("Rumble retail picture: could not bind verified entry");
+    }
+}
+
+namespace ps2_game_overrides
+{
+    void registerRumblePictureOverride()
+    {
+        static std::once_flag once;
+        std::call_once(once, [] {
+            registerDescriptor({"Rumble Racing USA retail IPUM picture", "SLUS_201.74",
+                                0x100008, 0x5720d8d8, applyRetailPicture});
+        });
+    }
+}
diff --git a/ps2xRuntime/src/lib/rumble_video.cpp b/ps2xRuntime/src/lib/rumble_video.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/rumble_video.cpp
@@ -0,0 +1,292 @@
+// Retail-specific UI adapter. Calls the owned game's menu/font/input routines;
+// contains no extracted code or assets. Host output settings never alter GS state.
+#include "game_overrides.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "runtime/ee_scheduler.h"
+#include <array>
+#include <cstring>
+#include <initializer_list>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+
+namespace
+{
+    constexpr uint32_t Root = 0x18a700, Navigate = 0x19f880, Render = 0x19ba90;
+    constexpr uint32_t Allocate = 0x120e60, Free = 0x121230, Frontend = 0x1f28fc;
+    constexpr uint16_t EnterVideo = 30000, LeaveVideo = 30001, Change = 30002;
+    constexpr size_t StorageSize = 2048;
+    struct Work;
+    struct State
+    {
+        PS2Runtime *runtime;
+        PS2Runtime::RecompiledFunction root, navigate, render;
+        Work *work = nullptr;
+        bool videoSelected = false, page = false;
+        uint8_t pageSelection = 0;
+        std::array<uint16_t, 4> animation{};
+    };
+    std::shared_ptr<State> active;
+
+    void check(uint32_t at, size_t bytes)
+    {
+        if (!at || at >= PS2_RAM_SIZE || bytes > PS2_RAM_SIZE - at)
+            throw std::runtime_error("Rumble Video Options: invalid guest range");
+    }
+    template<class T> T read(uint8_t *ram, uint32_t at)
+    { check(at, sizeof(T)); T value; std::memcpy(&value, ram + at, sizeof(T)); return value; }
+    template<class T> void write(uint8_t *ram, uint32_t at, T value)
+    { check(at, sizeof(T)); std::memcpy(ram + at, &value, sizeof(T)); }
+
+    struct Work : std::enable_shared_from_this<Work>
+    {
+        std::shared_ptr<State> state;
+        uint8_t *ram;
+        uint32_t frontend, returnPc, storage = 0, row = 0;
+        bool page, drawVideo, rootCalling = false, descriptionsSaved = false;
+        std::array<uint32_t, 12> descriptions{};
+        explicit Work(std::shared_ptr<State> s, uint8_t *r, uint32_t ret)
+            : state(std::move(s)), ram(r), frontend(read<uint32_t>(r, Frontend)), returnPc(ret),
+              page(state->page), drawVideo(state->videoSelected)
+        {
+            check(frontend, 0xec0);
+            if (ram[frontend + 6])
+            { state->page = page = false; state->videoSelected = drawVideo = true; }
+            if (state->work) throw std::runtime_error("Rumble Video Options: nested menu");
+            state->work = this;
+        }
+        ~Work() { restoreDescriptions(); state->work = nullptr; }
+        void restoreDescriptions()
+        {
+            if (!descriptionsSaved) return;
+            for (unsigned i = 0; i < 6; ++i)
+                std::memcpy(ram + frontend + 0xe08 + i * 32, descriptions.data() + i * 2, 8);
+            descriptionsSaved = false;
+        }
+        uint32_t text(unsigned slot, const std::string &label)
+        {
+            // Fixed slots keep addresses valid until the game's font queue has
+            // copied the strings. They are freed after all guest drawing calls.
+            if (slot >= 8 || label.size() >= 128) throw std::runtime_error("Rumble Video Options: long label");
+            const auto at = storage + 512 + slot * 128;
+            std::memcpy(ram + at, label.c_str(), label.size() + 1);
+            return at;
+        }
+        void makeRow(unsigned index, uint32_t label, uint32_t description,
+                     uint16_t y, uint16_t confirm, uint16_t back)
+        {
+            const auto at = storage + index * 32;
+            write(ram, at, label); write<uint16_t>(ram, at + 4, 72); write(ram, at + 6, y);
+            write(ram, at + 8, description); write(ram, at + 0x14, confirm); write(ram, at + 0x16, back);
+            ram[at + 0x18] = 1;
+            write(ram, at + 0x1a, state->animation[index]);
+        }
+        void prepare()
+        {
+            check(storage, StorageSize); std::memset(ram + storage, 0, StorageSize);
+            if (!page)
+            {
+                makeRow(0, text(0, "Video Options"), text(1, "Set display options."), 126,
+                    EnterVideo, read<uint16_t>(ram, frontend + 0xe16));
+                if (drawVideo)
+                {
+                    for (unsigned i = 0; i < 6; ++i)
+                    {
+                        const auto at = frontend + 0xe08 + i * 32;
+                        std::memcpy(descriptions.data() + i * 2, ram + at, 8);
+                        write(ram, at, storage + 640); write<uint32_t>(ram, at + 4, 0);
+                    }
+                    descriptionsSaved = true;
+                }
+            }
+            else
+            {
+                const auto settings = state->runtime->displaySettings();
+                makeRow(0, text(0, "Window: " + std::to_string(settings.width) + " x " + std::to_string(settings.height)),
+                    text(3, "Change output size. Internal game resolution stays the same."), 158, Change, LeaveVideo);
+                makeRow(1, text(1, settings.filter == PS2Runtime::DisplayFilter::Sharp ? "Filtering: Sharp" : "Filtering: Smooth"),
+                    text(4, "Sharp pixel edges or smooth display scaling."), 190, Change, LeaveVideo);
+                makeRow(2, text(2, "Back"), text(5, "Return to Game Options."), 222, LeaveVideo, LeaveVideo);
+                ram[frontend + 8] = state->pageSelection;
+                ram[frontend + 9] = state->pageSelection;
+            }
+        }
+        void invoke(R5900Context &parent, uint32_t address,
+                    std::initializer_list<uint32_t> args, unsigned next)
+        {
+            GuestInvocation call{}; call.kind = GuestInvocationKind::HleCall; call.tag = Root;
+            call.context = parent; call.context.pc = address;
+            unsigned reg = 4;
+            for (auto value : args) { SET_GPR_S32(&call.context, reg, static_cast<int32_t>(value)); ++reg; }
+            SET_GPR_U32(&call.context, 29, 0); SET_GPR_U32(&call.context, 31, 0);
+            call.onComplete = [work = shared_from_this(), next](const R5900Context &result, R5900Context &resume)
+            { work->advance(next, getRegU32(&result, 2), resume); };
+            state->runtime->eeScheduler().invokeCurrent(std::move(call));
+        }
+        void change(int direction)
+        {
+            auto settings = state->runtime->displaySettings();
+            if (state->pageSelection == 0)
+            {
+                constexpr std::array<std::array<uint16_t, 2>, 4> sizes{{{640,480}, {960,720}, {1280,720}, {1920,1080}}};
+                int selected = -1;
+                for (unsigned i = 0; i < sizes.size(); ++i)
+                    if (sizes[i][0] == settings.width && sizes[i][1] == settings.height) selected = int(i);
+                selected = selected < 0 ? 0 : (selected + direction + int(sizes.size())) % int(sizes.size());
+                settings.width = sizes[selected][0]; settings.height = sizes[selected][1];
+                settings.aspect = PS2Runtime::DisplayAspect::FourThree;
+            }
+            else if (state->pageSelection == 1)
+                settings.filter = settings.filter == PS2Runtime::DisplayFilter::Sharp ?
+                    PS2Runtime::DisplayFilter::Smooth : PS2Runtime::DisplayFilter::Sharp;
+            else return;
+            if (!state->runtime->requestDisplaySettings(settings))
+                throw std::runtime_error("Rumble Video Options: invalid display request");
+            ram[frontend + 0xc] = 1;
+            RUNTIME_LOG("[Rumble video] output=" << settings.width << "x" << settings.height
+                << " filter=" << (settings.filter == PS2Runtime::DisplayFilter::Sharp ? "sharp" : "smooth"));
+        }
+        void advance(unsigned step, uint32_t result, R5900Context &parent)
+        {
+            switch (step)
+            {
+            case 0: invoke(parent, Allocate, {StorageSize, 2, 16}, 1); break;
+            case 1:
+                storage = result; prepare();
+                if (!page) { rootCalling = true; invoke(parent, Root, {}, 2); }
+                else invoke(parent, 0x1a0180, {20000}, 10);
+                break;
+            case 2:
+                rootCalling = false; restoreDescriptions();
+                invoke(parent, 0x1a4800, {storage+256, storage+260, storage+264, drawVideo ? 1u : 0u}, 3); break;
+            case 3:
+                invoke(parent, Render, {read<uint32_t>(ram,storage+256), read<uint32_t>(ram,storage+260),
+                    read<uint32_t>(ram,storage+264), storage, 0, 1}, 4); break;
+            case 4:
+                state->animation[0] = read<uint16_t>(ram, storage+0x1a);
+                invoke(parent, Free, {storage}, 99); break;
+            case 10:
+                invoke(parent, 0x1a27a0, {0, read<uint32_t>(ram, storage+state->pageSelection*32+8),
+                    0x21, 400, 0x24, 0x1da, 0}, 11); break;
+            case 11:
+                invoke(parent, 0x1a4800, {storage+256, storage+260, storage+264, row == state->pageSelection ? 1u : 0u}, 12); break;
+            case 12:
+                invoke(parent, Render, {read<uint32_t>(ram,storage+256), read<uint32_t>(ram,storage+260),
+                    read<uint32_t>(ram,storage+264), storage, row, 3}, 13); break;
+            case 13:
+                state->animation[row] = read<uint16_t>(ram, storage+row*32+0x1a);
+                if (++row < 3) advance(11, 0, parent);
+                else invoke(parent, 0x188ed0, {}, 14);
+                break;
+            case 14: invoke(parent, Navigate, {storage, 3}, 15); break;
+            case 15:
+                if (ram[frontend+8] >= 3) throw std::runtime_error("Rumble Video Options: invalid selection");
+                state->pageSelection = ram[frontend+8];
+                if (read<uint16_t>(ram, frontend+4) == LeaveVideo)
+                {
+                    write<uint16_t>(ram, frontend+4, 0xffff);
+                    state->page = false; state->videoSelected = true;
+                    ram[frontend+8] = ram[frontend+9] = 0;
+                }
+                else if (read<uint16_t>(ram, frontend+4) == Change)
+                { write<uint16_t>(ram, frontend+4, 0xffff); change(1); }
+                else if (result == 0) { invoke(parent, 0x189090, {0x8000, 0xffffffffu, 1}, 16); break; }
+                invoke(parent, 0x189190, {}, 18); break;
+            case 16:
+                if (result) { change(-1); invoke(parent, 0x189190, {}, 18); }
+                else invoke(parent, 0x189090, {0x2000, 0xffffffffu, 1}, 17);
+                break;
+            case 17:
+                if (result) change(1);
+                invoke(parent, 0x189190, {}, 18); break;
+            case 18: invoke(parent, Free, {storage}, 99); break;
+            case 99: parent.pc = returnPc; break;
+            default: throw std::runtime_error("Rumble Video Options: invalid continuation");
+            }
+        }
+    };
+
+    void root(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = active;
+        if (!s || s->runtime != runtime) throw std::runtime_error("Rumble Video Options: runtime mismatch");
+        if (s->work && s->work->rootCalling) { s->root(ram, ctx, runtime); return; }
+        auto work = std::make_shared<Work>(s, ram, getRegU32(ctx,31));
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, ram);
+        work->advance(0, 0, *ctx);
+    }
+    void render(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = active;
+        if (!s || s->runtime != runtime) throw std::runtime_error("Rumble Video Options: runtime mismatch");
+        if (s->work && s->work->rootCalling && s->work->drawVideo &&
+            getRegU32(ctx, 7) == s->work->frontend + 0xe00)
+        { SET_GPR_U32(ctx,4,0x15); SET_GPR_U32(ctx,5,0x15); SET_GPR_U32(ctx,6,0); }
+        s->render(ram,ctx,runtime);
+    }
+    void navigate(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = active;
+        if (!s || s->runtime != runtime) throw std::runtime_error("Rumble Video Options: runtime mismatch");
+        auto *work = s->work;
+        if (!work || !work->rootCalling || getRegU32(ctx,4) != work->frontend+0xe00)
+        { s->navigate(ram,ctx,runtime); return; }
+        const auto frontend = work->frontend, ret = getRegU32(ctx,31);
+        if (ram[frontend+8] >= 6) throw std::runtime_error("Rumble Video Options: invalid retail selection");
+        // Only this temporary navigation table has seven entries. The original
+        // six-entry table and the adjacent Audio Options data never move.
+        std::memcpy(ram+work->storage+32, ram+frontend+0xe00, 6*32);
+        ram[frontend+8] = s->videoSelected ? 0 : ram[frontend+8]+1;
+        GuestInvocation call{}; call.kind = GuestInvocationKind::HleCall; call.tag = Navigate;
+        call.context = *ctx; call.context.pc = Navigate;
+        SET_GPR_U32(&call.context,4,work->storage); SET_GPR_U32(&call.context,5,7);
+        SET_GPR_U32(&call.context,29,0); SET_GPR_U32(&call.context,31,0);
+        call.onComplete = [s, ram, frontend, ret](const R5900Context &result, R5900Context &resume)
+        {
+            const auto selected = ram[frontend+8];
+            if (selected >= 7) throw std::runtime_error("Rumble Video Options: invalid extended selection");
+            s->videoSelected = selected == 0;
+            ram[frontend+8] = selected == 0 ? 0 : selected-1;
+            auto answer = getRegU32(&result,2);
+            if (read<uint16_t>(ram,frontend+4) == EnterVideo)
+            {
+                write<uint16_t>(ram,frontend+4,0xffff);
+                s->page = true; s->pageSelection = 0;
+                answer = 1;
+            }
+            // No stock left/right/modal action belongs to the added root row.
+            if (s->videoSelected) answer = 1;
+            SET_GPR_S32(&resume,2,static_cast<int32_t>(answer)); resume.pc = ret;
+        };
+        ctx->pc = ret;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx,ram);
+        runtime->eeScheduler().invokeCurrent(std::move(call));
+    }
+    void apply(PS2Runtime &runtime)
+    {
+        if (!runtime.hasFunction(Root)) return; // Partial runtimes need not include the frontend.
+        if (active && active->runtime == &runtime && runtime.lookupFunction(Root) == root) return;
+        for (auto at : {Root, Navigate, Render, Allocate, Free, 0x1a0180u, 0x1a27a0u, 0x1a4800u, 0x188ed0u, 0x189090u, 0x189190u})
+            if (!runtime.hasFunction(at)) throw std::runtime_error("Rumble Video Options: required guest function missing");
+        // Retail movies and loading pictures provide full progressive frames.
+        // The original display setup uses interlaced field mode for them;
+        // alternating row duplication on a PC makes stationary edges bounce.
+        // Preserve all uploaded rows. Frame-mode gameplay is unaffected.
+        runtime.gs().setProgressiveFieldPresentation(true);
+        active = std::make_shared<State>(State{&runtime, runtime.lookupFunction(Root),
+            runtime.lookupFunction(Navigate), runtime.lookupFunction(Render)});
+        runtime.replaceFunction(Root, root); runtime.replaceFunction(Navigate, navigate); runtime.replaceFunction(Render, render);
+    }
+}
+namespace ps2_game_overrides
+{
+    void registerRumbleVideoOverride()
+    {
+        static std::once_flag once;
+        std::call_once(once, [] { registerDescriptor({"Rumble Racing USA retail Video Options", "SLUS_201.74",
+            0x100008, 0x5720d8d8, apply}); });
+    }
+}
