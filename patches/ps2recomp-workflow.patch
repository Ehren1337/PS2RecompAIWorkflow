+                                // ambient/voice work and keys off all 48 voices;
+                                // enable resumes a paused stream if one exists.
+                                // Music teardown is committed below. Ordinary
+                                // bank one-shots are stopped with the other voices;
+                                // general-stream playback remains unsupported.
+                                // Active movies reject this path.
+                                soundEnabled = record[0] == 4;
+                                if (m_retail)
+                                {
