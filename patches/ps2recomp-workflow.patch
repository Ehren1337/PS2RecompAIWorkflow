+        private:
+            // Not an audio implementation. This opt-in test completes known
+            // sound requests silently; stream consumption is intentionally eager.
+            // EE sound command generation/transfers still run to preserve the game.
+            SifCommandResult handleSilentBatch(const std::array<uint8_t, 64> &packet,
+                const std::array<uint8_t, 0xcc0> &batch)
+            {
+                if (m_lastBatchCount > 40 || m_eeSize < 0x2c0) return {true, false, {}};
+                auto status = m_status;
+                auto movie = m_movie;
+                auto music = m_music;
+                bool stopMovie = false, stopMusic = false, speechDone = false;
+                status[1] = batch[5];
+                for (unsigned i = 0; i < m_lastBatchCount; ++i)
+                {
+                    const auto *record = batch.data() + 0x40 + i * 64;
+                    switch (record[0])
+                    {
+                    case 1: if (!music.open) return {true, false, {}}; music.playing = true; break;
+                    case 11: if (!movie.open) return {true, false, {}}; movie.playing = true; break;
+                    case 14: stopMovie = movie.open; break;
+                    case 9: case 5: case 17: case 25: stopMusic = music.open; break;
+                    case 24: speechDone = true; break;
+                    case 2: speechDone = false; break;
+                    case 31:
+                        if (record[1] > 2) return {true, false, {}};
+                        status[2] = record[1]; break;
+                    case 10: {
+                        const uint8_t v = record[2];
+                        switch (record[1]) {
+                        case 1: status[3] = v; status[4] = (uint32_t(v) * 0x3333) >> 14; status[7] = std::min(v, status[5]); break;
+                        case 2: status[5] = v; status[6] = musicLevel(v); status[7] = std::min(v, status[3]); break;
+                        case 3: status[7] = v; break;
+                        case 4: status[8] = status[9] = v; break;
+                        case 5: status[10] = v; status[11] = engineLevel(v); break;
+                        default: return {true, false, {}};
+                        }
+                        break;
+                    }
+                    case 3: case 4: case 15: case 16: case 20: case 22: case 23:
+                    case 26: case 27: case 28: case 32: case 33: break;
+                    default: ++m_unsupported; return {true, false, {}};
+                    }
+                }
+                if (stopMovie && stopMusic) return {true, false, {}};
+                unsigned events = m_voiceoverReleases;
+                if (events + unsigned(speechDone) + unsigned(stopMovie || stopMusic) > 10)
+                    return {true, false, {}};
+                std::array<uint8_t, 0x2c0> payload{};
+                std::copy(status.begin(), status.end(), payload.begin() + 4);
+                for (unsigned i = 0; i < events; ++i) payload[0x40 + i * 64] = 8;
+                if (speechDone) payload[0x40 + events++ * 64] = 2;
+                auto nextSlot = m_statusSlot;
+                SifCommandReply close{0, {}};
+                if (stopMovie || stopMusic)
+                {
+                    auto &stream = stopMusic ? music : movie;
+                    stream.open = stream.playing = false;
+                    stream.count = 0; stream.bytes = 0; stream.buffers = {}; stream.history = {};
+                    stream.closeSlot = nextSlot;
+                    nextSlot = (nextSlot + 1) & 7;
+                    stream.closePending = stream.releasePending = true;
+                    ++stream.closes;
+                    close.packet.resize(64);
+                    writeWord(close.packet.data(), 64);
+                    close.packet[0x1c] = 2; close.packet[0x1d] = 6;
+                    close.packet[0x1e] = stream.closeSlot; close.packet[0x1f] = stopMusic ? 1 : 3;
+                    payload[0x40 + events++ * 64] = stopMusic ? 7 : 13;
+                }
+                for (auto *stream : {&music, &movie})
+                    while (stream->playing && stream->count && events < 10)
+                    {
+                        stream->bytes -= stream->buffers[0].bytes.size();
+                        for (unsigned i = 1; i < stream->count; ++i)
+                            stream->buffers[i - 1] = std::move(stream->buffers[i]);
+                        stream->buffers[--stream->count] = {};
+                        ++stream->released;
+                        payload[0x40 + events++ * 64] = stream == &music ? 6 : 12;
+                    }
+                writeWord(payload.data(), events);
+                if (!m_host.writeGuest(m_eeBuffer, payload.data(), payload.size())) return {true, false, {}};
