+bool TextureMayAliasFrame(const GSDrawState &s, bool depthActive, const std::array<uint32_t, 4> *sampled = nullptr,
+    bool ignoreT8HighBit = false)
+{
+    // Conservative format-specific page footprints, including palette reads,
+    // region modes, unaligned block bases and wrap at 4 MiB. Texture/palette
+    // feedback must not race the GPU threads writing framebuffer pixels.
+    const auto &ctx = s.context;
+    std::bitset<512> frame, depth;
+    for (uint32_t y = ctx.scissor.y0 / 32; y <= ctx.scissor.y1 / 32; ++y)
+        for (uint32_t x = ctx.scissor.x0 / 64; x <= ctx.scissor.x1 / 64; ++x)
+            frame.set((ctx.frame.fbp + y * ctx.frame.fbw + x) & 511);
+    if (depthActive)
+    {
+        const uint32_t pageH = ctx.zbuf.psm == GS_PSM_Z16 || ctx.zbuf.psm == GS_PSM_Z16S ? 64 : 32;
+        for (uint32_t y = ctx.scissor.y0 / pageH; y <= ctx.scissor.y1 / pageH; ++y)
+            for (uint32_t x = ctx.scissor.x0 / 64; x <= ctx.scissor.x1 / 64; ++x)
+                depth.set((ctx.zbuf.zbp + y * ctx.frame.fbw + x) & 511);
+    }
+    auto overlaps = [&](uint32_t psm, uint32_t base, uint32_t width,
+                        uint32_t minX, uint32_t maxX, uint32_t minY, uint32_t maxY)
+    {
+        // High indexed formats read only bits 24..31. Z24 preserves those
+        // bits on every write, including across the whole queued batch (the
+        // depth format is part of its compatibility key). No framebuffer
+        // mask inference: color and CLUT overlap remain conservative.
+        const bool highOnly = psm == GS_PSM_T8H || psm == GS_PSM_T4HL || psm == GS_PSM_T4HH;
+        const bool depthHazard = !highOnly || ctx.zbuf.psm != GS_PSM_Z24;
+        const bool frameHazard = !(ignoreT8HighBit && psm == GS_PSM_T8H);
+        const auto used = [&](uint32_t page) { return (frameHazard && frame[page]) || (depthHazard && depth[page]); };
+        const bool indexed = psm == GS_PSM_T8 || psm == GS_PSM_T4;
+        const uint32_t pageW = indexed ? 128 : 64;
+        const uint32_t pageH = psm == GS_PSM_T4 ? 128 :
+            (psm == GS_PSM_T8 || psm == GS_PSM_CT16 || psm == GS_PSM_CT16S) ? 64 : 32;
+        const uint32_t row = indexed ? std::max(width >> 1, 1u) : width;
+        for (uint32_t y = minY / pageH; y <= maxY / pageH; ++y)
+            for (uint32_t x = minX / pageW; x <= maxX / pageW; ++x)
+            {
+                const uint32_t page = ((base >> 5) + y * row + x) & 511;
+                if (used(page) || ((base & 31) && used((page + 1) & 511))) return true;
+            }
+        return false;
+    };
+    auto limit = [](uint32_t mode, uint32_t size, uint32_t lo, uint32_t hi)
+    { return mode < 2 ? size - 1 : mode == 2 ? hi : lo | hi; };
+    const uint64_t c = ctx.clamp;
+    const uint32_t maxU = limit(c & 3, s.textureWidth, (c >> 4) & 1023, (c >> 14) & 1023);
+    const uint32_t maxV = limit((c >> 2) & 3, s.textureHeight, (c >> 24) & 1023, (c >> 34) & 1023);
+    const auto &tex = ctx.tex0;
+    if (overlaps(tex.psm, tex.tbp0, tex.tbw,
+        sampled ? (*sampled)[0] : 0, sampled ? (*sampled)[1] : maxU,
+        sampled ? (*sampled)[2] : 0, sampled ? (*sampled)[3] : maxV)) return true;
+    if (IsPalette(tex.psm))
+    {
+        // Include all possible resolved entries, not only the first CSA bank.
+        const uint32_t lastRow = tex.csm == 0 && (tex.cpsm == GS_PSM_CT16 || tex.cpsm == GS_PSM_CT16S) ? 31 : 15;
+        return overlaps(tex.cpsm, tex.cbp, std::max(uint32_t(s.texclut.cbw), 1u),
+            s.texclut.cou, s.texclut.cou + 15, s.texclut.cov, s.texclut.cov + lastRow);
+    }
+    return false;
+}
