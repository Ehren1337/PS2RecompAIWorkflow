+    const Packet *prepareNative(const VU1State &state, const uint8_t *code, uint32_t codeSize,
+                               const uint8_t *data, uint32_t dataSize, PS2Memory *memory, uint32_t maxCycles)
+    {
+        if (!nativeReady() || state.pc != 0x1428 || !data || state.top>=1024 || dataSize != 16384 ||
+            !memory || !memory->getRDRAM()) return nullptr;
+        const uint32_t phase = word(memory->getRDRAM(), 0x1f21e4 / 4);
+        if ((phase != 4 && phase != 13) || !matchesProgram(code, codeSize, memory)) return nullptr;
+        work.results = phase == 13;
+        work.multiGroup=(word(data,state.top*4)&65535u)>1;
+        if (!comparisonsReady(packetComparisonStats(work.results,work.multiGroup))) return nullptr;
+        auto &stats = work.results ? resultsExecutionStats : nativeStats;
+        stats.attempted.fetch_add(1, std::memory_order_relaxed);
+        auto &groupStats=multiGroupNativeStats[work.results ? 1 : 0];
+        if (work.multiGroup) groupStats.attempted.fetch_add(1,std::memory_order_relaxed);
