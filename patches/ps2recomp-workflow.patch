+                return;
+            }
+            default: throw std::runtime_error("Rumble dev AI: invalid continuation");
+            }
+        }
+    };
+
+    void initialize(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        if (s->initializingPlayer) { s->init(ram, ctx, runtime); return; }
+        auto work = std::make_shared<Work>(s, ram, getRegU32(ctx, 4), getRegU32(ctx, 31));
+        s->initializingPlayer = true;
+        s->extendedAllocation = false;
+        const auto descriptor = getRegU32(ctx, 5);
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, ram);
+        work->invoke(*ctx, kInitPlayer, {work->car, descriptor}, 1);
+    }
+    void allocate(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        const auto caller = getRegU32(ctx, 31);
+        if (s->initializingPlayer && caller == 0x17a6dc && getRegU32(ctx, 4) == 0x40)
+        {
+            SET_GPR_U32(ctx, 4, 0xe0); // Freed with the original player control block.
+            s->extendedAllocation = true;
+        }
+        if (s->initializingAi && caller == 0x179e88 && getRegU32(ctx, 4) == 0xa0)
+        {
+            s->reusedAiAllocation = true;
+            SET_GPR_U32(ctx, 2, s->ai); ctx->pc = caller; return;
+        }
+        s->allocate(ram, ctx, runtime);
+    }
+    void basic(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        if (s->initializingAi && getRegU32(ctx, 4) == s->car && getRegU32(ctx, 31) == 0x179e78)
+        {
+            ctx->pc = getRegU32(ctx, 31); return; // Player already owns initialized body/camera/laps.
+        }
+        s->basic(ram, ctx, runtime);
+    }
+    void input(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = owner(runtime);
+        const auto car = getRegU32(ctx, 4);
+        if (s->originalInput || car != s->car || ram[0x1f21e4] != 4 || word(ram, car + 0x10c))
+        { s->input(ram, ctx, runtime); return; }
+        const auto config = word(ram, 0x1f21c0);
+        if (word(ram, 0x1f21d0) != 1 || word(ram, config + 0x28) || word(ram, config + 0x2c))
+            throw std::runtime_error("Rumble dev AI currently requires one player in a normal race");
+        auto work = std::make_shared<Work>(s, ram, car, getRegU32(ctx, 31));
+        work->ticks = getRegU32(ctx, 6);
+        s->originalInput = true;
+        const auto controls = getRegU32(ctx, 5);
+        ctx->pc = work->returnPc;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, ram);
+        work->invoke(*ctx, kInput, {car, controls, work->ticks}, 2);
+    }
+    void apply(PS2Runtime &runtime)
+    {
+        applyUpgrades(runtime);
+        const char *enabled = std::getenv("PS2_RUMBLE_DEV_AI");
+        if (!enabled || std::strcmp(enabled, "no-mercy") != 0) return;
+        if (active && active->runtime == &runtime && runtime.lookupFunction(kInput) == input) return;
+        for (auto at : {kInitPlayer, kInput, kBasic, kAllocate, 0x179e50u, 0x17f790u,
+                        0x178140u, 0x178c90u, 0x1760b0u})
+            if (!runtime.hasFunction(at)) throw std::runtime_error("Rumble dev AI: required guest function missing");
+        if (active && active->work) throw std::runtime_error("Rumble dev AI: another operation is active");
+        auto s = std::make_shared<State>(); s->runtime = &runtime;
+        s->init = runtime.lookupFunction(kInitPlayer); s->input = runtime.lookupFunction(kInput);
+        s->basic = runtime.lookupFunction(kBasic); s->allocate = runtime.lookupFunction(kAllocate);
+        active = std::move(s);
+        runtime.replaceFunction(kInitPlayer, initialize); runtime.replaceFunction(kInput, input);
+        runtime.replaceFunction(kBasic, basic); runtime.replaceFunction(kAllocate, allocate);
+        RUNTIME_LOG("[Rumble dev AI] opt-in No Mercy autopilot hooks installed");
+    }
+}
+namespace ps2_game_overrides
+{
+    bool applyDevelopmentGlitchFrame(std::vector<uint8_t> &rgba, uint32_t width,
+                                    uint32_t height, uint64_t tick, bool enabled)
+    {
+        if (!enabled || !width || !height || rgba.size() % 4u ||
+            rgba.size() / 4u / width != height || rgba.size() / 4u % width) return false;
+        // Deliberately imitate a scrambled palette/texture atlas in a host copy.
+        // Stable blocks change slowly; no random state, game writes or asset edits.
+        const uint32_t phase = static_cast<uint32_t>(tick / 120u);
+        for (uint32_t y = 0; y < height; ++y)
+            for (uint32_t x = 0; x < width; ++x)
+            {
+                auto *p = rgba.data() + (size_t(y) * width + x) * 4u;
+                const uint8_t r = p[0], g = p[1], b = p[2];
+                if (!(r | g | b)) continue;
+                uint32_t tile = (x / 24u) * 0x45d9f3bu ^ (y / 16u) * 0x119de1f3u ^ phase;
+                tile ^= tile >> 16u;
+                if (tile % 29u == 0u)
+                {
+                    p[0] = static_cast<uint8_t>(r | 0xb0u);
+                    p[1] = static_cast<uint8_t>(g | 0xb0u);
+                    p[2] = static_cast<uint8_t>(b | 0xb0u);
+                }
+                else
+                {
+                    p[0] = static_cast<uint8_t>((g & 0xe0u) ^ ((tile & 3u) << 5u));
+                    p[1] = static_cast<uint8_t>((b & 0xe0u) ^ (((tile >> 2u) & 3u) << 5u));
+                    p[2] = static_cast<uint8_t>((r & 0xe0u) ^ (((tile >> 4u) & 3u) << 5u));
+                }
+                // Preserve source alpha and buffer dimensions exactly.
+            }
+        return true;
+    }
