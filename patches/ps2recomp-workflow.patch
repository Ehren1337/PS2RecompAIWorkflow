+ps2_game_overrides::DevelopmentObjectTiming ps2_game_overrides::developmentObjectTiming(uint32_t model, uint32_t object)
+{
+    DevelopmentObjectTiming total{};
+    for (const auto &entry : rumble_object_diagnostics::entries)
+        for (unsigned attempt = 0; attempt < 3; ++attempt)
+        {
+            const auto stamp = entry.stamp.load(std::memory_order_acquire);
+            if (stamp & 1) continue;
+            if (entry.model.load(std::memory_order_relaxed) != model) break;
+            if (object && entry.object.load(std::memory_order_relaxed) != object) break;
+            const DevelopmentObjectTiming result{entry.calls.load(), entry.completed.load(), entry.interrupted.load(),
+                entry.completedNanoseconds.load(), entry.maximumNanoseconds.load(),
+                entry.submittedTags.load(), entry.submittedBytes.load(), entry.vuCompleted.load(),
+                entry.vuInterrupted.load(), entry.vuNanoseconds.load(), entry.vuMaximumNanoseconds.load()};
+            if (stamp == entry.stamp.load(std::memory_order_acquire))
+            {
+                total.calls += result.calls; total.completed += result.completed;
+                total.interrupted += result.interrupted;
+                total.submittedTags += result.submittedTags; total.submittedBytes += result.submittedBytes;
+                total.vuCompleted += result.vuCompleted; total.vuInterrupted += result.vuInterrupted;
+                total.vuNanoseconds += result.vuNanoseconds;
+                if (result.vuMaximumNanoseconds > total.vuMaximumNanoseconds)
+                    total.vuMaximumNanoseconds = result.vuMaximumNanoseconds;
+                total.completedNanoseconds += result.completedNanoseconds;
+                if (result.maximumNanoseconds > total.maximumNanoseconds)
+                    total.maximumNanoseconds = result.maximumNanoseconds;
+                break;
+            }
+        }
+    return total;
+}
