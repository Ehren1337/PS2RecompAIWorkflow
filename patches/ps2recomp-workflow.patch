+                put(ram, kAiHead, car);
+                put(ram, car + 0x15c, 0); // MoveAll processes only this temporary member.
+            }
+        }
+        void invoke(R5900Context &parent, uint32_t address,
+                    std::initializer_list<uint32_t> arguments, unsigned next)
+        {
+            GuestInvocation call{};
+            call.kind = GuestInvocationKind::HleCall;
+            call.tag = kInput;
+            call.context = parent; call.context.pc = address;
+            unsigned reg = 4;
+            for (auto argument : arguments) { SET_GPR_U32(&call.context, reg, argument); ++reg; }
+            SET_GPR_U32(&call.context, 29, 0); SET_GPR_U32(&call.context, 31, 0);
+            call.onComplete = [work = shared_from_this(), next](const R5900Context &, R5900Context &resume)
+            { work->advance(next, resume); };
+            state->runtime->eeScheduler().invokeCurrent(std::move(call));
+        }
+        void advance(unsigned step, R5900Context &parent)
+        {
+            switch (step)
+            {
