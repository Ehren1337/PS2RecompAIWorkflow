+            }
+            const auto submitted = std::chrono::steady_clock::now();
+            gpu->Sync(GSSyncReason::Finish);
+            const auto finished = std::chrono::steady_clock::now();
+            std::cout << "queue benchmark api=" << api << " pass=" << pass << " batch=" << (pass&1) << " draws=20000 submit_us="
+                << std::chrono::duration_cast<std::chrono::microseconds>(submitted - begin).count()
+                << " finish_us=" << std::chrono::duration_cast<std::chrono::microseconds>(finished - begin).count() << '\n';
