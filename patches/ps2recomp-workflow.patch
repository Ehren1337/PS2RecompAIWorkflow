+                }
+                ++m_unsupported;
+                // Do not acknowledge work that has not been implemented. Record
+                // one diagnostic per kind (bounded), so the next reverse step is visible.
+                const uint32_t bit = 1u << (m_lastKind < 31 ? m_lastKind : 31);
