+bool SupportedFrame(const GSContext &ctx)
+{
+    return ctx.frame.fbw > 0 && ctx.frame.fbw <= 63 && ctx.frame.fbp <= 511 &&
+        (ctx.frame.psm == GS_PSM_CT32 || ctx.frame.psm == GS_PSM_CT24) &&
+        ctx.scissor.x0 <= ctx.scissor.x1 && ctx.scissor.y0 <= ctx.scissor.y1 &&
+        ctx.scissor.x1 <= 2047 && ctx.scissor.y1 <= 2047;
