+
+void PS2AudioBackend::setAudioReady(bool ready)
+{
+    std::lock_guard lock(m_mutex);
+    m_audioReady = ready;
+}
+
+bool PS2AudioBackend::beginStereoStream(uint32_t rate)
+{
+#if defined(PLATFORM_VITA)
+    return false; // This platform has no streaming sink wired up yet.
+#else
+    std::lock_guard lock(m_mutex);
+    if (!m_audioReady || m_impl->requested || rate < 8000 || rate > 96000) return false;
+    m_impl->pcm.clear();
+    m_impl->pcmOffset = 0;
+    m_impl->rate = rate;
+    m_impl->requested = true;
+    m_impl->failed = false;
+    m_impl->submittedFrames = 0;
+    ++m_impl->generation;
+    return true;
+#endif
+}
+
+bool PS2AudioBackend::queueStereoStream(const int16_t *samples, uint32_t frames)
+{
+    std::lock_guard lock(m_mutex);
+    if (!m_impl->requested || m_impl->failed || !samples || !frames || frames > 65536 || m_impl->pcm.size() >= 3)
+        return false;
+    m_impl->pcm.emplace_back(samples, samples + size_t(frames) * 2);
+    return true;
+}
+
+void PS2AudioBackend::mixStereoStream(uint8_t volume, bool mono)
+{
+    std::lock_guard lock(m_mutex);
+    m_impl->volume = std::min<uint8_t>(volume, 128);
+    m_impl->mono = mono;
+}
+
+void PS2AudioBackend::stopStereoStream()
+{
+    std::lock_guard lock(m_mutex);
+    m_impl->requested = false;
+    m_impl->pcm.clear();
+    m_impl->pcmOffset = 0;
+}
+
+uint64_t PS2AudioBackend::stereoFramesSubmitted()
+{
+    std::lock_guard lock(m_mutex);
+    return m_impl->submittedFrames;
+}
+
+uint32_t PS2AudioBackend::stereoBlocksQueued()
+{
+    std::lock_guard lock(m_mutex);
+    return static_cast<uint32_t>(m_impl->pcm.size());
+}
+
+uint32_t PS2AudioBackend::readStereoStream(int16_t *samples, uint32_t frames)
+{
+    if (!samples || !frames) return 0;
+    std::lock_guard lock(m_mutex);
+    return m_impl->read(samples, frames);
+}
+
+bool PS2AudioBackend::queuePcmVoices(const int16_t *samples, uint32_t frames, uint64_t mask)
+{
+#if defined(PLATFORM_VITA)
+    return false;
+#else
+    std::lock_guard lock(m_mutex);
+    if (!m_audioReady || m_impl->voicesFailed || !samples || !frames || frames > 65536 ||
+        !mask || (mask >> 48)) return false;
+    auto owned = std::make_shared<const std::vector<int16_t>>(samples, samples + size_t(frames) * 2);
+    if (!m_impl->voicesRequested) ++m_impl->voiceGeneration;
+    for (unsigned voice = 0; voice < 48; ++voice)
+        if (mask & (uint64_t(1) << voice)) m_impl->voices[voice] = {owned, 0};
+    m_impl->voicesRequested = true;
+    return true;
+#endif
+}
+
