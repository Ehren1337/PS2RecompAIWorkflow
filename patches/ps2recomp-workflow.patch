+template<class Factory, class CI>
+void ChooseAdapter(Factory *factory, CI &ci)
+{
+    if (!factory) throw std::runtime_error("Diligent graphics factory unavailable");
+    Uint32 count = 0;
+    factory->EnumerateAdapters(ci.GraphicsAPIVersion, count, nullptr);
+    std::vector<GraphicsAdapterInfo> adapters(count);
+    if (count) factory->EnumerateAdapters(ci.GraphicsAPIVersion, count, adapters.data());
+    for (Uint32 i = 0; i < count; ++i)
+        if (adapters[i].Type == ADAPTER_TYPE_DISCRETE)
+        {
+            ci.AdapterId = i;
+            break;
+        }
+    ci.Features.ComputeShaders = DEVICE_FEATURE_STATE_ENABLED;
+    ci.Features.ShaderFloat64 = std::getenv("PS2_GPU_DISABLE_FLOAT64") ? DEVICE_FEATURE_STATE_DISABLED : DEVICE_FEATURE_STATE_OPTIONAL;
+    if (const char *validation = std::getenv("PS2_GPU_VALIDATION"); validation && std::strcmp(validation, "1") == 0)
+        ci.SetValidationLevel(VALIDATION_LEVEL_1);
