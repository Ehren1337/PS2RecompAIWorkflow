+    compare("Pending GPU palette write invalidates host evidence before feedback");
+    test.Equals(gpu->GetBackendStats().cpuDraws, cleanCount + 1, "Stale CLUT cannot authorize GPU feedback");
+    for (GSRasterBackend *backend : {static_cast<GSRasterBackend *>(&cpu), gpu.get()})
+        backend->WriteVram(GS_PSM_CT32, fc.tex0.cbp, 1, 0, 8, 0);
+    submit(feedback);
+    compare("CPU palette repair is rechecked after stale-page reset");
+    test.Equals(gpu->GetBackendStats().cpuDraws, cleanCount + 1, "Fresh repaired palette restores GPU path");
+    // A GPU local copy into CLUT memory must invalidate the host proof too.
+    cpu.WriteVram(GS_PSM_CT32, 16000, 1, 0, 0, 0x11223344u);
+    gpu->WriteVram(GS_PSM_CT32, 16000, 1, 0, 0, 0x11223344u);
+    GSTransferCommand paletteCopy;
+    paletteCopy.direction = 2;
+    paletteCopy.bitbltbuf = {16000, 1, GS_PSM_CT32, fc.tex0.cbp, 1, GS_PSM_CT32};
