+void PS2AudioBackend::updateStereoStream()
+{
+    std::lock_guard lock(m_mutex);
+#if !defined(PLATFORM_VITA)
+    auto &s = *m_impl;
+    // Device calls stay on the desktop thread. Voice PCM is independent of
+    // the movie stream, including its rate, volume and queue ownership.
+    if (s.voiceStream.buffer && (!s.voicesRequested || s.loadedVoiceGeneration != s.voiceGeneration))
+    {
+        StopAudioStream(s.voiceStream);
+        UnloadAudioStream(s.voiceStream);
+        s.voiceStream = {};
+    }
+    if (s.voicesRequested && m_audioReady && !s.voicesFailed)
+    {
+        if (!s.voiceStream.buffer)
+        {
+            SetAudioStreamBufferSizeDefault(Impl::kOutputFrames);
+            s.voiceStream = LoadAudioStream(48000, 16, 2);
+            SetAudioStreamBufferSizeDefault(0);
+            if (!s.voiceStream.buffer) s.voicesFailed = true;
+            else { s.loadedVoiceGeneration = s.voiceGeneration; PlayAudioStream(s.voiceStream); }
+        }
+        if (!s.voicesFailed)
+            for (unsigned part = 0; part < 2 && IsAudioStreamProcessed(s.voiceStream); ++part)
+            {
+                std::array<int16_t, Impl::kOutputFrames * 2> output{};
+                const auto frames = s.readVoices(output.data(), Impl::kOutputFrames);
+                UpdateAudioStream(s.voiceStream, output.data(), Impl::kOutputFrames);
+                s.voiceSubmittedFrames += frames;
+            }
+    }
+    if (s.stream.buffer && (!s.requested || s.loadedGeneration != s.generation))
+    {
+        StopAudioStream(s.stream);
+        UnloadAudioStream(s.stream);
+        s.stream = {};
+    }
+    if (!s.requested || !m_audioReady || s.failed) return;
+    if (!s.stream.buffer)
+    {
+        SetAudioStreamBufferSizeDefault(Impl::kOutputFrames);
+        s.stream = LoadAudioStream(s.rate, 16, 2);
+        SetAudioStreamBufferSizeDefault(0);
+        if (!s.stream.buffer) { s.failed = true; return; }
+        s.loadedGeneration = s.generation;
+        PlayAudioStream(s.stream);
+    }
+    // Two device buffers plus at most three owned PCM chunks. Never drain
+    // more than the device can accept, even when the guest runs ahead.
+    for (unsigned part = 0; part < 2 && IsAudioStreamProcessed(s.stream); ++part)
+    {
+        std::array<int16_t, Impl::kOutputFrames * 2> output{};
+        const uint32_t frames = s.read(output.data(), Impl::kOutputFrames);
+        UpdateAudioStream(s.stream, output.data(), Impl::kOutputFrames);
+        s.submittedFrames += frames;
+    }
+#endif
+}
 
