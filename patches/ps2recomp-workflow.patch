+    const uint8_t dest = DEST(instruction);
+    if (!dest) return true;
+    const float *left = m_state.vf[FS(instruction)];
+    const float *right = m_state.vf[FT(instruction)];
+    const bool vector = arithmetic >= 0x28;
+    const float scalar = vector ? 0.0f : normalizeOperand(arithmetic < 0x1c
+        ? right[arithmetic & 3] : ((arithmetic & 2) ? m_state.i : m_state.q));
+    float result[4]{};
+    uint8_t flags[4]{};
+    uint32_t sticky = 0;
+    const auto lanes = [&]<unsigned Mode>()
+    {
+        for (uint32_t component = 0; component < 4; ++component)
+        {
+            if (!(dest & laneForComponent(component))) continue;
+            const float a = normalizeOperand(left[component]);
+            const float b = vector ? normalizeOperand(right[component]) : scalar;
+            const long double wideA = a, wideB = b;
+            long double exact;
+            if constexpr (Mode == 0) { result[component] = a + b; exact = wideA + wideB; }
+            else if constexpr (Mode == 1) { result[component] = a - b; exact = wideA - wideB; }
+            else
