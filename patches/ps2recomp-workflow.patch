+                writeWord(update.packet.data() + 4, m_eeBuffer);
+                writeWord(update.packet.data() + 0x14, 0x2c0);
+                writeWord(update.packet.data() + 0x20, m_eeBuffer);
+                update.packet[0x1c] = 2; update.packet[0x1d] = 5; update.packet[0x1e] = nextSlot;
+                m_status = status; m_movie = std::move(movie); m_music = std::move(music);
+                m_statusSlot = nextSlot; m_statusPending = true; m_voiceoverReleases = 0;
+                ++m_batches; m_silentCommands += m_lastBatchCount;
+                if (stopMovie || stopMusic) {
+                    m_deferredStatus = std::move(update);
+                    return {true, true, {}, {makeAck(packet), std::move(close)}};
+                }
+                return {true, true, {}, {makeAck(packet), std::move(update)}};
+            }
+            struct Emitter
+            {
+                bool active = false, repeats = false;
+                uint16_t alias = 0, basePitch = 0;
+                uint8_t handle = 0;
+                std::array<uint8_t, 12> position{};
+                uint32_t gain = 0x10000, pitch = 0x10000;
+            };
+            // AUDIO.IRX 0x4D48/0x4BF0 seed the 20-word ring; 0x4C88
+            // returns the wrapped sum in v0 (despite its inferred void type).
+            struct ShotRandom {
+                std::array<uint32_t, 20> words{};
+                int cursor = 20;
+                ShotRandom() {
+                    uint32_t seed = 0xdeadbeef;
+                    for (auto &word : words) {
+                        const uint32_t upper = (seed >> 16) * 0x41a7;
+                        seed = (seed & 0xffff) * 0x41a7 + (upper & 0x7fff) * 0x10000 + (upper >> 15);
+                        if (seed & 0x80000000u) seed -= 0x7fffffffu;
+                        word = seed;
+                    }
+                }
+                uint32_t next() {
+                    int index = cursor - 1, other = cursor + 2;
+                    if (index < 0) index = 19;
+                    else if (other > 19) other = cursor - 18;
+                    cursor = index;
+                    return words[index] += words[other];
+                }
+            };
+            using Emitters = std::array<Emitter, 64>;
+            using Listeners = std::array<std::array<uint8_t, 52>, 2>;
+            using SkidPitches = std::array<uint16_t, 8>;
