+                {
+                    m_loggedKinds |= bit;
+                    std::ostringstream out;
+                    out << "Rumble AUDIO: pending command support; state=" << unsigned(packet[0x1c])
+                        << " kind=" << m_lastKind << " slot=" << unsigned(packet[0x1e])
+                        << " subcommand=" << unsigned(packet[0x1f])
+                        << " bytes=" << command.extra.size;
+                    if (m_lastKind == 5)
