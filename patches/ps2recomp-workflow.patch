+    cpu.BeginTransfer(paletteCopy); gpu->BeginTransfer(paletteCopy);
+    submit(feedback);
+    compare("GPU copy invalidates stale host palette proof");
+    test.Equals(gpu->GetBackendStats().cpuDraws, cleanCount + 2, "Copied CLUT change restores safe CPU fallback");
+    const auto stats = gpu->GetBackendStats();
+    test.IsTrue(stats.gpuDraws >= 600 && stats.cpuDraws >= 4, "Both renderers actually exercised");
+    test.Equals(stats.roundingFallbacks, uint64_t(3), "Only non-nearest draws counted as rounding fallbacks");
+    test.IsTrue(stats.uploads > 1 && stats.readbacks > 1 && stats.queuePeak <= 256, "Coherent transfers and bounded queue measured");
