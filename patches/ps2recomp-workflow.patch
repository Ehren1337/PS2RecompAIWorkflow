+                            << " command_headers=" << batchCommands
+                            << " engine_update_mask=0x" << std::hex << m_lastEngineUpdateMask
+                            << " engine_init_mask=0x" << m_lastEngineInitMask
+                            << " player_update_mask=0x" << m_lastPlayerUpdateMask << std::dec;
