+        struct Restore
+        {
+            ProducerScope previous = currentProducer;
+            ~Restore() { currentProducer = previous; }
+        } restore;
+        currentProducer = {ctx, ctx->pc == 0x12c340 ? diagnosticCallSite(ram, getRegU32(ctx, 31), 0x12c340) : 0};
+        copyObjectData(ram, ctx, runtime);
+    }
+    struct ObjectScope
+    {
+        R5900Context *context = nullptr;
+        uint32_t object = 0, model = 0;
+    };
+    thread_local ObjectScope currentObject{};
+    struct ScopedObject
+    {
+        ObjectScope previous;
+        explicit ScopedObject(ObjectScope next) : previous(currentObject) { currentObject = next; }
+        ~ScopedObject() { currentObject = previous; }
+    };
+    struct ObjectTag
+    {
+        uint32_t address = 0, buffer = 0, object = 0, model = 0;
+        uint64_t tag = 0, tagData = 0;
+        uint32_t producerPc = 0, dataSource = 0;
+        uint32_t producerNode = 0, producerModel = 0;
+    };
+    // One EE writer. Bounded direct map: collisions discard attribution and
+    // are counted, never attributed to whichever object last used the slot.
+    std::array<ObjectTag, 4096> objectTags{};
