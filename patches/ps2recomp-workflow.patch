+    // fallback and a synchronous host write interleaved with pending draws.
+    // Compare complete VRAM so an early completion ticket cannot hide behind
+    // the next frame's drawing.
+    for (unsigned length : {15u, 16u, 17u, 255u, 256u, 257u})
+    {
+        for (unsigned i = 0; i < length; ++i)
+        {
+            std::fesetround(i == length / 2 ? FE_TOWARDZERO : FE_TONEAREST);
