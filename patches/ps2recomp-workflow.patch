+template<size_t N> void CheckRegisterKey(TestCase &test)
+{
+    std::array<uint32_t, N> a{}, b{};
+    for (size_t i = 0; i < N; ++i) a[i] = b[i] = uint32_t(i * 0x9e3779b9u);
+    test.IsTrue(gs_detail::EqualRegisterKey(a, b), "Identical register keys match");
+    for (size_t word = 0; word < N; ++word)
+        for (unsigned bit = 0; bit < 32; ++bit)
+        {
+            b[word] ^= 1u << bit;
+            test.IsTrue(!gs_detail::EqualRegisterKey(a, b), "Every register bit invalidates the cache key");
+            b[word] ^= 1u << bit;
+        }
+    b[0] ^= 1; b[N - 1] ^= 1;
+    test.IsTrue(!gs_detail::EqualRegisterKey(a, b), "Multiple differences cannot cancel");
+    if (!std::getenv("PS2_GS_KEY_BENCH")) return;
+    std::array<std::array<uint32_t, N>, 256> left{}, right{};
+    uint32_t seed = 0x91832u;
+    for (size_t i = 0; i < left.size(); ++i)
+    {
+        for (auto &word : left[i]) { seed = seed * 1664525u + 1013904223u; word = seed; }
+        right[i] = left[i];
+        if ((i & 31) == 0) right[i][i % N] ^= 0x80000000u;
+    }
+    for (bool reduced : {false, true, true, false})
+    {
+        uint32_t matches = 0;
+        const auto start = std::chrono::steady_clock::now();
+        for (uint32_t i = 0; i < 2000000; ++i)
+        {
+            std::atomic_signal_fence(std::memory_order_seq_cst);
+            const auto index = i & 255;
+            matches += reduced ? gs_detail::EqualRegisterKey(left[index], right[index]) : left[index] == right[index];
+        }
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+        test.Equals(matches, 1937500u, "Timed register comparisons retain exact results");
+        std::cout << "Register key benchmark words=" << N << " reduced=" << reduced << " ms=" << ms << '\n';
+    }
+}
