+bool PSPadBackend::setKeyboardBindings(std::string_view text)
+{
+    static constexpr std::array<std::string_view, 24> names = {
+        "Select", "L3", "R3", "Start", "Up", "Right", "Down", "Left",
+        "L2", "R2", "L1", "R1", "Triangle", "Circle", "Cross", "Square",
+        "LLeft", "LRight", "LUp", "LDown", "RLeft", "RRight", "RUp", "RDown"};
+    decltype(m_keyboard) keys{};
+    std::array<bool, 24> seen{};
+    const bool custom = !text.empty();
+    while (!text.empty())
+    {
+        const auto separator = text.find(';');
+        const auto entry = text.substr(0, separator);
+        const auto equals = entry.find('=');
+        if (equals == std::string_view::npos) return false;
+        size_t control = 0;
+        while (control < names.size() && names[control] != entry.substr(0, equals)) ++control;
+        if (control == names.size() || seen[control]) return false;
+        seen[control] = true;
+        auto values = entry.substr(equals + 1);
+        for (size_t index = 0;; ++index)
+        {
+            if (index >= 2 || values.empty()) return false;
+            const auto comma = values.find(',');
+            const auto value = values.substr(0, comma);
+            int key = 0;
+            const auto result = std::from_chars(value.data(), value.data() + value.size(), key);
+            if (result.ec != std::errc{} || result.ptr != value.data() + value.size() || key < 1 || key > 348)
+                return false;
+            keys[control][index] = key;
+            if (comma == std::string_view::npos) break;
+            values.remove_prefix(comma + 1);
+        }
+        if (separator == std::string_view::npos) break;
+        text.remove_prefix(separator + 1);
+    }
+    m_keyboard = keys;
+    m_customKeyboard = custom;
+    return true;
+}
