+        std::ostringstream out;
+        out << '"';
+        for (unsigned char c : text)
+        {
+            if (c == '"' || c == '\\') out << '\\' << c;
+            else if (c < 0x20) out << "\\u" << std::hex << std::setw(4) << std::setfill('0') << unsigned(c);
