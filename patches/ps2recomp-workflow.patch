+            target.loopStart = update.loopStart;
+            target.repeats = update.repeats;
+            target.adsr1 = update.adsr1;
+            target.adsr2 = update.adsr2;
+        }
+        target.pitch = update.pitch;
+        target.left = update.left;
+        target.right = update.right;
+    }
+    // Allocate new processors before committing any part of the transaction.
+    // Existing processors retain their delay RAM and allocate nothing on update.
+    std::array<std::unique_ptr<PS2ReverbProcessor>, 2> prepared;
+    for (unsigned bus = 0; bus < effects.size(); ++bus)
+    {
+        const auto &effect = effects[bus];
+        if (effect.action == EffectAction::Keep) continue;
+        any = true;
+        if (effect.action == EffectAction::Configure && !m_impl->reverbs[bus])
+        {
+            prepared[bus] = std::make_unique<PS2ReverbProcessor>();
+            prepared[bus]->configure(effect.registers, effect.startWord, effect.wordCount, effect.clear);
+        }
+    }
+    if (!any) return true;
+    for (unsigned bus = 0; bus < effects.size(); ++bus)
+    {
+        const auto &effect = effects[bus];
+        if (effect.action == EffectAction::Keep) continue;
+        if (effect.action == EffectAction::Reset)
+        {
+            m_impl->reverbs[bus].reset();
+            m_impl->reverbControls[bus] = {};
+            continue;
+        }
+        if (prepared[bus]) m_impl->reverbs[bus] = std::move(prepared[bus]);
+        else m_impl->reverbs[bus]->configure(effect.registers, effect.startWord, effect.wordCount, effect.clear);
+        m_impl->reverbControls[bus] = effect;
+    }
+    if (!m_impl->voicesRequested) ++m_impl->voiceGeneration;
+    m_impl->voices = std::move(next);
+    m_impl->voicesRequested = true;
+    return true;
+#endif
+}
