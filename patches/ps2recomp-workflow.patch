+        tc.Run("GS shadow-bit and blur-alpha passes preserve RGB across CT32 CT24 transitions", [](TestCase &t)
+        {
+            // Synthetic geometry exercising the register transitions used by
+            // retail shadow/blur preparation. No captured game packet/assets.
+            // The alpha-only passes must not erase the lower road's RGB.
+            std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+            GS gs;
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+            constexpr uint32_t width = 512, height = 224, depthPage = 224;
+            constexpr uint32_t oldZ = 0x112233, newZ = 0x665544, paint = 0x00765432;
+            const auto xyz = [](uint32_t x, uint32_t y, uint32_t z) {
+                return uint64_t(x * 16) | (uint64_t(y * 16) << 16) | (uint64_t(z) << 32);
+            };
+            const auto sprite = [&](uint32_t color, uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1) {
+                gs.writeRegister(GS_REG_RGBAQ, uint64_t(color) | (0x3f800000ull << 32));
+                gs.writeRegister(GS_REG_XYZ2, xyz(x0, y0, newZ));
+                gs.writeRegister(GS_REG_XYZ2, xyz(x1, y1, newZ));
+            };
+            const auto original = [](uint32_t x, uint32_t y) {
+                return 0x89000000u | ((x & 255u) << 16) | (y << 8) | ((x ^ y) & 255u);
+            };
+            // Both alternating main buffers; extra row guards the lower scissor.
+            for (uint32_t page : {0u, 56u})
+            {
+                const auto block = page * 32;
+                for (uint32_t y = 0; y <= height; ++y)
+                    for (uint32_t x = 0; x < width; ++x)
+                    {
+                        gs.WriteVram(GS_PSM_CT32, block, 8, x, y, original(x,y));
+                        gs.WriteVram(GS_PSM_Z24, depthPage * 32, 8, x, y, oldZ);
+                    }
+                gs.writeRegister(GS_REG_XYOFFSET_1, 0);
+                gs.writeRegister(GS_REG_SCISSOR_1, (511ull << 16) | (223ull << 48));
+                gs.writeRegister(GS_REG_PRIM, GS_PRIM_SPRITE);
+                gs.writeRegister(GS_REG_TEST_1, 0x3180b); // Alpha AFAIL=FB_ONLY, Z always.
+                gs.writeRegister(GS_REG_ZBUF_1, depthPage | (1ull << 24) | (1ull << 32));
+                gs.writeRegister(GS_REG_FRAME_1, page | (8ull << 16) | (0xbfffffffull << 32));
+                sprite(0x40112233, 0, 0, width, height + 1);
+                bool shadow = true;
+                for (uint32_t y = 0; y <= height; ++y)
+                    for (uint32_t x = 0; x < width; ++x)
+                        shadow &= gs.ReadVram(GS_PSM_CT32, block, 8, x, y) ==
+                            (original(x,y) | (y < height ? 0x40000000u : 0u));
+                t.IsTrue(shadow, "shadow mask changes only alpha bit6, respecting bottom scissor");
+
+                gs.writeRegister(GS_REG_FRAME_1, page | (8ull << 16) | (1ull << 24) | (0xff000000ull << 32));
+                gs.writeRegister(GS_REG_ZBUF_1, depthPage | (1ull << 24));
+                gs.writeRegister(GS_REG_TEST_1, 0x5180b); // Z >= stored, ordinary drawing restored.
+                sprite(0x80000000 | paint, 16, 184, 144, 216);
+                bool rgb24 = true;
+                for (uint32_t y = 184; y < 216; ++y)
+                    for (uint32_t x = 16; x < 144; ++x)
+                        rgb24 &= gs.ReadVram(GS_PSM_CT32, block, 8, x, y) == (0xc9000000u | paint);
+                t.IsTrue(rgb24, "CT24 restores lower-screen RGB drawing without losing the shadow alpha bit");
+
+                gs.writeRegister(GS_REG_FRAME_1, page | (8ull << 16) | (0x00ffffffull << 32));
+                gs.writeRegister(GS_REG_ZBUF_1, depthPage | (1ull << 24) | (1ull << 32));
+                gs.writeRegister(GS_REG_TEST_1, 0x3180b);
+                gs.writeRegister(GS_REG_ALPHA_1, 0xaa);
+                gs.writeRegister(GS_REG_PRIM, GS_PRIM_SPRITE | (1ull << 6));
+                sprite(0, 0, 0, width, height + 1);
+                bool colors = true, depths = true;
+                for (uint32_t y = 0; y <= height; ++y)
+                    for (uint32_t x = 0; x < width; ++x)
+                    {
+                        const bool painted = x >= 16 && x < 144 && y >= 184 && y < 216;
+                        const uint32_t expected = y == height ? original(x,y) :
+                            painted ? paint : original(x,y) & 0x00ffffffu;
+                        colors &= gs.ReadVram(GS_PSM_CT32, block, 8, x, y) == expected;
+                        depths &= gs.ReadVram(GS_PSM_Z24, depthPage * 32, 8, x, y) == (painted ? newZ : oldZ);
+                    }
+                t.IsTrue(colors, "blur alpha clear preserves all RGB and the row outside the viewport");
+                t.IsTrue(depths, "masked preparation passes preserve depth; ordinary draw writes only its rectangle");
