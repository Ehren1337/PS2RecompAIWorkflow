+int WrapCoordinate(int value, uint size, uint mode, uint lo, uint hi)
+{
+    int result = int((uint(value) & lo) | hi);
+    if (mode == 0) result = int(uint(value) & (size - 1));
+    else if (mode == 1) result = clamp(value, 0, int(size) - 1);
+    else if (mode == 2) result = min(max(value, int(lo)), int(hi));
