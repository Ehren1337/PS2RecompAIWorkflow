+                        writeWord(update.packet.data() + 0x14, 0x2c0);
+                        update.packet[0x1c] = 2;
+                        update.packet[0x1d] = 5;
+                        update.packet[0x1e] = m_statusSlot;
+                        writeWord(update.packet.data() + 0x20, m_eeBuffer);
+                        m_status = status;
+                        m_ambientStream = ambientStream;
+                        m_ambientObject = ambientObject;
+                        m_ambientPosition = ambientPosition;
+                        m_engineStream = engineStream;
+                        m_enginePlayer = enginePlayer;
+                        m_streamStopRequested = streamStopRequested;
+                        m_soundEnabled = soundEnabled;
+                        m_levelResets = levelResets;
+                        m_retailLevelRecord = retailLevelRecord;
+                        m_engines = engines;
+                        m_skidPitches = skidPitches;
+                        m_roadPitches = roadPitches;
+                        m_effect20Pitches = effect20Pitches;
+                        m_selectorPitches = selectorPitches;
+                        m_selectorRepeats = selectorRepeats;
+                        m_effect32Voices = effect32Voices;
+                        m_playerEffect32Voices = playerEffect32Voices;
+                        m_effect4Voices = effect4Voices;
+                        m_effect8Voices = effect8Voices;
+                        m_alternateEngineVoices = alternateEngineVoices;
+                        m_listeners = listeners;
+                        m_emitters = emitters;
+                        m_tornado = tornado;
+                        m_tornadoCommands += tornadoCommands;
+                        m_shotRandom = shotRandom;
+                        m_shotRequests += shotRequests;
+                        m_shotStarts += shotStarts;
+                        m_lastShotPitch = lastShotPitch;
+                        m_engineAliasesReady = engineAliasesReady;
+                        m_engineUpdates = engineUpdates;
+                        m_environmentEnabled = environmentEnabled;
