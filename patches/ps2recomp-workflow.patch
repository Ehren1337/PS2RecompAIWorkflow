+        default: return false;
+        }
+        if ((loop.action == Action::Start || loop.action == Action::Update) &&
+            (loop.pitch > 0x3fff || loop.left < -0x4000 || loop.left > 0x3fff ||
+             loop.right < -0x4000 || loop.right > 0x3fff)) return false;
+    }
+    auto next = m_impl->voices;
+    for (unsigned voice = 0; voice < voices.size(); ++voice)
+    {
+        if (!voices[voice].empty())
+        {
+            next[voice] = {};
+            next[voice].pcm = std::make_shared<const std::vector<int16_t>>(voices[voice]);
+            any = true;
+        }
+        const auto &update = loops[voice];
+        if (update.action == Action::Keep) continue;
+        any = true;
+        auto &target = next[voice];
+        if (update.action == Action::Stop) { target = {}; continue; }
+        // A finite voice may complete on the audio thread after the owner read
+        // its active mask. Do not resurrect it or reject unrelated batch work.
+        if (update.action == Action::Update && !target.loop) continue;
+        if (update.action == Action::Start)
+        {
+            target = {};
+            target.loop = std::make_shared<const std::vector<int16_t>>(update.samples);
+            target.loopStart = update.loopStart;
+            target.repeats = update.repeats;
+            target.adsr1 = update.adsr1;
+            target.adsr2 = update.adsr2;
+        }
+        target.pitch = update.pitch;
+        target.left = update.left;
+        target.right = update.right;
+    }
+    if (!any) return true;
+    if (!m_impl->voicesRequested) ++m_impl->voiceGeneration;
+    m_impl->voices = std::move(next);
+    m_impl->voicesRequested = true;
+    return true;
+#endif
+}
