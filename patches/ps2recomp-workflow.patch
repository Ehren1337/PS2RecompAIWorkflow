+        uint32_t peakQueued = 0;
+    };
+    BatchStats GetBatchStats() const;
+    void Flush(); // Submit queued draws; readback explicitly waits for completion.
+    void WaitForCompletion(); // FINISH without copying the VRAM mirror to CPU.
+    void UploadVram(std::span<const uint8_t> bytes);
+    void DownloadVram(std::span<uint8_t> bytes);
+    void DownloadVramPages(std::span<uint8_t> bytes, std::span<const uint16_t> pages);
+    // One immutable 64 KiB snapshot, submitted early without a CPU wait. The
+    // adapter must prove its pages have not been written since this capture.
+    void PrefetchVramRegion(uint16_t firstPage);
+    bool ReadPrefetchedVramPages(std::span<uint8_t> bytes, std::span<const uint16_t> pages);
+    // Decode only displayed pixels on GPU. Reuses tile-index scratch after
+    // flushing draws and the existing staging buffer; never modifies GS VRAM.
