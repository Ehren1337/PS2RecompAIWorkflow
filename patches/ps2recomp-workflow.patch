+        {
+            if (state->work) throw std::runtime_error("Rumble dev AI: nested operation");
+            state->work = this;
+        }
+        ~Work()
+        {
+            restore();
+            state->initializingPlayer = state->initializingAi = state->originalInput = false;
+            state->work = nullptr;
+        }
+        void restore() noexcept
+        {
+            if (!overlay) return;
+            std::memcpy(ram + car + 0x158, &state->player, 4);
+            std::memcpy(ram + kAiHead, &oldHead, 4);
+            std::memcpy(ram + car + 0x15c, &oldNext, 4);
+            std::memcpy(ram + kDifficultyScale, &oldScale, 4);
+            ram[car + 0xc6] = oldType;
+            ram[entry + 5] = oldDifficulty;
+            if (initOverlay)
+            {
+                std::memcpy(ram + 0x1f27e0, oldStart, 16);
+                std::memcpy(ram + car, oldDirection, 16);
+                std::memcpy(ram + car + 0x11c, &oldYaw, 4);
+            }
+            overlay = initOverlay = false;
+        }
+        void swap(bool initializing)
+        {
