+
+bool IsPalette(uint32_t psm)
+{
+    return psm == GS_PSM_T8 || psm == GS_PSM_T4 || psm == GS_PSM_T8H ||
+        psm == GS_PSM_T4HL || psm == GS_PSM_T4HH;
+}
+
+bool SupportedColorTexture(uint32_t psm)
+{
+    return psm == GS_PSM_CT32 || psm == GS_PSM_CT24 || psm == GS_PSM_CT16 || psm == GS_PSM_CT16S;
