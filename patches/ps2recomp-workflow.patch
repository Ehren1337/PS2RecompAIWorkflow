+#endif
+
+        using Clock = std::chrono::steady_clock;
+        struct Rounding
+        {
+            std::fenv_t saved;
+            bool captured = std::fegetenv(&saved) == 0;
+            bool valid = captured && std::fesetround(FE_TOWARDZERO) == 0;
+            ~Rounding() { if (captured) std::fesetenv(&saved); }
+        };
+        struct Work
+        {
+            Packet output;
+            Clock::time_point start;
+            const VU1State *owner = nullptr;
+            VU1State entry{};
+            uint32_t index = 0;
+            std::array<uint64_t, 4> lastCheckedNativeCalls{};
+            bool multiGroup = false;
+            bool results = false;
+        };
+        thread_local Work work;
+        struct ClipWork
+        {
+            ClipPacket output;
+            ClipTransfers transfers;
+            bool hasTransfers = false;
+            const VU1State *owner = nullptr;
+            Clock::time_point start;
+            std::array<uint64_t, 12> lastCheckExecution{};
+            bool results = false;
+        };
+        thread_local ClipWork clipWorkNative;
+        unsigned clipIndex(uint32_t pc)
+        { return pc == 0x24c0 ? 5 : pc == 0xdb0 ? 4 : pc == 0x840 ? 3 : pc == 0x400 ? 2 : pc == 0xb38 ? 1 : 0; }
+        ClipNativeStats &clipStats(uint32_t pc, bool results)
+        {
+            if (results) return resultsNativeStats[clipIndex(pc)];
+            return pc == 0x24c0 ? quadNativeStats : pc == 0xdb0 ? dualBasisNativeStats : pc == 0x840 ? reflectLitNativeStats :
+                pc == 0x400 ? litNativeStats : pc == 0xb38 ? reflectNativeStats : clipNativeStats;
+        }
+
+        thread_local uint32_t clipBuildRejectLine = 0;
+        thread_local bool clipCaptureRejected = false;
+        thread_local ClipBoundarySample *clipWork = nullptr;
+        thread_local const VU1State *clipOwner = nullptr;
+        bool nativeEnabled()
+        {
+            static const bool enabled = [] {
+                const char *value = std::getenv("PS2_RUMBLE_NATIVE_VU");
+                return value && std::strcmp(value, "1") == 0;
+            }();
+            return enabled;
+        }
+        bool matchesProgram(const uint8_t *code, uint32_t size, PS2Memory *memory)
+        {
+            if (!memory || !code || size != 16384 || code != memory->getVU1Code()) return false;
+            struct Cache { const uint8_t *code = nullptr; PS2Memory *memory = nullptr; uint64_t generation = 0; bool matched = false; };
+            thread_local Cache cache;
+            const uint64_t generation = memory->getVU1CodeGeneration();
+            if (cache.code != code || cache.memory != memory || cache.generation != generation)
+            {
+                uint64_t hash = UINT64_C(14695981039346656037);
+                for (uint32_t i = 0; i < size; ++i) hash = (hash ^ code[i]) * UINT64_C(1099511628211);
+                cache = {code, memory, generation, hash == UINT64_C(0xa1a24307237d2123)};
+            }
+            return cache.matched;
+        }
+        uint32_t word(const uint8_t *data, uint32_t index)
+        {
+            uint32_t value;
+            std::memcpy(&value, data + index * 4u, 4);
+            return value;
+        }
+        bool operand(float &value, bool saturate = false)
+        {
+            uint32_t bits = std::bit_cast<uint32_t>(value);
+            const auto exponent = (bits >> 23) & 255u;
+            if (exponent == 255u)
+            {
+                if (!saturate) return false;
+                value = std::bit_cast<float>((bits & 0x80000000u) | 0x7f7fffffu);
+            }
+            if (!exponent) value = std::bit_cast<float>(bits & 0x80000000u);
+            return true;
+        }
+        bool rounded(double value, float &out)
+        {
+            const uint64_t raw = std::bit_cast<uint64_t>(value);
+            const uint64_t magnitude = raw & UINT64_C(0x7fffffffffffffff);
+            // IEEE magnitudes are ordered. This rejects infinities/NaNs too,
+            // without strict-FP CRT classification calls for every vector lane.
+            constexpr uint64_t maximum = std::bit_cast<uint64_t>(double(std::numeric_limits<float>::max()));
+            constexpr uint64_t minimum = std::bit_cast<uint64_t>(double(std::numeric_limits<float>::min()));
+            if (magnitude > maximum) return false;
+            if (magnitude < minimum)
+                out = std::bit_cast<float>(uint32_t(raw >> 32) & 0x80000000u);
+            else
+                out = static_cast<float>(value); // Strict FP, FE_TOWARDZERO.
+            return true;
+        }
+        // Shared by the validated lighting specializations. Inputs are
+        // normalized first. This domain excludes arithmetic overflow/underflow,
+        // while retaining separate product/sum rounding and observable flags.
+        template<bool needFlags = true>
+        bool boundedLightingFmac(float a, float b, float addend, bool hasBase, bool subtract,
+            uint32_t &result, uint32_t &currentFlags, uint32_t &productFlags)
+        {
+            const auto bounded = [](float v) {
+                const uint32_t magnitude = std::bit_cast<uint32_t>(v) & 0x7fffffffu;
+                return !magnitude || (magnitude >= 0x2f800000u && magnitude <= 0x4f800000u);
+            };
+            if (!bounded(a) || !bounded(b) || (hasBase && !bounded(addend))) return false;
+            // [2^-32,2^32] products lie on a 2^-110 grid. A following
+            // addition/subtraction cannot create a nonzero subnormal float.
+            if constexpr (!needFlags)
+            {
+                const float product = a * b;
+                const float value = hasBase ? (subtract ? addend - product : addend + product) : product;
+                // This bounded domain can set only S/Z. Once both sticky bits
+                // are set and no current/MAC flags survive, their exact-result
+                // calculation adds no state (VU manual pp39-40). Keep separate
+                // float product/sum rounding. An exact cancellation implies a
+                // representable product, so its signed zero is also preserved.
+                result = std::bit_cast<uint32_t>(value);
+                currentFlags = productFlags = 0;
+                return true;
+            }
+            const double productExact = double(a) * double(b);
+            const float product = a * b;
+            const double exact = hasBase ? (subtract ? double(addend) - productExact : double(addend) + productExact) : productExact;
+            const float value = hasBase ? (subtract ? addend - product : addend + product) : product;
+            const uint64_t raw = std::bit_cast<uint64_t>(exact);
+            const uint64_t rawProduct = std::bit_cast<uint64_t>(productExact);
+            currentFlags = (uint32_t(raw >> 62) & 2u) | uint32_t((raw << 1) == 0);
+            productFlags = (uint32_t(rawProduct >> 62) & 2u) | uint32_t((rawProduct << 1) == 0);
+            result = (currentFlags & 1u) ? ((currentFlags & 2u) << 30) : std::bit_cast<uint32_t>(value);
+            return true;
+        }
+
+        // Per-packet cache for immutable matrices. Call only when S/Z sticky
+        // flags are saturated and this transform's current/MAC flags are dead.
+        struct BoundedMatrix
+        {
+            using Vec = std::array<uint32_t, 4>;
+            std::array<std::array<float, 4>, 4> rows{};
+            bool ready = false, bounded = true;
+
+            bool evaluate(const std::array<Vec, 32> &vf, unsigned first,
+                const Vec &value, Vec &acc, Vec &result)
+            {
+                const auto inBounds = [](float lane) {
+                    const float magnitude = std::abs(lane);
+                    return magnitude == 0 || (magnitude >= 0x1p-32f && magnitude <= 0x1p32f);
+                };
+                if (!ready)
+                {
+                    for (unsigned row = 0; row < 4; ++row)
+                        for (unsigned c = 0; c < 4; ++c)
+                        {
+                            float lane = std::bit_cast<float>(vf[first + row][c]);
+                            const bool supported = operand(lane);
+                            rows[row][c] = lane;
+                            bounded &= supported && inBounds(lane);
+                        }
+                    ready = true;
+                }
+                std::array<float, 3> position{};
+                bool supported = bounded;
+                for (unsigned c = 0; c < 3; ++c)
+                {
+                    position[c] = std::bit_cast<float>(value[c]);
+                    supported &= operand(position[c]) && inBounds(position[c]);
+                }
+                if (!supported) return false;
+                // Products/partial sums remain normal or zero. Translation*1
+                // is normalized translation; keep separate MUL/ADD rounding.
+#if defined(PS2_RUMBLE_SSE_TRANSFORM)
+                const auto packed = saturatedTransformSSE(rows[0].data(), rows[1].data(),
+                    rows[2].data(), rows[3].data(), position.data(), acc.data());
+                std::memcpy(result.data(), &packed, sizeof(packed));
+#else
+                for (unsigned c = 0; c < 4; ++c)
+                {
+                    const float z = rows[2][c] * position[2];
+                    const float az = rows[3][c] + z;
+                    const float y = rows[1][c] * position[1];
+                    const float ay = az + y;
+                    acc[c] = std::bit_cast<uint32_t>(ay);
+                    const float x = rows[0][c] * position[0];
+                    result[c] = std::bit_cast<uint32_t>(ay + x);
+                }
+#endif
+                return true;
+            }
+        };
+
+        uint32_t flags(long double value)
+        {
+            if constexpr (sizeof(long double) == sizeof(uint64_t) &&
+                std::numeric_limits<long double>::is_iec559 && std::numeric_limits<long double>::digits == 53)
+            {
+                uint64_t raw;
+                std::memcpy(&raw, &value, sizeof(raw));
+                const uint64_t magnitude = raw & UINT64_C(0x7fffffffffffffff);
+                const uint32_t sign = uint32_t(raw >> 62) & 2u;
+                constexpr uint64_t maximum = std::bit_cast<uint64_t>(double(std::numeric_limits<float>::max()));
+                constexpr uint64_t minimum = std::bit_cast<uint64_t>(double(std::numeric_limits<float>::min()));
+                if (!magnitude) return sign | 1u;
+                if (magnitude < minimum) return sign | 5u;
+                // Preserve the old comparison semantics for NaN: no O flag.
+                if (magnitude > maximum && magnitude <= UINT64_C(0x7ff0000000000000)) return sign | 8u;
+                return sign;
+            }
+            // Platforms with extended long double keep their original precision.
+            uint32_t result = std::signbit(value) ? 2u : 0u;
+            if (value == 0) return result | 1u;
+            if (std::fabs(value) < std::numeric_limits<float>::min()) return result | 5u;
+            if (std::fabs(value) > std::numeric_limits<float>::max()) return result | 8u;
+            return result;
+        }
+    }
+
+    bool buildPacket(const uint8_t *data, uint32_t top, const VU1State &entry, Packet &out, bool referenceTransform)
+    {
+        if (!data || top >= 1024) return false;
+        Rounding rounding;
+        if (!rounding.valid) return false;
+        float matrix[20];
+        std::memcpy(matrix, entry.vf, sizeof(matrix));
+        for (float &x : matrix) if (!operand(x)) return false;
+        if (matrix[0] != 0 || matrix[1] != 0 || matrix[2] != 0 || matrix[3] != 1) return false;
+        const uint32_t groups = word(data, top * 4) & 65535u;
+        const uint32_t prefix = word(data, top * 4 + 1) & 65535u;
+        if (!groups || groups > 32 || prefix >= 224 || top + 224 + prefix >= 1024) return false;
+        out.compared.fill(0);
+        std::memcpy(out.vf.data(), entry.vf, sizeof(entry.vf));
+        std::memcpy(out.vi.data(), entry.vi, sizeof(entry.vi));
+        out.vfCompared.fill(1);
+        out.scalar[5] = std::bit_cast<uint32_t>(entry.p);
+        out.scalar[6] = std::bit_cast<uint32_t>(entry.i);
+        out.scalar[7] = entry.r;
+        out.scalar[9] = entry.clip;
+        out.groups = groups; out.prefix = prefix; out.vertices = 0;
+        uint32_t sticky = 0, currentStatus = 0;
+        const auto bounded = [](float value) {
+            const uint32_t magnitude = std::bit_cast<uint32_t>(value) & 0x7fffffffu;
+            return !magnitude || (magnitude >= 0x2f800000u && magnitude <= 0x4f800000u);
+        };
+        bool boundedMatrix = !referenceTransform;
+        for (unsigned i = 4; i < 20; ++i) boundedMatrix &= bounded(matrix[i]);
+        const auto transform = [&](const float *position, float *transformed) {
+            if (boundedMatrix && bounded(position[0]) && bounded(position[1]) && bounded(position[2]))
+            {
+                // The bounded transform can add only sign/zero sticky bits.
+                // Once those are saturated, preserve the separate rounded
+                // products/sums and ACC without reclassifying exact results.
+                if ((sticky & 3u) == 3u)
+                {
+#if defined(PS2_RUMBLE_SSE_TRANSFORM)
+                    _mm_storeu_ps(transformed, saturatedTransformSSE(matrix + 4, matrix + 8, matrix + 12,
+                        matrix + 16, position, out.scalar.data()));
+#else
+                    for (unsigned c = 0; c < 4; ++c)
+                    {
+                        float acc = matrix[16 + c];
+                        for (int axis = 2; axis >= 0; --axis)
+                        {
+                            const float product = matrix[(axis + 1) * 4 + c] * position[axis];
+                            acc = acc + product;
+                            if (axis == 1) out.scalar[c] = std::bit_cast<uint32_t>(acc);
+                        }
+                        transformed[c] = acc;
+                    }
+#endif
+                    return true;
+                }
+                // Same bound as the clip transform: products are multiples of
+                // 2^-110, and all intermediate magnitudes stay below 2^66.
+                // No nonzero result can underflow/overflow binary32. Preserve
+                // separate product/sum rounding and exact-result sign/zero flags.
+                for (unsigned c = 0; c < 4; ++c)
+                {
+                    float acc = matrix[16 + c];
+                    const uint32_t initial = std::bit_cast<uint32_t>(acc);
+                    sticky |= ((initial >> 30) & 2u) | uint32_t((initial << 1) == 0);
+                    for (int axis = 2; axis >= 0; --axis)
+                    {
+                        const float coefficient = matrix[(axis + 1) * 4 + c];
+                        const double productExact = double(coefficient) * double(position[axis]);
+                        const double exact = double(acc) + productExact;
+                        const float product = coefficient * position[axis];
+                        const float sum = acc + product;
+                        const uint32_t productBits = std::bit_cast<uint32_t>(product);
+                        const uint64_t raw = std::bit_cast<uint64_t>(exact);
+                        const uint32_t f = (uint32_t(raw >> 62) & 2u) | uint32_t((raw << 1) == 0);
+                        sticky |= ((productBits >> 30) & 2u) | uint32_t((productBits << 1) == 0) | f;
+                        acc = (f & 1u) ? std::bit_cast<float>((f & 2u) << 30) : sum;
+                        if (axis == 1) out.scalar[c] = std::bit_cast<uint32_t>(acc);
+                    }
+                    transformed[c] = acc;
+                }
+                return true;
+            }
+            for (uint32_t c = 0; c < 4; ++c)
+            {
+                float acc = matrix[16 + c];
+                sticky |= flags(acc);
+                for (int axis = 2; axis >= 0; --axis)
