+                                // active engine/ambient playback remains unsupported.
+                                ++levelResets;
+                                if (m_retail)
+                                {
+                                    // Retail 0x934C consumes a record, unlike
+                                    // February. Own its environment and engine
+                                    // configuration for subsequent level work.
+                                    std::copy_n(record, 64, retailLevelRecord.begin());
+                                    engines = {};
+                                    skidPitches = {};
+                                    roadPitches = {};
+                                    engineAliasesReady = false;
+                                    for (unsigned engine = 0; engine < record[3]; ++engine)
+                                    {
+                                        engines[engine][0] = record[7 + engine * 4];
+                                        engines[engine][2] = record[6 + engine * 4];
