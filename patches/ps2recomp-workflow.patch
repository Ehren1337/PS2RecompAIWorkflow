+                        variants[definition] = uint8_t(selected);
+                        if (!at) return true; // A018/DBF0 failed key-on releases its reservation.
+                        const auto *tone = bank.header.data() + at + 4;
+                        if (!prepareEngineLoop(bank, tone, update, false)) return false;
+                        owner.basePitch = readHalf(tone + 14);
+                        owner.repeats = update.repeats;
+                        update.action = PcmLoopVoiceUpdate::Action::Start;
+                        owner.handle = uint8_t(slot + 1);
+                    }
+                    else if (update.action != PcmLoopVoiceUpdate::Action::Start)
+                        update.action = PcmLoopVoiceUpdate::Action::Update;
+                    const auto pitch = (uint64_t(owner.basePitch) * scale) >> 16;
+                    if (pitch > 0x3fff) return false;
+                    update.pitch = uint16_t(pitch);
+                    update.repeats = owner.repeats;
+                    update.left = fixedVolume(left); update.right = fixedVolume(right);
+                    occupied |= uint64_t(1) << slot;
+                    work = true;
+                    return true;
+                };
+                if (!layers[0].handle)
+                {
+                    // D40C initializes both background channels together; a
+                    // half-completed pair requires explicit replacement ordering.
+                    if (layers[1].handle) return false;
+                    const int gain = status[4] * 64;
+                    if (!play(0, background, gain, 0, 0x10000) ||
+                        !play(1, background, 0, gain, 0xff00)) return false;
+                }
+                const auto distance = engineDistance(record + 4, listeners[0].data());
+                if (distance < 0) return false;
+                int64_t attenuation = 0;
+                if (distance <= 0x3c000)
+                    attenuation = distance <= 0x8000 ? 0x10000 :
+                        0x10000 - (((distance - 0x8000) * 0x4ec4) >> 16);
+                if (!attenuation) return stop(2) && stop(3);
+                std::array<int64_t, 3> rotated{};
+                for (unsigned column = 0; column < 3; ++column)
+                    for (unsigned row = 0; row < 3; ++row)
+                    {
+                        const auto relative = int64_t(int32_t(readWord(record + 4 + row * 4))) -
+                            int32_t(readWord(listeners[0].data() + row * 4));
+                        const auto coefficient = int32_t(readWord(listeners[0].data() + 12 + row * 12 + column * 4));
+                        if (relative < -0x1000000 || relative > 0x1000000 || coefficient < -0x20000 || coefficient > 0x20000) return false;
+                        rotated[column] += (relative * coefficient) >> 16;
+                    }
+                const auto magnitude = rotated[0] < 0 ? -rotated[0] : rotated[0];
+                const auto panMagnitude = distance < 2 ? 0 : (magnitude * (0x80000000ull / (distance >> 1))) >> 16;
+                const int64_t pan = rotated[0] < 0 ? int64_t(panMagnitude) : -int64_t(panMagnitude);
+                const int64_t baseGain = (0xdc18 * uint32_t(status[4]) * 128u) >> 16;
+                const auto gain = (baseGain * attenuation) >> 16;
+                auto left = (gain * (0x10000 - pan)) >> 16;
+                auto right = (gain * (0x10000 + pan)) >> 16;
+                if (rotated[2] < -0x1000 && status[1] == 2) { if (left < right) left = -left; else right = -right; }
+                if (left < INT32_MIN || left > INT32_MAX || right < INT32_MIN || right > INT32_MAX) return false;
+                return play(2, spatial, left / 2, right / 2, 0x10000) &&
+                    play(3, spatial, left / 2, right / 2, 0xf558);
+            }
