+        ps2WriteInspectorFramePng(png.get(), static_cast<size_t>(size), false);
+        if (frames.size() == 8)
+        {
+            const int labelHeight = 20;
+            Image sheet = GenImageColor(int(width) * 2, (int(height) + labelHeight) * 4, BLACK);
+            try
+            {
+                for (size_t index = 0; index < frames.size(); ++index)
+                {
+                    auto &sample = frames[index];
+                    const int x = int(index % 2) * int(width);
+                    const int y = int(index / 2) * (int(height) + labelHeight);
+                    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(sample.time - frames.front().time).count();
+                    const std::string label = "#" + std::to_string(index + 1) + " +" + std::to_string(elapsed) +
