+                                        lastBankHash *= 1099511628211ull;
+                                    }
+                            }
+                        }
+                        if (m_retail && record[0] == 16)
+                        {
+                            // 0x934C -> 0x22C clears the cue's voice settings
+                            // and keys off all core-0 voices. Later key-ons are
+                            // silent until module initialization restores them.
+                            cueEnabled = false;
+                            cueMask = 0;
+                            stopCue = true;
+                        }
+                        if (m_retail && (record[0] == 5 || record[0] == 17))
+                        {
+                            // 0x9EDC(0) -> 0xDF28(0) keys off both SPU cores.
+                            // Unlike level init it does not clear cue settings.
+                            cueMask = 0;
+                            stopCue = true;
+                        }
+                        if (record[0] == 11 || (m_retail && record[0] == 1))
+                        {
+                            auto &stream = record[0] == 1 ? m_music : m_movie;
+                            idle = idle && !startMovie && !stopMovie && !startMusic && !stopMusic &&
+                                !m_movie.playing && !m_music.playing && stream.open && stream.count != 0;
