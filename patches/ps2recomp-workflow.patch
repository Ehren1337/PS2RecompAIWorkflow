+namespace rumble_object_diagnostics
+{
+    struct Entry
+    {
+        std::atomic<uint64_t> stamp{0}, calls{0}, completed{0}, interrupted{0};
+        std::atomic<uint64_t> completedNanoseconds{0}, maximumNanoseconds{0};
+        std::atomic<uint32_t> model{0}, object{0};
+        std::atomic<uint64_t> submittedTags{0}, submittedBytes{0};
+        std::atomic<uint64_t> vuCompleted{0}, vuInterrupted{0}, vuNanoseconds{0}, vuMaximumNanoseconds{0};
+    };
+    // Single EE writer, bounded table; no allocations, samples, images or files.
+    std::array<Entry, 512> entries{};
+    std::atomic<uint64_t> overflow{0};
+    std::atomic<uint64_t> emittedTags{0}, matchedTags{0}, unownedTags{0}, mismatchedTags{0}, tagEvictions{0};
+    std::atomic<uint64_t> unownedVuCompleted{0}, unownedVuInterrupted{0}, unownedVuNanoseconds{0};
