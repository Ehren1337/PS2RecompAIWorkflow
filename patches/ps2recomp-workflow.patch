+    // exact product for both accumulated-result flags and product sticky flags.
+    if (!((arithmetic <= 0x0fu) || (arithmetic >= 0x18u && arithmetic <= 0x1cu)))
+    {
+        normalizeFmacResult(result, dest, laneFlags);
+        return calculateFmacProductSticky(dest);
+    }
+    const auto *left = m_state.vf[FS(upper)];
+    const long double right = normalizeOperand(arithmetic == 0x1cu
+        ? m_state.q : m_state.vf[FT(upper)][arithmetic & 3u]);
+    const auto lanes = [&]<unsigned Mode>()
+    {
+        uint32_t sticky = 0;
+        for (uint32_t component = 0; component < 4; ++component)
+        {
+            laneFlags[component] = 0;
+            if (!(dest & laneForComponent(component))) continue;
+            const long double a = normalizeOperand(left[component]);
+            long double exact;
+            if constexpr (Mode == 0) exact = a + right;
+            else if constexpr (Mode == 1) exact = a - right;
+            else
+            {
+                const long double product = a * right;
+                if constexpr (Mode == 2) exact = product;
+                else
+                {
+                    const long double acc = normalizeOperand(m_state.acc[component]);
+                    if constexpr (Mode == 3) exact = acc + product;
+                    else exact = acc - product;
+                    // Only the flags are used; no redundant float multiply.
+                    float unused = 0;
+                    sticky |= normalizeFmacExactResult(unused, product);
+                }
+            }
+            laneFlags[component] = normalizeFmacExactResult(result[component], exact);
+        }
+        return sticky;
+    };
+    if (arithmetic <= 3) return lanes.template operator()<0>();
+    if (arithmetic <= 7) return lanes.template operator()<1>();
+    if (arithmetic <= 11) return lanes.template operator()<3>();
+    if (arithmetic <= 15) return lanes.template operator()<4>();
+    return lanes.template operator()<2>();
