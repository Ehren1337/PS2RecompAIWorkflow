+                        if (status[7] != batch[11]) status[7] = volume(batch[11]);
+                        status[8] = status[9] = volume(batch[12]);
+                        status[10] = volume(batch[14]);
+                        status[11] = engineLevel(status[10]);
+                        // 0x7E70 opcode 10: apply volume commands in record order.
+                        std::array<PcmLoopVoiceUpdate, 48> engineVoices{};
+                        bool engineVoiceWork = false;
+                        // D300 is also called by pause, disable, and level close.
+                        if (pauseVoices || stopCue) tornado = {};
+                        for (unsigned i = 0; i < m_lastBatchCount; ++i)
+                        {
+                            const auto *record = batch.data() + 0x40 + i * 64;
+                            switch (record[0])
+                            {
+                            case 31: status[2] = record[1]; continue; // Retail 0x95D8.
+                            case 32: continue; // Commit all key-ons after batch validation.
+                            case 33: continue; // Stop is idle until a selected preview is admitted.
+                            case 3: case 26: {
+                                // Retail 0x9CB0 consumes RNG even if 0x9ACC finds
+                                // the module disabled, the alias absent or the source out of range.
+                                auto &shot = shots[shotRequests++];
+                                shot.status = status;
+                                shot.enabled = soundEnabled;
+                                shot.emitter.active = true;
+                                shot.emitter.alias = readHalf(record + 2);
+                                if (record[0] == 3)
+                                {
+                                    // 0x9C7C passes explicit Q16 gain/pitch to
+                                    // 0x9ACC without the 0x9CB0 random draw.
+                                    std::copy_n(record + 8, 12, shot.emitter.position.begin());
