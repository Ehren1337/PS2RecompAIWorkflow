+            bool prepareBankOneShot(uint16_t alias, std::vector<uint8_t> &variants, std::vector<int16_t> &pcm)
+            {
+                if (!alias || alias >= 0x180) return false;
+                size_t definition = m_soundDefinitions.size();
+                // 0x9D80 writes aliases only on a definition's first registration;
+                // later definitions overwrite collisions in the 0x180-byte map.
+                for (size_t i = m_soundDefinitions.size(); i-- > 0;)
+                {
+                    const auto &parameters = m_soundDefinitions[i].parameters;
+                    for (unsigned slot = 0; slot < 4; ++slot)
+                        if (readHalf(parameters.data() + 8 + slot * 2) == alias) definition = i;
+                    if (definition != m_soundDefinitions.size()) break;
+                }
+                if (definition == m_soundDefinitions.size()) return false;
+                const auto &choices = m_soundDefinitions[definition].variants;
+                if (choices.empty()) return false;
+                // 0xA018 increments before selection; a single variant uses zero.
+                const unsigned selected = (variants[definition] + 1) % choices.size();
+                const auto &choice = choices[selected];
+                const auto &bank = m_soundBanks[choice.bank];
+                const auto program = readWord(bank.header.data() + 16 + choice.program * 4);
+                // Registration can retain empty program slots. Until the
+                // failed-key-on lifecycle is modeled, refuse their playback.
+                if (!program) return false;
+                const auto *tone = bank.header.data() + program + 4; // 0xDBF0 always tone zero.
+                const auto start = readWord(tone + 16);
+                const auto sample = std::find_if(bank.samples.begin(), bank.samples.end(),
+                    [start](const BankSample &s) { return s.offset == start; });
+                if (sample == bank.samples.end() || sample->repeats) return false;
+                const unsigned pitch = readHalf(tone + 14);
+                const unsigned adsr1 = readHalf(tone + 10), adsr2 = readHalf(tone + 12);
+                if (!pitch || pitch > 0x3fff) return false;
+                const size_t sourceFrames = size_t(sample->bytes / 16) * 28;
+                const uint64_t frames = (uint64_t(sourceFrames) * 4096 + pitch - 1) / pitch;
+                if (!frames || frames > 262144) return false;
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                std::vector<int16_t> source;
+                source.reserve(sourceFrames);
+                int64_t previous = 0, older = 0;
+                for (unsigned offset = start; offset < start + sample->bytes; offset += 16)
+                {
+                    const auto *block = bank.body.data() + offset;
+                    const auto &coefficient = coefficients[block[0] >> 4];
+                    for (unsigned n = 0; n < 28; ++n)
+                    {
+                        int nibble = (block[2 + n / 2] >> (4 * (n & 1))) & 15;
+                        if (nibble & 8) nibble -= 16;
+                        const int64_t value = ((nibble * 4096) >> (block[0] & 15)) +
+                            (previous * coefficient[0] + older * coefficient[1]) / 64;
+                        older = previous; previous = value;
+                        source.push_back(int16_t(std::clamp<int64_t>(value, -32768, 32767)));
+                    }
+                }
+                // Python checked the decoder independently against FFmpeg.
+                // Pitch/envelope rendering uses the original tone registers at
+                // the 48-kHz SPU2 clock. Linear interpolation is provisional;
+                // Gaussian interpolation, reverb and hardware timing are unverified.
+                pcm.resize(size_t(frames) * 2);
+                int level = 0, phase = 0, counter = 0;
+                for (size_t frame = 0; frame < frames; ++frame)
+                {
+                    const int shift = phase == 0 ? (adsr1 >> 10) & 31 :
+                        phase == 1 ? (adsr1 >> 4) & 15 : (adsr2 >> 8) & 31;
+                    const int step = phase == 0 ? (adsr1 >> 8) & 3 : phase == 1 ? 0 : (adsr2 >> 6) & 3;
+                    const bool decreasing = phase == 1 || (phase == 2 && (adsr2 & 0x4000));
+                    const bool exponential = phase == 1 || ((phase == 0 ? adsr1 : adsr2) & 0x8000);
+                    int delta = (decreasing ? -8 + step : 7 - step) * (1 << std::max(0, 11 - shift));
+                    int increment = 0x8000 >> std::max(0, shift - 11);
+                    if (exponential && !decreasing && level > 0x6000)
+                    {
+                        delta /= shift < 10 ? 4 : shift == 10 ? 2 : 1;
+                        increment /= shift >= 11 ? 4 : shift == 10 ? 2 : 1;
+                    }
+                    else if (exponential && decreasing) delta = (delta * level) >> 15;
+                    if (phase == 1 || shift * 4 + step != 127) increment = std::max(increment, 1);
+                    counter += increment;
+                    if (counter >= 0x8000)
+                    {
+                        counter -= 0x8000;
+                        level = std::clamp(level + delta, 0, 32767);
+                    }
+                    if ((phase == 0 && level == 32767) ||
+                        (phase == 1 && level <= int(((adsr1 & 15) + 1) * 0x800)))
+                    { ++phase; counter = 0; }
+                    const size_t index = frame * pitch / 4096;
+                    const int fraction = int(frame * pitch % 4096);
+                    const int a = source[index], b = index + 1 < source.size() ? source[index + 1] : 0;
+                    const int value = (a * (4096 - fraction) + b * fraction) / 4096;
+                    const int16_t scaled = int16_t((((int64_t(value) * level) >> 15) * 0x3ffe) >> 15);
+                    pcm[frame * 2] = pcm[frame * 2 + 1] = scaled;
+                }
+                variants[definition] = uint8_t(selected);
+                return true;
+            }
