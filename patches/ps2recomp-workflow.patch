+uint RoundChannel(float value)
+{
+    value = clamp(value, 0.0, 255.0);
+    uint whole = uint(value);
+    return min(whole + ((value - float(whole)) >= 0.5 ? 1u : 0u), 255u);
+}
+uint4 SampleTexture(DrawParams draw, float2 uv)
+{
+    uint4 color = uint4(0, 0, 0, 0);
+    if ((draw.Mode.y & 4) == 0)
+        color = SamplePoint(draw, int(uv.x), int(uv.y));
+    else
+    {
+        precise float2 samplePos = uv - 0.5;
+        int2 low = int2(floor(samplePos));
+        precise float2 f = samplePos - float2(low);
+        float4 a = float4(SamplePoint(draw, low.x, low.y));
+        // Zero-weight neighbors cannot affect integer color channels. Avoid
+        // reading them: the host sprite footprint uses these exact tap rules
+        // to keep adjacent render targets disjoint at texel-center edges.
+        precise float4 top = a;
+        if (f.x != 0.0)
+        {
+            float4 b = float4(SamplePoint(draw, low.x + 1, low.y));
+            top = a + (b - a) * f.x;
+        }
+        precise float4 result = top;
+        if (f.y != 0.0)
+        {
+            float4 c = float4(SamplePoint(draw, low.x, low.y + 1));
+            precise float4 bottom = c;
+            if (f.x != 0.0)
+            {
+                float4 d = float4(SamplePoint(draw, low.x + 1, low.y + 1));
+                bottom = c + (d - c) * f.x;
+            }
+            result = top + (bottom - top) * f.y;
+        }
+        // Match CPU lround without rounding a value just below 0.5 up during a
+        // float + 0.5 operation, and without requiring shader float64 support.
+        color = uint4(RoundChannel(result.r), RoundChannel(result.g), RoundChannel(result.b), RoundChannel(result.a));
+    }
+    return color;
+}
+uint4 Combine(DrawParams draw, uint4 shade, uint4 texel)
