+bool PS2AudioBackend::queuePcmVoices(const int16_t *samples, uint32_t frames, uint64_t mask)
+{
+#if defined(PLATFORM_VITA)
+    return false;
+#else
+    std::lock_guard lock(m_mutex);
+    if (!m_audioReady || m_impl->voicesFailed || !samples || !frames || frames > 65536 ||
+        !mask || (mask >> 48)) return false;
+    auto owned = std::make_shared<const std::vector<int16_t>>(samples, samples + size_t(frames) * 2);
+    if (!m_impl->voicesRequested) ++m_impl->voiceGeneration;
+    for (unsigned voice = 0; voice < 48; ++voice)
+        if (mask & (uint64_t(1) << voice)) m_impl->voices[voice] = {owned, 0};
+    m_impl->voicesRequested = true;
+    return true;
+#endif
+}
+
+bool PS2AudioBackend::queuePcmVoiceBatch(const std::array<std::vector<int16_t>, 48> &voices,
+    const std::array<ps2x::iop::PcmLoopVoiceUpdate, 48> &loops,
+        const std::array<ps2x::iop::PcmReverbUpdate, 2> &effects)
+{
+#if defined(PLATFORM_VITA)
+    return false;
+#else
+    std::lock_guard lock(m_mutex);
+    if (!m_audioReady || m_impl->voicesFailed) return false;
+    using Action = ps2x::iop::PcmLoopVoiceUpdate::Action;
+    using EffectAction = ps2x::iop::PcmReverbUpdate::Action;
+    bool any = false;
+    for (const auto &effect : effects)
+    {
+        if (effect.action == EffectAction::Keep || effect.action == EffectAction::Reset) continue;
+        if (effect.action != EffectAction::Configure || !effect.wordCount ||
+            effect.startWord >= PS2ReverbNetwork::kRamWords ||
+            effect.wordCount > PS2ReverbNetwork::kRamWords - effect.startWord ||
+            ((effect.sendLeft | effect.sendRight | effect.externalLeft | effect.externalRight) >> 48)) return false;
+    }
+    // Validate every entry before allocating or touching a playing voice.
+    for (size_t i = 0; i < voices.size(); ++i)
+    {
+        const auto &pcm = voices[i];
+        const auto &loop = loops[i];
+        if (pcm.size() % 2 || pcm.size() > 262144u * 2) return false;
+        if (loop.action != Action::Keep && !pcm.empty()) return false;
+        switch (loop.action)
+        {
+        case Action::Keep:
+        case Action::Stop:
+            if (!loop.samples.empty()) return false;
+            break;
+        case Action::Start:
+            if (loop.samples.empty() || loop.samples.size() > 262144u || loop.loopStart >= loop.samples.size()) return false;
+            if (!loop.repeats && loop.loopStart != 0) return false;
+            break;
+        case Action::Update:
+            if (!loop.samples.empty() || m_impl->voices[i].pcm) return false;
+            if (m_impl->voices[i].loop ? m_impl->voices[i].repeats != loop.repeats : loop.repeats) return false;
+            break;
+        default: return false;
+        }
+        if ((loop.action == Action::Start || loop.action == Action::Update) &&
+            (loop.pitch > 0x3fff || loop.left < -0x4000 || loop.left > 0x3fff ||
+             loop.right < -0x4000 || loop.right > 0x3fff)) return false;
+    }
+    auto next = m_impl->voices;
+    for (unsigned voice = 0; voice < voices.size(); ++voice)
+    {
+        if (!voices[voice].empty())
+        {
+            next[voice] = {};
+            next[voice].pcm = std::make_shared<const std::vector<int16_t>>(voices[voice]);
+            any = true;
+        }
+        const auto &update = loops[voice];
+        if (update.action == Action::Keep) continue;
+        any = true;
+        auto &target = next[voice];
+        if (update.action == Action::Stop) { target = {}; continue; }
+        // A finite voice may complete on the audio thread after the owner read
+        // its active mask. Do not resurrect it or reject unrelated batch work.
+        if (update.action == Action::Update && !target.loop) continue;
+        if (update.action == Action::Start)
+        {
+            target = {};
+            target.loop = std::make_shared<const std::vector<int16_t>>(update.samples);
+            target.loopStart = update.loopStart;
+            target.repeats = update.repeats;
+            target.adsr1 = update.adsr1;
+            target.adsr2 = update.adsr2;
+        }
+        target.pitch = update.pitch;
+        target.left = update.left;
+        target.right = update.right;
+    }
+    // Allocate new processors before committing any part of the transaction.
+    // Existing processors retain their delay RAM and allocate nothing on update.
+    std::array<std::unique_ptr<PS2ReverbProcessor>, 2> prepared;
+    for (unsigned bus = 0; bus < effects.size(); ++bus)
+    {
+        const auto &effect = effects[bus];
+        if (effect.action == EffectAction::Keep) continue;
+        any = true;
+        if (effect.action == EffectAction::Configure && !m_impl->reverbs[bus])
+        {
+            prepared[bus] = std::make_unique<PS2ReverbProcessor>();
+            prepared[bus]->configure(effect.registers, effect.startWord, effect.wordCount, effect.clear);
+        }
+    }
+    if (!any) return true;
+    for (unsigned bus = 0; bus < effects.size(); ++bus)
+    {
+        const auto &effect = effects[bus];
+        if (effect.action == EffectAction::Keep) continue;
+        if (effect.action == EffectAction::Reset)
+        {
+            m_impl->reverbs[bus].reset();
+            m_impl->reverbControls[bus] = {};
+            continue;
+        }
+        if (prepared[bus]) m_impl->reverbs[bus] = std::move(prepared[bus]);
+        else m_impl->reverbs[bus]->configure(effect.registers, effect.startWord, effect.wordCount, effect.clear);
+        m_impl->reverbControls[bus] = effect;
+    }
+    if (!m_impl->voicesRequested) ++m_impl->voiceGeneration;
+    m_impl->voices = std::move(next);
+    m_impl->voicesRequested = true;
+    return true;
+#endif
+}
