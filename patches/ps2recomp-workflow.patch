+        // a first successful wait must not make later copies appear ready.
+        const unsigned scenario = sequence % 6;
+        cpu.WriteVram(GS_PSM_Z24, 16000, 1, 0, 0, 0x123450 + sequence);
+        gpu->WriteVram(GS_PSM_Z24, 16000, 1, 0, 0, 0x123450 + sequence);
