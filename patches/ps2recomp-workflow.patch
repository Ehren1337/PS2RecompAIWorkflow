+                    if (bankVoiceCommands && (stopCue || startMovie || startMusic)) idle = false;
+                    if (idle && cueMask && !loadRetailCue()) idle = false;
+                    if (idle && m_eeSize >= 0x2c0) do
+                    {
+                        auto status = m_status;
+                        auto ambientStream = m_ambientStream;
+                        auto ambientObject = m_ambientObject;
+                        auto ambientPosition = m_ambientPosition;
+                        auto engineStream = m_engineStream;
+                        auto enginePlayer = m_enginePlayer;
+                        auto streamStopRequested = m_streamStopRequested;
+                        auto soundEnabled = m_soundEnabled;
+                        auto levelResets = m_levelResets;
+                        auto retailLevelRecord = m_retailLevelRecord;
+                        auto environmentEnabled = m_environmentEnabled;
+                        if (status[1] != batch[5]) status[1] = static_cast<int8_t>(batch[5]) < 3 ? batch[5] : 0;
+                        if (!m_retail) status[2] = batch[6];
