+                state->ai = state->player + 0x40;
+                state->ready = false; state->decisions = 0;
+                std::memset(ram + state->ai, 0, 0xa0);
+                parent.pc = returnPc;
+                RUNTIME_LOG("[Rumble dev AI] player control allocation extended; autopilot pending");
+                return;
+            case 2:
+                state->originalInput = false;
+                swap(!state->ready);
+                if (!state->ready)
+                {
+                    state->initializingAi = true;
+                    state->reusedAiAllocation = false;
+                    invoke(parent, 0x179e50, {car}, 3);
+                    return;
+                }
+                advance(4, parent);
+                return;
+            case 3:
+                state->initializingAi = false;
+                if (!state->reusedAiAllocation || word(ram, car + 0x158) != state->ai || ram[state->ai + 0x3e] != 2)
+                    throw std::runtime_error("Rumble dev AI: original AI initialization did not match No Mercy");
+                restore(); state->ready = true; swap(false);
+                RUNTIME_LOG("[Rumble dev AI] original NPC logic active for player; difficulty=No Mercy");
+                advance(4, parent);
+                return;
+            case 4: // Original NPC weapon choice, nearby-object search, goal selection, steering.
+            {
+                const uint32_t weapons = (static_cast<int8_t>(ram[car + 0x134]) >= 0 ? 1u : 0u) |
+                                         (static_cast<int8_t>(ram[car + 0x135]) >= 0 ? 2u : 0u);
+                invoke(parent, 0x17f790, {car, ticks, weapons}, 5);
+                return;
+            }
+            case 5: invoke(parent, 0x178140, {car, ticks}, 6); return;
+            case 6: invoke(parent, 0x178c90, {car, ticks}, 7); return;
+            case 7: invoke(parent, 0x1760b0, {ticks}, 8); return;
+            case 8:
+            {
+                const uint32_t physics = word(ram, car + 0xec);
+                checked(physics, 0xa20);
+                float steering, amount, maximum;
+                std::memcpy(&steering, ram + state->ai + 0x2c, 4);
+                std::memcpy(&amount, ram + state->ai + 0x34, 4);
+                std::memcpy(&maximum, ram + physics + 0x4c, 4);
+                const uint8_t mode = ram[state->ai + 0x38];
+                if (!std::isfinite(steering) || !std::isfinite(amount) || !std::isfinite(maximum) ||
+                    maximum <= 0 || mode > 2)
+                    throw std::runtime_error("Rumble dev AI: invalid original steering output");
+                // Same AI-to-physics transfer as retail17AE50; retain normal physics.
+                ram[physics + 0x34] = static_cast<uint8_t>(1 | (mode == 2 ? 2 : mode == 1 ? 4 : 8));
+                std::memcpy(ram + physics + (mode == 0 ? 0x40 : 0x3c), &amount, 4);
+                steering /= maximum;
+                std::memcpy(ram + physics + 0x38, &steering, 4);
+                restore(); ++state->decisions;
+                if (state->decisions == 1 || state->decisions % 600 == 0)
+                    RUNTIME_LOG("[Rumble dev AI] decisions=" << state->decisions << " clock=" << word(ram, 0x1f22b8));
