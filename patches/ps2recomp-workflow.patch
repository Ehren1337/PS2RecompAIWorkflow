+void PSPadBackend::applyKeyboardState(uint8_t *data, bool (*keyDown)(int)) const
+{
+    if (!m_customKeyboard || !data || !keyDown) return;
+    auto pressed = [&](size_t control) {
+        for (int key : m_keyboard[control]) if (key && keyDown(key)) return true;
+        return false;
+    };
+    uint16_t buttons = static_cast<uint16_t>(data[2] | (uint16_t(data[3]) << 8u));
+    for (size_t control = 0; control < 16; ++control)
+        if (pressed(control)) buttons &= ~(uint16_t(1) << control);
+    data[2] = static_cast<uint8_t>(buttons);
+    data[3] = static_cast<uint8_t>(buttons >> 8u);
+    for (size_t axis = 0; axis < 4; ++axis)
+    {
+        const bool negative = pressed(16 + axis * 2), positive = pressed(17 + axis * 2);
+        // Retain physical-stick input when no keyboard direction is held;
+        // opposing keyboard directions cancel to the neutral center.
+        if (negative || positive)
+            data[axis < 2 ? 6 + axis : 2 + axis] = negative == positive ? 128 : negative ? 0 : 255;
+    }
+}
