+    feedback.vertices[1].x = 32; feedback.vertices[1].y = 0; feedback.vertices[1].s = 1;
+    feedback.vertices[2].x = 0; feedback.vertices[2].y = 32; feedback.vertices[2].t = 1;
+    const auto cleanCount = gpu->GetBackendStats().cpuDraws;
+    submit(feedback); submit(feedback);
+    compare("Unchanged CLUT remains valid across framebuffer feedback draws");
+    test.Equals(gpu->GetBackendStats().cpuDraws, cleanCount, "Verified invariant palette avoids CPU fallback");
+    const auto beforePageRefresh = memory;
+    GSContext neighbor;
+    neighbor.frame = {300, 1, GS_PSM_CT32, 0}; neighbor.scissor = {40, 40, 20, 20};
+    cpu.ClearFramebuffer(neighbor, 0x80563412); gpu->ClearFramebuffer(neighbor, 0x80563412);
+    neighbor.frame.fbp = 200;
+    cpu.ClearFramebuffer(neighbor, 0x80765432); gpu->ClearFramebuffer(neighbor, 0x80765432);
+    const auto refreshStats = gpu->GetBackendStats();
+    submit(feedback); gpu->Sync(GSSyncReason::Finish);
+    test.Equals(gpu->GetBackendStats().cpuDraws, cleanCount, "Unchanged palette in a dirty page stays on GPU after page refresh");
+    test.Equals(gpu->GetBackendStats().uploads, refreshStats.uploads, "Palette page refresh requires no full re-upload");
+    test.Equals(gpu->GetBackendStats().readbacks, refreshStats.readbacks + 1, "Dirty palette pages are captured in one readback");
+    test.IsTrue(std::equal(memory.begin() + 300 * 8192, memory.begin() + 301 * 8192, reference.begin() + 300 * 8192),
