+    uint64_t observeSubmittedObjectTag(void *owner, uint32_t channel, uint32_t address,
+                                   uint64_t tag, uint64_t tagData, uint32_t bytes) noexcept
+    {
+        if (owner != objectTimingRuntime || channel != 0x10009000u || ((tag >> 28) & 7u) != 3u) return 0;
