+        draw.vertexCount = 3; draw.state.prim.type = GS_PRIM_TRIANGLE;
+        draw.state.context.frame = {0, 1, GS_PSM_CT32, 0};
+        draw.state.context.scissor = {0, 63, 0, 63};
+        draw.state.context.zbuf = {224, GS_PSM_Z32, true};
+        draw.state.context.test = 3ull << 16; // ALWAYS, not the default NEVER no-op.
+        const auto at = [&](unsigned i) {
+            auto value = draw;
