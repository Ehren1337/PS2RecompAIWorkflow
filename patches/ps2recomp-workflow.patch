+        if (count < 1 || count > 8) throw std::runtime_error("Rumble dev upgrades: invalid grid size");
+        std::array<uint8_t, 8> levels{}, models{};
+        unsigned humans = 0;
+        // Validate the entire grid before modifying any entry.
+        for (unsigned slot = 0; slot < count; ++slot)
+        {
+            const auto entry = 0x1f2170 + slot * 8;
+            const auto controller = ram[entry + 1], driver = ram[entry + 2];
+            if ((controller != 0 && controller != 255) || driver >= 36 || ram[entry + 3] > 2)
+                throw std::runtime_error("Rumble dev upgrades: unrecognized race entry");
+            const auto model = ram[0x1eac86 + driver * 28];
+            if (model >= 37) throw std::runtime_error("Rumble dev upgrades: invalid model index");
+            levels[slot] = controller == 0 ? 2 : 0; // Elite player, Rookie opponents.
+            humans += controller == 0;
+            models[slot] = static_cast<uint8_t>(model * 3 + levels[slot]);
+        }
+        if (humans != 1) throw std::runtime_error("Rumble dev upgrades: player identity is ambiguous");
+        for (unsigned slot = 0; slot < count; ++slot)
+        {
+            ram[0x1f2173 + slot * 8] = levels[slot];
+            ram[0x1f2176 + slot * 8] = models[slot];
+        }
+        RUNTIME_LOG("[Rumble dev upgrades] player=Elite opponents=Rookie; original retail loaders retained");
+    }
+
+    void prepareGrid(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto s = upgrades;
+        if (!s || s->runtime != runtime) throw std::runtime_error("Rumble dev upgrades: wrong runtime");
+        if (s->calling || getRegU32(ctx, 4) != 0) { s->prepare(ram, ctx, runtime); return; }
+        const auto ret = getRegU32(ctx, 31);
+        GuestInvocation call{};
+        call.kind = GuestInvocationKind::HleCall; call.tag = 0x1877d0;
+        call.context = *ctx; call.context.pc = 0x1877d0;
+        SET_GPR_U32(&call.context, 29, 0); SET_GPR_U32(&call.context, 31, 0);
+        call.onComplete = [s, ram, ret](const R5900Context &, R5900Context &resume)
+        {
+            s->calling = false;
+            upgradeGrid(ram);
+            resume.pc = ret;
+        };
+        s->calling = true;
+        ctx->pc = ret;
+        runtime->eeScheduler().bindMainContextForSyscall(*ctx, ram);
+        runtime->eeScheduler().invokeCurrent(std::move(call));
+    }
+
+    void applyUpgrades(PS2Runtime &runtime)
+    {
+        const char *enabled = std::getenv("PS2_RUMBLE_DEV_UPGRADES");
+        if (!enabled || std::strcmp(enabled, "player-elite") != 0) return;
+        if (upgrades && upgrades->runtime == &runtime && runtime.lookupFunction(0x1877d0) == prepareGrid) return;
+        if (!runtime.hasFunction(0x1877d0)) throw std::runtime_error("Rumble dev upgrades: grid function missing");
+        upgrades = std::make_shared<UpgradeState>(UpgradeState{&runtime, runtime.lookupFunction(0x1877d0)});
+        runtime.replaceFunction(0x1877d0, prepareGrid);
+        RUNTIME_LOG("[Rumble dev upgrades] opt-in Elite player / Rookie opponents enabled");
+    }
+    std::shared_ptr<State> owner(PS2Runtime *runtime)
+    {
+        if (!active || active->runtime != runtime)
+            throw std::runtime_error("Rumble dev AI: unexpected runtime owner");
+        return active;
+    }
+
+    struct Work : std::enable_shared_from_this<Work>
+    {
+        std::shared_ptr<State> state;
+        uint8_t *ram;
+        uint32_t car, returnPc, ticks = 0;
+        uint32_t oldHead = 0, oldNext = 0, oldScale = 0, entry = 0;
+        uint8_t oldType = 0, oldDifficulty = 0;
+        uint8_t oldStart[16]{}, oldDirection[16]{};
+        uint32_t oldYaw = 0;
