+                                continue;
+                            case 22:
+                                // 0x8B5C records the engine stream/player association.
+                                engineStream = readWord(record + 4);
+                                enginePlayer = readWord(record + 8);
+                                continue;
+                            }
+                            const uint8_t value = volume(record[2]);
+                            switch (record[1])
+                            {
+                            case 1:
+                                status[3] = value;
+                                status[4] = (uint32_t(value) * 0x3333) >> 14;
+                                status[7] = std::min(status[3], status[5]);
+                                break;
+                            case 2:
+                                status[5] = value;
+                                status[6] = musicLevel(value);
+                                status[7] = std::min(status[3], status[5]);
+                                break;
+                            case 3: status[7] = value; break;
+                            case 4: status[8] = status[9] = value; break;
+                            case 5: status[10] = value; status[11] = engineLevel(value); break;
+                            }
+                        }
+                        std::array<PcmLoopVoiceUpdate, 48> engineVoices{};
+                        bool engineVoiceWork = false;
+                        if (m_retail && !prepareEnginePlayback(engines, status, retailLevelRecord,
+                            soundEnabled && !stopCue && !closeEngines, occupiedVoices, engineVoices, engineVoiceWork, skidPitches, roadPitches, nextVariants, listeners)) break;
