+        const bool found = ctx->pc == 0x12c290 && gp >= 0x7c3c &&
+            read(gp - 0x7c3c, list) && list <= PS2_RAM_SIZE - 12 &&
+            read(list + 8, buffer) && buffer <= PS2_RAM_SIZE - 0x2b148 &&
+            read(buffer + 0x2b144, address) && address >= buffer &&
+            address <= buffer + 0x2b130 && !(address & 15);
