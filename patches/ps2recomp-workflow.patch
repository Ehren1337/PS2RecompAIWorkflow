+                                    !prepareTornado(record, tornado, status, listeners,
+                                        occupiedVoices, engineVoices, engineVoiceWork,
+                                        nextVariants, !cueEnabled)) idle = false;
+                                ++tornadoCommands;
+                                continue;
+                            case 1: case 11: continue; // Commit only after the full batch validates.
+                            case 23: case 24: continue; // Speech work is staged before committing.
+                            case 25:
+                                soundEnabled = environmentEnabled = false;
+                                reverb.enable(false);
+                                continue;
+                            case 4: case 5:
+                                // 0x9650 toggles e470. Disable stops music,
+                                // ambient/voice work and keys off all 48 voices;
+                                // enable resumes a paused stream if one exists.
+                                // Music teardown is committed below. Ordinary
+                                // bank one-shots are stopped with the other voices;
+                                // general-stream playback remains unsupported.
+                                // Active movies reject this path.
