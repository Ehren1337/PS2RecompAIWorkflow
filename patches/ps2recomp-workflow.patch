+        {
+            auto overwrite = copy; overwrite.bitbltbuf.dpsm = GS_PSM_CT32;
+            cpu.BeginTransfer(overwrite); gpu->BeginTransfer(overwrite);
+        }
+        if (scenario == 3)
+        {
+            cpu.WriteVram(GS_PSM_Z24, 8001, 1, 32, 16, 0xabcdef);
+            gpu->WriteVram(GS_PSM_Z24, 8001, 1, 32, 16, 0xabcdef);
+        }
+        if (scenario == 4) { cpu.BeginTransfer(copy); gpu->BeginTransfer(copy); }
+        if (scenario == 5) { cpu.Reset(); gpu->Reset(); }
+        auto read = copy; read.direction = 1;
+        read.bitbltbuf.sbp = 8001; read.bitbltbuf.spsm = GS_PSM_Z32;
+        read.trxpos.ssax = 32; read.trxpos.ssay = 16;
+        cpu.BeginTransfer(read); gpu->BeginTransfer(read);
+        std::array<uint8_t, 160> expectedDepth{}, actualDepth{};
+        test.Equals(cpu.ConsumeLocalToHostBytes(expectedDepth.data(), 160), 160u, "Expected depth byte count");
+        test.Equals(gpu->ConsumeLocalToHostBytes(actualDepth.data(), 160), 160u, "Prefetched depth byte count");
+        test.IsTrue(actualDepth == expectedDepth, "Depth prefetch respects unrelated, framebuffer, local and CPU writes, replacement and reset");
+        test.Equals(gs_prefetch_diagnostics::mismatched.load(), prefetchMismatches,
+            "Repeated depth copies must complete before prefetched bytes are mapped");
+        compare("Depth prefetch never changes guest VRAM");
+    }
+    // Shadow preparation writes one alpha bit in CT32, then ordinary drawing
+    // restores CT24 before an alpha-only clear. Exercise the actual queued
+    // adapter without an intermediate readback hiding a state/ownership bug.
+    for (uint32_t page : {0u, 56u})
+    {
+        GSPrimitiveBatch shadow{};
+        shadow.vertexCount = 2; shadow.state.prim.type = GS_PRIM_SPRITE;
+        auto &c = shadow.state.context;
+        c.frame = {page, 8, GS_PSM_CT32, 0};
+        c.scissor = {0, 511, 0, 224};
+        c.zbuf = {224, GS_PSM_Z24, true};
+        c.test = 0x3180b;
+        cpu.ClearFramebuffer(c, 0x893b719du); gpu->ClearFramebuffer(c, 0x893b719du);
+        c.scissor.y1 = 223; c.frame.fbmsk = 0xbfffffffu;
+        shadow.vertices[1].x = 512; shadow.vertices[1].y = 225;
+        for (auto &v : shadow.vertices) { v.r = 17; v.g = 34; v.b = 51; v.a = 64; v.z = 0x100000; }
+        const auto beforeShadow = gpu->GetBackendStats();
+        submit(shadow);
+
+        auto paint = shadow;
+        paint.state.context.frame.psm = GS_PSM_CT24;
+        paint.state.context.frame.fbmsk = 0xff000000u;
+        paint.vertices[0].x = 16; paint.vertices[0].y = 184;
+        paint.vertices[1].x = 144; paint.vertices[1].y = 216;
+        for (auto &v : paint.vertices) { v.r = 71; v.g = 103; v.b = 157; v.a = 128; }
+        submit(paint);
+
+        auto alphaClear = shadow;
+        alphaClear.state.context.frame.fbmsk = 0x00ffffffu;
+        alphaClear.state.context.alpha = 0xaa;
+        alphaClear.state.prim.abe = true;
+        for (auto &v : alphaClear.vertices) v.r = v.g = v.b = v.a = 0;
+        submit(alphaClear);
+        compare("Queued shadow-bit/CT24/alpha-clear transitions preserve RGB");
+        test.Equals(gpu->GetBackendStats().cpuDraws, beforeShadow.cpuDraws,
+            "Shadow transition regression actually exercises GPU drawing");
+        test.Equals(gpu->ReadVram(GS_PSM_CT32, page * 32, 8, 20, 190), 0x009d6747u,
+            "Alpha-only clear preserves painted ground RGB");
+        test.Equals(gpu->ReadVram(GS_PSM_CT32, page * 32, 8, 200, 190), 0x003b719du,
+            "Shadow preparation preserves unpainted ground RGB");
+        test.Equals(gpu->ReadVram(GS_PSM_CT32, page * 32, 8, 20, 224), 0x893b719du,
+            "Shadow/clear scissor excludes the guard row");
+    }
+    submit(batch); gpu.reset();
+    test.IsTrue(memory == reference, "Destruction drains queued GPU work into caller VRAM");
+    test.Equals(gs_prefetch_diagnostics::mismatched.load(), prefetchMismatches, "Prefetch comparisons must not silently disable the optimization");
+    if (const auto early = gs_prefetch_diagnostics::earlyFenceWaitReturns.load() - earlyFenceWaits)
+        std::cout << "depth early fence waits corrected=" << early << " api=" << api << '\n';
+}
+
+void CheckApi(TestCase &test, GSDiligentDevice::Api api)
+{
+    GSDiligentDevice gpu(api);
+    std::cout << "GPU adapter: " << gpu.AdapterName() << '\n';
+    const auto memory = gpu.GetBufferMemory();
+    test.Equals(memory.indices, uint64_t(512 * 1024), "Packed bounded tile indices reserve 512 KiB instead of 8 MiB");
+    test.Equals(memory.headers, uint64_t(128 * 1024), "Packed tile headers reserve 128 KiB instead of 256 KiB");
+    test.Equals(memory.lookup, uint64_t(68 * 1024), "Packed swizzle tables reserve 68 KiB instead of 136 KiB");
+    test.Equals(memory.vram, uint64_t(4 * 1024 * 1024), "Preserve full 4 MiB GS VRAM");
+    std::cout << "GPU buffer payload bytes=" << memory.vram + memory.readback + memory.lookup + memory.commands + memory.headers + memory.indices
+        << " tile_bytes=" << memory.headers + memory.indices << " swizzle_bytes=" << memory.lookup << '\n';
+    std::vector<uint8_t> expected(4u * 1024u * 1024u), actual(expected.size());
+    uint32_t seed = 0x984bc142u;
+    for (auto &byte : expected)
+    {
+        seed = seed * 1664525u + 1013904223u;
+        byte = uint8_t(seed >> 24);
+    }
+    GSCpuBackend cpu;
+    cpu.Initialize(expected.data(), uint32_t(expected.size()));
+    gpu.UploadVram(expected);
+    gpu.DownloadVram(actual);
+    test.IsTrue(actual == expected, "Initial 4 MiB upload/readback must preserve every byte");
+    {
+        gpu.PrefetchVramRegion(504);
+        test.Equals(gpu.GetBufferMemory().readback - memory.readback, uint64_t(65536), "Only one 64 KiB prefetch buffer allocated");
+        std::vector<uint8_t> changed(expected.size(), 0x5a);
+        gpu.UploadVram(changed);
+        gpu.WaitForCompletion();
+        gpu.DownloadVram(actual); // Other staging users cannot replace this snapshot.
+        actual.assign(actual.size(), 0xa5);
+        const std::array<uint16_t, 3> pages{511, 504, 511};
+        test.IsTrue(gpu.ReadPrefetchedVramPages(actual, pages), "Snapshot survives later writes and full readback");
+        for (uint32_t page = 0; page < 512; ++page)
+            test.IsTrue(page == 504 || page == 511
+                ? std::equal(actual.begin() + page * 8192, actual.begin() + (page + 1) * 8192, expected.begin() + page * 8192)
+                : std::all_of(actual.begin() + page * 8192, actual.begin() + (page + 1) * 8192, [](uint8_t b) { return b == 0xa5; }),
+                "Only requested pages receive captured bytes");
+        gpu.PrefetchVramRegion(0);
+        test.IsFalse(gpu.ReadPrefetchedVramPages(actual, pages), "Replaced region rejects old requests");
+        const std::array<uint16_t, 1> first{0};
+        test.IsTrue(gpu.ReadPrefetchedVramPages(actual, first), "Reused snapshot captures newer bytes");
+        test.IsTrue(std::all_of(actual.begin(), actual.begin() + 8192, [](uint8_t b) { return b == 0x5a; }), "New snapshot content");
+        test.Equals(gpu.GetBufferMemory().readback - memory.readback, uint64_t(65536), "Replacement never grows staging");
+        gpu.UploadVram(expected);
+    }
+    auto compare = [&](const std::string &label)
+    {
+        gpu.DownloadVram(actual);
+        const auto mismatch = std::mismatch(expected.begin(), expected.end(), actual.begin());
+        if (mismatch.first != expected.end())
+        {
+            test.Fail(label + ": VRAM differs at byte " + std::to_string(mismatch.first - expected.begin()) +
+                " CPU=" + std::to_string(*mismatch.first) + " GPU=" + std::to_string(*mismatch.second));
+            return false;
+        }
+        return true;
+    };
+
+    // Compare GPU display decoding against the CPU across formats, base units,
+    // wrapping origins, >512 KiB chunk boundaries, fields and two-CRT blending.
+    const auto drainDisplay = [&](std::vector<uint8_t> *recycled = nullptr)
+    {
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        auto frame = gpu.PollPresentation(recycled);
+        while (frame.pending && std::chrono::steady_clock::now() < deadline)
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            frame = gpu.PollPresentation(recycled);
+        }
+        test.IsFalse(frame.pending, "Deferred display completes without a blocking map");
+        return frame;
+    };
+    const auto sameDisplay = [](const PresentationFrame &a, const PresentationFrame &b)
+    {
+        return !a.pending && a.pixels == b.pixels && a.width == b.width && a.height == b.height &&
+            a.displayFbp == b.displayFbp && a.sourceFbp == b.sourceFbp && a.usedPreferred == b.usedPreferred;
+    };
+    std::vector<uint8_t> recycledDisplay(640u * 512u * 4u, 0xa5);
+    for (uint8_t format : {GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S})
+        for (unsigned scenario = 0; scenario < 11; ++scenario)
+        {
+            GSPresentationRequest request;
+            const uint32_t width = scenario & 1 ? 639 : 512, height = scenario & 1 ? 511 : 224;
+            request.pmode = 1;
+            request.dispfb1 = 511ull | (3ull << 9) | (uint64_t(format) << 15) | (2039ull << 32) | (2031ull << 43);
+            request.display1 = (uint64_t(width * 2 - 1) << 32) | (1ull << 23) | (uint64_t(height - 1) << 44);
+            request.smode2 = 1; request.vsyncTick = scenario & 1;
+            request.progressiveFieldPresentation = scenario == 2;
+            if (scenario == 3 || scenario == 4)
