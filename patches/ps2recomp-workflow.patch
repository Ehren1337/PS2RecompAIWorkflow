+                                    if (!soundEnabled) streamStopRequested = true;
+                                }
+                                continue;
+                            case 2:
+                                // 0x6FD4 -> 0x6F3C(0) -> 0xB8E0(0): stop flag,
+                                // retail 0x7674 -> 0x75DC(0) -> 0xCBE0(0).
+                                // no event 2. No stream has been admitted yet.
+                                streamStopRequested = true;
+                                continue;
+                            case 9:
+                                // 0x79B4 checks music-active f408, distinct from
+                                // movie-active f40c. Commit music teardown below;
+                                // an inactive music queue cannot stop a movie.
+                                // Retail 0x7F20 uses music-active 0x12238;
+                                // movie-active 0x1223C is separate as well.
+                                continue;
+                            case 14:
+                                // Commit stop/close only after the full batch
+                                // validates and the reply buffer is writable.
+                                continue;
+                            case 15:
