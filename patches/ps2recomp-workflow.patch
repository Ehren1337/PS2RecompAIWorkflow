+    PS2Runtime::RecompiledFunction copyObjectData = nullptr;
+    struct ProducerScope { R5900Context *context = nullptr; uint32_t pc = 0; };
+    thread_local ProducerScope currentProducer{};
+    constexpr uint64_t kProducerCookie = UINT64_C(0x8000000000000000);
+    uint32_t diagnosticCallSite(const uint8_t *ram, uint32_t returnPc, uint32_t target)
+    {
+        if (!ram || returnPc < 0x100008 || returnPc > PS2_RAM_SIZE || (returnPc & 3)) return 0;
+        uint32_t instruction;
+        std::memcpy(&instruction, ram + returnPc - 8, 4);
+        const bool jal = (instruction >> 26) == 3 && ((instruction & 0x3ffffffu) << 2) == target;
+        const bool jalr = (instruction & 0xfc1fffffu) == 0x0000f809u; // JALR ra,rs
+        return jal || jalr ? returnPc - 8 : 0;
+    }
+    rumble_producer_diagnostics::Entry *producerEntry(uint32_t pc, uint32_t node, uint32_t model)
+    {
+        using namespace rumble_producer_diagnostics;
+        for (size_t probe = 0; probe < entries.size(); ++probe)
+        {
+            auto &entry = entries[(((pc >> 2) ^ (node >> 4) ^ (model >> 4)) + probe) % entries.size()];
+            const auto key = entry.pc.load(std::memory_order_relaxed);
+            if (!key || (key == pc && entry.node.load(std::memory_order_relaxed) == node &&
+                         entry.model.load(std::memory_order_relaxed) == model)) return &entry;
+        }
+        ++overflow;
+        return nullptr;
+    }
+    void observeCopiedObjectData(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
