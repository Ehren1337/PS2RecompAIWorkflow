+    std::string memoryWatches(PS2Runtime &runtime)
+    {
+        // Optional physical EE RAM watches: name=0xaddress:length, or
+        // name=*0xpointerAddress:length. No MMIO, writes, or unbounded dumps.
+        const char *setting = std::getenv("PS2_INSPECTOR_WATCHES");
+        if (!setting || !*setting) return "[]";
+        std::istringstream specs(std::string(setting).substr(0, 4096));
+        std::vector<std::string> rows;
+        std::string spec;
+        const uint8_t *ram = runtime.memory().getRDRAM();
+        const auto readWord = [ram](uint32_t address) {
+            return uint32_t(ram[address]) | (uint32_t(ram[address + 1]) << 8) |
+                   (uint32_t(ram[address + 2]) << 16) | (uint32_t(ram[address + 3]) << 24);
+        };
+        while (rows.size() < 16 && std::getline(specs, spec, ';'))
+        {
+            try
+            {
+                const auto equals = spec.find('=');
+                const auto colon = spec.find(':', equals == std::string::npos ? 0 : equals);
+                if (equals == std::string::npos || equals == 0 || equals > 48 || colon == std::string::npos)
+                    throw std::runtime_error("expected name=address:length");
+                std::string addressText = spec.substr(equals + 1, colon - equals - 1);
+                const bool indirect = !addressText.empty() && addressText[0] == '*';
+                if (indirect) addressText.erase(0, 1);
+                size_t used = 0;
+                uint64_t address = std::stoull(addressText, &used, 0);
+                if (used != addressText.size()) throw std::runtime_error("invalid address");
+                const auto lengthText = spec.substr(colon + 1);
+                const uint64_t length = std::stoull(lengthText, &used, 0);
+                if (used != lengthText.size() || length == 0 || length > 256 || !ram)
+                    throw std::runtime_error("length must be 1..256 and RAM must be initialized");
+                if (indirect)
+                {
+                    if (address > PS2_RAM_SIZE - 4) throw std::runtime_error("pointer outside EE RAM");
+                    address = readWord(static_cast<uint32_t>(address));
+                    if (address == 0) throw std::runtime_error("null pointer");
+                }
+                if (address > PS2_RAM_SIZE - length) throw std::runtime_error("range outside EE RAM");
+                std::ostringstream bytes;
+                std::string ascii;
+                for (uint64_t i = 0; i < length; ++i)
+                {
+                    const uint8_t value = ram[address + i];
+                    bytes << std::hex << std::setfill('0') << std::setw(2) << unsigned(value);
+                    ascii += value >= 32 && value < 127 ? char(value) : '.';
+                }
+                rows.push_back(object({{"name", quote(spec.substr(0, equals))}, {"address", hex(address)},
+                    {"length", number(length)}, {"bytes", quote(bytes.str())}, {"ascii", quote(ascii)}}));
+            }
+            catch (const std::exception &e)
+            {
+                rows.push_back(object({{"spec", quote(spec)}, {"error", quote(e.what())}}));
+            }
+        }
+        return array(rows, [](const auto &row) { return row; });
+    }
