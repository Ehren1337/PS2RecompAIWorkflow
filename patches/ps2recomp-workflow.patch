+void PS2Memory::recycleDmaChain(std::vector<uint8_t> &bytes)
+{
+    // Reuse storage only after consumption. Large one-off transfers are freed
+    // normally rather than retaining their peak allocation for the session.
+    // Retail geometry chains measured about 1 MiB. One 2 MiB-capped slot
+    // accommodates those without retaining oversized loading-transfer peaks.
+    if (bytes.capacity() <= 2u * 1024u * 1024u && bytes.capacity() > m_dmaChainScratch.capacity())
+    {
+        bytes.clear();
+        bytes.swap(m_dmaChainScratch);
+    }
+}
+
+void PS2Memory::recycleDmaSources(std::vector<DmaSourceSpan> &sources)
+{
+    if (sources.capacity() <= 4096 && sources.capacity() > m_dmaSourceScratch.capacity())
+    {
+        sources.clear();
+        sources.swap(m_dmaSourceScratch);
+    }
+}
