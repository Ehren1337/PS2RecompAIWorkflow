+    void Observe(const GSPrimitiveBatch &draw)
+    {
+        static const uint32_t texture = [] {
+            const char *value = std::getenv("PS2_GS_SAMPLE_SHADOW_TBP");
+            if (!value || !*value) return UINT32_MAX;
+            char *end = nullptr;
+            const auto parsed = std::strtoul(value, &end, 0);
+            return end != value && *end == '\0' && parsed < 16384 ? uint32_t(parsed) : UINT32_MAX;
+        }();
+        if (texture == UINT32_MAX || reserved.load(std::memory_order_relaxed) >= records.size() ||
+            !draw.state.prim.tme || !draw.state.prim.abe ||
+            draw.state.context.tex0.tbp0 != texture || (draw.state.context.alpha & 255) != 0x62)
+            return;
+        const uint64_t ordinal = calls.fetch_add(1, std::memory_order_relaxed);
+        if (ordinal >= 8 && (ordinal - 8) % 4096 != 0) return;
+        const uint64_t slot = reserved.fetch_add(1, std::memory_order_relaxed);
+        if (slot >= records.size()) return;
+        auto &record = records[slot];
+        record.draw = draw; record.ordinal = ordinal;
+        record.ready.store(1, std::memory_order_release);
+    }
