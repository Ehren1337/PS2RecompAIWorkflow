+    void registerRumbleDevOverride()
+    {
+        static std::once_flag once;
+        std::call_once(once, [] {
+            registerDescriptor({"Rumble Racing USA retail dev AI", "SLUS_201.74", 0x100008, 0x5720d8d8, apply});
+        });
