diff --git a/ps2xIOP/include/ps2x/iop/rumble_reverb.h b/ps2xIOP/include/ps2x/iop/rumble_reverb.h
new file mode 100644
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/rumble_reverb.h
@@ -0,0 +1,100 @@
+#pragma once
+
+#include "iop_types.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace ps2x::iop::detail
+{
+    // Retail AUDIO.IRX effect controller (318/43C/7EC/848..A6C).
+    // All preset data comes from the caller's verified modules, never this file.
+    struct RumbleReverbTables
+    {
+        struct Environment { int32_t mode = 0, depth = 0, delay = 0, feedback = 0; };
+        std::array<Environment, 64> environments{};
+        std::array<std::array<uint16_t, 32>, 10> registers{};
+        std::array<uint32_t, 10> workWords{};
+
+        bool valid() const
+        {
+            for (auto words : workWords) if (!words || words > (1u << 20)) return false;
+            for (const auto &e : environments)
+                if (e.mode < 0 || e.mode > 9 || e.depth < 0 || e.depth > 65536 ||
+                    e.delay < 0 || e.delay > 127 || e.feedback < 0 || e.feedback > 127) return false;
+            return true;
+        }
+    };
+
+    struct RumbleReverbState
+    {
+        int environment = 0, preset = -1, mode = 0;
+        int32_t depth = 0;
+        uint32_t flags = 0;
+        PcmReverbUpdate applied{};
+
+        void initialize(int value)
+        {
+            // 318 resets software state, not physical delay memory/registers.
+            environment = value; preset = -1; mode = 0; depth = 0; flags = 2;
+        }
+        void enable(bool value)
+        {
+            if (value) { flags |= 2; if (preset >= 0) flags |= 1; }
+            else flags &= ~2u;
+        }
+        bool select(unsigned value)
+        {
+            if (value >= 4) return true; // Original 43C ignores this sentinel.
+            if (environment < 0 || environment >= 16) return false;
+            if (preset < 0) flags |= 1;
+            preset = int(value);
+            return true;
+        }
+        PcmReverbUpdate advance(const RumbleReverbTables &tables, uint64_t sendMask)
+        {
+            if (!(flags & 1) || preset < 0) return {};
+            const auto &request = tables.environments[environment * 4 + preset];
+            const int32_t target = (flags & 2) ? request.depth : 0;
+            const int32_t next = depth + std::clamp(target - depth, -2048, 2048);
+            if (request.mode != mode || !(flags & 2))
+            {
+                if (!next) flags |= 6;
+                else flags &= ~2u;
+            }
+            depth = next;
+            if (flags & 4)
+            {
+                mode = request.mode;
+                applied.action = PcmReverbUpdate::Action::Configure;
+                applied.registers = tables.registers[mode];
+                applied.wordCount = tables.workWords[mode];
+                applied.startWord = (1u << 20) - applied.wordCount;
+                applied.writeEnabled = mode != 0;
+                if (mode == 7 || mode == 8)
+                {
+                    // LIBSD echo/delay transforms; address units are eight bytes.
+                    const unsigned delay = unsigned(request.delay + 1) * 32;
+                    auto &r = applied.registers;
+                    r[7] = uint16_t(request.feedback * 258);
+                    r[10] = uint16_t(2 * delay - r[0]);
+                    r[11] = uint16_t(delay - r[1]);
+                    r[16] = uint16_t(r[17] + delay);
+                    r[12] = uint16_t(r[13] + delay);
+                    r[27] = uint16_t(r[29] + delay);
+                    r[26] = uint16_t(r[28] + delay);
+                }
+                flags &= ~4u;
+            }
+            if (applied.action == PcmReverbUpdate::Action::Keep) return {};
+            applied.depthLeft = applied.depthRight = int16_t(std::clamp<int64_t>(
+                (int64_t(depth) * 0x3fff) >> 16, -0x3fff, 0x3fff));
+            // 1494: core0 effects disabled, core1 MMIX=F0F enables external
+            // dry AND wet. Core0's dry mix therefore also feeds core1 reverb,
+            // independently of the per-voice wet mask; AVOL is 7FFF.
+            applied.sendLeft = applied.sendRight = sendMask & 0xffffff000000ull;
+            applied.externalLeft = applied.externalRight = 0xffffff;
+            return applied;
+        }
+    };
+}
