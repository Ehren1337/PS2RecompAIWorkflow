+    feedback.vertexCount = 3; feedback.state.prim.type = GS_PRIM_TRIANGLE;
+    feedback.state.prim.tme = true;
+    auto &fc = feedback.state.context;
+    fc.frame = {0, 1, GS_PSM_CT32, 0x7f000000u}; fc.scissor = {0, 31, 0, 31};
+    fc.test = 1ull << 17; fc.zbuf = {224, GS_PSM_Z24, true}; fc.fba = 1;
+    fc.tex0.tbp0 = 0; fc.tex0.tbw = 1; fc.tex0.psm = GS_PSM_T8H;
+    fc.tex0.cbp = 300 * 32; fc.tex0.cpsm = GS_PSM_CT32; fc.tex0.tfx = 1; fc.tex0.tcc = 1;
+    feedback.state.textureWidth = feedback.state.textureHeight = 32;
+    for (uint32_t i = 0; i < 256; ++i)
+        for (GSRasterBackend *backend : {static_cast<GSRasterBackend *>(&cpu), gpu.get()})
+            backend->WriteVram(GS_PSM_CT32, fc.tex0.cbp, 1, i & 15, i >> 4, (i & 64) ? 0x80808080u : 0u);
