+        auto &lastChecked=work.lastCheckedNativeCalls[(work.results ? 2 : 0)+(work.multiGroup ? 1 : 0)];
+        if (stats.attempted.load() >= 256) return false;
+        // First128 form the startup gate. Up to128 more checks are spread
+        // over real native execution, covering changing scene/input layouts.
+        const uint64_t executed = execution.executed.load();
+        if (stats.attempted.load() >= 128 &&
+            (!nativeEnabled() || executed - lastChecked < 1024)) return false;
+        uint64_t hash = UINT64_C(14695981039346656037);
+        for (uint32_t i = 0; i < codeSize; ++i) hash = (hash ^ code[i]) * UINT64_C(1099511628211);
+        if (hash != UINT64_C(0xa1a24307237d2123)) return false;
+        work.index = static_cast<uint32_t>(stats.attempted.fetch_add(1));
+        if (work.index >= 128) lastChecked = executed;
+        work.entry = state;
+        const auto start = Clock::now();
+        const bool accepted = buildPacket(data, state.top, state, work.output);
+        stats.nativeNanoseconds.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count());
+        if (!accepted) { stats.rejected.fetch_add(1); return false; }
+        work.owner = &state;
+        work.start = Clock::now();
+        return true;
+    }
+
+    void endComparison(const VU1State &state, const uint8_t *data)
+    {
+        if (work.owner != &state) return;
+        auto &stats=packetComparisonStats(work.results,work.multiGroup);
+        stats.interpreterNanoseconds.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - work.start).count());
+        work.owner = nullptr;
+        bool equal = state.pc == 0x1428;
+        const bool contract = validateTransfer(work.output, work.entry.top) &&
+            state.cycles - work.entry.cycles == work.output.totalCycles &&
+            !state.ebit && !state.haltAfterDelaySlot && !state.branchPending &&
+            !state.stoppedByD && !state.stoppedByT && state.branchTarget == 0x1418 && state.branchDelay == 0 &&
+            state.top == work.entry.top && state.itop == work.entry.itop &&
+            state.dBitEnabled == work.entry.dBitEnabled && state.tBitEnabled == work.entry.tBitEnabled;
+        if (!contract) { equal = false; stats.contractMismatches.fetch_add(1); }
+        uint64_t compared = 0;
+        for (uint32_t i = 0; i < work.output.words.size(); ++i)
+        {
+            if (!work.output.compared[i]) continue;
+            ++compared;
+            if (word(data, i) != work.output.words[i])
+            {
+                equal = false;
+                uint64_t unset = 4096;
+                stats.firstMismatchWord.compare_exchange_strong(unset, i);
+            }
+        }
+        stats.comparedWords.fetch_add(compared);
+        const auto registerMismatch = firstRegisterMismatch(work.output, state);
+        stats.registerChecks.fetch_add(1);
+        if (registerMismatch != 155)
+        {
+            equal = false;
+            stats.registerMismatches.fetch_add(1);
+            uint64_t unset = 155;
+            stats.firstMismatchRegister.compare_exchange_strong(unset, registerMismatch);
+        }
+        if (!work.multiGroup && work.index < boundaryRecords.size())
+            boundaryRecords[work.index] = {state.cycles - work.entry.cycles, state.top,
+                work.output.groups, work.output.prefix, work.output.vertices, work.output.packetQwords,
+                work.entry.status, state.status, registerMismatch};
+        if (stats.mismatched.load() == 0)
+        {
+            boundarySample.entry = work.entry;
+            boundarySample.actual = state;
+            boundarySample.expected = work.output;
+        }
+        (equal ? stats.matched : stats.mismatched).fetch_add(1);
+    }
+}
