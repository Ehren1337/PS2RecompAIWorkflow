+            (draw.WrapMore.w != 0 && (value & 32767) == 0 ? 0 : draw.WrapMore.z);
+    }
+    return color;
+}
+uint4 SamplePoint(DrawParams draw, int u, int v)
+{
+    uint x = uint(WrapCoordinate(u, draw.Texture.z, draw.Wrap.x, draw.Wrap.z, draw.Wrap.w));
+    uint y = uint(WrapCoordinate(v, draw.Texture.w, draw.Wrap.y, draw.WrapMore.x, draw.WrapMore.y));
+    uint psm = draw.Mode.x;
+    uint value = ReadTexel(psm, draw.Texture.x, draw.Texture.y, x, y, (draw.Mode.y & (32 | 128)) != 0);
+    if (psm == 27 && (draw.Mode.y & 64) != 0) value &= 127;
+    if (psm == 19 || psm == 20 || psm == 27 || psm == 36 || psm == 44)
+    {
+        uint index = value;
+        psm = draw.Palette.y;
+        if (draw.Palette.z == 0)
+        {
+            index = (index + (draw.Palette.w >> 16)) & (draw.Palette.w & 65535);
+            index = (index & ~24u) | ((index & 8) << 1) | ((index & 16) >> 1);
+        }
+        uint px = draw.PaletteLayout.y + (index & 15);
+        uint py = draw.PaletteLayout.z + (index >> 4);
+        value = ReadTexel(psm, draw.Palette.x, draw.PaletteLayout.x, px, py, false);
