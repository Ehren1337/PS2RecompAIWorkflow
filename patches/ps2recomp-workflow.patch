+float RoundedReciprocal(float value)
+{
+    // Hardware rcp can differ by an ULP and cross a bilinear rounding boundary.
+    // Refine its 24-bit mantissa with an exact integer remainder. The product
+    // wraps modulo 2^32; the small signed residual around 2^47 is still exact.
+    // Validated host input guarantees a finite, normal reciprocal here.
+    uint raw = asuint(value);
+    uint divisor = (raw & 0x7fffff) | 0x800000;
+    float normalized = asfloat(0x3f800000 | (raw & 0x7fffff));
+    uint mantissa = uint((1.0 / normalized) * 16777216.0);
+    int remainder = int(0u - mantissa * divisor);
+    while (remainder < 0) { --mantissa; remainder += int(divisor); }
+    while (remainder >= int(divisor)) { ++mantissa; remainder -= int(divisor); }
+    uint twice = uint(remainder) * 2;
+    if (twice > divisor || (twice == divisor && (mantissa & 1) != 0)) ++mantissa;
+    uint exponent = 253 - ((raw >> 23) & 255);
+    if (mantissa >= 0x1000000) { mantissa >>= 1; ++exponent; }
+    return asfloat((raw & 0x80000000) | (exponent << 23) | (mantissa & 0x7fffff));
+}
+float PixelRatio(uint pixel, uint span)
+{
+    // Exactly rounded (pixel + 0.5)/span for bounded integer sprite spans.
+    // Correct an approximate float quotient using its small integer residual,
+    // avoiding shader double division and an extra hardware requirement.
+    uint numerator = pixel * 2 + 1, divisor = span * 2;
+    int exponent = int(firstbithigh(numerator)) - int(firstbithigh(divisor));
+    uint normalized = numerator << uint(-exponent);
+    if (normalized < divisor) { normalized <<= 1; --exponent; }
+    uint mantissa = uint((float(normalized) / float(divisor)) * 8388608.0);
+    int remainder = int((normalized << 23) - mantissa * divisor);
+    while (remainder < 0) { --mantissa; remainder += int(divisor); }
+    while (remainder >= int(divisor)) { ++mantissa; remainder -= int(divisor); }
+    uint twice = uint(remainder) * 2;
+    if (twice > divisor || (twice == divisor && (mantissa & 1) != 0)) ++mantissa;
+    if (mantissa >= 0x1000000) { mantissa >>= 1; ++exponent; }
+    return asfloat((uint(exponent + 127) << 23) | (mantissa & 0x7fffff));
