+                            m_soundDefinitions[i].lastVariant = nextVariants[i];
+                        m_bankVoiceCommands += bankVoiceCommands;
+                        if (bankVoiceCommands)
+                        {
+                            m_lastBankSound = lastBankSound;
+                            m_lastBankVoiceFrames = lastBankFrames;
+                            m_lastBankVoiceHash = lastBankHash;
+                        }
+                        m_statusPending = true;
+                        ++m_batches;
+                        if (stopMovie || stopMusic)
+                        {
+                            m_deferredStatus = std::move(update);
+                            return {true, true, {}, {std::move(ack), std::move(close)}};
+                        }
+                        return {true, true, {}, {std::move(ack), std::move(update)}};
