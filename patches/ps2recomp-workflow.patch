+                        if (speechSlot < 48)
+                        {
+                            speechUpdate.left = speechUpdate.right = int16_t(status[9] << 7);
+                            engineVoices[speechSlot] = std::move(speechUpdate);
+                            engineVoiceWork = true;
+                        }
+                        m_controlStage = 5;
+                        if (m_retail && !prepareEnginePlayback(engines, status, retailLevelRecord,
+                            soundEnabled && !stopCue && !closeEngines, occupiedVoices, engineVoices, engineVoiceWork, skidPitches, roadPitches, effect20Pitches, selectorPitches, selectorRepeats, effect32Voices, playerEffect32Voices, effect4Voices, effect8Voices, alternateEngineVoices, nextVariants, shotRandom, listeners, !cueEnabled)) break;
