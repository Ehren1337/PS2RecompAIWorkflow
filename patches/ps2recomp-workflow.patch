+                                retailLevelRecord[3] = 0;
+                                for (auto &engine : engines) writeWord(engine.data() + 0x94, 0);
+                                continue;
+                            case 17:
+                                // Retail 0x93E8 -> 0x7304: stop audio, unload all
+                                // banks/variants/aliases and both descriptor tables.
+                                // Release owned storage only after sink/reply checks.
+                                releaseBanks = true;
+                                soundEnabled = environmentEnabled = false;
+                                reverb.flags = 0; // 3E8 terminates the effect controller.
+                                streamStopRequested = true;
+                                engineAliasesReady = false;
+                                continue;
+                            case 16:
+                                // 0x8AC4 clears per-level engine/voice state.
+                                // Retail stops admitted one-shot voices below;
+                                // active engine/ambient playback remains unsupported.
+                                ++levelResets;
+                                if (m_retail)
+                                {
+                                    // Retail 0x934C consumes a record, unlike
+                                    // February. Own its environment and engine
+                                    // configuration for subsequent level work.
+                                    std::copy_n(record, 64, retailLevelRecord.begin());
+                                    engines = {};
+                                    skidPitches = {};
+                                    roadPitches = {};
+                                    effect20Pitches = {};
+                                    selectorPitches = {};
+                                    selectorRepeats = {};
+                                    effect32Voices = {};
+                                    playerEffect32Voices = {};
+                                    effect4Voices = {};
+                                    effect8Voices = {};
+                                    alternateEngineVoices = {};
+                                    engineAliasesReady = false;
+                                    for (unsigned engine = 0; engine < record[3]; ++engine)
+                                    {
+                                        engines[engine][0] = record[7 + engine * 4];
+                                        engines[engine][2] = record[6 + engine * 4];
+                                        engines[engine][0x7a] = 0xff;
+                                        writeWord(engines[engine].data() + 0x94, 1);
+                                    }
+                                    status[2] = record[4]; // 0x95D8.
