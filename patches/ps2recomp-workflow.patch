+            bool readSoundResource(const SifCommand &command, const std::array<uint8_t, 64> &packet,
+                                   uint32_t tag, uint32_t &identity, std::vector<uint8_t> &payload)
+            {
+                const uint32_t size = readWord(packet.data() + 0x14);
+                const uint32_t address = command.extraDestination;
+                const uint32_t begin = (m_iopBuffer + 63u) & ~63u;
+                if (size < 40 || size > kBufferSize || command.extra.size != ((size + 15u) & ~15u) ||
+                    address != readWord(packet.data() + 0x20) || (address & 63u) != 0 ||
+                    // Retail's large Cvkb transfer reuses the allocation base,
+                    // also used by copied control batches. Pending replies and
+                    // retained resources already own their data separately.
+                    uint64_t(address) < uint64_t(begin) ||
+                    uint64_t(address) + command.extra.size > uint64_t(m_iopBuffer) + kBufferSize)
+                    return false;
+                std::array<uint8_t, 40> header{};
+                if (!m_host.readGuest(address, header.data(), header.size()) ||
+                    readWord(header.data() + 0x1c) != tag) return false;
+                const uint32_t source = readWord(packet.data() + 0x10);
+                const uint32_t pointer = readWord(header.data());
+                const uint32_t bytes = readWord(header.data() + 0x24);
+                if (pointer < source) return false;
+                const uint32_t offset = pointer - source;
+                if (offset < header.size() || bytes == 0 || uint64_t(offset) + bytes > size) return false;
+                payload.resize(bytes);
+                identity = readWord(header.data() + 0x20);
+                return m_host.readGuest(address + offset, payload.data(), bytes);
+            }
+
+            static bool validBankHeader(const std::vector<uint8_t> &header)
+            {
+                if (header.size() < 16 || readWord(header.data()) != 2) return false;
+                const unsigned directoryEnd = 16 + unsigned(header[4]) * 4;
+                if (directoryEnd > header.size()) return false;
+                const uint32_t bytes = readWord(header.data() + 12);
+                if (!bytes || bytes > kBufferSize || bytes % 16) return false;
+                unsigned tones = 0;
+                for (unsigned i = 0; i < header[4]; ++i)
+                {
+                    const auto offset = readWord(header.data() + 16 + i * 4);
+                    if (!offset) continue;
+                    if (offset < directoryEnd || uint64_t(offset) + 4 > header.size()) return false;
+                    const unsigned count = header[offset];
+                    tones += count;
+                    if (!count || tones > 255 || uint64_t(offset) + 4 + count * 20 > header.size()) return false;
+                    for (unsigned tone = 0; tone < count; ++tone)
+                    {
+                        const auto start = readWord(header.data() + offset + 20 + tone * 20);
+                        if (start >= bytes || start % 16) return false;
+                    }
+                }
+                return tones != 0;
+            }
+
+            bool retainSoundBank(const SifCommand &command, const std::array<uint8_t, 64> &packet)
+            {
+                // Retail 0x6E7C retains Cvkh, then pairs Cvkb by resource ID.
+                // 0x6CFC/0x2DC8 copy the sample body to owned sound RAM before
+                // the incoming slot is ACKed; the transfer callback is IOP-only.
+                // Native storage keeps offsets relative instead of embedding
+                // guest/host pointers. Verified independent one-shots consume
+                // this storage, as do supported engine and skid loops.
+                SoundBank bank;
+                if (packet[0x1d] == 0)
+                {
+                    if (!m_pendingBank.header.empty() ||
+                        !readSoundResource(command, packet, 0x43766b68, bank.identity, bank.header) ||
+                        !validBankHeader(bank.header) || bank.identity > 127) return false;
+                    for (const auto &loaded : m_soundBanks)
+                        if (!loaded.header.empty() && loaded.identity == bank.identity) return false;
+                    m_pendingBank = std::move(bank);
+                    return true;
+                }
+                if (m_pendingBank.header.empty() ||
+                    !readSoundResource(command, packet, 0x43766b62, bank.identity, bank.body) ||
+                    bank.identity != m_pendingBank.identity ||
+                    bank.body.size() != readWord(m_pendingBank.header.data() + 12)) return false;
+                auto slot = std::find_if(m_soundBanks.begin(), m_soundBanks.end(),
+                    [](const SoundBank &b) { return b.header.empty(); });
+                if (slot == m_soundBanks.end()) return false;
+                // 0x6900 reserves sound memory from 0x1C4080 upward; allocator
+                // 0xC40 starts banks at 0x5500. Only full level release is
+                // admitted, so aligned aggregate usage equals contiguous usage.
+                const uint32_t allocation = (uint32_t(bank.body.size()) + 63u) & ~63u;
+                if (allocation > 0x1c4080u - 0x5500u - m_bankAllocatedBytes) return false;
+                bank.header = m_pendingBank.header;
+                for (unsigned program = 0; program < bank.header[4]; ++program)
+                {
+                    const auto offset = readWord(bank.header.data() + 16 + program * 4);
+                    if (!offset) continue;
+                    for (unsigned tone = 0; tone < bank.header[offset]; ++tone)
+                    {
+                        const auto start = readWord(bank.header.data() + offset + 20 + tone * 20);
+                        if (std::any_of(bank.samples.begin(), bank.samples.end(),
+                            [start](const BankSample &sample) { return sample.offset == start; })) continue;
+                        BankSample sample;
+                        sample.offset = start;
+                        bool ended = false, hasLoop = false;
+                        for (uint32_t at = start; at < bank.body.size(); at += 16)
+                        {
+                            const uint8_t control = bank.body[at], flags = bank.body[at + 1];
+                            if ((control >> 4) > 4 || (control & 15) > 12 || flags > 6 || flags == 5) return false;
+                            if (flags & 4) { hasLoop = true; sample.loopOffset = at; }
+                            if (flags & 1)
+                            {
+                                ended = true;
+                                sample.bytes = at + 16 - start;
+                                sample.repeats = (flags & 2) != 0;
+                                break;
+                            }
+                        }
+                        if (!ended || (sample.repeats && !hasLoop)) return false;
+                        bank.samples.push_back(sample);
+                    }
+                }
+                // 0x6B2C selects the first retained table containing the bank.
+                const uint8_t *descriptors = nullptr;
+                unsigned descriptorCount = 0;
+                for (const auto &table : m_soundTables)
+                {
+                    if (table.payload.empty()) continue;
+                    for (unsigned i = 0; i < readHalf(table.payload.data() + 2); ++i)
+                    {
+                        const auto *entry = table.payload.data() + 4 + i * 8;
+                        if (readHalf(entry) != bank.identity) continue;
+                        descriptorCount = readHalf(entry + 2);
+                        descriptors = table.payload.data() + readWord(entry + 4);
+                        break;
+                    }
+                    if (descriptors) break;
+                }
+                if (!descriptors) return false;
+                auto definitions = m_soundDefinitions;
+                unsigned variantCount = 0;
+                for (const auto &definition : definitions) variantCount += unsigned(definition.variants.size());
+                const uint8_t bankSlot = uint8_t(slot - m_soundBanks.begin());
+                for (unsigned i = 0; i < descriptorCount; ++i)
+                {
+                    const auto *descriptor = descriptors + i * 36;
+                    const uint8_t program = descriptor[2], identity = descriptor[0];
+                    // 0x6BDC/0x7B8C register descriptors without looking up
+                    // program data. Retail SE1.TRK bank 51 references empty
+                    // slots 50/56/57; those variants must retain their order.
+                    // Lookup 0x2688 handles absence later at playback time.
+                    if (program >= bank.header[4] || !descriptor[5]) return false;
+                    auto definition = std::find_if(definitions.begin(), definitions.end(),
+                        [identity](const SoundDefinition &d) { return d.identity == identity; });
+                    if (definition == definitions.end())
+                    {
+                        if (definitions.size() == 130) return false;
+                        SoundDefinition fresh;
+                        fresh.identity = identity;
+                        std::copy_n(descriptor, 36, fresh.parameters.begin());
+                        fresh.parameters[0] = uint8_t(definitions.size());
+                        fresh.parameters[1] = 0;
+                        fresh.parameters[4] = std::clamp<uint8_t>(descriptor[4], 1, 10);
+                        fresh.parameters[5] = std::min<uint8_t>(descriptor[5], 8);
+                        definitions.push_back(std::move(fresh));
+                        definition = definitions.end() - 1;
+                    }
+                    // 0x9D80 retains the first definition for a sound ID;
+                    // 0x7B8C adds up to eight variants from a 150-entry pool.
+                    if (definition->variants.size() == 8 || variantCount == 150) return false;
+                    definition->variants.push_back({bankSlot, program});
+                    ++variantCount;
+                }
+                // Commit all ownership and registration before releasing the
+                // sender. Invalid pairs preserve pending header and old banks.
+                *slot = std::move(bank);
+                m_soundDefinitions = std::move(definitions);
+                m_bankAllocatedBytes += allocation;
+                m_pendingBank = {};
+                return true;
+            }
+
+            bool retainSoundTable(const SifCommand &command, const std::array<uint8_t, 64> &packet)
+            {
+                // Retail 0x6E7C relocates Cshd's pointer by subtracting the EE
+                // source, retains version 7 in two slots at 0x12110, then ACKs.
+                // 0x6B2C searches those tables; 0x6BDC uses payload-relative
+                // bank offsets and 36-byte descriptors after sample-bank load.
+                // Own the payload before releasing the EE source. Opcode 17
+                // releases the retained tables with the rest of the level.
+                auto slot = std::find_if(m_soundTables.begin(), m_soundTables.end(),
+                    [](const SoundTable &table) { return table.payload.empty(); });
+                if (slot == m_soundTables.end()) return false;
+                const uint32_t size = readWord(packet.data() + 0x14);
+                const uint32_t address = command.extraDestination;
+                const uint32_t begin = (m_iopBuffer + 63u) & ~63u;
+                if (size < 40 || size > kBufferSize || command.extra.size != ((size + 15u) & ~15u) ||
+                    address != readWord(packet.data() + 0x20) || (address & 63u) != 0 ||
+                    uint64_t(address) < uint64_t(begin) + 0xcc0 ||
+                    uint64_t(address) + command.extra.size > uint64_t(m_iopBuffer) + kBufferSize)
+                    return false;
+                std::array<uint8_t, 40> header{};
+                if (!m_host.readGuest(address, header.data(), header.size()) ||
+                    readWord(header.data() + 0x1c) != 0x43736864) return false;
+                const uint32_t source = readWord(packet.data() + 0x10);
+                const uint32_t pointer = readWord(header.data());
+                const uint32_t bytes = readWord(header.data() + 0x24);
+                if (pointer < source) return false;
+                const uint32_t offset = pointer - source;
+                if (offset < header.size() || bytes < 4 || uint64_t(offset) + bytes > size) return false;
+                SoundTable table;
+                table.payload.resize(bytes);
+                if (!m_host.readGuest(address + offset, table.payload.data(), bytes)) return false;
+                const auto *data = table.payload.data();
+                const uint32_t count = readHalf(data + 2);
+                const uint32_t directoryEnd = 4 + 8 * count;
+                if (readHalf(data) != 7 || directoryEnd > bytes) return false;
+                for (uint32_t i = 0; i < count; ++i)
+                {
+                    const auto *bank = data + 4 + 8 * i;
+                    const uint32_t entries = readHalf(bank + 2);
+                    const uint32_t start = readWord(bank + 4);
+                    if (start < directoryEnd || uint64_t(start) + uint64_t(entries) * 36 > bytes) return false;
+                    table.descriptors += entries;
+                }
+                *slot = std::move(table);
+                return true;
+            }
+
+            bool loadRetailCue()
+            {
+                if (m_cueAttempted) return !m_cuePcm.empty();
+                m_cueAttempted = true;
+                // Retail/March module identity guards these file offsets and
+                // the original voice setup at 0x1A0. Never embed game audio.
+                const auto path = m_host.translateGuestPath("cdrom0:\\MODULES\\AUDIO.IRX;1");
+                const auto file = m_host.openHostFile(path);
+                if (!file) return false;
+                uint64_t size = 0;
+                size_t got = 0;
+                std::vector<uint8_t> module(91704);
+                const bool read = m_host.hostFileSize(file, size) && size == module.size() &&
+                    m_host.readHostFile(file, 0, module.data(), module.size(), got) && got == module.size();
+                m_host.closeHostFile(file);
+                if (!read) return false;
+                uint32_t crc = 0xffffffffu;
+                for (const auto byte : module)
+                {
+                    crc ^= byte;
+                    for (unsigned bit = 0; bit < 8; ++bit)
+                        crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320u : 0u);
+                }
+                if ((crc ^ 0xffffffffu) != 0x6eaeed1fu)
+                {
+                    m_host.log(LogLevel::Warning, "Rumble retail cue: AUDIO.IRX identity mismatch");
+                    return false;
+                }
+                // One-shot at module 0xF0D0, file 0xF160. Decode through the
+                // end flag, excluding the non-audio marker that follows it.
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                std::vector<int16_t> source;
+                int64_t previous = 0, older = 0;
+                for (unsigned offset = 0; offset < 0x2c0; offset += 16)
+                {
+                    const auto *block = module.data() + 0xf160 + offset;
+                    if ((block[0] >> 4) > 4 || (block[0] & 15) > 12) return false;
+                    const auto &coefficient = coefficients[block[0] >> 4];
+                    for (unsigned sample = 0; sample < 28; ++sample)
+                    {
+                        int nibble = (block[2 + sample / 2] >> (4 * (sample & 1))) & 15;
+                        if (nibble & 8) nibble -= 16;
+                        const int64_t value = ((nibble * 4096) >> (block[0] & 15)) +
+                            (previous * coefficient[0] + older * coefficient[1]) / 64;
+                        older = previous; previous = value;
+                        source.push_back(int16_t(std::clamp<int64_t>(value, -32768, 32767)));
+                    }
+                    if (block[1] & 1) break;
+                }
+                if (source.size() != 1204) return false;
+                // Original pitch 0x400 = 1/4 of the 48-kHz SPU2 clock.
+                // ADSR1 0x9EEE: exponential attack shift 7/step 2, decay
+                // shift 14, sustain level 0x7800. ADSR2 0xCD21: exponential
+                // decreasing sustain shift 13/step 0. End flag stops the cue.
+                // Linear interpolation is provisional, not Gaussian SPU2 fidelity.
+                int level = 0, phase = 0, counter = 0;
+                m_cuePcm.reserve(source.size() * 8);
+                for (size_t frame = 0; frame < source.size() * 4; ++frame)
+                {
+                    int step = phase == 0 ? 80 : ((-8 * level) >> 15);
+                    int increment = phase == 0 ? 0x8000 : (phase == 1 ? 0x1000 : 0x2000);
+                    if (phase == 0 && level > 0x6000) step /= 4;
+                    counter += increment;
+                    if (counter >= 0x8000)
+                    {
+                        counter -= 0x8000;
+                        level = std::clamp(level + step, 0, 32767);
+                        if ((phase == 0 && level == 32767) || (phase == 1 && level <= 0x7800))
+                        { ++phase; counter = 0; }
+                    }
+                    const size_t index = frame / 4;
+                    const int a = source[index], b = index + 1 < source.size() ? source[index + 1] : 0;
+                    const int value = (a * (4 - int(frame % 4)) + b * int(frame % 4)) / 4;
+                    const int16_t scaled = int16_t(((int64_t(value) * level) >> 15) * 0x3ffe >> 15);
+                    m_cuePcm.push_back(scaled); m_cuePcm.push_back(scaled);
+                }
+                return true;
+            }
+            std::array<uint8_t, 16> initialStatus() const
+            {
+                // Retail 0x9264 initializes through the individual setters;
+                // February's default volumes are different.
+                if (m_retail) return {0, 1, 0, 75, 59, 0, 0, 64, 75, 75, 64, 64, 0, 0, 0, 0};
+                return {0, 1, 0, 64, 51, 64, 51, 64, 75, 75, 75, 37, 0, 0, 0, 0};
+            }
+            uint8_t musicLevel(uint8_t value) const
+            {
+                // Retail 0x96A4 uses 3/4; February uses 0x3333 / 0x4000.
+                return m_retail ? (uint32_t(value) * 3) >> 2 : (uint32_t(value) * 0x3333) >> 14;
+            }
+            uint8_t engineLevel(uint8_t value) const
+            {
+                // Retail 0x97E0 copies the volume; February halves it.
+                return m_retail ? value : value >> 1;
+            }
+            struct MovieBuffer
+            {
+                uint32_t address = 0;
+                std::vector<uint8_t> bytes;
+            };
+            using MovieHistory = std::array<std::array<int64_t, 2>, 2>;
+            struct StreamState
+            {
+                bool open = false, playing = false, closePending = false, releasePending = false;
+                uint8_t closeSlot = 0;
+                unsigned count = 0;
+                uint64_t bytes = 0, stagedFrames = 0, released = 0, closes = 0, closeAcks = 0;
+                MovieHistory history{};
+                // Retail music retains ten inputs, movies only three. The
+                // incoming command path enforces the selected queue's limit.
+                std::array<MovieBuffer, 10> buffers{};
+            };
+            static bool decodeStereoChunk(const MovieBuffer &buffer, MovieHistory &history, std::vector<int16_t> &pcm)
+            {
+                // Verified February/retail movies and retail music: planar PSX
+                // ADPCM channels. History survives chunk boundaries. Predictor
+                // arithmetic matches the independently checked FFmpeg experiment.
+                constexpr unsigned bytes = 0x2fc0, frames = bytes / 16 * 28;
+                if (buffer.bytes.size() != 0x40 + bytes * 2) return false;
+                for (unsigned offset = 0x40; offset < buffer.bytes.size(); offset += 16)
+                    if ((buffer.bytes[offset] >> 4) > 4 || buffer.bytes[offset + 1] != 2) return false;
+                constexpr int coefficients[5][2] = {{0,0},{60,0},{115,-52},{98,-55},{122,-60}};
+                pcm.resize(frames * 2);
+                for (unsigned channel = 0; channel < 2; ++channel)
+                {
+                    unsigned frame = 0;
+                    auto &h = history[channel];
+                    for (unsigned offset = 0; offset < bytes; offset += 16)
+                    {
+                        const auto *block = buffer.bytes.data() + 0x40 + channel * bytes + offset;
+                        const auto &coefficient = coefficients[block[0] >> 4];
+                        const unsigned shift = block[0] & 15;
+                        for (unsigned sample = 0; sample < 28; ++sample)
+                        {
+                            const int nibble = (block[2 + sample / 2] >> (4 * (sample & 1))) & 15;
+                            const int signedNibble = nibble < 8 ? nibble : nibble - 16;
+                            const int64_t value = ((signedNibble * 4096) >> shift) +
+                                (h[0] * coefficient[0] + h[1] * coefficient[1]) / 64;
+                            h[1] = h[0]; h[0] = value;
+                            pcm[(frame++) * 2 + channel] = static_cast<int16_t>(std::clamp<int64_t>(value, -32768, 32767));
+                        }
+                    }
+                }
+                return true;
+            }
+            static SifCommandReply makeAck(const std::array<uint8_t, 64> &packet)
+            {
+                SifCommandReply ack{0, {packet.begin(), packet.end()}};
+                writeWord(ack.packet.data(), 64);
+                writeWord(ack.packet.data() + 4, 0);
+                writeWord(ack.packet.data() + 8, 0);
+                ack.packet[0x1c] = 3;
+                return ack;
+            }
+            static constexpr uint32_t kBufferSize = 0x100000;
+            static uint16_t readHalf(const uint8_t *p)
+            {
+                return uint16_t(p[0]) | (uint16_t(p[1]) << 8);
+            }
+            static uint32_t readWord(const uint8_t *p)
+            {
+                return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+            }
+            static void writeWord(uint8_t *p, uint32_t value)
+            {
+                for (unsigned i = 0; i < 4; ++i) p[i] = static_cast<uint8_t>(value >> (8 * i));
+            }
+            IopHost &m_host;
+            const bool m_retail;
+            std::vector<int16_t> m_cuePcm;
+            bool m_cueAttempted = false;
+            bool m_cueEnabled = true;
+            uint32_t m_cueVoice = 0, m_cueCommands = 0;
+            std::array<uint8_t, 64> m_retailLevelRecord{};
+            EngineStates m_engines{};
+            SkidPitches m_skidPitches{};
+            SkidPitches m_roadPitches{};
+            Listeners m_listeners{};
+            Emitters m_emitters{};
+            bool m_engineAliasesReady = false;
+            uint64_t m_engineUpdates = 0;
+            std::array<SoundTable, 2> m_soundTables{};
+            SoundBank m_pendingBank;
+            std::array<SoundBank, 16> m_soundBanks{};
+            std::vector<SoundDefinition> m_soundDefinitions;
+            uint32_t m_bankAllocatedBytes = 0;
+            uint64_t m_bankVoiceCommands = 0, m_lastBankSound = 0, m_lastBankVoiceFrames = 0, m_lastBankVoiceHash = 0;
+            bool m_environmentEnabled = false;
+            mutable std::mutex m_mutex;
+            uint32_t m_iopBuffer = 0, m_eeBuffer = 0, m_eeSize = 0;
+            uint64_t m_commands = 0, m_unsupported = 0;
+            uint32_t m_lastKind = 0, m_loggedKinds = 0;
+            bool m_ready = false;
+            std::array<uint8_t, 16> m_status{0, 1, 0, 64, 51, 64, 51, 64, 75, 75, 75, 37, 0, 0, 0, 0};
+            bool m_statusPending = false;
+            uint8_t m_statusSlot = 0;
+            SifCommandReply m_deferredStatus{};
+            uint64_t m_batches = 0, m_statusAcks = 0;
+            uint32_t m_lastBatchCount = 0, m_lastOpcode = 0;
+            uint32_t m_lastEngineUpdateMask = 0, m_lastEngineInitMask = 0, m_lastPlayerUpdateMask = 0;
+            bool m_streamStopRequested = false;
+            bool m_soundEnabled = false;
+            StreamState m_movie{}, m_music{};
+            uint64_t m_immediateCommands = 0;
+            uint64_t m_levelResets = 0;
+            uint32_t m_ambientStream = 0xffffffffu, m_ambientObject = 0;
+            std::array<uint32_t, 3> m_ambientPosition{};
+            uint32_t m_engineStream = 0xffffffffu, m_enginePlayer = 0xffffffffu;
+        };
+    }
+
+    std::unique_ptr<IopService> createRumbleAudioService(IopHost &host)
+    {
+        return std::make_unique<RumbleAudio>(host);
+    }
+
+    std::unique_ptr<IopService> createRumbleRetailAudioService(IopHost &host)
+    {
+        return std::make_unique<RumbleAudio>(host, true);
+    }
+}
