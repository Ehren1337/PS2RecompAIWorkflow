+
+bool NonAliasingFrame(const GSContext &ctx)
+{
+    const uint32_t firstPage = (ctx.scissor.y0 / 32) * ctx.frame.fbw + ctx.scissor.x0 / 64;
+    const uint32_t lastPage = (ctx.scissor.y1 / 32) * ctx.frame.fbw + ctx.scissor.x1 / 64;
+    return ctx.scissor.x1 < ctx.frame.fbw * 64 && lastPage - firstPage < 512;
