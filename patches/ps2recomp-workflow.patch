+// Render-thread companions: one latest image and one bounded history sheet.
+void ps2WriteInspectorFramePng(const void *data, size_t size, bool history)
+{
+#if defined(_WIN32)
+    const auto setting = _wgetenv(L"PS2_INSPECTOR_FILE");
+#else
+    const auto setting = std::getenv("PS2_INSPECTOR_FILE");
+#endif
+    if (!setting || !*setting) return;
+    auto path = std::filesystem::path(setting);
+    path.replace_extension(history ? ".frames.png" : ".png");
+    replaceFile(path, std::string(static_cast<const char *>(data), size));
+}
+
+PS2Inspector::PS2Inspector()
+{
+#if defined(_WIN32)
+    const auto setting = _wgetenv(L"PS2_INSPECTOR_FILE");
+#else
+    const auto setting = std::getenv("PS2_INSPECTOR_FILE");
+#endif
+    if (setting && *setting) m_path = setting;
+}
+
+void PS2Inspector::capture(PS2Runtime &runtime, const R5900Context &context)
+{
+    if (!m_requested.exchange(false, std::memory_order_relaxed)) return;
+    try
+    {
+        ++m_sequence;
+        uint32_t ra;
+        std::memcpy(&ra, &context.r[31], sizeof(ra));
+        m_cpuHistory.push_back(object({{"sequence", number(m_sequence)}, {"captured_unix_ms", number(nowMs())},
+            {"pc", hex(context.pc)}, {"ra", hex(ra)}}));
+        while (m_cpuHistory.size() > 60) m_cpuHistory.pop_front();
+        auto text = collect(runtime, context, m_sequence, array(m_cpuHistory, [](const auto &s) { return s; }));
+        std::lock_guard lock(m_mutex);
+        m_snapshot = std::move(text);
+    }
+    catch (const std::exception &e)
+    {
+        // A failed capture must not be mistaken for a fresh snapshot.
+        std::lock_guard lock(m_mutex);
+        m_snapshot = object({{"sequence", number(m_sequence)}, {"captured_unix_ms", number(nowMs())}, {"error", quote(e.what())}});
+    }
+}
+
+void PS2Inspector::poll(bool stopped)
+{
+    if (!enabled()) return;
+    const auto now = std::chrono::steady_clock::now();
+    if (!stopped && now < m_nextPoll) return;
+    m_nextPoll = now + std::chrono::seconds(1);
+    std::string snapshot;
+    {
+        std::lock_guard lock(m_mutex);
+        snapshot = m_snapshot;
+    }
+    m_requested.store(true, std::memory_order_relaxed);
+    if (snapshot.empty()) snapshot = "null";
+    try
+    {
+#if defined(_WIN32)
+        const auto pid = GetCurrentProcessId();
+#else
+        const auto pid = getpid();
+#endif
+        replaceFile(m_path, object({{"schema_version", "1"}, {"process_id", number(pid)},
+            {"written_unix_ms", number(nowMs())}, {"runtime_state", quote(stopped ? "stopped" : "running")}, {"snapshot", snapshot}}));
+        m_error.clear();
+    }
+    catch (const std::exception &e)
+    {
+        if (m_error != e.what()) RUNTIME_ERROR("[inspector] " << e.what() << std::endl);
+        m_error = e.what();
+    }
+}
