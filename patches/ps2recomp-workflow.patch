diff --git a/ps2xIOP/src/modules/rumble_audio.cpp b/ps2xIOP/src/modules/rumble_audio.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xIOP/src/modules/rumble_audio.cpp
@@ -0,0 +1,2047 @@
+#include "iop_service.h"
+#include "module_factories.h"
+
+#include <array>
+#include <algorithm>
+#include <cstring>
+#include <chrono>
+#include <mutex>
+#include <sstream>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // February AUDIO.IRX: thread 0x856C calls transfer init 0xCE20 with
+        // 0x100000 bytes. 0xCCF4 exchanges SREG 30/31 using command 0x80000001.
+        // This is the verified transport startup, not a replacement audio mixer.
+        class RumbleAudio final : public IopService
+        {
+        public:
+            explicit RumbleAudio(IopHost &host, bool retail = false) : m_host(host), m_retail(retail)
+            { m_status = initialStatus(); }
+            ~RumbleAudio() override { reset(); }
+            std::string_view name() const override
+            { return m_retail ? "Rumble retail AUDIO transport" : "Rumble February AUDIO transport"; }
+            std::span<const uint32_t> sids() const override { return {}; }
+            RpcResult handleRpc(const RpcRequest &) override { return {}; }
+
+            void reset() override
+            {
+                std::lock_guard lock(m_mutex);
+                if (m_iopBuffer) m_host.freeIopMemory(m_iopBuffer);
+                m_iopBuffer = m_eeBuffer = m_eeSize = 0;
+                m_ready = false;
+                m_commands = m_unsupported = m_lastKind = m_loggedKinds = 0;
+                m_batches = m_statusAcks = m_lastBatchCount = m_lastOpcode = 0;
+                m_lastEngineUpdateMask = m_lastEngineInitMask = m_lastPlayerUpdateMask = 0;
+                m_statusPending = false;
+                m_statusSlot = 0;
+                m_movie = {};
+                m_music = {};
+                m_deferredStatus = {};
+                m_streamStopRequested = false;
+                m_soundEnabled = false;
+                m_host.stopStereoStream();
+                m_host.stopPcmVoices();
+                m_cuePcm.clear();
+                m_cueAttempted = false;
+                m_cueVoice = m_cueCommands = 0;
+                m_cueEnabled = true;
+                m_retailLevelRecord = {};
+                m_engines = {};
+                m_skidPitches = {};
+                m_roadPitches = {};
+                m_listeners = {};
+                m_emitters = {};
+                m_engineAliasesReady = false;
+                m_engineUpdates = 0;
+                m_soundTables = {};
+                m_pendingBank = {};
+                m_soundBanks = {};
+                m_soundDefinitions.clear();
+                m_bankAllocatedBytes = 0;
+                m_bankVoiceCommands = m_lastBankSound = m_lastBankVoiceFrames = m_lastBankVoiceHash = 0;
+                m_environmentEnabled = false;
+                m_immediateCommands = 0;
+                m_levelResets = 0;
+                m_ambientStream = m_engineStream = 0xffffffffu;
+                m_ambientObject = 0;
+                m_enginePlayer = 0xffffffffu;
+                m_ambientPosition = {};
+                m_status = initialStatus();
+            }
+
+            SifCommandResult handleSifCommand(const SifCommand &command) override
+            {
+                std::lock_guard lock(m_mutex);
+                if (command.id == 0x80000001u)
+                {
+                    // Retail 0xE2F0, called by thread 0x8DAC, uses the same
+                    // owned 1-MiB allocation, alignment and SREG 30/31 exchange.
+                    // Sharing this handshake does not enable February opcodes.
+                    std::array<uint32_t, 6> packet{};
+                    if (command.packet.size != sizeof(packet) ||
+                        !m_host.readGuest(command.packet.address, packet.data(), sizeof(packet)))
+                        return {};
+                    const auto index = packet[4];
+                    const auto value = packet[5];
+                    if (index != 30 && index != 31) return {};
+                    ++m_commands;
+                    if (index == 30)
+                    {
+                        m_eeBuffer = value;
+                        return {true, true, {}};
+                    }
+                    m_eeSize = value;
+                    uint32_t begin = 0, end = 0;
+                    if (value <= 1 || value > 0x02000000u || m_eeBuffer == 0 ||
+                        uint64_t(m_eeBuffer) + value > 0x100000000ull ||
+                        !m_host.normalizeGuestAddress(m_eeBuffer, begin) ||
+                        !m_host.normalizeGuestAddress(m_eeBuffer + value - 1, end) ||
+                        uint64_t(begin) + value - 1 != end)
+                    {
+                        m_ready = false;
+                        std::ostringstream out;
+                        out << "Rumble AUDIO: EE buffer unavailable; address=0x" << std::hex
+                            << m_eeBuffer << " size=0x" << value;
+                        m_host.log(LogLevel::Warning, out.str());
+                        return {true, true, {{31, 1}}};
+                    }
+                    if (!m_iopBuffer) m_iopBuffer = m_host.allocateIopMemory(kBufferSize + 64);
+                    if (!m_iopBuffer)
+                        return {true, true, {{31, 1}}};
+                    const uint32_t aligned = (m_iopBuffer + 63u) & ~63u;
+                    const uint32_t usable = kBufferSize - (aligned - m_iopBuffer);
+                    m_ready = true;
+                    m_host.log(LogLevel::Info, "Rumble AUDIO: exchanged EE/IOP transfer buffers");
+                    return {true, true, {{30, aligned}, {31, usable}}};
+                }
+                if (command.id != 0 || !m_ready) return {};
+                std::string batchCommands;
+                std::array<uint8_t, 64> packet{};
+                if (command.packet.size != packet.size() ||
+                    !m_host.readGuest(command.packet.address, packet.data(), packet.size()))
+                    return {true, false, {}};
+                ++m_commands;
+                m_lastKind = packet[0x1d];
+                // 0x86F8 uses the saved outgoing slot's kind, not the ACK's kind.
+                auto *closing = m_movie.closePending ? &m_movie : m_music.closePending ? &m_music : nullptr;
+                if (packet[0x1c] == 3 && closing &&
+                    packet[0x1e] == closing->closeSlot && command.extra.size == 0)
+                {
+                    closing->closePending = false;
+                    ++closing->closeAcks;
+                    // Original 0xD010/0xD130 serializes outgoing commands. The
+                    // close callback is acknowledged before status is sent.
+                    SifCommandReply status = std::move(m_deferredStatus);
+                    m_deferredStatus = {};
+                    return {true, true, {}, {std::move(status)}};
+                }
+                if (packet[0x1c] == 3 && m_statusPending && !closing &&
+                    packet[0x1e] == m_statusSlot)
+                {
+                    m_statusPending = false;
+                    m_movie.releasePending = false;
+                    m_music.releasePending = false;
+                    m_statusSlot = (m_statusSlot + 1) & 7;
+                    ++m_statusAcks;
+                    return {true, true, {}};
+                }
+                if (m_retail && packet[0x1c] == 2 && packet[0x1e] < 8 &&
+                    m_lastKind == 2 && packet[0x1f] == 0 && retainSoundTable(command, packet))
+                    return {true, true, {}, {makeAck(packet)}};
+                if (m_retail && packet[0x1c] == 2 && packet[0x1e] < 8 &&
+                    m_lastKind <= 1 && packet[0x1f] == 0 && retainSoundBank(command, packet))
+                    return {true, true, {}, {makeAck(packet)}};
+                if (packet[0x1c] == 2 && packet[0x1e] < 8 && m_lastKind == 6 &&
+                    command.extra.size == 0 && readWord(packet.data() + 0x14) == 0)
+                {
+                    // 0x67B0 subcommand 0 -> 0x82EC stops the shared active
+                    // stream. Activation is still rejected, so no held buffer
+                    // exists to release. Subcommand 4 opens the movie FIFO.
+                    // Reopening requires the original close notification and
+                    // release events; do not silently erase an existing queue.
+                    // Retail 0x6E7C -> 0x889C / 0xCD08 has the same protocol.
+                    if ((packet[0x1f] == 0 && !m_movie.playing && !m_music.playing) ||
+                        (m_retail && packet[0x1f] == 2 && !m_music.open && !m_music.releasePending) ||
+                        (packet[0x1f] == 4 && !m_movie.open && !m_movie.releasePending))
+                    {
+                        // Retail 0xCC38 -> 0xCEA0 opens the independent music FIFO.
+                        if (packet[0x1f] == 2) m_music.open = true;
+                        if (packet[0x1f] == 4) m_movie.open = true;
+                        ++m_immediateCommands;
+                        return {true, true, {}, {makeAck(packet)}};
+                    }
+                }
+                const bool musicInput = m_retail && m_lastKind == 3;
+                auto &inputStream = musicInput ? m_music : m_movie;
+                if (packet[0x1c] == 2 && packet[0x1e] < 8 && (musicInput || m_lastKind == 7) &&
+                    packet[0x1f] == 0 && inputStream.open && inputStream.count < (musicInput ? 10u : 3u))
+                {
+                    // 0xBA58 -> 0xBBE0 retains the copied IOP chunk. The ACK
+                    // releases its EE source, not the IOP slot: event 12 follows
+                    // only when 0x7DA4 advances past the consumed audio buffer.
+                    // Retail 0xCD58 -> 0xCEE0 retains the same three-buffer
+                    // FIFO; 0x8310 advances planar channels at +0x40/+0x3000.
+                    // Retail music 0xCC88 uses ten slots and release event 6.
+                    const uint32_t address = command.extraDestination;
+                    const uint32_t size = readWord(packet.data() + 0x14);
+                    const uint32_t begin = (m_iopBuffer + 63u) & ~63u;
+                    bool valid = size >= 0x40 && size <= 0x6000 &&
+                        command.extra.size == ((size + 15u) & ~15u) &&
+                        address == readWord(packet.data() + 0x20) && (address & 63u) == 0 &&
+                        uint64_t(address) >= uint64_t(begin) + 0xcc0 &&
+                        uint64_t(address) + 0x6000 <= uint64_t(m_iopBuffer) + kBufferSize;
+                    for (const auto *queue : {&m_movie, &m_music})
+                        for (unsigned i = 0; valid && i < queue->count; ++i)
+                            valid = uint64_t(address) + 0x6000 <= queue->buffers[i].address ||
+                                uint64_t(queue->buffers[i].address) + 0x6000 <= address;
+                    MovieBuffer buffer;
+                    if (valid)
+                    {
+                        buffer.bytes.resize(size);
+                        valid = m_host.readGuest(address, buffer.bytes.data(), size) &&
+                            readWord(buffer.bytes.data() + 4) == size;
+                    }
+                    if (valid)
+                    {
+                        buffer.address = address;
+                        inputStream.bytes += size;
+                        inputStream.buffers[inputStream.count++] = std::move(buffer);
+                        return {true, true, {}, {makeAck(packet)}};
+                    }
+                }
+                if (packet[0x1c] == 2 && m_lastKind == 5 && packet[0x1e] < 8 &&
+                    packet[0x1f] == 0 && !m_statusPending && command.extra.size == 0xcc0 &&
+                    command.extraDestination == ((m_iopBuffer + 63u) & ~63u))
+                {
+                    std::array<uint8_t, 0xcc0> batch{};
+                    if (!m_host.readGuest(command.extraDestination, batch.data(), batch.size()))
+                        return {true, false, {}};
+                    m_lastBatchCount = readWord(batch.data());
+                    m_lastOpcode = m_lastBatchCount ? batch[0x40] : 0;
+                    // Keep rejected batch evidence in the existing bounded log.
+                    // Eight header bytes include the signed preview category.
+                    if (!(m_loggedKinds & (1u << 5)))
+                    {
+                        std::ostringstream commands;
+                        for (unsigned i = 0; i < std::min(m_lastBatchCount, 40u); ++i)
+                        {
+                            const auto *record = batch.data() + 0x40 + i * 64;
+                            if (i) commands << ',';
+                            commands << unsigned(record[0]) << ':' << unsigned(record[1])
+                                     << ':' << unsigned(record[2]) << ':' << unsigned(record[3])
+                                     << ':' << unsigned(record[4]) << ':' << unsigned(record[5])
+                                     << ':' << unsigned(record[6]) << ':' << unsigned(record[7]);
+                        }
+                        batchCommands = commands.str();
+                    }
+                    // 0x7E70 updates control state before dispatching sound commands.
+                    // Support control batches first; never consume active sound
+                    // or engine/ambient updates without implementing their effects.
+                    // Retail 0x83DC uses the retained player count, changed by
+                    // opcode 31; February reads it from the batch header.
+                    const unsigned players = m_retail ? m_status[2] : batch[6];
+                    // Record every section of the rejected packet, not just its
+                    // first ordinary opcode. Retail 0x83DC processes engine and
+                    // player updates before the command list.
+                    m_lastEngineUpdateMask = m_lastEngineInitMask = m_lastPlayerUpdateMask = 0;
+                    for (unsigned player = 0; player < std::min(players, 2u); ++player)
+                        if (batch[0xc40 + player * 64 + 0x3d]) m_lastPlayerUpdateMask |= 1u << player;
+                    if (batch[0x14])
+                        for (unsigned engine = 0; engine < 8; ++engine)
+                            if (batch[0xa40 + engine * 64])
+                            {
+                                m_lastEngineUpdateMask |= 1u << engine;
+                                if (m_retail && batch[0xa40 + engine * 64 + 0x22])
+                                    m_lastEngineInitMask |= 1u << engine;
+                            }
+                    bool idle = m_lastBatchCount <= 40 && players <= 2;
+                    bool startMovie = false;
+                    bool stopMovie = false;
+                    bool startMusic = false;
+                    bool stopMusic = false;
+                    unsigned cueCount = 0;
+                    unsigned cueVoice = m_cueVoice;
+                    uint64_t cueMask = 0;
+                    bool cueEnabled = m_cueEnabled, stopCue = false;
+                    bool closeEngines = false, releaseBanks = false;
+                    std::array<std::vector<int16_t>, 48> bankVoices{};
+                    std::vector<uint8_t> nextVariants;
+                    for (const auto &definition : m_soundDefinitions) nextVariants.push_back(definition.lastVariant);
+                    uint64_t occupiedVoices = m_host.activePcmVoiceMask();
+                    unsigned bankVoiceCommands = 0, lastBankSound = 0;
+                    uint64_t lastBankFrames = 0, lastBankHash = 0;
+                    auto engines = m_engines;
+                    auto skidPitches = m_skidPitches;
+                    auto roadPitches = m_roadPitches;
+                    auto listeners = m_listeners;
+                    auto emitters = m_emitters;
+                    // Reconcile completion before any command can reuse an idle
+                    // slot. The later allocation mask also contains new voices.
+                    for (auto &emitter : emitters)
+                        if (emitter.handle && !(occupiedVoices & (uint64_t(1) << (emitter.handle - 1))))
+                            emitter.handle = 0;
+                    bool engineAliasesReady = m_engineAliasesReady;
+                    uint64_t engineUpdates = m_engineUpdates;
+                    for (unsigned i = 0; idle && i < m_lastBatchCount; ++i)
+                    {
+                        const auto *record = batch.data() + 0x40 + i * 64;
+                        idle = (record[0] == 10 && record[1] >= 1 && record[1] <= 5) ||
+                            (m_retail ? ((record[0] == 31 && record[1] <= 2) || record[0] == 32 || record[0] == 33 ||
+                                record[0] == 1 || record[0] == 2 || record[0] == 4 || record[0] == 5 || record[0] == 9 ||
+                                record[0] == 11 || record[0] == 14 || record[0] == 15 || record[0] == 17 || record[0] == 20 ||
+                                (record[0] == 28 && record[1] <= 2 && record[4] < 64) ||
+                                (record[0] == 16 && record[3] <= 8 && record[4] <= 2)) :
+                               (record[0] == 2 || record[0] == 4 || record[0] == 5 || record[0] == 9 || record[0] == 14 ||
+                                record[0] == 11 || record[0] == 16 || record[0] == 20 || record[0] == 21 || record[0] == 22));
+                        if (m_retail && record[0] == 32)
+                        {
+                            ++cueCount;
+                            if (cueEnabled) cueMask |= uint64_t(1) << cueVoice;
+                            cueVoice = (cueVoice + 1) % 24;
+                        }
+                        if (m_retail && record[0] == 28)
+                            // A later registration after a bulk key-off needs
+                            // ordered stop/restart submission to the host sink.
+                            idle = idle && !stopCue && prepareEmitterCommand(record, emitters);
+                        if (m_retail && record[0] == 33 && record[1] != 0)
+                        {
+                            // 0x8A60 category < 0 is an independent core-1 voice,
+                            // gain 0x1FFF. Category-controlled/looping previews
+                            // need their own update/release lifecycle first.
+                            idle = static_cast<int8_t>(record[4]) < 0;
+                            unsigned voice = 24;
+                            while (voice < 48 && (occupiedVoices & (uint64_t(1) << voice))) ++voice;
+                            if (voice == 48) idle = false;
+                            if (idle) idle = prepareBankOneShot(readHalf(record + 2), nextVariants, bankVoices[voice]);
+                            if (idle)
+                            {
+                                occupiedVoices |= uint64_t(1) << voice;
+                                ++bankVoiceCommands;
+                                lastBankSound = readHalf(record + 2);
+                                lastBankFrames = bankVoices[voice].size() / 2;
+                                lastBankHash = 14695981039346656037ull;
